# http://editorconfig.org

root = true

[*]
charset = utf-8
indent_style = space
indent_size = 2
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

[*.sh]
indent_size = 4

[*.md]
insert_final_newline = true
trim_trailing_whitespace = false

# These files preserve exact, hash-verified upstream source bytes.
[scripts/data/create-awesome/pinned/**/semantic/*.source]
charset = unset
end_of_line = unset
indent_style = unset
indent_size = unset
insert_final_newline = unset
trim_trailing_whitespace = unset
