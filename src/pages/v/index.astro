---
import SectionLayout from '@/layouts/SectionLayout.astro';
import { getRouteMeta } from '@/data/routes';
import VComputationalLab from '@/features/v/components/VComputationalLab.astro';

const meta = getRouteMeta('/v')!;
---

<SectionLayout
  currentPath="/v"
  world="V Ecosystem"
  title={meta.title}
  description={meta.description}
  theme="v"
  immersive
>
  <VComputationalLab />
</SectionLayout>
