---
import SectionLayout from '@/layouts/SectionLayout.astro';
import { getRouteMeta } from '@/data/routes';
const meta = getRouteMeta('/projects')!;
---

<SectionLayout title={meta.title} description={meta.description} theme="projects">
  <h1>Projects — Curated catalog</h1>
  <p>
    Proyectos que no requieren sección dedicada — control editorial manual, enriquecimiento GH opcional, estados
    active/maintained/experimental/archived.
  </p>
  <div style="display:grid; grid-template-columns:repeat(auto-fit,minmax(250px,1fr)); gap:1rem; margin:1rem 0;">
    <div style="padding:1rem; border:1px solid var(--color-border); border-radius:10px;">
      <h3>recoil-devtools</h3>
      <p style="color:var(--color-muted); font-size:0.9rem;">
        Devtools para Recoil — 49★. No archivado (verificado). Estado: experimental.
      </p>
      <a href="https://github.com/ulises-jeremias/recoil-devtools" target="_blank" rel="noreferrer">Repo →</a>
    </div>
    <div style="padding:1rem; border:1px solid var(--color-border); border-radius:10px;">
      <h3>awesome-v</h3>
      <p style="color:var(--color-muted); font-size:0.9rem;">Curated V resources — mantenido por Ulises.</p>
      <a href="https://github.com/ulises-jeremias/awesome-v" target="_blank" rel="noreferrer">Repo →</a>
    </div>
    <div style="padding:1rem; border:1px solid var(--color-border); border-radius:10px; opacity:0.7;">
      <h3>Ejemplo archivado</h3>
      <p style="color:var(--color-muted); font-size:0.9rem;">
        Tratamiento sutil para archivados — no oculto, pero distinguido.
      </p>
    </div>
  </div>
  <p style="color:var(--color-muted); font-size:0.9rem;">
    Última verificación: 2026-08-07. Enriquecimiento GH muestra fuente + fecha, fallback gracioso si API falla.
  </p>
</SectionLayout>
