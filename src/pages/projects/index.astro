---
import SectionLayout from '@/layouts/SectionLayout.astro';
import { Catalog } from '@/features/projects';
import { getRouteMeta } from '@/data/routes';
const meta = getRouteMeta('/projects')!;
---

<SectionLayout
  currentPath="/projects"
  world="Projects"
  title={meta.title}
  description={meta.description}
  theme="projects"
>
  <Catalog />
</SectionLayout>
