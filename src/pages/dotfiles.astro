---
import SectionLayout from '@/layouts/SectionLayout.astro';
import { getRouteMeta } from '@/data/routes.js';
import DotfilesWorld from '@/features/dotfiles/components/DotfilesWorld.astro';
import '@/styles/dotfiles.css';

const meta = getRouteMeta('/dotfiles')!;
---

<SectionLayout
  title={meta.title}
  description={meta.description}
  currentPath="/dotfiles"
  world="HorneroConfig"
  theme="dotfiles"
  immersive
>
  <DotfilesWorld />
</SectionLayout>
