---
import SectionLayout from '@/layouts/SectionLayout.astro';
import { getRouteMeta } from '@/data/routes.js';
import {
  DotfilesNarrative,
  LayersDiagram,
  ScreenshotGallery,
  SmartColorsAnimation,
  attributionEntries,
  verifiedFacts,
} from '@/features/dotfiles';
import '@/styles/dotfiles.css';

const meta = getRouteMeta('/dotfiles')!;
const pageTitle = meta.title;
const pageDescription = meta.description;

const heroScene = {
  primary: {
    src: '/media/dotfiles/screen.png',
    alt: 'HorneroConfig dark desktop with Quickshell bars, btop, and cava',
    width: 1914,
    height: 1075,
    label: 'screen.png · dark desktop',
  },
  thumbs: [
    {
      src: '/media/dotfiles/screenshot-launchpad.png',
      alt: 'Application launchpad grid',
      width: 1440,
      height: 900,
      label: 'Launchpad',
    },
    {
      src: '/media/dotfiles/screenshot-spotlight-dark.png',
      alt: 'Dark spotlight launcher',
      width: 1440,
      height: 868,
      label: 'Spotlight',
    },
    {
      src: '/media/dotfiles/screen-2.jpg',
      alt: 'Landscape appearance with telemetry bar',
      width: 1916,
      height: 1080,
      label: 'Landscape theme',
    },
  ],
};
---

<SectionLayout
  title={pageTitle}
  description={pageDescription}
  currentPath="/dotfiles"
  world="HorneroConfig"
  theme="dotfiles"
>
  <div class="dotfiles-page">
    <header class="dotfiles-hero" role="banner">
      <div class="dotfiles-hero__main">
        <div class="dotfiles-hero__copy">
          <p class="dotfiles-hero__eyebrow">HorneroConfig · Personal DX desktop</p>
          <h1 class="dotfiles-hero__title">
            <span class="dotfiles-hero__title-accent">Hornero</span>Config
          </h1>
          <p class="dotfiles-hero__subtitle">
            The framework that builds your digital nest. <strong>Hyprland + Quickshell + Kitty + Zsh</strong> orchestrated
            by <strong>chezmoi</strong> and <strong>{verifiedFacts.dotsScriptCount} dots-*</strong> scripts. Smart Colors
            maps wallpaper → Material extraction → <code>scheme.json</code> → Quickshell, Hyprland, Kitty, and GTK.
          </p>

          <div class="dotfiles-hero__badges" role="list" aria-label="Project facts">
            <span class="dotfiles-hero__badge" role="listitem">MIT · 2019-2025</span>
            <span class="dotfiles-hero__badge" role="listitem">{verifiedFacts.themeCount} themes</span>
            <span class="dotfiles-hero__badge" role="listitem">theme.json · no apply.sh</span>
            <span class="dotfiles-hero__badge dotfiles-hero__badge--plum" role="listitem"
              >plum #191114 · pink #FFB0CA</span
            >
          </div>

          <div class="dotfiles-hero__actions">
            <a href="#gallery" class="dotfiles-hero__cta dotfiles-hero__cta--primary">View gallery</a>
            <a href="#smart-colors" class="dotfiles-hero__cta dotfiles-hero__cta--secondary">Smart Colors →</a>
            <a
              href={verifiedFacts.wikiUrl}
              class="dotfiles-hero__cta dotfiles-hero__cta--ghost"
              target="_blank"
              rel="noreferrer">Docs wiki</a
            >
          </div>

          <div class="dotfiles-hero__install" role="region" aria-label="Quick install">
            <p class="dotfiles-hero__install-label">One-command install</p>
            <pre class="dotfiles-hero__install-code"><code>{verifiedFacts.installCurl}</code></pre>
            <div class="dotfiles-hero__install-alts">
              <code>yay -S dots-stable</code>
              <code>chezmoi init --apply ulises-jeremias</code>
              <code>dots appearance</code>
            </div>
          </div>
        </div>

        <div class="dotfiles-hero__visual">
          <figure class="dotfiles-hero__scene">
            <img
              class="dotfiles-hero__scene-img"
              src={heroScene.primary.src}
              alt={heroScene.primary.alt}
              width={String(heroScene.primary.width)}
              height={String(heroScene.primary.height)}
              decoding="async"
              fetchpriority="high"
            />
            <figcaption class="dotfiles-hero__scene-caption">{heroScene.primary.label}</figcaption>
          </figure>
          <div class="dotfiles-hero__thumbs" role="list" aria-label="More desktop captures">
            {
              heroScene.thumbs.map((thumb) => (
                <figure class="dotfiles-hero__thumb" role="listitem">
                  <img
                    src={thumb.src}
                    alt={thumb.alt}
                    width={String(thumb.width)}
                    height={String(thumb.height)}
                    loading="lazy"
                    decoding="async"
                  />
                  <figcaption>{thumb.label}</figcaption>
                </figure>
              ))
            }
          </div>
        </div>
      </div>
    </header>

    <main id="contenido" class="dotfiles-main" tabindex="-1">
      <section class="dotfiles-section" aria-label="Narrative">
        <DotfilesNarrative />
      </section>

      <section id="stack" class="dotfiles-section dotfiles-section--alt" aria-label="Layers diagram">
        <LayersDiagram />
      </section>

      <section id="smart-colors" class="dotfiles-section" aria-label="Smart Colors">
        <SmartColorsAnimation />
      </section>

      <section id="gallery" class="dotfiles-section dotfiles-section--alt" aria-label="Screenshot gallery">
        <ScreenshotGallery />
      </section>

      <section id="attribution" class="dotfiles-section" aria-labelledby="attribution-title">
        <details class="dotfiles-attribution">
          <summary class="dotfiles-attribution__summary">
            <p class="dotfiles-attribution__eyebrow">Attribution</p>
            <h2 id="attribution-title" class="dotfiles-attribution__title">Credits that keep the nest honest</h2>
            <p class="dotfiles-attribution__desc">
              HorneroConfig is MIT. Quickshell UI is adapted from caelestia-dots/shell (GPL-3.0) with upstream credit —
              expand for component notes.
            </p>
          </summary>

          <ul class="dotfiles-attribution__list">
            {
              attributionEntries.map((entry) => (
                <li class="dotfiles-attribution__item">
                  <span class="dotfiles-attribution__badge">{entry.license}</span>
                  <div>
                    <strong>{entry.component}</strong>
                    <span class="dotfiles-attribution__source">{entry.source}</span>
                    <p>{entry.notes}</p>
                  </div>
                </li>
              ))
            }
          </ul>
        </details>
      </section>

      <section class="dotfiles-cta" aria-label="Call to action">
        <div class="dotfiles-cta__inner">
          <h2 class="dotfiles-cta__title">Ready to nest?</h2>
          <p class="dotfiles-cta__text">
            Clone, apply a theme, and let Smart Colors handle the rest. Meet builders across the Digital Nest community
            — HorneroConfig is one station in the workshop, not a solo silo.
          </p>
          <div class="dotfiles-cta__actions">
            <a
              href={verifiedFacts.repoUrl}
              target="_blank"
              rel="noreferrer"
              class="dotfiles-cta__btn dotfiles-cta__btn--primary">Open on GitHub</a
            >
            <a href={verifiedFacts.smartColorsWikiUrl} target="_blank" rel="noreferrer" class="dotfiles-cta__btn"
              >Explore Smart Colors</a
            >
            <a href="/community" class="dotfiles-cta__btn">Digital Nest community</a>
            <a href="/" class="dotfiles-cta__btn dotfiles-cta__btn--ghost">← Back to home</a>
          </div>
        </div>
      </section>
    </main>
  </div>

  <style>
    .dotfiles-hero {
      max-width: 1120px;
      margin: 0 auto;
      padding: 1.1rem 1.2rem 2rem;
    }

    .dotfiles-hero__main {
      display: grid;
      gap: 1.6rem;
      margin-top: 0.4rem;
      align-items: start;
    }

    @media (min-width: 920px) {
      .dotfiles-hero__main {
        grid-template-columns: 1.05fr 0.95fr;
      }
    }

    .dotfiles-hero__eyebrow {
      display: inline-flex;
      padding: 0.32rem 0.75rem;
      border-radius: 999px;
      background: rgba(255, 176, 202, 0.14);
      border: 1px solid rgba(255, 176, 202, 0.28);
      color: #ffb0ca;
      font-size: 0.78rem;
      font-weight: 750;
      letter-spacing: 0.06em;
      text-transform: uppercase;
      margin: 0 0 0.9rem;
    }

    .dotfiles-hero__title {
      margin: 0 0 0.65rem;
      font-size: clamp(2.3rem, 5vw, 3.6rem);
      font-weight: 900;
      letter-spacing: -0.04em;
      line-height: 0.95;
      color: #fbe7ec;
    }

    .dotfiles-hero__title-accent {
      color: #ffb0ca;
    }

    .dotfiles-hero__subtitle {
      margin: 0 0 1rem;
      color: #d5c2c6;
      line-height: 1.65;
      font-size: 1.02rem;
      max-width: 62ch;
    }

    .dotfiles-hero__subtitle strong,
    .dotfiles-hero__subtitle code {
      color: #fbe7ec;
      font-weight: 750;
    }

    .dotfiles-hero__subtitle code {
      font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
      font-size: 0.92em;
      font-weight: 650;
      padding: 0.08rem 0.28rem;
      border-radius: 0.3rem;
      background: rgba(255, 176, 202, 0.12);
      color: #ffb0ca;
    }

    .dotfiles-hero__badges {
      display: flex;
      flex-wrap: wrap;
      gap: 0.5rem;
      margin-bottom: 1.1rem;
    }

    .dotfiles-hero__badge {
      padding: 0.28rem 0.6rem;
      border-radius: 999px;
      background: rgba(25, 17, 20, 0.9);
      border: 1px solid rgba(255, 176, 202, 0.18);
      color: #e2bdc7;
      font-size: 0.76rem;
      font-weight: 700;
    }

    .dotfiles-hero__badge--plum {
      background: #ffb0ca;
      color: #191114;
      border-color: #ffb0ca;
    }

    .dotfiles-hero__actions {
      display: flex;
      flex-wrap: wrap;
      gap: 0.6rem;
      margin-bottom: 1.2rem;
    }

    .dotfiles-hero__cta {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      padding: 0.7rem 1rem;
      border-radius: 0.85rem;
      font-weight: 800;
      font-size: 0.9rem;
      text-decoration: none;
      border: 1px solid transparent;
      transition:
        transform 0.15s ease,
        background 0.15s ease,
        border-color 0.15s ease;
    }

    .dotfiles-hero__cta:hover {
      transform: translateY(-1px);
    }

    .dotfiles-hero__cta--primary {
      background: #ffb0ca;
      color: #191114;
      border-color: #ffb0ca;
    }

    .dotfiles-hero__cta--primary:hover {
      background: #ffc6d8;
    }

    .dotfiles-hero__cta--secondary {
      background: rgba(25, 17, 20, 0.92);
      color: #fbe7ec;
      border-color: rgba(255, 176, 202, 0.28);
    }

    .dotfiles-hero__cta--ghost {
      background: transparent;
      color: #d5c2c6;
      border-color: rgba(255, 176, 202, 0.16);
    }

    .dotfiles-hero__install {
      background: rgba(25, 17, 20, 0.92);
      border: 1px solid rgba(255, 176, 202, 0.16);
      border-radius: 1rem;
      padding: 0.9rem;
    }

    .dotfiles-hero__install-label {
      margin: 0 0 0.45rem;
      font-size: 0.78rem;
      font-weight: 750;
      letter-spacing: 0.05em;
      text-transform: uppercase;
      color: #ffb0ca;
    }

    .dotfiles-hero__install-code {
      margin: 0;
      padding: 0.65rem 0.75rem;
      border-radius: 0.7rem;
      background: #191114;
      border: 1px solid rgba(255, 176, 202, 0.14);
      overflow-x: auto;
      font-size: 0.78rem;
      line-height: 1.5;
      color: #fbe7ec;
    }

    .dotfiles-hero__install-code code {
      font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
      white-space: pre-wrap;
      overflow-wrap: anywhere;
    }

    .dotfiles-hero__install-alts {
      display: flex;
      flex-wrap: wrap;
      gap: 0.5rem;
      margin-top: 0.6rem;
    }

    .dotfiles-hero__install-alts code {
      padding: 0.28rem 0.5rem;
      border-radius: 0.45rem;
      background: rgba(255, 176, 202, 0.12);
      border: 1px solid rgba(255, 176, 202, 0.16);
      color: #e2bdc7;
      font-size: 0.76rem;
      font-family: ui-monospace, monospace;
    }

    .dotfiles-hero__visual {
      display: flex;
      flex-direction: column;
      gap: 0.75rem;
    }

    .dotfiles-hero__scene {
      margin: 0;
      border-radius: 1.1rem;
      overflow: hidden;
      border: 1px solid rgba(255, 176, 202, 0.22);
      background: #191114;
      box-shadow: 0 18px 48px rgba(0, 0, 0, 0.42);
    }

    .dotfiles-hero__scene-img {
      display: block;
      width: 100%;
      height: auto;
      aspect-ratio: 16 / 10;
      object-fit: cover;
    }

    .dotfiles-hero__scene-caption {
      margin: 0;
      padding: 0.55rem 0.75rem;
      font-size: 0.72rem;
      font-family: ui-monospace, monospace;
      color: #c9a8b2;
      background: rgba(25, 17, 20, 0.96);
      border-top: 1px solid rgba(255, 176, 202, 0.12);
    }

    .dotfiles-hero__thumbs {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 0.55rem;
      margin: 0;
      padding: 0;
      list-style: none;
    }

    .dotfiles-hero__thumb {
      margin: 0;
      border-radius: 0.75rem;
      overflow: hidden;
      border: 1px solid rgba(255, 176, 202, 0.16);
      background: #191114;
    }

    .dotfiles-hero__thumb img {
      display: block;
      width: 100%;
      height: auto;
      aspect-ratio: 4 / 3;
      object-fit: cover;
    }

    .dotfiles-hero__thumb figcaption {
      padding: 0.35rem 0.45rem;
      font-size: 0.68rem;
      color: #c9a8b2;
      font-family: ui-monospace, monospace;
    }

    .dotfiles-main {
      max-width: 1120px;
      margin: 0 auto;
      padding: 0 1.2rem 2rem;
      display: flex;
      flex-direction: column;
      gap: 2.2rem;
    }

    .dotfiles-section {
      padding: 1.2rem;
      border-radius: 1.25rem;
      background: rgba(25, 17, 20, 0.42);
      border: 1px solid rgba(255, 176, 202, 0.08);
    }

    .dotfiles-section--alt {
      background: rgba(45, 32, 39, 0.28);
      border-color: rgba(255, 176, 202, 0.1);
    }

    .dotfiles-attribution {
      max-width: 960px;
      margin: 0 auto;
    }

    .dotfiles-attribution__summary {
      cursor: pointer;
      list-style: none;
    }

    .dotfiles-attribution__summary::-webkit-details-marker {
      display: none;
    }

    .dotfiles-attribution[open] .dotfiles-attribution__summary {
      margin-bottom: 1rem;
    }

    .dotfiles-attribution__eyebrow {
      display: inline-flex;
      padding: 0.28rem 0.7rem;
      border-radius: 999px;
      background: rgba(255, 176, 202, 0.12);
      border: 1px solid rgba(255, 176, 202, 0.26);
      color: #ffb0ca;
      font-size: 0.78rem;
      font-weight: 700;
      letter-spacing: 0.06em;
      text-transform: uppercase;
      margin: 0 0 0.7rem;
    }

    .dotfiles-attribution__title {
      margin: 0 0 0.45rem;
      font-size: clamp(1.35rem, 2.8vw, 1.95rem);
      font-weight: 800;
      letter-spacing: -0.03em;
      color: #fbe7ec;
      line-height: 1.2;
    }

    .dotfiles-attribution__desc {
      margin: 0;
      color: #d5c2c6;
      line-height: 1.65;
      font-size: 0.92rem;
      max-width: 72ch;
    }

    .dotfiles-attribution__list {
      list-style: none;
      margin: 1.1rem 0 0;
      padding: 0;
      display: grid;
      gap: 0.85rem;
    }

    @media (min-width: 720px) {
      .dotfiles-attribution__list {
        grid-template-columns: 1fr 1fr;
      }
    }

    .dotfiles-attribution__item {
      display: flex;
      gap: 0.75rem;
      align-items: flex-start;
      padding: 0.95rem;
      border-radius: 1rem;
      background: linear-gradient(180deg, rgba(45, 32, 39, 0.92), rgba(25, 17, 20, 0.98));
      border: 1px solid rgba(255, 176, 202, 0.16);
    }

    .dotfiles-attribution__item strong {
      display: block;
      color: #ffb0ca;
      font-size: 0.95rem;
      margin-bottom: 0.15rem;
    }

    .dotfiles-attribution__item p {
      margin: 0.35rem 0 0;
      font-size: 0.84rem;
      color: #c9a8b2;
      line-height: 1.55;
    }

    .dotfiles-attribution__badge {
      flex-shrink: 0;
      padding: 0.2rem 0.5rem;
      border-radius: 999px;
      background: #ffb0ca;
      color: #191114;
      font-size: 0.72rem;
      font-weight: 800;
    }

    .dotfiles-attribution__source {
      display: block;
      font-size: 0.76rem;
      color: #e2bdc7;
      font-family: ui-monospace, monospace;
    }

    .dotfiles-cta {
      padding: 1.4rem;
      border-radius: 1.25rem;
      background: linear-gradient(135deg, rgba(255, 176, 202, 0.18), rgba(45, 32, 39, 0.9));
      border: 1px solid rgba(255, 176, 202, 0.22);
      text-align: center;
    }

    .dotfiles-cta__inner {
      max-width: 720px;
      margin: 0 auto;
    }

    .dotfiles-cta__title {
      margin: 0 0 0.4rem;
      font-size: clamp(1.4rem, 3vw, 2rem);
      font-weight: 900;
      letter-spacing: -0.03em;
      color: #fbe7ec;
    }

    .dotfiles-cta__text {
      margin: 0 0 1rem;
      color: #d5c2c6;
      line-height: 1.6;
    }

    .dotfiles-cta__actions {
      display: flex;
      flex-wrap: wrap;
      gap: 0.7rem;
      justify-content: center;
    }

    .dotfiles-cta__btn {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      padding: 0.7rem 1.05rem;
      border-radius: 0.85rem;
      font-weight: 800;
      font-size: 0.9rem;
      text-decoration: none;
      border: 1px solid transparent;
      transition:
        transform 0.15s ease,
        background 0.15s ease;
    }

    .dotfiles-cta__btn:hover {
      transform: translateY(-1px);
    }

    .dotfiles-cta__btn--primary {
      background: #ffb0ca;
      color: #191114;
      border-color: #ffb0ca;
    }

    .dotfiles-cta__btn:not(.dotfiles-cta__btn--primary):not(.dotfiles-cta__btn--ghost) {
      background: rgba(25, 17, 20, 0.92);
      color: #fbe7ec;
      border-color: rgba(255, 176, 202, 0.22);
    }

    .dotfiles-cta__btn--ghost {
      background: transparent;
      color: #d5c2c6;
      border-color: rgba(255, 176, 202, 0.16);
    }

    @media (prefers-reduced-motion: reduce) {
      .dotfiles-hero__cta,
      .dotfiles-cta__btn {
        transition: none;
      }
    }
  </style>
</SectionLayout>
