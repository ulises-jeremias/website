---
import SectionLayout from '@/layouts/SectionLayout.astro';
import CreateAwesomeWorld from '@/features/create-awesome/components/CreateAwesomeWorld.astro';
import SupportNote from '@/shared/components/SupportNote.astro';
import { getRouteMeta } from '@/data/routes';

const meta = getRouteMeta('/create-awesome')!;
---

<SectionLayout
  currentPath="/create-awesome"
  world="Create Awesome"
  title={meta.title}
  description={meta.description}
  theme="create-awesome"
  immersive
>
  <CreateAwesomeWorld />
  <SupportNote area="create-awesome" />
</SectionLayout>
