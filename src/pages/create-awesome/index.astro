---
import SectionLayout from '@/layouts/SectionLayout.astro';
import { Details, Hero, Variants } from '@/features/create-awesome';
import { getRouteMeta } from '@/data/routes';
const meta = getRouteMeta('/create-awesome')!;
---

<SectionLayout title={meta.title} description={meta.description} theme="create-awesome">
  <Hero />
  <Variants />
  <Details />
</SectionLayout>
