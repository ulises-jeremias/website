---
import SectionLayout from '@/layouts/SectionLayout.astro';
import { getCollection } from 'astro:content';
import { getRouteMeta, getCanonicalUrl } from '@/data/routes';
import '@/styles/blog.css';

const meta = getRouteMeta('/blog')!;
const posts = (await getCollection('blog'))
  .filter((p) => !p.data.draft)
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
const hasPosts = posts.length > 0;

const itemListJsonLd = hasPosts
  ? {
      '@context': 'https://schema.org',
      '@type': 'ItemList',
      itemListElement: posts.map((post, index) => ({
        '@type': 'ListItem',
        position: index + 1,
        url: getCanonicalUrl(`/blog/${post.id}/`),
        name: post.data.title,
      })),
    }
  : undefined;
---

<SectionLayout
  currentPath="/blog"
  world="Blog"
  title={meta.title}
  description={meta.description}
  theme="blog"
  jsonLd={itemListJsonLd}
>
  <div class="blog-page">
    <div class="blog-page__inner">
      <p class="blog-page__nav">
        <a href="/">← Digital Nest</a>
        <span class="blog-page__nav-sep" aria-hidden="true">·</span>
        <a href="/rss.xml">RSS</a>
      </p>
      <h1 class="blog-page__title">Blog</h1>
      <p class="blog-page__lead">Field notes on tooling and open source.</p>

      {
        hasPosts ? (
          <ul class="blog-list">
            {posts.map((post) => (
              <li class="blog-list__item">
                <a class="blog-list__link" href={`/blog/${post.id}/`}>
                  <h2 class="blog-list__title">{post.data.title}</h2>
                  <p class="blog-list__meta">
                    <time datetime={post.data.pubDate.toISOString()}>
                      {post.data.pubDate.toLocaleDateString('en-US', {
                        year: 'numeric',
                        month: 'short',
                        day: 'numeric',
                      })}
                    </time>
                  </p>
                  <p class="blog-list__desc">{post.data.description}</p>
                </a>
              </li>
            ))}
          </ul>
        ) : (
          <div class="blog-empty" role="status">
            <div class="blog-empty__desk" aria-hidden="true">
              <span class="blog-empty__lamp" />
              <span class="blog-empty__pad" />
            </div>
            <h2>Desk clear.</h2>
            <p>
              Notes soon. Browse <a href="/projects">projects</a> or <a href="/community">community</a>.
            </p>
          </div>
        )
      }
    </div>
  </div>
</SectionLayout>
