---
import SectionLayout from '@/layouts/SectionLayout.astro';
import { getCollection } from 'astro:content';
import { getRouteMeta, getCanonicalUrl } from '@/data/routes';
import '@/styles/blog.css';

const meta = getRouteMeta('/blog')!;
const posts = (await getCollection('blog'))
  .filter((p) => !p.data.draft)
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
const hasPosts = posts.length > 0;

const collectionJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'CollectionPage',
  name: meta.title,
  description: meta.description,
  url: getCanonicalUrl('/blog'),
  isPartOf: {
    '@type': 'WebSite',
    name: 'Digital Nest',
    url: getCanonicalUrl('/'),
  },
  ...(hasPosts
    ? {
        mainEntity: {
          '@type': 'ItemList',
          itemListElement: posts.map((post, index) => ({
            '@type': 'ListItem',
            position: index + 1,
            url: getCanonicalUrl(`/blog/${post.id}/`),
            name: post.data.title,
          })),
        },
      }
    : {}),
};
---

<SectionLayout
  currentPath="/blog"
  world="Blog"
  title={meta.title}
  description={meta.description}
  theme="blog"
  jsonLd={collectionJsonLd}
>
  <div class="blog-page">
    <div class="blog-page__inner">
      <p class="blog-page__nav">
        <a href="/">← Digital Nest</a>
        <span class="blog-page__nav-sep" aria-hidden="true">·</span>
        <a href="/rss.xml">RSS</a>
      </p>
      <h1 class="blog-page__title">Blog — field notes</h1>
      <p class="blog-page__lead">
        Notes on developer tooling, systems, and open source — written for reading, not spectacle.
      </p>

      {
        hasPosts ? (
          <ul class="blog-list">
            {posts.map((post) => (
              <li class="blog-list__item">
                <a class="blog-list__link" href={`/blog/${post.id}/`}>
                  <h2 class="blog-list__title">{post.data.title}</h2>
                  <p class="blog-list__meta">
                    <time datetime={post.data.pubDate.toISOString()}>
                      {post.data.pubDate.toLocaleDateString('en-US', {
                        year: 'numeric',
                        month: 'short',
                        day: 'numeric',
                      })}
                    </time>
                  </p>
                  <p class="blog-list__desc">{post.data.description}</p>
                </a>
              </li>
            ))}
          </ul>
        ) : (
          <div class="blog-empty" role="status">
            <h2>The writing desk is ready.</h2>
            <p>The first field notes are still being prepared.</p>
            <p>No fabricated thought-leadership posts. Empty state is intentional.</p>
            <p class="blog-empty__elsewhere">
              Meanwhile: explore the
              <a href="/projects">projects ledger</a>,<a href="/open-source">open-source evidence</a>, or the
              <a href="/community">community workshop</a>.
            </p>
          </div>
        )
      }
    </div>
  </div>
</SectionLayout>
