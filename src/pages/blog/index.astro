---
import SectionLayout from '@/layouts/SectionLayout.astro';
import { getCollection } from 'astro:content';
import { getRouteMeta, getCanonicalUrl } from '@/data/routes';
import '@/styles/blog.css';

const meta = getRouteMeta('/blog')!;
const posts = (await getCollection('blog'))
  .filter((p) => !p.data.draft)
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
const hasPosts = posts.length > 0;

const itemListJsonLd = hasPosts
  ? {
      '@context': 'https://schema.org',
      '@type': 'ItemList',
      itemListElement: posts.map((post, index) => ({
        '@type': 'ListItem',
        position: index + 1,
        url: getCanonicalUrl(`/blog/${post.id}/`),
        name: post.data.title,
      })),
    }
  : undefined;
---

<SectionLayout
  currentPath="/blog"
  world="Blog"
  title={meta.title}
  description={meta.description}
  theme="blog"
  jsonLd={itemListJsonLd}
>
  <div class="blog-page">
    <div class="blog-page__inner">
      <p class="blog-page__nav">
        <a href="/">← Digital Nest</a>
        <span class="blog-page__nav-sep" aria-hidden="true">·</span>
        <a href="/rss.xml">RSS</a>
      </p>
      <header class="blog-page__masthead">
        <div class="blog-page__masthead-copy">
          <p class="blog-page__kicker">Digital Nest · publication desk</p>
          <h1 class="blog-page__title">Field Notes</h1>
          <p class="blog-page__lead">
            A technical journal on developer tooling, agent workflows, and open source — written from shipped work, not
            announcements.
          </p>
        </div>
        <aside class="blog-page__contract" aria-label="Field Notes publication contract">
          <p>Publication contract</p>
          <dl>
            <div><dt>Topics</dt><dd>tools · agents · OSS</dd></div>
            <div><dt>Source</dt><dd>shipped work</dd></div>
            <div><dt>Status</dt><dd>{hasPosts ? `${posts.length} published` : 'desk open'}</dd></div>
          </dl>
        </aside>
      </header>

      {
        hasPosts ? (
          <ul class="blog-list">
            {posts.map((post) => (
              <li class="blog-list__item">
                <a class="blog-list__link" href={`/blog/${post.id}/`}>
                  <h2 class="blog-list__title">{post.data.title}</h2>
                  <p class="blog-list__meta">
                    <time datetime={post.data.pubDate.toISOString()}>
                      {post.data.pubDate.toLocaleDateString('en-US', {
                        year: 'numeric',
                        month: 'short',
                        day: 'numeric',
                      })}
                    </time>
                  </p>
                  <p class="blog-list__desc">{post.data.description}</p>
                </a>
              </li>
            ))}
          </ul>
        ) : (
          <div class="blog-empty">
            <div class="blog-empty__desk" aria-hidden="true">
              <span class="blog-empty__lamp" />
              <span class="blog-empty__pad" />
            </div>
            <h2>No posts published yet.</h2>
            <p>
              Entries land here only when there is something verified to write up — HorneroConfig internals, agent
              orchestration patterns from Agent Toolkit, and V ecosystem engineering. No filler posts.
            </p>
            <p class="blog-empty__elsewhere">
              Until then, the work itself is documented in <a href="/projects">the project ledger</a> and the{' '}
              <a href="/open-source">open-source evidence trail</a>, and discussed in{' '}
              <a href="/community">the community workshop</a>.
            </p>
            <p class="blog-empty__elsewhere">
              <a href="/rss.xml">Subscribe to the RSS feed</a> to get the first entry when it ships.
            </p>
            <aside class="blog-empty__routes" aria-label="Read current work elsewhere">
              <p class="blog-empty__routes-title">Read the current work</p>
              <ul>
                <li>
                  <>
                    <a href="/projects">01 · Project ledger</a>
                    <span>systems and outcomes</span>
                  </>
                </li>
                <li>
                  <>
                    <a href="/open-source">02 · Open-source evidence</a>
                    <span>contributions and provenance</span>
                  </>
                </li>
                <li>
                  <>
                    <a href="/community">03 · Community workshop</a>
                    <span>questions and coordination</span>
                  </>
                </li>
              </ul>
            </aside>
          </div>
        )
      }
    </div>
  </div>
</SectionLayout>
