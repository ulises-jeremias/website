---
import SectionLayout from '@/layouts/SectionLayout.astro';
import { getCollection } from 'astro:content';
import { getRouteMeta, getCanonicalUrl } from '@/data/routes';
import { EmptyDesk } from '@/features/blog';
import { formatBlogDate } from '@/features/blog/lib/format-date';
import '@/styles/blog.css';

const meta = getRouteMeta('/blog')!;
const posts = (await getCollection('blog'))
  .filter((p) => !p.data.draft)
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
const hasPosts = posts.length > 0;

const itemListJsonLd = hasPosts
  ? {
      '@context': 'https://schema.org',
      '@type': 'ItemList',
      itemListElement: posts.map((post, index) => ({
        '@type': 'ListItem',
        position: index + 1,
        url: getCanonicalUrl(`/blog/${post.id}/`),
        name: post.data.title,
      })),
    }
  : undefined;
---

<SectionLayout
  currentPath="/blog"
  headerAccent="var(--nest-blue)"
  world="Blog"
  title={meta.title}
  description={meta.description}
  theme="blog"
  noIndex={!hasPosts}
  jsonLd={itemListJsonLd}
>
  <div class="blog-page">
    <div class="blog-page__inner">
      <p class="blog-page__nav">
        <a href="/">← Digital Nest</a>
        <span class="blog-page__nav-sep" aria-hidden="true">
          ·
        </span>
        <a href="/rss.xml">RSS</a>
      </p>
      <header class="blog-page__masthead">
        <div class="blog-page__masthead-copy">
          <p class="blog-page__kicker">Digital Nest · publication desk</p>
          <h1 class="blog-page__title">Field Notes</h1>
          <p class="blog-page__lead">
            Field notes from shipped work: agentic engineering, developer experience, V and scientific computing, Linux
            desktops, open source, and the infrastructure behind them. Written after something ships, not before.
          </p>
        </div>
        <aside class="blog-page__contract" aria-label="Field Notes publication contract">
          <p>Publication contract</p>
          <dl>
            <div>
              <dt>Topics</dt>
              <dd>agents · DX · V · Linux · OSS</dd>
            </div>
            <div>
              <dt>Source</dt>
              <dd>shipped work</dd>
            </div>
            <div>
              <dt>Status</dt>
              <dd>{hasPosts ? `${posts.length} published` : 'desk open'}</dd>
            </div>
          </dl>
        </aside>
      </header>

      {hasPosts ? (
        <ul class="blog-list">
          {posts.map((post) => (
            <li class="blog-list__item">
              <a class="blog-list__link" href={`/blog/${post.id}/`}>
                <h2 class="blog-list__title">{post.data.title}</h2>
                <p class="blog-list__meta">
                  <time datetime={post.data.pubDate.toISOString()}>{formatBlogDate(post.data.pubDate, 'short')}</time>
                </p>
                <p class="blog-list__desc">{post.data.description}</p>
              </a>
            </li>
          ))}
        </ul>
      ) : (
        <div class="blog-empty">
          <EmptyDesk />
          <div class="blog-empty__copy">
            <h2>No posts published yet.</h2>
            <p>Field Notes are written after something ships and its sources are checked. No filler posts.</p>
            <details class="blog-path">
              <summary>Trace the publication path</summary>
              <div class="blog-path__body">
                <p class="blog-path__eyebrow">Editorial path · explanatory, not live</p>
                <div class="blog-path__track" aria-hidden="true">
                  <span></span>
                </div>
                <ol class="blog-path__steps">
                  <li>
                    <span class="blog-path__index" aria-hidden="true">
                      01
                    </span>
                    <strong>Work ships</strong>
                    <span>A real system is ready to learn from.</span>
                  </li>
                  <li>
                    <span class="blog-path__index" aria-hidden="true">
                      02
                    </span>
                    <strong>Sources check out</strong>
                    <span>Claims and examples have evidence.</span>
                  </li>
                  <li>
                    <span class="blog-path__index" aria-hidden="true">
                      03
                    </span>
                    <strong>A note lands</strong>
                    <span>The write-up joins Field Notes.</span>
                  </li>
                </ol>
              </div>
            </details>
            <p class="blog-empty__elsewhere">
              <a href="/rss.xml">Subscribe to the RSS feed</a> to get the first entry when it ships.
            </p>
            <aside class="blog-empty__routes" aria-label="Explore current work elsewhere">
              <p class="blog-empty__routes-title">Explore the current work</p>
              <ul>
                <li>
                  <a href="/projects">Project ledger</a>
                  <span>systems and outcomes</span>
                </li>
                <li>
                  <a href="/open-source">Open-source evidence</a>
                  <span>contributions and provenance</span>
                </li>
                <li>
                  <a href="/community">Community workshop</a>
                  <span>questions and coordination</span>
                </li>
              </ul>
            </aside>
          </div>
        </div>
      )}
    </div>
  </div>
</SectionLayout>
