---
import SectionLayout from '@/layouts/SectionLayout.astro';
import { getCollection } from 'astro:content';
import { getRouteMeta } from '@/data/routes';
const meta = getRouteMeta('/blog')!;
const posts = (await getCollection('blog'))
  .filter((p) => !p.data.draft)
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
const hasPosts = posts.length > 0;
---

<SectionLayout title={meta.title} description={meta.description} theme="blog">
  <h1>Blog — Field notes</h1>
  {
    hasPosts ? (
      <ul>
        {posts.map((post) => (
          <li>
            <a href={`/blog/${post.slug}/`}>{post.data.title}</a> — {post.data.description}
          </li>
        ))}
      </ul>
    ) : (
      <div style="text-align:center; padding:3rem; border:1px dashed var(--color-border); border-radius:10px; background:var(--color-paper);">
        <h2>📝 The writing desk is ready.</h2>
        <p>The first field notes are still being prepared.</p>
        <p style="color:var(--color-muted);">
          No se fabrican posts de thought-leadership. El blog está listo antes de que existan posts.
        </p>
      </div>
    )
  }
  <p style="margin-top:2rem;"><a href="/">← Volver</a></p>
</SectionLayout>
