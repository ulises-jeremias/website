---
import SectionLayout from '@/layouts/SectionLayout.astro';
import { getCollection, render } from 'astro:content';
import type { CollectionEntry } from 'astro:content';
import '@/styles/blog.css';

export async function getStaticPaths() {
  const posts = await getCollection('blog', ({ data }) => !data.draft);

  return posts.map((post) => ({
    params: { slug: post.id },
    props: { post },
  }));
}

type Props = {
  post: CollectionEntry<'blog'>;
};

const { post } = Astro.props as Props;

const hasPost = Boolean(post);

let Content: Awaited<ReturnType<typeof render>>['Content'] | null = null;
let pageTitle = 'Note not found — Blog';
let pageDescription = 'This note has not been published yet. The writing desk is ready for future field notes.';

if (hasPost) {
  const rendered = await render(post);
  Content = rendered.Content;
  pageTitle = post.data.title + ' — Blog';
  pageDescription = post.data.description;
}
---

<SectionLayout title={pageTitle} description={pageDescription} currentPath="/blog" theme="blog" world="Blog">
  <div class="blog-page">
    <div class="blog-page__inner">
      <nav class="blog-page__nav" aria-label="Blog">
        <a href="/blog">← Blog</a>
      </nav>

      {
        hasPost && Content ? (
          <article>
            <h1 class="blog-page__title">{post.data.title}</h1>
            <p class="blog-post__meta">
              <time datetime={post.data.pubDate.toISOString()}>
                {post.data.pubDate.toLocaleDateString('en-US', {
                  year: 'numeric',
                  month: 'long',
                  day: 'numeric',
                })}
              </time>
            </p>
            <div class="blog-post__content">
              <Content />
            </div>
          </article>
        ) : (
          <article>
            <h1 class="blog-page__title">Note not found</h1>
            <p>This note has not been published yet. The writing desk is ready for future field notes.</p>
            <p>
              <a href="/blog">Back to the blog index</a>
            </p>
          </article>
        )
      }
    </div>
  </div>
</SectionLayout>
