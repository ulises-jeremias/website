---
import SectionLayout from '@/layouts/SectionLayout.astro';
import { getFooterRouteGroups, getNavLabel } from '@/data/routes';

const atlasGroups = getFooterRouteGroups().map((group) => ({
  ...group,
  routes: group.routes.filter((route) => route.path !== '/'),
}));
const atlasRouteCount = atlasGroups.reduce((count, group) => count + group.routes.length, 0);
---

<SectionLayout
  title="404 — Signal lost"
  description="World not found — return to Digital Nest"
  theme="home"
  world="404"
  currentPath="/404"
  noIndex={true}
>
  <section class="lost-world" aria-labelledby="lost-title">
    <header class="lost-world__header">
      <div>
        <p class="lost-world__eyebrow">404 · Digital Nest recovery</p>
        <p class="lost-world__signal" aria-hidden="true">
          COORDINATE UNRESOLVED
        </p>
        <h1 id="lost-title" class="lost-world__title">
          This world is unlisted
        </h1>
        <p class="lost-world__lead">
          There is no page at this address. The link may be outdated or mistyped; use the verified route index below to
          continue.
        </p>
      </div>
      <aside class="lost-world__console" aria-label="Recovery console">
        <p class="lost-world__console-kicker">Recovery console</p>
        <dl>
          <div>
            <dt>Coordinate</dt>
            <dd>404 / unresolved</dd>
          </div>
          <div>
            <dt>Next action</dt>
            <dd>Return home</dd>
          </div>
          <div>
            <dt>Route source</dt>
            <dd>Digital Nest index</dd>
          </div>
        </dl>
        <nav class="lost-world__actions" aria-label="Primary recovery">
          <a class="lost-world__cta lost-world__cta--primary" href="/">
            Return to Digital Nest
          </a>
          <a class="lost-world__cta" href="/projects">
            Browse the work
          </a>
        </nav>
      </aside>
    </header>

    <nav class="lost-world__atlas" aria-labelledby="lost-atlas-title">
      <p class="lost-world__atlas-kicker">Verified destination index</p>
      <h2 id="lost-atlas-title" class="lost-world__atlas-title">
        Jump to a known route
      </h2>
      <div class="lost-world__finder" data-route-finder hidden role="search">
        <label class="lost-world__finder-label" for="lost-route-query">
          Tune the lost signal
        </label>
        <div class="lost-world__finder-field">
          <input
            id="lost-route-query"
            class="lost-world__finder-input"
            type="search"
            autocomplete="off"
            aria-describedby="lost-route-help lost-route-status"
            placeholder="Try Hornero OS or /create-awesome"
          />
          <span class="lost-world__finder-sweep" aria-hidden="true"></span>
        </div>
        <p id="lost-route-help" class="lost-world__finder-help">
          Search route names or paths. Press Enter when one destination remains.
        </p>
        <p id="lost-route-status" class="lost-world__finder-status" role="status" aria-live="polite" aria-atomic="true">
          Search is ready for {atlasRouteCount} verified destinations.
        </p>
        <p class="lost-world__finder-empty" data-route-empty hidden>
          No signal matches that query. Clear it to restore the full atlas.
        </p>
      </div>
      {atlasGroups.map((group) => (
        <div class="lost-world__route-group" data-route-group>
          <h3 class="lost-world__atlas-group">{group.label}</h3>
          <ul class="lost-world__atlas-list">
            {group.routes.map((route, index) => (
              <li class="lost-world__route-entry" data-route-entry>
                <a class="lost-world__atlas-link" href={route.path}>
                  <span class="lost-world__atlas-index" aria-hidden="true">
                    {String(index + 1).padStart(2, '0')}
                  </span>
                  <span>
                    <strong>{getNavLabel(route)}</strong>
                    <code>{route.path}</code>
                  </span>
                </a>
              </li>
            ))}
          </ul>
        </div>
      ))}
    </nav>
  </section>
  <script src="@/features/recovery/scripts/route-finder.ts"></script>
</SectionLayout>

<style>
  .lost-world {
    width: min(100% - 2 * var(--section-padding-x), 78rem);
    margin: 0 auto;
    padding-block: clamp(1.5rem, 5vw, 3.5rem) clamp(2rem, 6vw, 4rem);
    padding-inline: clamp(0.75rem, 2vw, 1.5rem);
    border-inline: 1px solid color-mix(in srgb, var(--nest-magenta) 18%, transparent);
    background:
      linear-gradient(90deg, color-mix(in srgb, var(--nest-magenta) 5%, transparent), transparent 36%),
      color-mix(in srgb, var(--nest-midnight-950) 70%, transparent);
  }

  .lost-world__header {
    display: grid;
    gap: 1.5rem;
    padding: clamp(1.25rem, 3vw, 2.75rem) clamp(0.75rem, 3vw, 2rem);
    border-block: 1px solid color-mix(in srgb, var(--nest-magenta) 32%, transparent);
    border-inline-start: 2px solid var(--nest-magenta);
    text-align: left;
  }

  @media (min-width: 820px) {
    .lost-world__header {
      grid-template-columns: minmax(0, 1.2fr) minmax(18rem, 0.8fr);
      align-items: end;
    }
  }

  .lost-world__console {
    padding: 0.9rem 1rem;
    border: 1px solid color-mix(in srgb, var(--nest-cyan) 38%, transparent);
    background: color-mix(in srgb, var(--nest-midnight-950) 78%, transparent);
  }

  .lost-world__console-kicker,
  .lost-world__atlas-group {
    margin: 1.25rem 0 0.6rem;
    color: var(--nest-pink);
    font-family: var(--font-mono);
    font-size: 0.75rem;
    font-weight: 400;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }

  .lost-world__atlas-kicker {
    margin: 0 0 0.55rem;
    color: var(--nest-cyan);
    font-family: var(--font-mono, ui-monospace, monospace);
    font-size: 0.68rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }

  .lost-world__console dl {
    display: grid;
    gap: 0.45rem;
    margin: 0;
  }

  .lost-world__console dl div {
    display: flex;
    justify-content: space-between;
    gap: 0.75rem;
    padding-top: 0.4rem;
    border-top: 1px solid color-mix(in srgb, var(--nest-cyan) 22%, transparent);
    font-family: var(--font-mono);
    font-size: 0.7rem;
  }

  .lost-world__console dt,
  .lost-world__console dd {
    margin: 0;
  }

  .lost-world__console dt {
    color: var(--color-text-muted);
    text-transform: uppercase;
  }

  .lost-world__console dd {
    color: var(--color-text);
    text-align: right;
  }
  .lost-world__eyebrow {
    margin: 0;
    font-family: var(--font-mono, ui-monospace, monospace);
    font-size: 0.72rem;
    letter-spacing: 0.32em;
    text-transform: uppercase;
    color: var(--nest-cyan);
  }
  .lost-world__signal {
    margin: 0.85rem 0 0;
    font-family: var(--font-mono, ui-monospace, monospace);
    font-size: clamp(0.85rem, 2.4vw, 1rem);
    letter-spacing: 0.42em;
    text-transform: uppercase;
    color: color-mix(in srgb, var(--nest-violet) 85%, white);
    text-shadow: 0 0 18px color-mix(in srgb, var(--nest-violet) 45%, transparent);
    animation: lost-world-pulse 2.8s ease-in-out infinite;
  }
  .lost-world__title {
    margin: 0.65rem 0 0;
    font-family: var(--font-display);
    font-size: clamp(1.8rem, 6vw, 2.8rem);
    letter-spacing: 0.04em;
    color: var(--nest-magenta);
    text-shadow: 0 0 28px color-mix(in srgb, var(--nest-magenta) 40%, transparent);
  }
  .lost-world__lead {
    margin: 0.85rem 0 0;
    max-width: 56ch;
    color: var(--color-text-muted);
    line-height: 1.6;
  }
  .lost-world__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.65rem;
    justify-content: flex-start;
    margin-top: 1rem;
  }
  .lost-world__cta {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 44px;
    padding: 0 1rem;
    clip-path: var(--clip-corner-sm);
    border: 1px solid var(--color-border);
    color: var(--color-text);
    text-decoration: none;
    font-weight: 700;
  }
  .lost-world__cta--primary {
    border-color: color-mix(in srgb, var(--nest-magenta) 60%, transparent);
    color: var(--nest-pink);
  }
  .lost-world__cta:focus-visible {
    outline: 2px solid var(--color-focus-ring);
    outline-offset: 2px;
  }
  .lost-world__atlas {
    margin-top: 1.5rem;
    padding: 1rem clamp(0.75rem, 3vw, 2rem) 0;
    border-top: 1px solid color-mix(in srgb, var(--nest-violet) 30%, transparent);
  }

  .lost-world__atlas-group {
    margin: 1.25rem 0 0.6rem;
    color: var(--nest-pink);
    font-family: var(--font-mono);
    font-size: 0.75rem;
    font-weight: 400;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }

  .lost-world__atlas-kicker {
    color: var(--nest-sunset-orange);
  }
  .lost-world__atlas-title {
    margin: 0 0 1rem;
    font-family: var(--font-mono, ui-monospace, monospace);
    font-size: 0.78rem;
    font-weight: 400;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--nest-text-faint);
  }

  .lost-world__finder {
    display: grid;
    gap: 0.35rem;
    margin: 0 0 1.35rem;
    padding: 0.85rem 1rem 0.95rem;
    border: 1px solid color-mix(in srgb, var(--nest-cyan) 30%, transparent);
    background: color-mix(in srgb, var(--nest-midnight-950) 72%, transparent);
  }

  .lost-world__finder[hidden],
  .lost-world__route-group[hidden],
  .lost-world__route-entry[hidden],
  .lost-world__finder-empty[hidden] {
    display: none !important;
  }

  .lost-world__finder-label {
    color: var(--nest-cyan);
    font-family: var(--font-mono);
    font-size: 0.7rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }

  .lost-world__finder-field {
    position: relative;
  }

  .lost-world__finder-input {
    width: 100%;
    min-height: 48px;
    padding: 0.65rem 0.8rem;
    border: 1px solid color-mix(in srgb, var(--nest-cyan) 34%, transparent);
    border-radius: 0;
    background: var(--nest-midnight-950);
    color: var(--color-text);
    font-family: var(--font-mono, ui-monospace, monospace);
    font-size: 0.95rem;
    font-weight: 400;
    line-height: 1.4;
  }

  .lost-world__finder-input::placeholder {
    color: var(--color-text-faint);
    opacity: 1;
  }

  .lost-world__finder-input:focus-visible {
    outline: 2px solid var(--color-focus-ring);
    outline-offset: 3px;
  }

  .lost-world__finder-sweep {
    position: absolute;
    inset: 0 auto auto 0;
    width: 18%;
    height: 1px;
    background: var(--nest-cyan);
    box-shadow: 0 0 12px color-mix(in srgb, var(--nest-cyan) 70%, transparent);
    opacity: 0;
    pointer-events: none;
  }

  .lost-world__finder-field:focus-within .lost-world__finder-sweep {
    opacity: 1;
    animation: lost-world-signal-sweep 1.8s linear infinite;
  }

  .lost-world__finder-help,
  .lost-world__finder-status,
  .lost-world__finder-empty {
    margin: 0;
    color: var(--color-text-faint);
    font-size: 0.75rem;
    line-height: 1.5;
  }

  .lost-world__finder-status {
    min-height: 1.2em;
    color: color-mix(in srgb, var(--nest-cyan) 76%, var(--color-text));
    font-family: var(--font-mono);
  }

  .lost-world__finder-empty {
    padding: 0.7rem 0;
    color: var(--nest-pink);
  }

  .lost-world__route-group {
    min-width: 0;
  }

  .lost-world__atlas-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(12rem, 1fr));
    gap: 0.55rem;
    text-align: left;
  }

  .lost-world__route-entry[data-exact-match='true'] {
    border-inline-start: 1px solid var(--nest-cyan);
    background: color-mix(in srgb, var(--nest-cyan) 8%, transparent);
  }

  .lost-world__route-entry[data-exact-match='true'] .lost-world__atlas-link {
    padding-inline-start: 0.45rem;
    color: var(--nest-cyan);
  }
  .lost-world__atlas-link {
    display: inline-flex;
    align-items: center;
    gap: 0.65rem;
    min-height: 44px;
    color: var(--color-text);
    text-decoration: none;
  }

  .lost-world__atlas-link > span:last-child {
    display: grid;
    gap: 0.1rem;
  }

  .lost-world__atlas-link strong {
    font-weight: 500;
  }

  .lost-world__atlas-link code {
    color: var(--color-text-faint);
    font-family: var(--font-mono);
    font-size: 0.68rem;
    font-weight: 400;
  }
  .lost-world__atlas-link:hover {
    color: var(--nest-cyan);
  }
  .lost-world__atlas-link:focus-visible {
    outline: 2px solid var(--color-focus-ring);
    outline-offset: 2px;
  }
  .lost-world__atlas-index {
    font-family: var(--font-mono, ui-monospace, monospace);
    font-size: 0.72rem;
    color: var(--nest-cyan);
  }

  @keyframes lost-world-signal-sweep {
    from {
      transform: translateX(0);
    }
    to {
      transform: translateX(555%);
    }
  }

  @keyframes lost-world-pulse {
    0%,
    100% {
      opacity: 0.55;
    }
    50% {
      opacity: 1;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .lost-world__signal {
      animation: none;
      opacity: 0.9;
    }

    .lost-world__finder-sweep {
      animation: none;
    }
  }
</style>
