---
import SectionLayout from '@/layouts/SectionLayout.astro';
import Constellation from '@/features/open-source/components/Constellation.astro';
import EvidenceLedger from '@/features/open-source/components/EvidenceLedger.astro';
import { getRouteMeta } from '@/data/routes';

const meta = getRouteMeta('/open-source')!;
---

<SectionLayout
  currentPath="/open-source"
  world="Open Source"
  title={meta.title}
  description={meta.description}
  theme="open-source"
  ogImage={meta.ogImage}
  immersive
>
  <Constellation />
  <EvidenceLedger />
</SectionLayout>
