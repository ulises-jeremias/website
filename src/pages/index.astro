---
import SectionLayout from '../layouts/SectionLayout.astro';
import { getRouteById } from '../data/routes.js';
import Hero from '../features/home/components/Hero.astro';
import ProjectAtlas from '../features/home/components/ProjectAtlas.astro';
import NestStatus from '../features/home/components/NestStatus.astro';
import AboutPanel from '../features/home/components/AboutPanel.astro';
import FeaturedProjectLedger from '../features/home/components/FeaturedProjectLedger.astro';
import ResponsibilityTopology from '../shared/components/ResponsibilityTopology.astro';
import '../styles/home.css';

const route = getRouteById('home');
if (!route) throw new Error('Home route metadata is required');
---

<SectionLayout
  title={route.title}
  description={route.description}
  currentPath={route.path}
  world="Digital Nest"
  theme="home"
  immersive
>
  <div class="home">
    <Hero>
      <ProjectAtlas slot="atlas" />
    </Hero>

    <ResponsibilityTopology />

    <div class="home-evidence">
      <NestStatus />
      <AboutPanel />
      <FeaturedProjectLedger />
    </div>
  </div>
</SectionLayout>
