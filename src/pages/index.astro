---
import SectionLayout from '@/layouts/SectionLayout.astro';
import { Hero } from '@/features/home';
import { Worlds } from '@/features/home';
import { profile } from '@/data/profile';
import { getRouteMeta } from '@/data/routes';
const meta = getRouteMeta('/')!;
---

<SectionLayout title={meta.title} description={meta.description} theme="home">
  <Hero />
  <Worlds />
  <section aria-labelledby="profile-title">
    <h2 id="profile-title">Who is Ulises</h2>
    <p><strong>{profile.name}</strong> — {profile.tagline}</p>
    <ul>
      {
        profile.roles.map((r) => (
          <li>
            {r.title} @ {r.org}
          </li>
        ))
      }
    </ul>
    <p>Focus: {profile.focus.join(' · ')}</p>
    <p>Strengths: {profile.strengths.join(' · ')}</p>
    <p><em>{profile.funFact}</em> — Build your own nest.</p>
  </section>
  <section aria-labelledby="contact-title">
    <h2 id="contact-title">Collaborate</h2>
    <p>Open to collaborating on Linux tooling, CLI, AI agents, scientific computing.</p>
    <ul>
      {
        profile.socials.map((s) => (
          <li>
            <a href={s.href} target="_blank" rel="noreferrer">
              {s.label}
            </a>
          </li>
        ))
      }
      <li><a href={`mailto:${profile.contact.email}`}>{profile.contact.email}</a> — {profile.pronouns}</li>
    </ul>
  </section>
</SectionLayout>
