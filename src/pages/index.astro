---
import SectionLayout from '../layouts/SectionLayout.astro';
import { getRouteById } from '../data/routes.js';
import Hero from '../features/home/components/Hero.astro';
import FeaturedAreas from '../features/home/components/FeaturedAreas.astro';
import NestStatus from '../features/home/components/NestStatus.astro';
import AboutPanel from '../features/home/components/AboutPanel.astro';
import NestExplore from '../features/home/components/NestExplore.astro';
import '../styles/home.css';

const route = getRouteById('home');
if (!route) throw new Error('Home route metadata is required');
---

<SectionLayout
  title={route.title}
  description={route.description}
  currentPath={route.path}
  world="Digital Nest"
  theme="home"
  immersive
>
  <div class="home">
    <Hero />

    <FeaturedAreas />

    <div class="home-evidence" data-reveal>
      <NestStatus />
      <AboutPanel />
    </div>

    <NestExplore />
  </div>
</SectionLayout>
