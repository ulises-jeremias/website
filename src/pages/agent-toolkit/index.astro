---
import SectionLayout from '@/layouts/SectionLayout.astro';
import {
  CapabilityNexus,
  CommunityWorkshopLink,
  EcosystemContext,
  InstallConsole,
  ProvenanceStrip,
  QueueVsSwarmVisual,
  RuntimeSurfaces,
  SwarmControlRoom,
} from '@/features/agent-toolkit';
import SupportNote from '@/shared/components/SupportNote.astro';
import { toolkitMeta } from '@/features/agent-toolkit/data/index.js';
---

<SectionLayout
  title={toolkitMeta.title}
  description={toolkitMeta.description}
  currentPath="/agent-toolkit"
  world="Agent Toolkit"
  theme="toolkit"
  immersive
>
  <CapabilityNexus />
  <ProvenanceStrip />
  <RuntimeSurfaces />
  <EcosystemContext />
  <QueueVsSwarmVisual />
  <SwarmControlRoom />
  <InstallConsole />
  <CommunityWorkshopLink />
  <SupportNote area="agentic" />
</SectionLayout>
