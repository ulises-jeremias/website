---
import SectionLayout from '@/layouts/SectionLayout.astro';
import {
  CapabilityNexus,
  CommunityWorkshopLink,
  EcosystemContext,
  InstallConsole,
  ProvenanceStrip,
  QueueVsSwarmVisual,
  SwarmControlRoom,
} from '@/features/agent-toolkit';
import { toolkitMeta } from '@/features/agent-toolkit/data/index.js';
---

<SectionLayout
  title={toolkitMeta.title}
  description={toolkitMeta.description}
  currentPath="/agent-toolkit"
  world="Agent Toolkit"
  theme="toolkit"
  immersive
>
  <CapabilityNexus />
  <ProvenanceStrip />
  <EcosystemContext />
  <QueueVsSwarmVisual />
  <SwarmControlRoom />
  <InstallConsole />
  <CommunityWorkshopLink />
</SectionLayout>
