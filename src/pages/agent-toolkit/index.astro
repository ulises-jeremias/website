---
import SectionLayout from '@/layouts/SectionLayout.astro';
import { getRouteMeta } from '@/data/routes';
import { Hero, Overview, Capabilities, SwarmVisualization } from '@/features/agent-toolkit';
import { budgetItems, installSnippets } from '@/features/agent-toolkit/data/index.js';
const meta = getRouteMeta('/agent-toolkit')!;
---

<SectionLayout
  title={meta.title}
  description={meta.description}
  theme="toolkit"
  hero={{ eyebrow: 'Agent Toolkit', title: 'One source → many assistants', description: '61 skills' }}
>
  <Fragment slot="hero"><Hero /></Fragment>
  <Overview />
  <Capabilities />
  <SwarmVisualization />
  <div>
    {
      budgetItems.map((b) => (
        <div>
          {b.label} {b.value}
        </div>
      ))
    }
    {installSnippets.map((s) => <div>{s.label}</div>)}
  </div>
</SectionLayout>
