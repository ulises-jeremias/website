---
import SectionLayout from '@/layouts/SectionLayout.astro';
import { getRouteMeta } from '@/data/routes';
import WorkstationBootMap from '@/features/workstation/components/WorkstationBootMap.astro';
import ThinWorkstationBadge from '@/features/workstation/components/ThinWorkstationBadge.astro';

const meta = getRouteMeta('/agentic-workstation')!;
---

<SectionLayout
  currentPath="/agentic-workstation"
  world="Agentic Workstation"
  title={meta.title}
  description={meta.description}
  theme="workstation"
  immersive
>
  <div class="ws-page">
    <div class="ws-page__badge">
      <ThinWorkstationBadge />
    </div>
    <WorkstationBootMap />
  </div>
</SectionLayout>

<style>
  .ws-page {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    padding-bottom: 2rem;
  }

  .ws-page__badge {
    width: min(100% - 2 * var(--section-padding-x, 1.5rem), 74rem);
    margin-inline: auto;
    padding-top: 1rem;
  }
</style>
