---
import SectionLayout from '@/layouts/SectionLayout.astro';
import { getRouteMeta } from '@/data/routes';
import WorkstationSystemMap from '@/features/workstation/components/WorkstationSystemMap.astro';

const meta = getRouteMeta('/agentic-workstation')!;
---

<SectionLayout
  currentPath="/agentic-workstation"
  world="Agentic Workstation"
  title={meta.title}
  description={meta.description}
  theme="workstation"
  immersive
>
  <WorkstationSystemMap />
</SectionLayout>
