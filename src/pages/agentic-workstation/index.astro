---
import SectionLayout from '@/layouts/SectionLayout.astro';
import { getRouteMeta } from '@/data/routes';
import StackDiagram from '@/features/workstation/components/StackDiagram.astro';
import EcosystemDiagram from '@/features/workstation/components/EcosystemDiagram.astro';
import LayersSection from '@/features/workstation/components/LayersSection.astro';
import ProvisioningSection from '@/features/workstation/components/ProvisioningSection.astro';
import DoctorChecks from '@/features/workstation/components/DoctorChecks.astro';
import ToolkitRationale from '@/features/workstation/components/ToolkitRationale.astro';
import ThinWorkstationBadge from '@/features/workstation/components/ThinWorkstationBadge.astro';

const meta = getRouteMeta('/agentic-workstation')!;
---

<SectionLayout
  title={meta.title}
  description={meta.description}
  theme="workstation"
  hero={{
    eyebrow: 'Epic G · Agentic Workstation · 4-layer DX stack',
    title: 'Agentic Workstation — thin machine, fat capabilities',
    description:
      'Four-layer ecosystem: HorneroConfig desktop → Workstation machine → Toolkit capabilities → Harness runtime. Provisioning via chezmoi, health checks via dots-doctor, and why capabilities live in agent-toolkit (thin workstation verified).',
  }}
>
  <Fragment slot="hero-actions">
    <div class="ws-hero-actions">
      <ThinWorkstationBadge />
      <div class="ws-hero-cta">
        <a href="#stack" class="ws-btn ws-btn--primary">Explore 4 layers ↓</a>
        <a href="#provisioning" class="ws-btn ws-btn--ghost">Provisioning &amp; doctor</a>
        <code class="ws-hero-code">chezmoi init --apply ulises-jeremias/agentic-workstation</code>
      </div>
      <nav class="ws-toc" aria-label="On this page">
        <span class="ws-toc__label">On this page</span>
        <a href="#stack">Stack · 4 layers</a>
        <a href="#ecosystem">Ecosystem SVG</a>
        <a href="#provisioning">Provisioning</a>
        <a href="#doctor">Health checks</a>
        <a href="#toolkit">Why toolkit owns capabilities</a>
      </nav>
    </div>
  </Fragment>

  <div class="ws-page">
    <!-- Narrative -->
    <section class="ws-narrative" aria-labelledby="ws-narrative-title">
      <h2 id="ws-narrative-title" class="ws-narrative__title">Four layers, one continuous system</h2>
      <p class="ws-narrative__lead">
        The <strong>Digital Nest</strong> is built as a 4-layer DX stack. <em>Dotfiles</em> are where you type,
        <em>machine provisioning</em> is what boots, <em>LLM policy</em> is what gates the model, and
        <em>tooling</em> is what the agent can do. Each layer delegates — never duplicates. The workstation stays
        <strong>thin</strong>: it ships no <code>skills/*</code>, <code>loops/*</code>, <code>mcp/*</code> — only
        <code>dev-companion/runner</code>. Everything else is delegated to <code>agent-toolkit</code> via
        <code>uv tool install --force agent-toolkit-cli &amp;&amp; agent-toolkit install</code>.
      </p>
      <div class="ws-narrative__facts" role="list">
        <div class="ws-fact" role="listitem">
          <span class="ws-fact__k">Dotfiles</span><span class="ws-fact__v"
            >HorneroConfig · Hyprland + Quickshell · 13+ rices · smart-colors</span
          >
        </div>
        <div class="ws-fact" role="listitem">
          <span class="ws-fact__k">Machine provisioning</span><span class="ws-fact__v"
            >chezmoi apply · packages · shell · dots-* thin helpers</span
          >
        </div>
        <div class="ws-fact" role="listitem">
          <span class="ws-fact__k">LLM policy</span><span class="ws-fact__v"
            >env.d · DOTS_AI_DEVCOMPANION_LLM_ALLOWLIST · strict=1 · llm-status gate</span
          >
        </div>
        <div class="ws-fact" role="listitem">
          <span class="ws-fact__k">Tooling</span><span class="ws-fact__v"
            >agent-toolkit · 52 skills · 16 agents · 10 loops · MCP · SKILL.md catalog</span
          >
        </div>
      </div>
    </section>

    <div id="stack">
      <StackDiagram />
    </div>

    <section class="ws-diagram-wrap" aria-label="Ecosystem diagram — 4 layers inline SVG">
      <div class="ws-diagram-head">
        <h2 class="ws-diagram-title">Ecosystem — 4 capas · SVG · midnight identity</h2>
        <p class="ws-diagram-desc">
          The diagram is the map; the layers below are the territory. HorneroConfig paints the desktop, Workstation
          provisions the machine (thin), Toolkit distributes every capability, Harness keeps runtime memory. <code
            >midnight #020617</code
          > · <code>cyan #22D3EE</code> ·
          <code>violet #A78BFA</code> · <code>lime #84CC16</code>.
        </p>
      </div>
      <div id="ecosystem">
        <EcosystemDiagram />
      </div>
      <p class="ws-diagram-meta">
        Thin boundary marked after L1 — no embedded capabilities. Accessible inline SVG with <code>role="img"</code>, <code
          >&lt;title&gt;</code
        > and <code>&lt;desc&gt;</code>.
      </p>
    </section>

    <LayersSection />

    <ProvisioningSection />

    <DoctorChecks />

    <ToolkitRationale />

    <!-- CTAs -->
    <section class="ws-ctas" aria-labelledby="ws-ctas-title">
      <h2 id="ws-ctas-title" class="ws-ctas__title">Verified thin workstation — start here</h2>
      <p class="ws-ctas__lead">
        One command installs the machine, another installs every capability. Verify before queuing background jobs.
      </p>
      <div class="ws-ctas__grid">
        <div class="ws-cta-card">
          <h3 class="ws-cta-card__title">1 · Provision the machine</h3>
          <pre class="ws-cta-card__code"><code>chezmoi init --apply ulises-jeremias/agentic-workstation</code></pre>
          <p class="ws-cta-card__desc">Idempotent chezmoi apply · profile-driven (technical / data / ai / minimal).</p>
          <a
            href="https://github.com/ulises-jeremias/agentic-workstation"
            target="_blank"
            rel="noreferrer"
            class="ws-cta-card__link">agentic-workstation → machine provisioning ↗</a
          >
        </div>
        <div class="ws-cta-card ws-cta-card--accent">
          <h3 class="ws-cta-card__title">2 · Install capabilities (sole path)</h3>
          <pre
            class="ws-cta-card__code ws-cta-card__code--highlight"><code>uv tool install --force agent-toolkit-cli &amp;&amp; agent-toolkit install</code></pre>
          <p class="ws-cta-card__desc">
            52 skills · 16 agents · 10 loops · 6 MCP · plugins. Delegated via toolkit — no AUR/pipx fallback.
          </p>
          <a
            href="https://github.com/ulises-jeremias/agent-toolkit"
            target="_blank"
            rel="noreferrer"
            class="ws-cta-card__link">agent-toolkit → 52+ skills ↗</a
          >
        </div>
        <div class="ws-cta-card">
          <h3 class="ws-cta-card__title">3 · Verify health</h3>
          <pre class="ws-cta-card__code"><code>dots-doctor
dots-doctor --json | jq
agent-toolkit swarm doctor</code></pre>
          <p class="ws-cta-card__desc">Profile-aware swarm gate · snapshot + machine report · drift check.</p>
          <a
            href="https://github.com/ulises-jeremias/dotfiles"
            target="_blank"
            rel="noreferrer"
            class="ws-cta-card__link">HorneroConfig → dotfiles ↗</a
          >
        </div>
        <div class="ws-cta-card">
          <h3 class="ws-cta-card__title">4 · Gate LLM policy (before queue)</h3>
          <pre class="ws-cta-card__code"><code>dots-devcompanion llm-status</code></pre>
          <p class="ws-cta-card__desc">
            Machine-level provider allowlist · <code>DOTS_AI_DEVCOMPANION_LLM_ALLOWLIST</code> + <code>STRICT=1</code>.
            Never invokes model.
          </p>
          <a
            href="https://github.com/ulises-jeremias/ai-workspace"
            target="_blank"
            rel="noreferrer"
            class="ws-cta-card__link">ai-workspace → harness runtime ↗</a
          >
        </div>
      </div>
      <p class="ws-ctas__foot">
        Full docs: <code>docs/ARCHITECTURE.md</code> + <code>docs/AGENT_TOOLKIT.md</code> in agentic-workstation. Tokens from
        <code>src/styles/tokens.css</code> · layout via <code>SectionLayout</code>.
      </p>
    </section>
  </div>
</SectionLayout>

<style>
  .ws-hero-actions {
    display: flex;
    flex-direction: column;
    gap: 0.85rem;
    margin-top: 1rem;
  }
  .ws-hero-cta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.65rem;
  }
  .ws-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 0.6rem 1rem;
    border-radius: 0.75rem;
    font-weight: 700;
    font-size: 0.9rem;
    text-decoration: none;
    border: 1px solid transparent;
  }
  .ws-btn--primary {
    background: linear-gradient(135deg, #22d3ee 0%, #0ea5e9 45%, #a78bfa 100%);
    color: #020617;
  }
  .ws-btn--ghost {
    background: var(--color-paper, #f7f0e6);
    color: var(--color-ink, #181512);
    border-color: var(--color-border, #e9d8c3);
  }
  .ws-hero-code {
    padding: 0.4rem 0.6rem;
    border-radius: 0.55rem;
    background: #020617;
    border: 1px solid rgba(51, 65, 85, 0.5);
    color: #a5f3fc;
    font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
    font-size: 0.76rem;
  }
  .ws-toc {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.82rem;
  }
  .ws-toc__label {
    font-size: 0.7rem;
    font-weight: 800;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--color-muted, #6b715e);
  }
  .ws-toc a {
    padding: 0.28rem 0.6rem;
    border-radius: 999px;
    background: var(--color-paper, #f7f0e6);
    border: 1px solid var(--color-border, #e9d8c3);
    color: var(--color-ink, #181512);
    font-size: 0.8rem;
    font-weight: 600;
    text-decoration: none;
  }
  .ws-toc a:hover {
    border-color: var(--theme-accent, #1e5a8a);
  }
  .ws-page {
    display: flex;
    flex-direction: column;
    gap: 2rem;
    max-width: 1160px;
    margin: 0 auto;
    padding: 1rem 0 1rem;
  }
  .ws-narrative {
    max-width: 72ch;
  }
  .ws-narrative__title {
    margin: 0 0 0.6rem;
    font-size: clamp(1.35rem, 3vw, 1.85rem);
    font-weight: 800;
    letter-spacing: -0.02em;
    color: var(--color-ink, #181512);
  }
  .ws-narrative__lead {
    margin: 0 0 1rem;
    color: var(--color-muted, #6b715e);
    line-height: 1.65;
    font-size: 0.98rem;
  }
  .ws-narrative__lead strong {
    color: var(--color-ink, #181512);
  }
  .ws-narrative__lead code {
    color: var(--color-ink, #181512);
    font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
    font-size: 0.84rem;
    background: var(--color-paper, #f7f0e6);
    padding: 0.1rem 0.3rem;
    border-radius: 0.35rem;
    border: 1px solid var(--color-border, #e9d8c3);
  }
  .ws-facts {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }
  .ws-fact {
    display: grid;
    grid-template-columns: 160px 1fr;
    gap: 0.75rem;
    padding: 0.65rem 0.75rem;
    border-radius: 0.75rem;
    background: var(--color-paper, #f7f0e6);
    border: 1px solid var(--color-border, #e9d8c3);
    font-size: 0.88rem;
    line-height: 1.5;
  }
  @media (max-width: 640px) {
    .ws-fact {
      grid-template-columns: 1fr;
    }
  }
  .ws-fact__k {
    font-weight: 800;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    font-size: 0.72rem;
    color: var(--theme-accent, #1e5a8a);
  }
  .ws-fact__v {
    color: var(--color-muted, #6b715e);
  }
  .ws-diagram-wrap {
    display: flex;
    flex-direction: column;
    gap: 0.85rem;
  }
  .ws-diagram-head {
    max-width: 72ch;
  }
  .ws-diagram-title {
    margin: 0 0 0.35rem;
    font-size: 1rem;
    font-weight: 800;
    color: var(--color-ink, #181512);
  }
  .ws-diagram-desc {
    margin: 0;
    color: var(--color-muted, #6b715e);
    font-size: 0.92rem;
    line-height: 1.6;
  }
  .ws-diagram-desc code {
    font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
    font-size: 0.82rem;
    color: var(--color-ink, #181512);
  }
  .ws-diagram-meta {
    color: #6b7280;
    font-size: 0.78rem;
  }
  .ws-diagram-meta code {
    font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
    color: #475569;
  }
  .ws-ctas {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    padding: 1.25rem;
    border-radius: 1.25rem;
    background: var(--color-paper, #f7f0e6);
    border: 1px solid var(--color-border, #e9d8c3);
  }
  .ws-ctas__title {
    margin: 0;
    font-size: 1.25rem;
    font-weight: 800;
    letter-spacing: -0.02em;
    color: var(--color-ink, #181512);
  }
  .ws-ctas__lead {
    margin: 0;
    color: var(--color-muted, #6b715e);
    line-height: 1.6;
  }
  .ws-ctas__grid {
    display: grid;
    gap: 0.85rem;
    grid-template-columns: 1fr;
  }
  @media (min-width: 760px) {
    .ws-ctas__grid {
      grid-template-columns: 1fr 1fr;
    }
  }
  .ws-cta-card {
    padding: 1rem;
    border-radius: 1rem;
    background: var(--color-warm-white, #fffdf9);
    border: 1px solid var(--color-border, #e9d8c3);
    border-left: 3px solid var(--theme-accent, #1e5a8a);
  }
  .ws-cta-card--accent {
    border-left-color: #22d3ee;
    background: #f8fafc;
  }
  .ws-cta-card__title {
    margin: 0 0 0.5rem;
    font-size: 0.95rem;
    font-weight: 800;
    color: var(--color-ink, #181512);
  }
  .ws-cta-card__code {
    margin: 0 0 0.55rem;
    padding: 0.6rem 0.7rem;
    border-radius: 0.65rem;
    background: #020617;
    border: 1px solid #1e293b;
    overflow-x: auto;
  }
  .ws-cta-card__code code {
    color: #a5f3fc;
    font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
    font-size: 0.78rem;
    white-space: pre;
  }
  .ws-cta-card__code--highlight code {
    color: #bef264;
  }
  .ws-cta-card__desc {
    margin: 0 0 0.6rem;
    color: #64748b;
    font-size: 0.86rem;
    line-height: 1.5;
  }
  .ws-cta-card__desc code {
    font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
    font-size: 0.78rem;
    color: #475569;
  }
  .ws-cta-card__link {
    font-size: 0.84rem;
    font-weight: 700;
    color: var(--theme-accent, #1e5a8a);
    text-decoration: none;
  }
  .ws-cta-card__link:hover {
    text-decoration: underline;
  }
  .ws-ctas__foot {
    margin: 0;
    padding-top: 0.75rem;
    border-top: 1px dashed var(--color-border, #e9d8c3);
    color: #6b7280;
    font-size: 0.78rem;
    line-height: 1.5;
  }
  .ws-ctas__foot code {
    font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
    color: #475569;
  }
</style>
