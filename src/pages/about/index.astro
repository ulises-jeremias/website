---
import SectionLayout from '@/layouts/SectionLayout.astro';
import './about.css';
import { getRouteMeta, getCanonicalUrl } from '@/data/routes';
import { profile } from '@/data/profile';
import { getHomepagePortfolioAreas } from '@/data/portfolio';

const meta = getRouteMeta('/about')!;

/** Each stop describes verified work or first-person experience; no roles or dates are inferred. */
type TrajectoryStage = {
  id: string;
  tone: string;
  period: string;
  mapLabel: string;
  heading: string;
  body: string;
  links: { href: string; label: string }[];
};

const trajectory: TrajectoryStage[] = [
  {
    id: 'foundations',
    tone: 'cyan',
    period: 'Foundations',
    mapLabel: 'Developer tooling',
    heading: 'Developer tools begin at the workbench',
    body: 'I started with command-line tools, automation, and a Linux desktop I kept rebuilding by hand. That practice shaped a lasting focus: developer experience is part of the product, not an afterthought.',
    links: [],
  },
  {
    id: 'v-science',
    tone: 'blue',
    period: 'Since 2019',
    mapLabel: 'V + scientific computing',
    heading: 'Give a language a working ecosystem',
    body: 'I started VSL, the V Scientific Library, in 2019 and still lead it. I maintain VTL for tensors and autograd, built setup-v for CI and RxV for reactive streams, and contribute to the V compiler.',
    links: [{ href: '/v', label: 'Explore the V ecosystem' }],
  },
  {
    id: 'composition',
    tone: 'orange',
    period: 'Since 2020',
    mapLabel: 'App composition',
    heading: 'Compose applications from parts',
    body: 'Create Awesome Node App began in 2020 as a way to combine a template with extensions instead of copying starters. Python, V, and Rust siblings now share that model; Recoil DevTools remains maintained for apps that still use Recoil.',
    links: [{ href: '/create-awesome', label: 'Explore Create Awesome' }],
  },
  {
    id: 'linux',
    tone: 'pink',
    period: 'HorneroConfig → Hornero OS',
    mapLabel: 'Linux systems',
    heading: 'Make the working environment reproducible',
    body: 'HorneroConfig grew from its X11 roots into a Hyprland and Quickshell desktop managed with chezmoi. Generic parts of that configuration informed Hornero OS, an early-stage Arch-based desktop OS that is not installable yet.',
    links: [
      { href: '/dotfiles', label: 'HorneroConfig' },
      { href: '/hornero-os', label: 'Hornero OS' },
    ],
  },
  {
    id: 'agentic',
    tone: 'magenta',
    period: 'Now',
    mapLabel: 'Agentic workflows',
    heading: 'Carry the systems model into agentic work',
    body: 'Agent Toolkit makes skills, agents, and loops portable across coding assistants. Agentic Workstation provisions the machine; Agentic Harness keeps workspace context between sessions.',
    links: [
      { href: '/agentic', label: 'Explore the Agentic Developer Stack' },
      { href: '/agent-toolkit', label: 'Agent Toolkit' },
      { href: '/agentic-workstation', label: 'Workstation' },
      { href: '/agentic-harness', label: 'Harness' },
    ],
  },
];

const values = [
  {
    title: 'Less friction',
    body: 'A tool earns its place when it removes a step people repeat, not when it adds a feature.',
  },
  {
    title: 'Developer control',
    body: 'Automation should serve the person using it. Provenance, configuration, and exits stay visible.',
  },
  {
    title: 'Composable pieces',
    body: 'Small parts with clear boundaries outlive the next assistant, framework, or machine.',
  },
  {
    title: 'Reproducible by default',
    body: 'Environments are declared, versioned, and rebuilt — never assembled by hand twice.',
  },
  {
    title: 'Work in public',
    body: 'Decisions, ADRs, and history live in the repositories, where anyone can check them.',
  },
];

const roleGroups = [
  { kind: 'employment', title: 'Work', note: 'Client work stays private and is not shown on this site.' },
  {
    kind: 'open-source',
    title: 'Open source',
    note: 'Roles are linked to their public organizations and repositories.',
  },
  { kind: 'community', title: 'Community', note: 'Community work is open to anyone and separate from my employer.' },
] as const;

const focusAreas = getHomepagePortfolioAreas();

const profilePageJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'ProfilePage',
  mainEntity: {
    '@type': 'Person',
    name: profile.displayName,
    url: getCanonicalUrl('/'),
    jobTitle: profile.title,
    sameAs: [profile.links.github, profile.links.linkedin, profile.links.sponsors],
  },
  url: getCanonicalUrl('/about'),
};
---

<SectionLayout
  currentPath="/about"
  world="About"
  title={meta.title}
  description={meta.description}
  theme="about"
  jsonLd={profilePageJsonLd}
>
  <div class="about-page">
    <div class="about-page__inner">
      <header class="about-hero" data-testid="about-hero">
        <div class="about-hero__identity">
          <p class="about-page__kicker">Digital Nest <span aria-hidden="true">/</span> builder profile</p>
          <h1 class="about-hero__title">{profile.displayName}</h1>
          <p class="about-hero__role">{profile.title}<span aria-hidden="true"> · </span>open-source builder</p>
          <p class="about-hero__lead">{profile.summary}</p>
          <p class="about-hero__location">
            <span class="about-hero__location-mark" aria-hidden="true"></span>{profile.location}
          </p>
          <nav class="about-hero__actions" aria-label="Explore my work and contact me">
            <a class="about-hero__primary-link" href="/projects">Explore the work</a>
            <a href="/open-source">Trace the open-source work</a>
          </nav>
        </div>

        <nav class="about-path" aria-label="Build trajectory" data-testid="about-build-path">
          <p class="about-path__label">One thread through the work</p>
          <p class="about-path__thesis">Make every layer easier to work with.</p>
          <ol class="about-path__stops">
            {
              trajectory.map((stage) => (
                <li class="about-path__stop" data-tone={stage.tone}>
                  <a href={`#trajectory-${stage.id}`}>
                    <span class="about-path__node" aria-hidden="true" />
                    <span>{stage.mapLabel}</span>
                  </a>
                </li>
              ))
            }
          </ol>
        </nav>
      </header>

      <section class="about-trajectory" aria-labelledby="about-trajectory-title">
        <header class="about-section-heading">
          <p class="about-page__kicker">From the workstation outward</p>
          <h2 id="about-trajectory-title">The systems I build</h2>
          <p>
            The projects move across environments, languages, applications, and workflows. The common thread is to make
            these layers work together and leave the person in control.
          </p>
        </header>
        <ol class="about-stations" data-testid="about-trajectory">
          {
            trajectory.map((stage) => (
              <li class="about-station" id={`trajectory-${stage.id}`} data-tone={stage.tone}>
                <article aria-labelledby={`trajectory-title-${stage.id}`}>
                  <p class="about-station__period">{stage.period}</p>
                  <h3 id={`trajectory-title-${stage.id}`}>{stage.heading}</h3>
                  <p class="about-station__body">{stage.body}</p>
                  {stage.links.length > 0 && (
                    <ul class="about-station__links" aria-label={`${stage.mapLabel} links`}>
                      {stage.links.map((link) => (
                        <li>
                          <a href={link.href}>
                            {link.label}
                            <span aria-hidden="true"> ↗</span>
                          </a>
                        </li>
                      ))}
                    </ul>
                  )}
                </article>
              </li>
            ))
          }
        </ol>
      </section>

      <section class="about-roles" aria-labelledby="about-roles-title">
        <header class="about-section-heading about-section-heading--compact">
          <p class="about-page__kicker">How I contribute</p>
          <h2 id="about-roles-title">Roles and provenance</h2>
          <p>Employment, open-source maintenance, and community work are shown as separate responsibilities.</p>
        </header>
        <div class="about-role-groups">
          {
            roleGroups.map((group) => (
              <section class="about-role-group" aria-labelledby={`role-group-${group.kind}`}>
                <h3 id={`role-group-${group.kind}`}>{group.title}</h3>
                <ul>
                  {profile.roles
                    .filter((role) => role.kind === group.kind)
                    .map((role) => (
                      <li>
                        <strong>{role.label}</strong>
                        {role.organization && (
                          <span>
                            {role.href ? (
                              <a href={role.href} target="_blank" rel="noopener noreferrer">
                                {role.organization}
                                <span class="sr-only"> (opens in new tab)</span>
                              </a>
                            ) : (
                              role.organization
                            )}
                          </span>
                        )}
                      </li>
                    ))}
                </ul>
                <p>{group.note}</p>
              </section>
            ))
          }
        </div>
        <p class="about-roles__provenance">
          Project ownership is explicit throughout the site: work I own, work I maintain within organizations such as
          vlang, and upstream contributions are labelled differently. <a href="/open-source">Open Source</a> links to the
          evidence.
        </p>
      </section>

      <section class="about-focus" aria-labelledby="about-focus-title">
        <header class="about-section-heading about-section-heading--compact">
          <p class="about-page__kicker">What is active across the portfolio</p>
          <h2 id="about-focus-title">Current focus</h2>
        </header>
        <ul class="about-focus__areas">
          {
            focusAreas.map((area) => (
              <li>
                <a href={area.path}>
                  <strong>{area.title}</strong>
                  <span>{area.memberLinks.map((member) => member.title).join(' · ')}</span>
                </a>
              </li>
            ))
          }
        </ul>
      </section>

      <section class="about-values" aria-labelledby="about-values-title">
        <header class="about-section-heading about-section-heading--compact">
          <p class="about-page__kicker">The design rules behind the work</p>
          <h2 id="about-values-title">What I care about</h2>
        </header>
        <ul class="about-values__list">
          {
            values.map((value) => (
              <li>
                <h3>{value.title}</h3>
                <p>{value.body}</p>
              </li>
            ))
          }
        </ul>
      </section>

      <section class="about-contact-band" aria-label="Support and contact">
        <div class="about-support" aria-labelledby="about-support-title">
          <p class="about-page__kicker">Open-source support</p>
          <h2 id="about-support-title">Help the work continue</h2>
          <p>
            The projects are free and open source. Support can fund integrations, infrastructure credits, or Linux
            hardware for testing. Sponsorship is disclosed and never buys a technical recommendation.
          </p>
          <p class="about-support__links">
            <a class="about-hero__primary-link" href="/sponsor">Sponsor &amp; partner</a>
            <a href={profile.links.sponsors} target="_blank" rel="noopener noreferrer">
              GitHub Sponsors<span aria-hidden="true"> ↗</span><span class="sr-only"> (opens in new tab)</span>
            </a>
          </p>
        </div>
        <div class="about-contact" aria-labelledby="about-contact-title">
          <p class="about-page__kicker">Start a conversation</p>
          <h2 id="about-contact-title">Contact</h2>
          <p>Email is the best way to reach me:</p>
          <a class="about-contact__email" href={`mailto:${profile.contact.email}`}>{profile.contact.email}</a>
          <ul class="about-contact__social">
            {
              profile.socials.map((social) => (
                <li>
                  <a href={social.href} target="_blank" rel="noopener noreferrer">
                    {social.label}
                    <span class="sr-only"> (opens in new tab)</span>
                  </a>
                </li>
              ))
            }
          </ul>
        </div>
      </section>
    </div>
  </div>
</SectionLayout>
