---
import SectionLayout from '@/layouts/SectionLayout.astro';
import {
  ActiveWorkshop,
  ContributionExplorer,
  DiscordCTA,
  Hero,
  ModerationPrivacy,
  SupportChannels,
  WorkshopGraph,
  WorkshopNarrative,
  communityMeta,
} from '@/features/community';
import { getRouteMeta } from '@/data/routes';

const meta = getRouteMeta('/community')!;
---

<SectionLayout
  currentPath="/community"
  world="Community"
  title={meta.title}
  description={meta.description}
  theme="community"
>
  <div class="community-page">
    <Hero />
    <WorkshopNarrative />
    <DiscordCTA />
    <WorkshopGraph />
    <ActiveWorkshop />
    <ContributionExplorer />
    <SupportChannels />
    <ModerationPrivacy />

    <section class="community-closing" aria-labelledby="closing-title">
      <h2 id="closing-title" class="community-closing__title">Pick a world. Or just hang out.</h2>
      <p class="community-closing__lead">
        Whether you care about Linux rices, agent skills, scaffolding CLIs, V numerics, or something still incubating —
        the workshop is open. Start in Discord or jump straight to a repository that matches your interests.
      </p>
      <div class="community-closing__actions">
        <a
          href={communityMeta.discordInviteUrl}
          class="community-closing__cta community-closing__cta--discord"
          target="_blank"
          rel="noopener noreferrer"
          aria-label="Join the Digital Nest Discord (opens in a new tab)"
        >
          Join the Discord
        </a>
        <a href="#find-something" class="community-closing__cta">Find something to contribute</a>
        <a href="/projects" class="community-closing__cta community-closing__cta--ghost">Browse projects</a>
        <a href="/open-source" class="community-closing__cta community-closing__cta--ghost">Open Source evidence</a>
      </div>
      <p class="community-closing__note">
        Invite verified · <code>discord.gg/bR5VyATgka</code> · {communityMeta.communityDistinctNote}
      </p>
    </section>
  </div>
</SectionLayout>

<style>
  .community-page {
    display: grid;
    gap: 0.25rem;
    max-width: 72rem;
    margin: 0 auto;
    padding: 0 1rem 2.5rem;
    width: 100%;
  }
  @media (width >= 860px) {
    .community-page {
      padding-inline: 1.5rem;
    }
  }
  .community-closing {
    padding: 1.75rem 0 0.5rem;
  }
  .community-closing__title {
    margin: 0;
    font-size: clamp(1.4rem, 3vw, 1.75rem);
    font-weight: 800;
    color: var(--color-text);
  }
  .community-closing__lead {
    margin: 0.5rem 0 0;
    max-width: 62ch;
    color: var(--color-text-muted);
    line-height: 1.6;
  }
  .community-closing__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem;
    margin-top: 1rem;
  }
  .community-closing__cta {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 44px;
    padding: 0 1rem;
    clip-path: var(--clip-corner-sm);
    background: color-mix(in srgb, var(--nest-midnight-900) 88%, transparent);
    border: 1px solid var(--color-border);
    color: var(--color-text);
    font-weight: 700;
    font-size: 0.92rem;
    text-decoration: none;
  }
  .community-closing__cta:hover {
    border-color: var(--nest-cyan);
  }
  .community-closing__cta:focus-visible {
    outline: 2px solid var(--color-focus-ring);
    outline-offset: 2px;
  }
  .community-closing__cta--discord {
    background: #5865f2;
    border-color: #5865f2;
    color: #fff;
  }
  .community-closing__cta--discord:hover {
    background: #4752c4;
    border-color: #4752c4;
    color: #fff;
  }
  .community-closing__cta--ghost {
    background: transparent;
  }
  .community-closing__note {
    margin: 0.85rem 0 0;
    color: var(--color-text-faint);
    font-size: 0.85rem;
    line-height: 1.5;
  }
  .community-closing__note code {
    padding: 0.1rem 0.35rem;
    clip-path: var(--clip-corner-sm);
    background: color-mix(in srgb, var(--nest-violet) 12%, transparent);
    border: 1px solid var(--color-border);
    font-size: 0.85rem;
  }
</style>
