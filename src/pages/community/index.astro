---
import SectionLayout from '@/layouts/SectionLayout.astro';
import CommunityPlaza from '@/features/community/components/CommunityPlaza.astro';
import { getRouteMeta } from '@/data/routes';

const meta = getRouteMeta('/community')!;
---

<SectionLayout
  currentPath="/community"
  world="Community"
  title={meta.title}
  description={meta.description}
  theme="community"
  immersive
>
  <CommunityPlaza />
</SectionLayout>
