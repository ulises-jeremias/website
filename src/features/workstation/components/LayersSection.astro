---
import { workstationLayers } from '../data/index.js';
import LayerCard from './LayerCard.astro';
---

<section id="ws-layers" class="ws-layers" aria-labelledby="ws-layers-title">
  <div class="ws-layers__head">
    <h2 id="ws-layers-title" class="ws-layers__title">Four nodes, one Personal DX graph</h2>
    <p class="ws-layers__lead">
      <strong>HorneroConfig</strong> (optional desktop path) · <strong>Workstation</strong> (machine provisioning) ·
      <strong>Toolkit</strong> (capability distribution and orchestration) · <strong>Agentic Harness</strong> (persistent
      workspace context). Desktop is independently usable, and no project is a required step for every visitor.
    </p>
  </div>

  <div class="ws-layers__grid">
    {workstationLayers.map((layer) => <LayerCard layer={layer} />)}
  </div>

  <div class="ws-layers__legend" role="note" aria-label="Identity">
    <span class="ws-layers__legend-dot" style="background:#020617; border-color:#334155"></span> midnight #020617
    <span class="ws-layers__legend-dot" style="background:#22D3EE"></span> cyan #22D3EE
    <span class="ws-layers__legend-dot" style="background:#A78BFA"></span> violet #A78BFA
    <span class="ws-layers__legend-dot" style="background:#84CC16"></span> lime #84CC16
    <span class="ws-layers__legend-text"
      >— Workstation provisions the host; Toolkit owns capabilities and orchestration; Harness persists context.</span
    >
  </div>
</section>

<style>
  .ws-layers {
    display: flex;
    flex-direction: column;
    gap: 1.4rem;
  }
  .ws-layers__head {
    max-width: 72ch;
  }
  .ws-layers__title {
    margin: 0 0 0.55rem;
    font-size: clamp(1.35rem, 3.2vw, 1.9rem);
    font-weight: 800;
    letter-spacing: -0.03em;
    color: #f8fafc;
    line-height: 1.15;
  }
  .ws-layers__lead {
    margin: 0;
    color: #94a3b8;
    line-height: 1.65;
    font-size: 0.98rem;
  }
  .ws-layers__lead strong {
    color: #cbd5e1;
    font-weight: 700;
  }
  .ws-layers__grid {
    display: grid;
    gap: 1rem;
    grid-template-columns: 1fr;
  }
  @media (min-width: 760px) {
    .ws-layers__grid {
      grid-template-columns: 1fr 1fr;
    }
  }
  @media (min-width: 1140px) {
    .ws-layers__grid {
      grid-template-columns: repeat(4, 1fr);
    }
  }
  .ws-layers__legend {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.5rem 0.9rem;
    font-size: 0.78rem;
    color: #64748b;
    border-top: 1px solid rgba(51, 65, 85, 0.5);
    padding-top: 0.9rem;
  }
  .ws-layers__legend-dot {
    width: 12px;
    height: 12px;
    border-radius: 50%;
    border: 1px solid transparent;
    display: inline-block;
    flex-shrink: 0;
  }
  .ws-layers__legend-text {
    color: #475569;
  }
</style>
