---
import type { LayerMeta } from '../types/index.js';

interface Props {
  layer: LayerMeta;
}

const { layer } = Astro.props as Props;
---

<article class="ws-layer-card" style={`--accent:${layer.accent}`}>
  <div class="ws-layer-card__header">
    <span class="ws-layer-card__label">{layer.label}</span>
    <span class="ws-layer-card__index" aria-hidden="true">0{layer.index + 1}</span>
  </div>

  <h3 class="ws-layer-card__title">{layer.title}</h3>
  <p class="ws-layer-card__subtitle">{layer.subtitle}</p>
  <p class="ws-layer-card__mapping">{layer.mapping}</p>

  <p class="ws-layer-card__desc">{layer.description}</p>

  <div class="ws-layer-card__block">
    <h4 class="ws-layer-card__block-title">Owns</h4>
    <ul class="ws-layer-card__list">
      {layer.responsibilities.map((r) => <li>{r}</li>)}
    </ul>
  </div>

  <div class="ws-layer-card__block">
    <h4 class="ws-layer-card__block-title">Delivers</h4>
    <ul class="ws-layer-card__delivers">
      {
        layer.delivers.map((d) => (
          <li>
            <code>{d}</code>
          </li>
        ))
      }
    </ul>
  </div>

  {
    layer.repo && (
      <p class="ws-layer-card__repo">
        <span aria-hidden="true">↗</span> <code>{layer.repo}</code>
      </p>
    )
  }
</article>

<style>
  .ws-layer-card {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: 0.65rem;
    padding: 1.35rem 1.25rem 1.15rem;
    border-radius: 1.25rem;
    background: rgba(15, 23, 42, 0.72);
    border: 1px solid rgba(51, 65, 85, 0.7);
    border-top: 2px solid var(--accent);
    backdrop-filter: blur(10px);
    transition:
      transform 0.18s,
      border-color 0.18s,
      box-shadow 0.18s;
  }
  .ws-layer-card:hover {
    transform: translateY(-2px);
    border-color: color-mix(in srgb, var(--accent) 45%, #334155);
    box-shadow:
      0 12px 30px rgba(2, 6, 23, 0.45),
      0 0 24px color-mix(in srgb, var(--accent) 14%, transparent);
  }
  .ws-layer-card__header {
    display: flex;
    align-items: center;
    justify-content: space-between;
  }
  .ws-layer-card__label {
    display: inline-flex;
    align-items: center;
    padding: 0.28rem 0.6rem;
    border-radius: 999px;
    font-size: 0.68rem;
    font-weight: 800;
    letter-spacing: 0.09em;
    text-transform: uppercase;
    color: #020617;
    background: var(--accent);
  }
  .ws-layer-card__index {
    font-size: 0.78rem;
    font-weight: 800;
    color: #334155;
    letter-spacing: 0.08em;
  }
  .ws-layer-card__title {
    margin: 0;
    font-size: 1.28rem;
    font-weight: 800;
    letter-spacing: -0.02em;
    color: #f8fafc;
    line-height: 1.15;
  }
  .ws-layer-card__subtitle {
    margin: -0.35rem 0 0;
    font-size: 0.82rem;
    color: var(--accent);
    font-weight: 600;
    letter-spacing: 0.02em;
  }
  .ws-layer-card__mapping {
    margin: 0;
    font-size: 0.78rem;
    color: #64748b;
    font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
  }
  .ws-layer-card__desc {
    margin: 0.15rem 0 0.2rem;
    color: #94a3b8;
    font-size: 0.92rem;
    line-height: 1.6;
  }
  .ws-layer-card__block {
    margin-top: 0.35rem;
  }
  .ws-layer-card__block-title {
    margin: 0 0 0.35rem;
    font-size: 0.72rem;
    font-weight: 800;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: #cbd5e1;
  }
  .ws-layer-card__list {
    margin: 0;
    padding-left: 1.1rem;
    color: #cbd5e1;
    font-size: 0.88rem;
    line-height: 1.55;
  }
  .ws-layer-card__list li::marker {
    color: var(--accent);
  }
  .ws-layer-card__delivers {
    margin: 0;
    padding: 0;
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 0.32rem;
  }
  .ws-layer-card__delivers li code {
    display: inline-block;
    padding: 0.22rem 0.5rem;
    border-radius: 0.5rem;
    background: rgba(2, 6, 23, 0.85);
    border: 1px solid rgba(51, 65, 85, 0.6);
    color: #e2e8f0;
    font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
    font-size: 0.74rem;
    word-break: break-all;
  }
  .ws-layer-card__repo {
    margin: 0.35rem 0 0;
    padding-top: 0.75rem;
    border-top: 1px dashed rgba(51, 65, 85, 0.6);
    color: #64748b;
    font-size: 0.76rem;
  }
  .ws-layer-card__repo code {
    color: #94a3b8;
    font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
    font-size: 0.74rem;
  }
</style>
