---
import { provisioningSteps } from '../data/index.js';
---

<section id="provisioning" class="ws-provisioning" aria-labelledby="ws-prov-title">
  <div class="ws-section-head">
    <span class="ws-kicker">Provisioning · machine installs, toolkit distributes</span>
    <h2 id="ws-prov-title" class="ws-section-title">Machine provisioning: from zero to agentic in one command</h2>
    <p class="ws-section-lead">
      Agentic Workstation keeps provisioning and capabilities strictly separate. The workstation (L1) is a <strong
        >thin</strong
      > chezmoi baseline — shells, packages, configs, secrets and LLM policy. Capabilities never live here; they are injected
      by the toolkit on demand.
    </p>
  </div>

  <ol class="ws-steps" role="list">
    {
      provisioningSteps.map((s, i) => (
        <li
          class="ws-step"
          style={`--accent:${i === 0 ? '#A78BFA' : i === 1 ? '#84CC16' : i === 2 ? '#22D3EE' : '#A78BFA'}`}
        >
          <div class="ws-step__index">0{i + 1}</div>
          <div class="ws-step__body">
            <h3 class="ws-step__title">{s.step}</h3>
            <pre class="ws-step__code">
              <code>{s.command}</code>
            </pre>
            <p class="ws-step__desc">{s.description}</p>
            {s.note && <p class="ws-step__note">{s.note}</p>}
          </div>
        </li>
      ))
    }
  </ol>

  <div class="ws-provisioning__callout" role="note">
    <h3 class="ws-provisioning__callout-title">Profile-driven — no host snowflakes</h3>
    <p class="ws-provisioning__callout-text">
      <code>home/.chezmoidata/profiles.yaml</code> encodes feature groups. <code>technical</code>, <code>data</code>, <code
        >ai</code
      > enable
      <code>swarm</code> by default (<code>install_group_swarm</code>). <code>custom</code> answers every flag. Questionnaire
      lives in
      <code>home/.chezmoi.toml.tmpl</code>; install scripts translate canonical <code>package_groups</code> names per platform
      (apt / brew / pacman / dnf).
    </p>
    <p class="ws-provisioning__callout-text">
      Secrets & LLM policy stay in <code>~/.config/agentic-workstation/env.d/*.env</code> and are never committed. Runner
      logic
      <code>dev-companion/runner</code> is the only capability kept in the workstation — everything else is delegated.
    </p>
  </div>
</section>

<style>
  .ws-provisioning {
    display: flex;
    flex-direction: column;
    gap: 1.3rem;
  }
  .ws-section-head {
    max-width: 72ch;
  }
  .ws-kicker {
    display: inline-block;
    font-size: 0.72rem;
    font-weight: 800;
    letter-spacing: 0.09em;
    text-transform: uppercase;
    color: #22d3ee;
    margin-bottom: 0.45rem;
  }
  .ws-section-title {
    margin: 0 0 0.55rem;
    font-size: clamp(1.25rem, 3vw, 1.75rem);
    font-weight: 800;
    letter-spacing: -0.03em;
    line-height: 1.18;
    color: #f8fafc;
  }
  .ws-section-lead {
    margin: 0;
    color: #94a3b8;
    line-height: 1.65;
    font-size: 0.96rem;
  }
  .ws-section-lead strong {
    color: #e2e8f0;
  }
  .ws-steps {
    margin: 0;
    padding: 0;
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 0.9rem;
  }
  .ws-step {
    display: grid;
    grid-template-columns: 56px 1fr;
    gap: 1rem;
    padding: 1.15rem 1.15rem 1.15rem 1rem;
    border-radius: 1.15rem;
    background: rgba(15, 23, 42, 0.7);
    border: 1px solid rgba(51, 65, 85, 0.65);
    border-left: 3px solid var(--accent);
  }
  @media (max-width: 600px) {
    .ws-step {
      grid-template-columns: 1fr;
    }
  }
  .ws-step__index {
    display: grid;
    place-items: center;
    width: 56px;
    height: 56px;
    border-radius: 0.9rem;
    background: #020617;
    border: 1px solid rgba(51, 65, 85, 0.7);
    color: var(--accent);
    font-weight: 850;
    font-size: 1rem;
    letter-spacing: 0.04em;
    font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
  }
  .ws-step__title {
    margin: 0 0 0.5rem;
    font-size: 1.05rem;
    font-weight: 800;
    color: #f8fafc;
    letter-spacing: -0.01em;
  }
  .ws-step__code {
    margin: 0 0 0.6rem;
    padding: 0.65rem 0.75rem;
    border-radius: 0.7rem;
    background: #020617;
    border: 1px solid rgba(51, 65, 85, 0.7);
    overflow-x: auto;
    -webkit-overflow-scrolling: touch;
  }
  .ws-step__code code {
    color: #a5f3fc;
    font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
    font-size: 0.8rem;
    white-space: pre;
  }
  .ws-step__desc {
    margin: 0;
    color: #cbd5e1;
    font-size: 0.92rem;
    line-height: 1.6;
  }
  .ws-step__note {
    margin: 0.45rem 0 0;
    color: #64748b;
    font-size: 0.82rem;
    line-height: 1.55;
  }
  .ws-step__note code {
    color: #94a3b8;
    font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
    font-size: 0.78rem;
  }
  .ws-provisioning__callout {
    padding: 1.15rem 1.2rem;
    border-radius: 1.15rem;
    background: linear-gradient(135deg, rgba(34, 211, 238, 0.08), rgba(167, 139, 250, 0.06));
    border: 1px solid rgba(34, 211, 238, 0.18);
  }
  .ws-provisioning__callout-title {
    margin: 0 0 0.5rem;
    font-size: 0.98rem;
    font-weight: 800;
    color: #e0f2fe;
  }
  .ws-provisioning__callout-text {
    margin: 0 0 0.55rem;
    color: #94a3b8;
    font-size: 0.9rem;
    line-height: 1.6;
  }
  .ws-provisioning__callout-text:last-child {
    margin-bottom: 0;
  }
  .ws-provisioning__callout-text code {
    color: #cbd5e1;
    font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
    font-size: 0.82rem;
  }
</style>
