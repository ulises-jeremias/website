---
interface Props {
  variant?: 'compact' | 'full';
}
const { variant = 'full' } = Astro.props as Props;
---

<div class={`ws-badge ws-badge--${variant}`} role="note" aria-label="Thin workstation verified">
  <span class="ws-badge__dot" aria-hidden="true"></span>
  <span class="ws-badge__label">Thin workstation</span>
  <span class="ws-badge__detail">No embedded skills · toolkit delegates via <code>uv</code></span>
</div>

<style>
  .ws-badge {
    display: inline-flex;
    align-items: center;
    gap: 0.55rem;
    flex-wrap: wrap;
    border-radius: 999px;
    border: 1px solid rgba(34, 211, 238, 0.35);
    background: rgba(15, 23, 42, 0.75);
    padding: 0.4rem 0.85rem;
    font-size: 0.82rem;
    line-height: 1.2;
    color: #e0f2fe;
    backdrop-filter: blur(8px);
  }
  .ws-badge__dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: #22d3ee;
    box-shadow: 0 0 12px rgba(34, 211, 238, 0.7);
    flex-shrink: 0;
  }
  .ws-badge__label {
    font-weight: 800;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    font-size: 0.72rem;
    color: #22d3ee;
  }
  .ws-badge__detail {
    color: #94a3b8;
    font-size: 0.78rem;
  }
  .ws-badge__detail code {
    color: #a5f3fc;
    font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, 'Liberation Mono', 'Courier New', monospace;
    font-size: 0.76rem;
  }
  .ws-badge--compact .ws-badge__detail {
    display: none;
  }
  @media (max-width: 560px) {
    .ws-badge__detail {
      display: none;
    }
  }
</style>
