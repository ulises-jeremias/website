---
import { PlaybackControls, SceneInspector, StageScrubber, StatusMeter, WorldDock } from '@/shared/components/visual';
import '@/shared/components/visual/visual.css';
import {
  doctorChecks,
  provisioningSteps,
  thinWorkstationVerification,
  workstationIdentity,
  workstationLayers,
  workstationProfiles,
} from '../data/index.js';
import { inventoryStrip } from '@/features/agent-toolkit/data/inventory.js';

const bootStages = [
  {
    id: 'fresh',
    title: 'Fresh',
    summary: 'Empty machine. Thin workstation will provision — no embedded skills.',
    command: thinWorkstationVerification.installPath.split('&&')[0]?.trim() ?? 'chezmoi init',
    illuminate: ['hornero'] as const,
  },
  {
    id: 'profile',
    title: 'Profile',
    summary: 'Pick a chezmoi profile. Groups drive packages and swarm prerequisites.',
    command: 'profile = technical | minimal | …',
    illuminate: ['hornero', 'workstation'] as const,
  },
  {
    id: 'provision',
    title: 'Provision',
    summary: provisioningSteps[0]!.description,
    command: provisioningSteps[0]!.command,
    illuminate: ['hornero', 'workstation'] as const,
  },
  {
    id: 'doctor',
    title: 'Doctor',
    summary: doctorChecks[0]!.description,
    command: doctorChecks[0]!.command,
    illuminate: ['hornero', 'workstation'] as const,
  },
  {
    id: 'toolkit',
    title: 'Toolkit uplink',
    summary: `Capabilities via agent-toolkit · ${inventoryStrip()}.`,
    command: provisioningSteps[1]!.command,
    illuminate: ['hornero', 'workstation', 'toolkit'] as const,
  },
  {
    id: 'harness',
    title: 'Harness',
    summary: workstationLayers.find((l) => l.id === 'harness')!.description,
    command: 'workspace-context · knowledge/ · personas/',
    illuminate: ['hornero', 'workstation', 'toolkit', 'harness'] as const,
  },
];
const bootStageCount = bootStages.length;

const nodes = [
  { id: 'hornero', x: 90, y: 210, layer: workstationLayers[0]! },
  { id: 'workstation', x: 280, y: 120, layer: workstationLayers[1]! },
  { id: 'toolkit', x: 480, y: 120, layer: workstationLayers[2]! },
  { id: 'harness', x: 670, y: 210, layer: workstationLayers[3]! },
];

// The boot map selects independent responsibility stations. Cross-project
// semantics live in ResponsibilityTopology, where every edge is verb-labeled.
const paths: { id: string; d: string; from: string; to: string }[] = [];

const stagesJson = JSON.stringify(bootStages);
const profilesJson = JSON.stringify(
  workstationProfiles.map((p) => ({
    id: p.id,
    description: p.description,
    groups: p.groups,
  })),
);
const layersJson = JSON.stringify(
  workstationLayers.map((l) => ({
    id: l.id,
    label: l.label,
    title: l.title,
    subtitle: l.subtitle,
    description: l.description,
    accent: l.accent,
    repo: l.repo ?? '',
    delivers: l.delivers.slice(0, 3),
  })),
);
const doctorJson = JSON.stringify(doctorChecks.map((d) => ({ name: d.name, command: d.command, when: d.when })));

const defaultProfile = workstationProfiles[0]!;
const defaultLayer = workstationLayers[1]!;
---

<section
  class="ws-map"
  aria-labelledby="ws-map-title"
  data-ws-map
  data-stages={stagesJson}
  data-profiles={profilesJson}
  data-layers={layersJson}
  data-doctor={doctorJson}
>
  <header class="ws-map__header">
    <p class="ws-map__eyebrow">Workstation System Map</p>
    <h1 id="ws-map-title">Agentic Workstation</h1>
    <p class="ws-map__lede">
      Fresh → Profile → Provision → Doctor, with optional Toolkit capability integration and persistent Harness context.
    </p>
    <div class="ws-map__header-rail" aria-label="Personal DX layer boundaries">
      <span><strong>L0</strong> optional desktop path</span>
      <span><strong>L1</strong> machine provisioning</span>
      <span><strong>L1.5</strong> capability distribution</span>
      <span><strong>L3</strong> workspace context</span>
    </div>
  </header>

  <div class="vf-scene" data-ws-machine data-profile={defaultProfile.id}>
    <div class="vf-stage ws-map__stage">
      <svg class="ws-map__svg" viewBox="0 0 760 340" aria-hidden="true" focusable="false">
        <defs>
          <radialGradient id="ws-core" cx="50%" cy="50%" r="50%">
            <stop offset="0%" stop-color="#A78BFA" stop-opacity="0.35"></stop>
            <stop offset="100%" stop-color="#020617" stop-opacity="0"></stop>
          </radialGradient>
          <linearGradient id="ws-chassis" x1="0" y1="0" x2="1" y2="1">
            <stop offset="0%" stop-color="#0b1224"></stop>
            <stop offset="100%" stop-color="#1a1030"></stop>
          </linearGradient>
        </defs>
        <rect x="0" y="0" width="760" height="340" fill="url(#ws-core)"></rect>
        <!-- Machine chassis -->
        <rect
          class="ws-map__chassis"
          x="48"
          y="36"
          width="664"
          height="268"
          rx="10"
          fill="url(#ws-chassis)"
          stroke="color-mix(in srgb, var(--nest-cyan) 35%, transparent)"
          stroke-width="1.5"></rect>
        <rect x="64" y="52" width="180" height="14" rx="2" fill="color-mix(in srgb, #22d3ee 25%, transparent)"></rect>
        <text x="68" y="63" class="ws-map__chassis-label" fill="#67e8f9" font-size="9" font-family="var(--font-mono)"
          >MACHINE · BOOT</text
        >
        {paths.map((p) => <path class="vf-flow" data-flow={p.id} data-from={p.from} data-to={p.to} d={p.d} />)}
        {
          nodes.map((n) => (
            <g
              class:list={['ws-map__node', { 'is-selected': n.id === defaultLayer.id }]}
              data-node={n.id}
              style={`--vf-node-accent:${n.layer.accent}`}
            >
              <rect x={n.x - 42} y={n.y - 28} width="84" height="56" rx="4" class="ws-map__module" />
              <text x={n.x} y={n.y - 2} text-anchor="middle" class="ws-map__node-label">
                {n.layer.title}
              </text>
              <text x={n.x} y={n.y + 14} text-anchor="middle" class="ws-map__node-sub">
                {n.layer.label.split('·')[0]?.trim()}
              </text>
            </g>
          ))
        }
        <text x="380" y="318" text-anchor="middle" class="ws-map__thin"
          >no embedded capabilities — Toolkit remains independently installable</text
        >
      </svg>

      <fieldset class="ws-map__node-controls" data-ws-layer-controls disabled>
        <legend>Choose a responsibility</legend>
        <div class="ws-map__node-options">
          {
            workstationLayers.map((layer, i) => (
              <>
                <input
                  class="ws-map__radio"
                  type="radio"
                  name="ws-layer"
                  id={`ws-layer-${layer.id}`}
                  value={layer.id}
                  checked={i === 1}
                  data-layer={layer.id}
                  data-layer-control={layer.id}
                  aria-controls="ws-layer-inspector"
                />
                <label class="vf-node" for={`ws-layer-${layer.id}`} style={`--vf-node-accent:${layer.accent}`}>
                  {layer.title}
                </label>
              </>
            ))
          }
        </div>
      </fieldset>
      <noscript>
        <div class="ws-map__layer-fallback" data-ws-layer-fallback>
          <p>Interactive selection is unavailable. Project responsibilities:</p>
          <ul>
            {
              workstationLayers.map((layer) => (
                <li>
                  <strong>{layer.title}</strong> — {layer.description}
                </li>
              ))
            }
          </ul>
        </div>
      </noscript>
    </div>

    <SceneInspector
      eyebrow="Responsibility"
      title={defaultLayer.title}
      id="ws-layer-inspector"
      live={false}
      headingLevel={2}
    >
      <p data-layer-copy>{defaultLayer.description}</p>
      <Fragment slot="meta">
        <div data-layer-meta>
          <span data-layer-label>{defaultLayer.label}</span>
          {
            defaultLayer.repo ? (
              <span>
                <code data-layer-repo>{defaultLayer.repo}</code>
              </span>
            ) : (
              <span>
                <code data-layer-repo hidden />
              </span>
            )
          }
        </div>
      </Fragment>
    </SceneInspector>
  </div>
  <p class="ws-map__layer-status" role="status" aria-atomic="true" data-ws-layer-status></p>

  <div class="ws-map__boot" data-boot>
    <div class="ws-map__boot-head">
      <h2>Boot sequence</h2>
      <StatusMeter
        value={Math.round((1 / bootStageCount) * 100)}
        label="Boot stage"
        caption="boot sequence"
        displayValue={`Step 1/${bootStageCount}`}
        accent={workstationIdentity.cyan}
      />
    </div>
    <StageScrubber stages={bootStages} label="Boot stage" />
    <p class="ws-map__stage-copy" data-stage-copy>{bootStages[0]!.summary}</p>
    <pre
      class="ws-map__stage-cmd"
      tabindex="0"
      role="region"
      aria-label="Current boot command"><code data-stage-cmd>{bootStages[0]!.command}</code></pre>
    <PlaybackControls label="Boot playback" />
  </div>

  <div class="ws-map__profile">
    <h2>Profile</h2>
    <div class="ws-map__profile-grid" role="radiogroup" aria-label="Chezmoi profile">
      {
        workstationProfiles.map((profile, i) => (
          <>
            <input
              class="ws-map__radio"
              type="radio"
              name="ws-profile"
              id={`ws-profile-${profile.id}`}
              value={profile.id}
              checked={i === 0}
              data-profile={profile.id}
            />
            <label class="vf-node" for={`ws-profile-${profile.id}`}>
              {profile.id}
            </label>
          </>
        ))
      }
    </div>
    <SceneInspector eyebrow="Profile" title={defaultProfile.id} id="ws-profile-inspector">
      <p data-profile-copy>{defaultProfile.description}</p>
      <Fragment slot="meta">
        <div data-profile-groups>
          {
            defaultProfile.groups.length ? (
              defaultProfile.groups.map((g) => (
                <code class="ws-map__profile-token" data-group={g}>
                  {g}
                </code>
              ))
            ) : (
              <span class="ws-map__profile-empty" data-profile-empty>
                custom — answer every group prompt
              </span>
            )
          }
        </div>
      </Fragment>
    </SceneInspector>
  </div>

  <div class="ws-map__health">
    <h2>Health console</h2>
    <ul class="ws-map__health-list">
      {
        doctorChecks.map((check) => (
          <li>
            <code>{check.command}</code>
            <span>{check.name}</span>
          </li>
        ))
      }
    </ul>
    <section class="ws-map__verification">
      <h3>Thin workstation verification</h3>
      <p>{thinWorkstationVerification.statement}</p>
      <p>
        No embedded: {thinWorkstationVerification.noEmbedded.join(', ')}. Kept: {
          thinWorkstationVerification.kept.join(', ')
        }.
      </p>
    </section>
  </div>

  <WorldDock label="Get started">
    <a
      class="vf-dock__primary"
      href="https://github.com/ulises-jeremias/agentic-workstation"
      target="_blank"
      rel="noopener noreferrer"
    >
      GitHub
    </a>
    <a href="/agent-toolkit">Open Toolkit</a>
    <a href="/dotfiles">HorneroConfig</a>
    <a href="/community">Community</a>
    <code class="vf-dock__code">chezmoi init --apply ulises-jeremias/agentic-workstation</code>
  </WorldDock>
</section>

<script>
  import { initStagePlayer } from '@/shared/lib/visual-stage-player';

  type Stage = {
    id: string;
    title: string;
    summary: string;
    command: string;
    illuminate: string[];
  };
  type Profile = { id: string; description: string; groups: string[] };
  type Layer = {
    id: string;
    label: string;
    title: string;
    subtitle: string;
    description: string;
    accent: string;
    repo: string;
    delivers: string[];
  };

  function clearChildren(el: HTMLElement) {
    while (el.firstChild) el.removeChild(el.firstChild);
  }

  function initMap(root: HTMLElement) {
    const stages = JSON.parse(root.dataset.stages || '[]') as Stage[];
    const profiles = JSON.parse(root.dataset.profiles || '[]') as Profile[];
    const layers = JSON.parse(root.dataset.layers || '[]') as Layer[];

    const stageCopy = root.querySelector<HTMLElement>('[data-stage-copy]');
    const stageCmd = root.querySelector<HTMLElement>('[data-stage-cmd]');
    const meter = root.querySelector<HTMLElement>('[data-vf-meter]');
    const meterValue = root.querySelector<HTMLElement>('[data-vf-meter-value]');
    const boot = root.querySelector<HTMLElement>('[data-boot]');
    const machine = root.querySelector<HTMLElement>('[data-ws-machine]');
    const layerControls = root.querySelector<HTMLFieldSetElement>('[data-ws-layer-controls]');
    const layerRadios = Array.from(root.querySelectorAll<HTMLInputElement>('[data-layer-control]'));
    const layerStatus = root.querySelector<HTMLElement>('[data-ws-layer-status]');

    let selectedLayerId = 'workstation';
    let bootIndex = 0;

    const syncNodeVisuals = () => {
      const stage = stages[bootIndex];
      const illuminated = new Set(stage?.illuminate ?? []);
      root.querySelectorAll<SVGGElement>('[data-node]').forEach((g) => {
        const id = g.dataset.node || '';
        g.classList.toggle('is-lit', illuminated.has(id));
        g.classList.toggle('is-selected', id === selectedLayerId);
        g.classList.toggle('is-active', id === selectedLayerId || illuminated.has(id));
      });
      root.querySelectorAll<SVGPathElement>('[data-flow]').forEach((path, i) => {
        const from = path.dataset.from || '';
        const to = path.dataset.to || '';
        const bootLit = illuminated.has(from) && illuminated.has(to);
        const layerLit = from === selectedLayerId || to === selectedLayerId;
        path.classList.toggle('is-active', bootLit || layerLit);
        path.classList.toggle('is-boot', bootLit && i <= Math.min(bootIndex, 3));
      });
    };

    const applyStage = (index: number) => {
      const stage = stages[index];
      if (!stage) return;
      bootIndex = index;
      if (stageCopy) stageCopy.textContent = stage.summary;
      if (stageCmd) stageCmd.textContent = stage.command;
      const progress = Math.round(((index + 1) / stages.length) * 100);
      if (meter) {
        meter.style.setProperty('--vf-meter-value', String(progress));
        meter.setAttribute('aria-valuenow', String(progress));
        meter.setAttribute('aria-valuetext', `Step ${index + 1}/${stages.length}`);
      }
      if (meterValue) meterValue.textContent = `Step ${index + 1}/${stages.length}`;
      root.dataset.bootStage = stage.id;
      syncNodeVisuals();
    };

    if (boot) {
      initStagePlayer({
        root: boot,
        stageCount: stages.length,
        onStage: applyStage,
        autoplayOnce: true,
        intervalMs: 2400,
      });
    }

    const layerTitle = root.querySelector('#ws-layer-inspector .vf-inspector__title');
    const layerCopy = root.querySelector<HTMLElement>('[data-layer-copy]');
    const layerLabel = root.querySelector<HTMLElement>('[data-layer-label]');
    const layerRepo = root.querySelector<HTMLElement>('[data-layer-repo]');

    const selectLayer = (id: string, announce = false) => {
      const layer = layers.find((l) => l.id === id) || layers[1];
      if (!layer) return;
      selectedLayerId = layer.id;
      if (layerTitle) layerTitle.textContent = layer.title;
      if (layerCopy) layerCopy.textContent = layer.description;
      if (layerLabel) layerLabel.textContent = layer.label;
      if (layerRepo) {
        layerRepo.textContent = layer.repo;
        layerRepo.hidden = !layer.repo;
      }
      syncNodeVisuals();
      if (announce && layerStatus) {
        layerStatus.textContent = `Responsibility selected: ${layer.title} — ${layer.subtitle}.`;
      }
    };

    layerRadios.forEach((input) => {
      input.addEventListener('change', () => {
        if (input.checked) selectLayer(input.value, true);
      });
    });
    root.querySelectorAll<SVGGElement>('[data-node]').forEach((g) => {
      g.style.cursor = 'pointer';
      g.addEventListener('click', () => {
        const id = g.dataset.node || '';
        layerRadios.find((input) => input.value === id)?.click();
      });
    });

    const profileTitle = root.querySelector('#ws-profile-inspector .vf-inspector__title');
    const profileCopy = root.querySelector<HTMLElement>('[data-profile-copy]');
    const profileGroups = root.querySelector<HTMLElement>('[data-profile-groups]');

    const selectProfile = (id: string) => {
      const profile = profiles.find((p) => p.id === id) || profiles[0];
      if (!profile || !profileGroups) return;
      if (profileTitle) profileTitle.textContent = profile.id;
      if (profileCopy) profileCopy.textContent = profile.description;
      if (machine) machine.dataset.profile = profile.id;
      root.dataset.profile = profile.id;
      clearChildren(profileGroups);
      if (profile.groups.length) {
        profile.groups.forEach((g) => {
          const code = document.createElement('code');
          code.className = 'ws-map__profile-token';
          code.textContent = g;
          profileGroups.appendChild(code);
        });
      } else {
        const span = document.createElement('span');
        span.className = 'ws-map__profile-empty';
        span.textContent = 'custom — answer every group prompt';
        profileGroups.appendChild(span);
      }
    };

    root.querySelectorAll<HTMLInputElement>('[data-profile]').forEach((input) => {
      input.addEventListener('change', () => {
        if (input.checked) selectProfile(input.value);
      });
    });

    selectLayer('workstation');
    if (layerControls) layerControls.disabled = false;
    applyStage(0);
  }

  document.querySelectorAll<HTMLElement>('[data-ws-map]').forEach(initMap);
</script>

<style>
  .ws-map {
    width: min(100% - 2 * var(--section-padding-x, 1.5rem), 78rem);
    margin: 0 auto;
    padding-block: clamp(1.25rem, 3vw, 2.5rem) clamp(2rem, 5vw, 3.5rem);
    padding-inline: clamp(0.75rem, 2vw, 1.5rem);
    border-inline: 1px solid color-mix(in srgb, var(--nest-cyan) 18%, transparent);
    background-color: color-mix(in srgb, var(--nest-midnight-950) 84%, transparent);
    /* Operations-room surface: faint horizontal rules behind the provisioning content. */
    background-image: repeating-linear-gradient(
      180deg,
      transparent 0,
      transparent 3.5rem,
      color-mix(in srgb, var(--nest-cyan) 4%, transparent) 3.5rem,
      color-mix(in srgb, var(--nest-cyan) 4%, transparent) calc(3.5rem + 1px)
    );
  }

  .ws-map__header {
    display: grid;
    gap: 0.45rem;
    max-inline-size: 62rem;
    padding: clamp(1.5rem, 4vw, 3.25rem) clamp(0.75rem, 3vw, 2rem);
    border-block: 1px solid color-mix(in srgb, var(--nest-cyan) 30%, transparent);
    border-inline-start: 2px solid var(--nest-cyan);
    background: linear-gradient(90deg, color-mix(in srgb, var(--nest-cyan) 8%, transparent), transparent 65%);
  }

  .ws-map__header-rail {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 0.5rem;
    margin-top: 1rem;
    font-family: var(--font-mono);
    font-size: 0.65rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--color-text-faint);
  }

  .ws-map__header-rail span {
    padding-top: 0.45rem;
    border-top: 1px solid color-mix(in srgb, var(--nest-cyan) 35%, transparent);
  }

  .ws-map__header-rail strong {
    display: block;
    margin-bottom: 0.2rem;
    color: var(--nest-cyan);
    font-size: 0.75rem;
  }

  .ws-map__health {
    background: var(--world-surface-tint);
  }

  .ws-map :global(.vf-dock__primary) {
    background: var(--world-accent);
    color: var(--color-text-on-accent, var(--nest-midnight-900));
  }

  .ws-map h1,
  .ws-map h2 {
    color: var(--color-text);
  }

  .ws-map__eyebrow {
    margin: 0 0 0.35rem;
    font-family: var(--font-mono);
    font-size: 0.68rem;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--world-accent-tertiary, var(--nest-sunset-orange));
  }

  .ws-map h1 {
    margin: 0;
    font-size: clamp(1.6rem, 3.5vw, 2.35rem);
    text-transform: uppercase;
    letter-spacing: 0.03em;
  }

  .ws-map__lede {
    margin: 0.45rem 0 0;
    color: var(--color-text-muted);
    max-inline-size: 54ch;
  }

  .ws-map__stage {
    padding: 0.75rem;
    min-height: 25rem;
    border-color: color-mix(in srgb, var(--nest-cyan) 58%, transparent);
    background:
      linear-gradient(90deg, color-mix(in srgb, var(--nest-cyan) 4%, transparent) 1px, transparent 1px),
      linear-gradient(color-mix(in srgb, var(--nest-violet) 4%, transparent) 1px, transparent 1px),
      radial-gradient(
        ellipse 80% 70% at 50% 35%,
        color-mix(in srgb, var(--nest-violet) 18%, transparent),
        transparent 72%
      ),
      var(--nest-midnight-950);
    background-size:
      2rem 2rem,
      2rem 2rem,
      auto,
      auto;
  }

  .ws-map > .vf-scene {
    grid-template-columns: 1fr;
    gap: 0;
  }

  .ws-map > .vf-scene > .ws-map__stage {
    border-block-end: 0;
  }

  .ws-map > .vf-scene > :global(.vf-inspector) {
    min-height: 0;
    border-block-start: 2px solid color-mix(in srgb, var(--nest-violet) 58%, transparent);
    border-inline-start: 0;
    clip-path: var(--clip-corner-sm);
  }

  .ws-map__svg {
    width: 100%;
    height: auto;
    display: block;
  }

  .ws-map__module {
    fill: color-mix(in srgb, var(--vf-node-accent, #22d3ee) 14%, #020617);
    stroke: color-mix(in srgb, var(--vf-node-accent, #22d3ee) 45%, transparent);
    stroke-width: 1.25;
    opacity: 0.45;
  }

  .ws-map__node.is-lit .ws-map__module {
    opacity: 1;
    fill: color-mix(in srgb, var(--vf-node-accent, #22d3ee) 28%, #020617);
    stroke: var(--vf-node-accent, #22d3ee);
  }

  .ws-map__node.is-selected .ws-map__module {
    stroke-width: 2.5;
    filter: drop-shadow(0 0 8px color-mix(in srgb, var(--vf-node-accent, #22d3ee) 55%, transparent));
  }

  [data-ws-machine][data-profile='minimal'] .ws-map__chassis {
    stroke: color-mix(in srgb, #94a3b8 45%, transparent);
  }

  [data-ws-machine][data-profile='technical'] .ws-map__chassis {
    stroke: color-mix(in srgb, var(--nest-cyan) 55%, transparent);
  }

  [data-ws-machine][data-profile='swarm'] .ws-map__chassis,
  [data-ws-machine][data-profile='full'] .ws-map__chassis {
    stroke: color-mix(in srgb, var(--nest-violet) 55%, transparent);
  }

  .ws-map__node-label {
    fill: var(--nest-paper, #f8fafc);
    font-size: 11px;
    font-family: var(--font-mono);
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

