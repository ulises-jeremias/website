---
/**
 * WorkTiers — visitor-oriented portfolio tiers (#404, ADR-003).
 *
 * The /projects (Work) page leads with four editorial tiers sourced from the
 * portfolio taxonomy, then the detailed grouped ledger continues below
 * (Catalog). Tier order: Featured → Maintained ecosystems → Selected work →
 * Labs/demos. No popularity ranking; roles distinguish ownership.
 */
import {
  getHomepagePortfolioAreas,
  portfolioEntries,
  getPortfolioEntriesByTier,
  type PortfolioEntry,
} from '@/data/portfolio.js';
import ProofStrip from '@/shared/components/ProofStrip.astro';

/** Featured areas share the homepage selector — facts are never retyped. */
const featured = getHomepagePortfolioAreas();

const maturityLabel: Record<string, string> = {
  established: 'established',
  active: 'active',
  early: 'early',
  preview: 'preview · not installable',
};

/** Maintained ecosystems: significant responsibility with external/org ownership. */
const maintained: PortfolioEntry[] = portfolioEntries.filter(
  (entry) =>
    entry.tier === 'flagship-component' &&
    entry.repositoryOwner !== 'ulises-jeremias' &&
    ['primary-maintainer', 'maintainer'].includes(entry.responsibility),
);

/** Selected work: narrower/earlier tooling with continuing relevance. */
const selected = getPortfolioEntriesByTier('selected-work');

/** Labs, demos, and supporting resources. */
const labs = [...getPortfolioEntriesByTier('lab-demo'), ...getPortfolioEntriesByTier('supporting-resource')];

const areaArt: Record<string, { src: string; code: string }> = {
  agentic: { src: 'island-agent', code: 'SYS / 01' },
  hornero: { src: 'island-dotfiles', code: 'SYS / 02' },
  'v-ecosystem': { src: 'island-v', code: 'LAB / 03' },
  'create-awesome': { src: 'island-assembly-workshop', code: 'FORGE / 04' },
};
---

<div class="work-tiers" data-testid="work-tiers">
  <section class="work-tiers__tier" aria-labelledby="work-featured-title">
    <header class="work-tiers__section-head">
      <div>
        <p class="work-tiers__eyebrow">Portfolio / four connected areas</p>
        <h2 id="work-featured-title" class="work-tiers__heading">
          Flagship systems
        </h2>
      </div>
      <p>Start with an area, then follow its component projects.</p>
    </header>
    <ul class="work-tiers__featured-grid" aria-label="Four flagship work areas">
      {featured.map((area, areaIndex) => (
        <li class="work-tiers__plate" data-area={area.id}>
          <div class="work-tiers__plate-art" aria-hidden="true">
            <span>{areaArt[area.id].code}</span>
            <img
              src={`/assets/nest/${areaArt[area.id].src}-sm.webp`}
              srcset={`/assets/nest/${areaArt[area.id].src}-192.webp 192w, /assets/nest/${areaArt[area.id].src}-sm.webp 440w`}
              sizes="(min-width: 480px) 144px, 72px"
              alt=""
              width="440"
              height="440"
              loading="lazy"
              decoding="async"
            />
          </div>
          <div class="work-tiers__plate-main">
            <p class="work-tiers__plate-index">
              <span>Area / {String(areaIndex + 1).padStart(2, '0')}</span>
              <span class="work-tiers__lens">{area.lens}</span>
            </p>
            <h3>
              <a href={area.path}>{area.title}</a>
            </h3>
            <p class="work-tiers__proposition">{area.proposition}</p>
            <ul class="work-tiers__members" aria-label={`${area.title} projects`}>
              {area.memberLinks.map((member, index) => (
                <li>
                  <span class="work-tiers__member-node" aria-hidden="true">
                    {String(index + 1).padStart(2, '0')}
                  </span>
                  <a href={member.path}>{member.title}</a>
                  {member.maturity && <span class="work-tiers__maturity">{maturityLabel[member.maturity]}</span>}
                </li>
              ))}
            </ul>
            <a class="work-tiers__enter" href={area.path}>
              Open area <span aria-hidden="true">↗</span>
            </a>
          </div>
        </li>
      ))}
    </ul>
    <p class="work-tiers__support">
      Building on one of these, or want to support one? <a href="/sponsor">Sponsorship and partnerships</a> are
      disclosed and scoped per area.
    </p>
  </section>

  {maintained.length > 0 && (
    <section class="work-tiers__tier" aria-labelledby="work-maintained-title">
      <h2 id="work-maintained-title" class="work-tiers__heading">
        Maintained ecosystems
      </h2>
      <p class="work-tiers__tier-note">
        Projects where I hold significant responsibility but external or organization ownership stays explicit.
      </p>
      <ul class="work-tiers__entry-list">
        {maintained.map((entry) => (
          <li>
            <a class="work-tiers__row" href={entry.path}>
              <strong>{entry.title}</strong>
              <span>
                {entry.roleLabel ?? entry.responsibility.replaceAll('-', ' ')} · {entry.repositoryOwner}/
                {entry.repositorySlug}
              </span>
            </a>
          </li>
        ))}
      </ul>
    </section>
  )}

  {selected.length > 0 && (
    <section class="work-tiers__tier" aria-labelledby="work-selected-title">
      <h2 id="work-selected-title" class="work-tiers__heading">
        Selected work
      </h2>
      <ul class="work-tiers__entry-list">
        {selected.map((entry) => (
          <li>
            <a class="work-tiers__row" href={entry.path}>
              <strong>{entry.title}</strong>
              <span>{entry.description}</span>
            </a>
            <ProofStrip entry={entry} label={`Contextual proof for ${entry.title}`} />
          </li>
        ))}
      </ul>
    </section>
  )}

  {labs.length > 0 && (
    <section class="work-tiers__tier" aria-labelledby="work-labs-title">
      <h2 id="work-labs-title" class="work-tiers__heading">
        Labs, demos &amp; references
      </h2>
      <p class="work-tiers__tier-note">Supporting material — useful context, not flagship products.</p>
      <ul class="work-tiers__entry-list">
        {labs.map((entry) => (
          <li>
            <a class="work-tiers__row" href={entry.path}>
              <strong>{entry.title}</strong>
              <span>{entry.description}</span>
            </a>
          </li>
        ))}
      </ul>
    </section>
  )}
</div>

<style>
  .work-tiers {
    display: grid;
    gap: 1.75rem;
    width: min(100% - 2 * var(--section-padding-x, 1rem), 74rem);
    margin: 0 auto;
    padding: 1.5rem clamp(0.75rem, 2vw, 1.5rem);
  }

  .work-tiers__heading {
    margin: 0 0 0.75rem;
    font-size: 1rem;
    letter-spacing: 0.05em;
    text-transform: uppercase;
  }

  .work-tiers__tier-note {
    margin: -0.4rem 0 0.75rem;
    font-size: 0.82rem;
    line-height: 1.5;
    color: var(--color-text-faint);
  }

  .work-tiers__featured-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 26rem), 1fr));
    gap: 0.8rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .work-tiers__support {
    margin: 0.9rem 0 0;
    color: var(--color-text-faint);
    font-size: 0.85rem;
  }

  .work-tiers__support a {
    color: var(--nest-pink);
  }

  .work-tiers__proposition {
    font-size: 0.86rem;
    line-height: 1.5;
    color: var(--color-text-muted);
  }

  .work-tiers__entry-list {
    display: grid;
    gap: 0.5rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .work-tiers__row {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.4rem 0.75rem;
    padding: 0.5rem 0.8rem;
    border: 1px solid color-mix(in srgb, var(--nest-cyan) 22%, transparent);
    border-radius: 8px;
  }

  .work-tiers__row span {
    font-size: 0.8rem;
    line-height: 1.45;
    color: var(--color-text-faint);
  }

  .work-tiers__tier:first-child {
    padding-block: 0.25rem 0.8rem;
    border-block-end: 1px solid color-mix(in srgb, var(--nest-sunset-orange) 22%, transparent);
  }

  .work-tiers__section-head {
    display: flex;
    align-items: end;
    justify-content: space-between;
    gap: 1rem;
    margin-bottom: 1rem;
    padding-bottom: 0.7rem;
    border-bottom: 1px dashed color-mix(in srgb, var(--nest-sunset-orange) 38%, transparent);
  }

  .work-tiers__section-head > p {
    max-width: 34ch;
    margin: 0;
    color: var(--color-text-faint);
    font-size: 0.8rem;
    text-align: right;
  }

  .work-tiers__eyebrow {
    margin: 0 0 0.25rem;
    color: var(--nest-sunset-orange);
    font-family: var(--font-mono);
    font-size: 0.65rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }

  .work-tiers__heading {
    margin-bottom: 0;
  }

  .work-tiers__featured-grid {
    position: relative;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 0;
    padding-top: 2.25rem;
  }

  .work-tiers__featured-grid::before {
    position: absolute;
    inset: 0 12.5% auto;
    height: 1px;
    content: '';
    background: linear-gradient(
      90deg,
      var(--nest-cyan),
      var(--nest-magenta) 36%,
      var(--nest-violet) 68%,
      var(--nest-sunset-orange)
    );
    opacity: 0.72;
  }

  .work-tiers__plate {
    --area-ink: var(--nest-cyan);
    position: relative;
    display: grid;
    grid-template-rows: auto auto 1fr;
    gap: 0.8rem;
    min-width: 0;
    padding: 0.25rem clamp(0.6rem, 1.3vw, 1.1rem) 0;
    border-inline-start: 1px solid color-mix(in srgb, var(--area-ink) 26%, transparent);
    background: linear-gradient(180deg, color-mix(in srgb, var(--area-ink) 5%, transparent), transparent 48%);
    transition:
      background-color 180ms ease,
      border-color 180ms ease;
  }

  .work-tiers__plate::before {
    position: absolute;
    inset: -1.9rem auto auto 50%;
    width: 0.7rem;
    height: 0.7rem;
    border: 1px solid var(--area-ink);
    background: var(--nest-midnight-950);
    box-shadow: 0 0 0 4px color-mix(in srgb, var(--area-ink) 10%, transparent);
    content: '';
    transform: translateX(-50%) rotate(45deg);
    transition:
      background-color 180ms ease,
      box-shadow 180ms ease;
  }

  .work-tiers__plate[data-area='hornero'] {
    --area-ink: var(--nest-magenta);
  }

  .work-tiers__plate[data-area='v-ecosystem'] {
    --area-ink: var(--nest-violet);
  }

  .work-tiers__plate[data-area='create-awesome'] {
    --area-ink: var(--nest-sunset-orange);
  }

  .work-tiers__plate:focus-within {
    border-color: var(--area-ink);
    background-color: color-mix(in srgb, var(--area-ink) 8%, transparent);
  }

  .work-tiers__plate:focus-within::before {
    background: var(--area-ink);
    box-shadow: 0 0 0 5px color-mix(in srgb, var(--area-ink) 16%, transparent);
  }

  .work-tiers__plate-art {
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    justify-content: space-between;
    gap: 0.5rem;
    min-width: 0;
    min-height: 9rem;
    padding: 0.1rem 0.15rem 0.7rem;
    color: var(--area-ink);
    font-family: var(--font-mono);
    font-size: 0.58rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  .work-tiers__plate-art img {
    position: absolute;
    inset: 0.3rem 0.25rem 0.6rem auto;
    display: block;
    width: min(76%, 9rem);
    height: 8.2rem;
    object-fit: contain;
    mix-blend-mode: screen;
    filter: drop-shadow(0 0 12px color-mix(in srgb, var(--area-ink) 24%, transparent));
    transition:
      filter 220ms ease,
      transform 260ms cubic-bezier(0.2, 0.8, 0.2, 1);
  }

  .work-tiers__plate:focus-within .work-tiers__plate-art img {
    filter: drop-shadow(0 0 16px color-mix(in srgb, var(--area-ink) 46%, transparent));
    transform: translateY(-3px);
  }

  .work-tiers__lens {
    max-width: 16ch;
    color: var(--color-text-faint);
    font-size: 0.54rem;
    font-weight: 400;
    letter-spacing: 0.04em;
    line-height: 1.3;
    text-align: right;
    text-transform: uppercase;
  }

  .work-tiers__plate-main {
    display: grid;
    align-content: start;
    gap: 0.55rem;
    min-width: 0;
  }

  .work-tiers__plate-index {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.3rem;
    margin: 0;
    color: var(--area-ink);
    font-family: var(--font-mono);
    font-size: 0.6rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  .work-tiers__plate-main h3 {
    margin: 0;
    font-size: 1.05rem;
    line-height: 1.25;
  }

  .work-tiers__plate-main h3 a {
    display: inline-flex;
    align-items: center;
    min-height: 2.75rem;
    color: var(--nest-paper);
    text-underline-offset: 0.2em;
  }

  .work-tiers__plate .work-tiers__proposition {
    margin: 0;
    font-size: 0.78rem;
    line-height: 1.45;
  }

  .work-tiers__plate .work-tiers__members {
    display: grid;
    gap: 0.2rem;
    margin: 0.15rem 0 0;
  }

  .work-tiers__plate .work-tiers__members li {
    display: grid;
    grid-template-columns: 1rem minmax(0, auto) minmax(0, 1fr);
    align-items: center;
    justify-content: start;
    gap: 0.25rem;
    min-width: 0;
    min-height: 2.75rem;
    border-top: 1px solid color-mix(in srgb, var(--area-ink) 18%, transparent);
    font-size: 0.72rem;
  }

  .work-tiers__member-node {
    color: var(--area-ink);
    font-family: var(--font-mono);
    font-size: 0.58rem;
  }

  .work-tiers__plate .work-tiers__members a {
    min-width: 0;
    color: var(--nest-cyan);
    text-underline-offset: 0.2em;
  }

  .work-tiers__plate .work-tiers__maturity {
    margin-inline-start: 0;
    color: var(--color-text-faint);
    font-size: 0.56rem;
  }

  .work-tiers__enter {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    justify-self: start;
    min-height: 2.75rem;
    margin-top: 0.1rem;
    color: var(--area-ink);
    font-family: var(--font-mono);
    font-size: 0.66rem;
    letter-spacing: 0.08em;
    text-decoration: none;
    text-transform: uppercase;
  }

  .work-tiers__enter:hover,
  .work-tiers__enter:focus-visible {
    text-decoration: underline;
    text-underline-offset: 0.25em;
  }

  .work-tiers__row {
    border-radius: 0;
  }

  @media (prefers-reduced-motion: reduce) {
    .work-tiers__plate,
    .work-tiers__plate::before,
    .work-tiers__plate-art img {
      transition: none;
    }
  }

  @media (width < 760px) {
    .work-tiers__featured-grid {
      grid-template-columns: minmax(0, 1fr);
      gap: 0.8rem;
      padding: 0 0 0 1.75rem;
    }

    .work-tiers__featured-grid::before {
      inset: 0.35rem auto 0 0.55rem;
      width: 1px;
      height: auto;
      background: linear-gradient(
        180deg,
        var(--nest-cyan),
        var(--nest-magenta) 36%,
        var(--nest-violet) 68%,
        var(--nest-sunset-orange)
      );
    }

    .work-tiers__plate {
      grid-template-columns: 6.5rem minmax(0, 1fr);
      grid-template-rows: auto;
      align-items: start;
      gap: 0 0.85rem;
      padding: 0 0 0.6rem;
      border-inline-start: 0;
      background: none;
    }

    .work-tiers__plate::before {
      inset: 0.65rem auto auto -1.55rem;
      width: 0.65rem;
      height: 0.65rem;
    }

    .work-tiers__plate-art {
      grid-row: 1 / span 2;
      min-height: 7rem;
      padding: 0.2rem 0.1rem;
      font-size: 0.52rem;
    }

    .work-tiers__plate-art img {
      inset: 1rem 0 1rem auto;
      width: 100%;
      height: 5.4rem;
    }

    .work-tiers__plate-main {
      padding-top: 0.1rem;
    }

    .work-tiers__plate-index {
      align-items: flex-start;
      flex-direction: column;
      gap: 0.2rem;
      font-size: 0.55rem;
    }

    .work-tiers__lens {
      max-width: 100%;
      text-align: left;
    }

    .work-tiers__plate .work-tiers__members li {
      grid-template-columns: 1rem minmax(0, 1fr);
      min-height: 2.75rem;
      padding-block: 0.25rem;
    }

    .work-tiers__plate .work-tiers__maturity {
      grid-column: 2;
    }
  }

  @media (width < 480px) {
    .work-tiers__section-head {
      align-items: start;
      flex-direction: column;
    }

    .work-tiers__section-head > p {
      text-align: left;
    }

    .work-tiers__plate-art img {
      width: min(100%, 4.5rem);
    }
  }

  @media (width < 380px) {
    .work-tiers__plate {
      grid-template-columns: minmax(0, 1fr);
      grid-template-rows: auto auto;
      gap: 0.5rem;
    }

    .work-tiers__plate-art {
      grid-row: auto;
      min-height: 5.2rem;
    }

    .work-tiers__plate-art img {
      inset: 0 0 0.1rem auto;
      width: min(100%, 5.2rem);
      height: 5.1rem;
    }

    .work-tiers__plate-main {
      padding-inline-end: 0.35rem;
    }
  }
</style>
