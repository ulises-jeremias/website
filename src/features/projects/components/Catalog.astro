---
import Archipelago from './Archipelago.astro';
import WorkTiers from './WorkTiers.astro';
import { getGroupedLedger, ledgerProjects } from '../data/index.js';
import { roleLabels, statusLabels, type Project } from '../types/index.js';

const groups = getGroupedLedger(ledgerProjects);
const groupOptions = groups.map((g) => ({ id: g.id, label: g.label, count: g.projects.length }));

function primaryHref(project: Project): string {
  return project.links[0]?.href ?? '#';
}

const verifiedDateFormatter = new Intl.DateTimeFormat('en-US', { dateStyle: 'medium', timeZone: 'UTC' });
const worldCount = ledgerProjects.filter((project) => project.visibility === 'world').length;
const archivedCount = ledgerProjects.filter((project) => project.status === 'archived').length;

function formatVerifiedDate(value: string): string {
  const date = new Date(value);
  return Number.isNaN(date.getTime()) ? value : verifiedDateFormatter.format(date);
}
---

<Archipelago />

<WorkTiers />

<section class="projects-ledger" data-reveal aria-labelledby="projects-ledger-title" data-testid="projects-ledger">
  <div class="projects-ledger__head">
    <div class="projects-ledger__head-copy">
      <p class="projects-ledger__eyebrow">Work · detailed ledger</p>
      <h2 id="projects-ledger-title">Grouped ledger</h2>
      <p class="projects-ledger__lede">
        Every project I own or maintain, grouped by ecosystem. Entries marked
        <span class="projects-ledger__world-tag">world</span> have a dedicated page on this site. No stars or download counts
        appear unless independently verified.
      </p>
    </div>

    <aside class="projects-ledger__readout" aria-label="Project ledger readout">
      <p class="projects-ledger__readout-kicker">Reading key</p>
      <dl>
        <div><dt>Records</dt><dd>{ledgerProjects.length}</dd></div>
        <div><dt>World pointers</dt><dd>{worldCount}</dd></div>
        <div><dt>Archived</dt><dd>{archivedCount}</dd></div>
      </dl>
    </aside>

    <form class="projects-ledger__controls" role="search" data-projects-search>
      <label class="projects-ledger__search">
        <span class="visually-hidden">Filter projects</span>
        <input type="search" name="q" placeholder="Filter by name, tag, role…" autocomplete="off" data-projects-query />
      </label>
      <label class="projects-ledger__group-filter">
        <span class="visually-hidden">Group</span>
        <select name="group" data-projects-group>
          <option value="">All groups</option>
          {
            groupOptions.map((g) => (
              <option value={g.id}>
                {g.label} ({g.count})
              </option>
            ))
          }
        </select>
      </label>
      <noscript>
        <p class="projects-ledger__noscript">
          Filtering enhances this page; group headings remain available without JS.
        </p>
      </noscript>
    </form>
  </div>

  {
    groups.map((bucket) => (
      <section
        class="projects-ledger__group"
        aria-labelledby={`group-${bucket.id}`}
        data-group={bucket.id}
        data-projects-group-section
      >
        <h3 id={`group-${bucket.id}`}>{bucket.label}</h3>
        <div class="projects-ledger__table">
          <div class="projects-ledger__row projects-ledger__row--head" aria-hidden="true">
            <span>Project</span>
            <span>Status</span>
            <span>Links</span>
          </div>
          {bucket.projects.map((p) => (
            <article
              class="projects-ledger__row"
              aria-labelledby={`project-${p.slug}-title`}
              data-status={p.status}
              data-visibility={p.visibility}
              data-testid="project-row"
              data-projects-row
              data-search={`${p.title} ${p.summary} ${p.tags.join(' ')} ${p.role} ${p.kind} ${p.slug}`}
            >
              <div>
                <h4 id={`project-${p.slug}-title`}>
                  <a href={primaryHref(p)}>{p.title}</a>
                  {p.visibility === 'world' ? <span class="projects-ledger__world-tag">world</span> : null}
                </h4>
                <div class="projects-ledger__meta">
                  <p class="projects-ledger__summary">{p.summary}</p>
                  {p.licenseNote ? <p class="projects-ledger__caution">{p.licenseNote}</p> : null}
                  {p.archivedNote ? <p class="projects-ledger__archived-note">{p.archivedNote}</p> : null}
                  <p class="projects-ledger__tags">
                    {p.tags.slice(0, 2).map((t) => (
                      <span>#{t}</span>
                    ))}
                  </p>
                </div>
              </div>
              <div>
                <span class={`projects-ledger__badge projects-ledger__badge--${p.status}`}>
                  {statusLabels[p.status]}
                </span>
                <span class="projects-ledger__kind">
                  {p.kind} · {roleLabels[p.role]} ·{' '}
                  <time datetime={p.lastVerified}>{formatVerifiedDate(p.lastVerified)}</time>
                </span>
              </div>
              <div class="projects-ledger__links">
                {p.links.map((l) => (
                  <a
                    href={l.href}
                    target={l.href.startsWith('http') ? '_blank' : undefined}
                    rel={l.href.startsWith('http') ? 'noopener noreferrer' : undefined}
                  >
                    {l.label}
                  </a>
                ))}
              </div>
            </article>
          ))}
        </div>
      </section>
    ))
  }

  <p class="projects-ledger__empty" data-projects-empty hidden>No projects match this filter.</p>
  <p class="visually-hidden" role="status" aria-atomic="true" data-projects-status>
    {ledgerProjects.length} projects shown.
  </p>
</section>

<script>
  const root = document.querySelector('[data-projects-search]');
  const ledger = document.querySelector('[data-testid="projects-ledger"]');
  if (root && ledger) {
    const query = root.querySelector('[data-projects-query]');
    const group = root.querySelector('[data-projects-group]');
    const rows = [...ledger.querySelectorAll('[data-projects-row]')];
    const sections = [...ledger.querySelectorAll('[data-projects-group-section]')];
    const empty = ledger.querySelector('[data-projects-empty]');
    const status = ledger.querySelector('[data-projects-status]');

    const apply = (updateUrl = true) => {
      const rawQuery = (query instanceof HTMLInputElement ? query.value : '').trim();
      const q = rawQuery.toLowerCase();
      const g = group instanceof HTMLSelectElement ? group.value : '';
      let visible = 0;

      for (const row of rows) {
        const hay = (row.getAttribute('data-search') ?? '').toLowerCase();
        const section = row.closest('[data-projects-group-section]');
        const groupId = section?.getAttribute('data-group') ?? '';
        const matchQ = !q || hay.includes(q);
        const matchG = !g || groupId === g;
        const show = matchQ && matchG;
        row.toggleAttribute('hidden', !show);
        if (show) visible += 1;
      }

      for (const section of sections) {
        const any = [...section.querySelectorAll('[data-projects-row]')].some((row) => !row.hasAttribute('hidden'));
        const groupId = section.getAttribute('data-group') ?? '';
        const groupOk = !g || groupId === g;
        section.toggleAttribute('hidden', !(any && groupOk));
      }

      empty?.toggleAttribute('hidden', visible > 0);
      if (status) status.textContent = `${visible} ${visible === 1 ? 'project' : 'projects'} shown.`;

      if (updateUrl) {
        const url = new URL(window.location.href);
        if (rawQuery) url.searchParams.set('q', rawQuery);
        else url.searchParams.delete('q');
        if (g) url.searchParams.set('group', g);
        else url.searchParams.delete('group');
        window.history.replaceState({}, '', url);
      }
    };

    root.addEventListener('input', () => apply());
    root.addEventListener('change', () => apply());

    const restoreFromUrl = () => {
      const params = new URL(window.location.href).searchParams;
      if (query instanceof HTMLInputElement) query.value = params.get('q') ?? '';
      if (group instanceof HTMLSelectElement) {
        const requested = params.get('group') ?? '';
        group.value = [...group.options].some((option) => option.value === requested) ? requested : '';
      }
      apply(false);
    };

    window.addEventListener('popstate', restoreFromUrl);
    restoreFromUrl();
  }
</script>

<style>
  .projects-ledger {
    width: min(100% - 2 * var(--section-padding-x), 74rem);
    margin: 0 auto;
    padding-block: 1.5rem 2.75rem;
  }

  .projects-ledger__head {
    display: grid;
    gap: 1.25rem;
    margin-bottom: 1.5rem;
  }

  .projects-ledger__head-copy {
    min-inline-size: 0;
  }

  .projects-ledger__readout {
    padding: 0.9rem 1rem;
    border: 1px solid color-mix(in srgb, var(--nest-cyan) 34%, transparent);
    background: color-mix(in srgb, var(--nest-midnight-950) 76%, transparent);
  }

  .projects-ledger__readout-kicker {
    margin: 0;
    color: var(--nest-cyan);
    font-family: var(--font-mono);
    font-size: 0.68rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }

  .projects-ledger__readout dl {
    display: grid;
    gap: 0.45rem;
    margin: 0.65rem 0 0;
  }

  .projects-ledger__readout dl div {
    display: flex;
    justify-content: space-between;
    gap: 0.75rem;
    padding-top: 0.4rem;
    border-top: 1px solid color-mix(in srgb, var(--nest-cyan) 22%, transparent);
    font-family: var(--font-mono);
    font-size: 0.7rem;
  }

  .projects-ledger__readout dt,
  .projects-ledger__readout dd {
    margin: 0;
  }

  .projects-ledger__readout dt {
    color: var(--color-text-muted);
    text-transform: uppercase;
  }

  .projects-ledger__readout dd {
    color: var(--color-text);
  }

  @media (width >= 900px) {
    .projects-ledger__head {
      grid-template-columns: minmax(0, 1.5fr) minmax(16rem, 0.9fr);
      align-items: end;
    }
  }

  .projects-ledger__eyebrow {
    margin: 0 0 var(--space-2);
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--nest-sunset-orange);
  }

  .projects-ledger__head h2 {
    margin: 0 0 var(--space-3);
    font-size: clamp(1.35rem, 2.8vw, 1.85rem);
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }

  .projects-ledger__lede {
    margin: 0;
    max-inline-size: 68ch;
    color: var(--color-text-muted);
  }

  .projects-ledger__controls {
    display: grid;
    gap: 0.65rem;
  }

  .projects-ledger__search input,
  .projects-ledger__group-filter select {
    width: 100%;
    min-height: var(--touch-min, 44px);
    padding: 0.7rem 0.85rem;
    border: 1px solid var(--color-border);
    background: color-mix(in srgb, var(--nest-midnight-900) 92%, transparent);
    color: var(--color-text);
    font: inherit;
    clip-path: var(--clip-corner-sm);
  }

  .projects-ledger__search input:focus-visible,
  .projects-ledger__group-filter select:focus-visible {
    outline: 2px solid var(--nest-cyan);
    outline-offset: 2px;
  }

  .projects-ledger__noscript {
    margin: 0;
    font-size: 0.78rem;
    color: var(--color-text-faint);
  }

  .projects-ledger__group {
    margin-bottom: 1.75rem;
  }

  .projects-ledger__group h3 {
    margin: 0 0 0.75rem;
    font-size: 1.02rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--nest-cyan);
  }

  .projects-ledger__table {
    display: grid;
    border: 1px solid var(--color-border);
    background: color-mix(in srgb, var(--nest-midnight-900) 92%, transparent);
    clip-path: var(--clip-corner-md);
  }

  .projects-ledger__row {
    display: grid;
    grid-template-columns: minmax(14rem, 2.6fr) 1.1fr 0.9fr;
    gap: 0.75rem;
    padding: 0.85rem 1rem;
    border-block-end: 1px solid color-mix(in srgb, var(--color-border) 80%, transparent);
  }

  .projects-ledger__row:last-child {
    border-block-end: 0;
  }

  .projects-ledger__row--head {
    font-family: var(--font-mono);
    font-size: 0.68rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--color-text-faint);
    background: color-mix(in srgb, var(--nest-violet) 8%, transparent);
  }

  .projects-ledger__row h4 {
    margin: 0 0 0.25rem;
    font-size: 0.98rem;
    display: flex;
    flex-wrap: wrap;
    gap: 0.45rem;
    align-items: center;
  }

  .projects-ledger__row h4 a {
    color: inherit;
    text-decoration: none;
  }

  .projects-ledger__row h4 a:hover,
  .projects-ledger__row h4 a:focus-visible {
    color: var(--nest-cyan);
  }

  .projects-ledger__row h4 a:focus-visible {
    outline: 2px solid var(--color-focus);
    outline-offset: 2px;
  }

  .projects-ledger__world-tag {
    font-family: var(--font-mono);
    font-size: 0.62rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--nest-pink);
    border: 1px solid color-mix(in srgb, var(--nest-pink) 40%, transparent);
    padding: 0.1rem 0.35rem;
  }

  .projects-ledger__row p {
    margin: 0;
    color: var(--color-text-muted);
    font-size: 0.86rem;
  }

  .projects-ledger__caution {
    margin-block-start: 0.35rem !important;
    color: var(--nest-sunset-orange) !important;
    font-size: 0.8rem !important;
  }

  .projects-ledger__archived-note {
    margin-block-start: 0.35rem !important;
    font-style: italic;
    color: var(--color-text-faint) !important;
  }

  .projects-ledger__tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.35rem;
    margin-block-start: 0.35rem !important;
    font-family: var(--font-mono);
    font-size: 0.68rem;
    color: var(--color-text-faint);
  }

  .projects-ledger__metrics {
    color: var(--nest-cyan);
  }

  .projects-ledger__kind {
    font-size: 0.82rem;
    color: var(--color-text-muted);
  }

  .projects-ledger__badge {
    display: inline-flex;
    padding: 0.2rem 0.45rem;
    border: 1px solid var(--color-border);
    font-family: var(--font-mono);
    font-size: 0.68rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .projects-ledger__badge--active {
    border-color: color-mix(in srgb, var(--nest-cyan) 50%, transparent);
    color: var(--nest-cyan);
  }

  .projects-ledger__badge--maintained {
    border-color: color-mix(in srgb, var(--nest-pink) 45%, transparent);
    color: var(--nest-pink);
  }

  .projects-ledger__badge--experimental {
    border-color: color-mix(in srgb, var(--nest-sunset-orange) 45%, transparent);
    color: var(--nest-sunset-orange);
  }

  .projects-ledger__badge--archived {
    color: var(--color-text-faint);
  }

  .projects-ledger__links {
    display: flex;
    flex-wrap: wrap;
    gap: 0.45rem;
  }

  .projects-ledger__links a {
    display: inline-flex;
    align-items: center;
    min-height: var(--touch-min, 44px);
    font-family: var(--font-mono);
    font-size: 0.72rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--nest-cyan);
    text-decoration: none;
  }

  .projects-ledger__links a:focus-visible {
    outline: 2px solid var(--nest-cyan);
    outline-offset: 2px;
  }

  .projects-ledger__empty {
    margin: 1rem 0 0;
    color: var(--color-text-faint);
  }

  .visually-hidden {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }

  @media (width < 900px) {
    .projects-ledger__row--head {
      display: none;
    }

    .projects-ledger__row {
      grid-template-columns: 1fr;
      gap: 0.4rem;
    }
  }
</style>
