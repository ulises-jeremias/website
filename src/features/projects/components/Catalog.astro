---
import { activeProjects, archivedProjects } from '../data/index.js';
import { statusLabels } from '../types/index.js';
---

<section class="projects-hero" aria-labelledby="projects-hero-title" data-testid="projects-hero">
  <p class="projects-hero__eyebrow">Epic M · Projects · curated catalog</p>
  <h1 id="projects-hero-title" class="projects-hero__title">Projects — curated, not auto-scraped</h1>
  <p class="projects-hero__lead">Proyectos que no necesitan mundo dedicado. Curaduría manual, fuente + fecha verificada, estados con texto (no solo color) y tratamiento sutil para archivados.</p>
</section>

<section class="projects-grid" aria-labelledby="projects-active-title">
  <h2 id="projects-active-title">Active &amp; maintained</h2>
  <div class="projects-grid__list">
    {activeProjects.map((p) => (
      <article class="project-card" data-status={p.status} data-testid="project-card">
        <header class="project-card__head">
          <h3 class="project-card__title">{p.title}</h3>
          <span class={`project-card__badge project-card__badge--${p.status}`} aria-label={`Status ${statusLabels[p.status]}`}>{statusLabels[p.status]}</span>
        </header>
        <p class="project-card__summary">{p.summary}</p>
        <div class="project-card__meta">
          <span class="project-card__kind">{p.kind}</span> · <span>{p.role}</span>
          {p.stars ? <span> · {p.stars}★</span> : null}
          <span> · verified {p.lastVerified}</span>
        </div>
        <div class="project-card__tags">
          {p.tags.map((t) => (
            <span class="project-card__tag">#{t}</span>
          ))}
        </div>
        <div class="project-card__links">
          {p.links.map((l) => (
            <a href={l.href} target={l.href.startsWith('http') ? '_blank' : undefined} rel={l.href.startsWith('http') ? 'noreferrer' : undefined}>{l.label} →</a>
          ))}
        </div>
      </article>
    ))}
  </div>
</section>

{archivedProjects.length > 0 && (
  <section class="projects-archived" aria-labelledby="projects-archived-title">
    <h2 id="projects-archived-title">Archived — preserved</h2>
    <p class="projects-archived__note">No ocultos, pero distinguido con opacidad y nota. Sin inventar claims.</p>
    <div class="projects-grid__list projects-grid__list--archived">
      {archivedProjects.map((p) => (
        <article class="project-card project-card--archived" data-status={p.status}>
          <header class="project-card__head">
            <h3 class="project-card__title">{p.title}</h3>
            <span class={`project-card__badge project-card__badge--${p.status}`}>{statusLabels[p.status]}</span>
          </header>
          <p class="project-card__summary">{p.summary}</p>
          {p.archivedNote ? <p class="project-card__archived-note"><em>{p.archivedNote}</em></p> : null}
          <div class="project-card__links">
            {p.links.map((l) => (
              <a href={l.href}>{l.label} →</a>
            ))}
          </div>
        </article>
      ))}
    </div>
  </section>
)}

<style>
  .projects-hero { padding: var(--space-8) 0; border-bottom: 1px solid var(--color-border); }
  .projects-hero__eyebrow { font-size: 0.8rem; letter-spacing: 0.08em; text-transform: uppercase; color: var(--color-muted); margin: 0 0 var(--space-2); }
  .projects-hero__title { font-size: 2.2rem; line-height: 1.1; margin: 0 0 var(--space-2); }
  .projects-hero__lead { color: var(--color-muted); max-width: 70ch; margin: 0; }
  .projects-grid { margin: var(--space-8) 0; }
  .projects-grid h2 { font-size: 1.2rem; margin-bottom: var(--space-3); }
  .projects-grid__list { display: grid; gap: var(--space-3); }
  @media (min-width: 800px) { .projects-grid__list { grid-template-columns: repeat(2, 1fr); } }
  @media (min-width: 1200px) { .projects-grid__list { grid-template-columns: repeat(3, 1fr); } }
  .project-card { padding: var(--space-3); border: 1px solid var(--color-border); border-radius: 10px; background: var(--color-surface); }
  .project-card--archived { opacity: 0.85; background: color-mix(in srgb, var(--color-surface) 80%, var(--color-border)); }
  .project-card__head { display: flex; justify-content: space-between; align-items: center; gap: var(--space-2); }
  .project-card__title { font-size: 1rem; margin: 0; }
  .project-card__badge { font-size: 0.65rem; text-transform: uppercase; letter-spacing: 0.05em; padding: 0.2rem 0.5rem; border-radius: 999px; border: 1px solid var(--color-border); }
  .project-card__badge--active { background: #ECFDF5; color: #065F46; border-color: #6EE7B7; }
  .project-card__badge--maintained { background: #EFF6FF; color: #1E40AF; border-color: #93C5FD; }
  .project-card__badge--experimental { background: #FFFBEB; color: #92400E; border-color: #FCD34D; }
  .project-card__badge--archived { background: #F3F4F6; color: #374151; border-color: #D1D5DB; }
  .project-card__summary { color: var(--color-muted); font-size: 0.9rem; margin: var(--space-2) 0; }
  .project-card__meta { font-size: 0.8rem; color: var(--color-muted); }
  .project-card__tags { display: flex; gap: 0.4rem; flex-wrap: wrap; margin-top: var(--space-2); }
  .project-card__tag { font-size: 0.75rem; background: var(--color-surface); border: 1px solid var(--color-border); padding: 0.15rem 0.4rem; border-radius: 999px; }
  .project-card__links { margin-top: var(--space-2); font-size: 0.85rem; display: flex; gap: var(--space-2); }
  .project-card__archived-note { font-size: 0.85rem; color: var(--color-muted); margin: var(--space-1) 0; }
  .projects-archived { margin-top: var(--space-8); }
  .projects-archived__note { color: var(--color-muted); font-size: 0.9rem; }
</style>
