---
import { ledgerProjects, worldPointerProjects } from '../data/index.js';
import { groupLabels } from '../types/index.js';

const islandByWorld: Record<string, string> = {
  dotfiles: 'island-dotfiles',
  workstation: 'island-workstation',
  toolkit: 'island-agent',
  v: 'island-v',
  'create-awesome': 'island-scaffold',
};

const islands = worldPointerProjects.map((project, index) => ({
  ...project,
  island: islandByWorld[project.worldId ?? ''] ?? 'island-projects',
  number: String(index + 1).padStart(2, '0'),
  href: project.links.find((l) => l.kind === 'world')?.href ?? project.links[0]?.href ?? '/projects',
}));

const groupCount = new Set(ledgerProjects.map((project) => project.group)).size;
---

<section class="archipelago" aria-labelledby="archipelago-title" data-testid="projects-archipelago">
  <header class="archipelago__header">
    <div class="archipelago__intro">
      <p class="archipelago__eyebrow">Projects · archive index</p>
      <h1 id="archipelago-title">Project archive</h1>
      <p class="archipelago__lede">
        Start with the project worlds, then read the curated detail and archived work in the ledger below. Links are the
        source of truth; no popularity ranking is implied.
      </p>
    </div>
    <aside class="archipelago__readout" aria-label="Project archive readout">
      <p class="archipelago__readout-kicker">Archive readout</p>
      <dl>
        <div><dt>World pointers</dt><dd>{islands.length}</dd></div>
        <div><dt>Groups represented</dt><dd>{groupCount}</dd></div>
        <div><dt>Next record</dt><dd>Grouped ledger</dd></div>
      </dl>
    </aside>
  </header>

  <p class="archipelago__index-note">01–{String(islands.length).padStart(2, '0')} · Dedicated project worlds</p>

  <ul class="archipelago__map" role="list">
    {
      islands.map((island) => (
        <li class="archipelago__island" data-group={island.group}>
          <a class="archipelago__link" href={island.href} data-testid="archipelago-island">
            <span class="archipelago__num" aria-hidden="true">
              {island.number}
            </span>
            <img
              class="archipelago__art"
              src={`/assets/nest/${island.island}-sm.webp`}
              alt=""
              width="160"
              height="120"
              loading="lazy"
              decoding="async"
            />
            <span class="archipelago__label">
              <span class="archipelago__title">{island.title}</span>
              <span class="archipelago__group">{groupLabels[island.group]}</span>
            </span>
          </a>
        </li>
      ))
    }
  </ul>

  <svg class="archipelago__constellation" viewBox="0 0 100 20" aria-hidden="true" focusable="false">
    <path
      d="M8 12 C 20 4, 30 16, 42 10 S 70 4, 92 12"
      fill="none"
      stroke="currentColor"
      stroke-width="0.35"
      stroke-dasharray="1.2 1.4"></path>
    {[8, 28, 48, 68, 88].map((x, i) => <circle cx={x} cy={i % 2 === 0 ? 11 : 9} r="0.7" fill="currentColor" />)}
  </svg>
</section>

<style>
  .archipelago {
    width: min(100% - 2 * var(--section-padding-x), 74rem);
    margin: 0 auto;
    padding-block: clamp(1.5rem, 4vw, 2.75rem) 0.5rem;
    padding-inline: clamp(0.75rem, 2vw, 1.5rem);
    border-inline: 1px solid color-mix(in srgb, var(--nest-sunset-orange) 18%, transparent);
    background:
      linear-gradient(90deg, color-mix(in srgb, var(--nest-sunset-orange) 5%, transparent), transparent 34%),
      color-mix(in srgb, var(--nest-midnight-950) 68%, transparent);
  }

  .archipelago__header {
    display: grid;
    gap: 1.25rem;
    padding: clamp(1.25rem, 3vw, 2.5rem) clamp(0.75rem, 3vw, 2rem);
    border-block: 1px solid color-mix(in srgb, var(--nest-sunset-orange) 32%, transparent);
    border-inline-start: 2px solid var(--nest-sunset-orange);
    background: linear-gradient(90deg, color-mix(in srgb, var(--nest-sunset-orange) 7%, transparent), transparent 70%);
  }

  @media (min-width: 820px) {
    .archipelago__header {
      grid-template-columns: minmax(0, 1.3fr) minmax(17rem, 0.7fr);
      align-items: end;
    }
  }

  .archipelago__readout {
    padding: 0.9rem 1rem;
    border: 1px solid color-mix(in srgb, var(--nest-cyan) 38%, transparent);
    background: color-mix(in srgb, var(--nest-midnight-950) 78%, transparent);
  }

  .archipelago__readout-kicker,
  .archipelago__index-note {
    margin: 0;
    color: var(--nest-cyan);
    font-family: var(--font-mono);
    font-size: 0.68rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }

  .archipelago__readout dl {
    display: grid;
    gap: 0.45rem;
    margin: 0.65rem 0 0;
  }

  .archipelago__readout dl div {
    display: flex;
    justify-content: space-between;
    gap: 0.75rem;
    padding-top: 0.4rem;
    border-top: 1px solid color-mix(in srgb, var(--nest-cyan) 22%, transparent);
    font-family: var(--font-mono);
    font-size: 0.7rem;
  }

  .archipelago__readout dt,
  .archipelago__readout dd {
    margin: 0;
  }

  .archipelago__readout dt {
    color: var(--color-text-muted);
    text-transform: uppercase;
  }

  .archipelago__readout dd {
    color: var(--color-text);
    text-align: right;
  }

  .archipelago__index-note {
    margin-top: 1.5rem;
    padding-bottom: 0.55rem;
    border-bottom: 1px dashed var(--color-border);
    color: var(--nest-sunset-orange);
  }

  .archipelago__eyebrow {
    margin: 0 0 var(--space-2);
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--nest-sunset-orange);
  }

  .archipelago__intro h1 {
    margin: 0 0 var(--space-3);
    font-size: clamp(1.55rem, 3.4vw, 2.15rem);
    letter-spacing: 0.02em;
    text-transform: uppercase;
  }

  .archipelago__lede {
    margin: 0;
    max-inline-size: 68ch;
    color: var(--color-text-muted);
  }

  .archipelago__map {
    list-style: none;
    margin: 0.85rem 0 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(5, minmax(0, 1fr));
    gap: 0.85rem;
  }

  .archipelago__island:nth-child(even) {
    margin-block-start: 1.25rem;
  }

  .archipelago__link {
    display: grid;
    gap: 0.45rem;
    color: inherit;
    text-decoration: none;
    padding: 0.35rem 0.15rem 0.55rem;
    min-block-size: var(--touch-min, 44px);
    border: 0;
    background: transparent;
    position: relative;
    transition:
      transform 160ms ease,
      color 160ms ease;
  }

  .archipelago__link:hover,
  .archipelago__link:focus-visible {
    transform: translateY(-3px);
    color: var(--nest-cyan);
  }

  .archipelago__link:focus-visible {
    outline: 2px solid var(--color-focus);
    outline-offset: 3px;
  }

  .archipelago__link:focus-visible .archipelago__art {
    outline: 2px solid var(--nest-cyan);
    outline-offset: 3px;
  }

  .archipelago__num {
    position: absolute;
    inset: 0.45rem auto auto 0.55rem;
    font-family: var(--font-mono);
    font-size: 0.65rem;
    letter-spacing: 0.12em;
    color: var(--color-text-faint);
  }

  .archipelago__art {
    width: min(100%, 9rem);
    height: auto;
    margin-inline: auto;
    pointer-events: none;
  }

  .archipelago__label {
    display: grid;
    gap: 0.15rem;
  }

  .archipelago__title {
    font-size: 0.92rem;
    letter-spacing: 0.03em;
  }

  .archipelago__group {
    font-family: var(--font-mono);
    font-size: 0.68rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--nest-cyan);
  }

  .archipelago__constellation {
    display: block;
    width: min(100%, 42rem);
    margin: 1.25rem auto 0;
    color: color-mix(in srgb, var(--nest-violet) 55%, transparent);
  }

  @media (width < 960px) {
    .archipelago__map {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }

  @media (width < 640px) {
    .archipelago__map {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .archipelago__island:nth-child(even) {
      margin-block-start: 0;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .archipelago__link {
      transition: none;
    }

    .archipelago__link:hover,
    .archipelago__link:focus-visible {
      transform: none;
    }
  }
</style>
