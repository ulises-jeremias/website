---
/**
 * Hero — Create Awesome family
 */
import { familyIntro } from '../data/index.js';
---

<section class="ca-hero" aria-labelledby="ca-hero-title" data-testid="ca-hero">
  <div class="ca-hero__copy">
    <p class="ca-hero__eyebrow">Epic J · Create Awesome · family hub</p>
    <h1 id="ca-hero-title" class="ca-hero__title">{familyIntro.title}</h1>
    <p class="ca-hero__lead">{familyIntro.lead}</p>
    <p class="ca-hero__principle"><em>{familyIntro.principle}</em></p>
  </div>
  <div class="ca-hero__visual" aria-hidden="true">
    <div class="ca-hero__stack">
      <span class="ca-hero__chip ca-hero__chip--amber">template</span>
      <span class="ca-hero__plus">+</span>
      <span class="ca-hero__chip ca-hero__chip--teal">addons</span>
      <span class="ca-hero__arrow">→</span>
      <span class="ca-hero__chip ca-hero__chip--ink">app</span>
    </div>
  </div>
</section>

<style>
  .ca-hero {
    display: grid;
    gap: var(--space-6);
    padding: var(--space-8) 0;
    border-bottom: 1px solid var(--color-border);
  }
  @media (min-width: 900px) {
    .ca-hero {
      grid-template-columns: 1.2fr 0.8fr;
      align-items: center;
    }
  }
  .ca-hero__eyebrow {
    font-size: 0.8rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--color-text-muted);
    margin: 0 0 var(--space-2);
  }
  .ca-hero__title {
    font-size: 2.4rem;
    line-height: 1.1;
    margin: 0 0 var(--space-3);
  }
  .ca-hero__lead {
    font-size: 1.05rem;
    color: var(--color-text-muted);
    margin: 0 0 var(--space-2);
    max-width: 60ch;
  }
  .ca-hero__principle {
    font-size: 0.95rem;
    color: var(--color-text-muted);
    margin: 0;
  }
  .ca-hero__visual {
    display: grid;
    place-items: center;
  }
  .ca-hero__stack {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    flex-wrap: wrap;
    justify-content: center;
    padding: var(--space-4);
    border: 1px dashed var(--color-border);
    border-radius: 12px;
    background: var(--color-surface);
  }
  .ca-hero__chip {
    padding: 0.35rem 0.7rem;
    border-radius: 999px;
    font-size: 0.85rem;
    font-weight: 600;
    border: 1px solid var(--color-border);
  }
  .ca-hero__chip--amber {
    background: color-mix(in srgb, var(--nest-sunset-orange) 16%, var(--nest-midnight-900));
    border-color: color-mix(in srgb, var(--nest-sunset-orange) 45%, transparent);
    color: var(--nest-sunset-orange);
  }
  .ca-hero__chip--teal {
    background: color-mix(in srgb, var(--nest-cyan) 14%, var(--nest-midnight-900));
    border-color: color-mix(in srgb, var(--nest-cyan) 45%, transparent);
    color: var(--nest-cyan);
  }
  .ca-hero__chip--ink {
    background: var(--world-accent);
    color: var(--color-text-on-accent);
    border-color: var(--world-accent-strong);
  }
  .ca-hero__plus,
  .ca-hero__arrow {
    font-weight: 700;
    color: var(--color-text-muted);
  }
</style>
