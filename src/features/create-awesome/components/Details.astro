---
import { compositionExamples, comparisonRows, contributionSteps, distributionChannels } from '../data/index.js';
---

<section class="ca-details" data-testid="ca-details">
  <div class="ca-block">
    <h2>Composition</h2>
    <p class="ca-muted">Not opaque scaffolding — it composes real files. Verifiable examples:</p>
    <div class="ca-examples">
      {
        compositionExamples.map((e) => (
          <div class="ca-example">
            <h3>
              {e.title} <span class="ca-chip">{e.variant}</span>
            </h3>
            <p class="ca-muted">
              template <code>{e.template}</code> + addons <code>{e.addons.join(', ')}</code>
            </p>
            <pre>
              <code>{e.command}</code>
            </pre>
          </div>
        ))
      }
    </div>
  </div>

  <div class="ca-block">
    <h2>Distribution</h2>
    <ul class="ca-channels">
      {
        distributionChannels.map((c) => (
          <li>
            <strong>{c.label}</strong> <code>{c.command}</code> <span class="ca-muted">— {c.note}</span>
          </li>
        ))
      }
    </ul>
  </div>

  <div class="ca-block">
    <h2>Quick comparison</h2>
    <div class="ca-table-wrap">
      <table class="ca-table">
        <thead><tr><th>Feature</th><th>Node</th><th>Python</th><th>V</th></tr></thead>
        <tbody>
          {
            comparisonRows.map((r) => (
              <tr>
                <>
                  <td>{r.feature}</td>
                  <td>{r.node}</td>
                  <td>{r.python}</td>
                  <td>{r.v}</td>
                </>
              </tr>
            ))
          }
        </tbody>
      </table>
    </div>
  </div>

  <div class="ca-block">
    <h2>How to contribute</h2>
    <ol class="ca-steps">
      {
        contributionSteps.map((s) => (
          <li>
            <strong>
              {s.step}. {s.title}
            </strong>{' '}
            — {s.description}
            {s.href ? (
              <span>
                {' '}
                <a href={s.href} target="_blank" rel="noreferrer">
                  →
                </a>
              </span>
            ) : null}
          </li>
        ))
      }
    </ol>
    <p class="ca-muted">
      Build-time sync: catalog lives in <code>cna-templates / cpa-templates / cva-templates</code>, the site just
      composes. No duplication.
    </p>
  </div>

  <div class="ca-block ca-community">
    <h2>Community</h2>
    <p>
      Create Awesome sits inside the shared <a href="/community">Digital Nest community</a> — HorneroConfig, agentic tooling,
      V ecosystem work, and incubating experiments. Discord is the workshop for the whole nest, not a Create-Awesome-only
      server.
    </p>
    <p class="ca-muted">
      <a href="/community">Community workshop →</a> ·
      <a href="https://discord.gg/bR5VyATgka" target="_blank" rel="noreferrer">Discord invite ↗</a>
    </p>
  </div>
</section>

<style>
  .ca-details {
    margin: var(--space-8) 0;
    display: grid;
    gap: var(--space-8);
    max-width: 100%;
    min-width: 0;
  }
  .ca-block {
    max-width: 100%;
    min-width: 0;
  }
  .ca-block h2 {
    font-size: 1.3rem;
    margin-bottom: var(--space-2);
  }
  .ca-muted {
    color: var(--color-text-muted);
    font-size: 0.9rem;
  }
  .ca-examples {
    display: grid;
    gap: var(--space-3);
    max-width: 100%;
    min-width: 0;
  }
  @media (min-width: 800px) {
    .ca-examples {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }
  .ca-example {
    min-width: 0;
    padding: var(--space-3);
    border: 1px solid var(--color-border);
    border-radius: 10px;
    background: var(--color-surface);
  }
  .ca-example h3 {
    font-size: 0.95rem;
    margin: 0 0 var(--space-1);
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }
  .ca-chip {
    font-size: 0.65rem;
    text-transform: uppercase;
    padding: 0.15rem 0.4rem;
    border-radius: 999px;
    background: var(--color-surface);
    border: 1px solid var(--color-border);
  }
  .ca-example pre {
    margin: var(--space-2) 0 0;
    padding: var(--space-2);
    background: var(--nest-midnight-950);
    color: var(--nest-paper);
    border-radius: 8px;
    font-size: 0.75rem;
    overflow-x: auto;
    white-space: pre-wrap;
    overflow-wrap: anywhere;
  }
  .ca-channels {
    display: grid;
    gap: 0.5rem;
    padding-left: 1.1rem;
    max-width: 100%;
    min-width: 0;
  }
  .ca-channels li {
    overflow-wrap: anywhere;
  }
  .ca-channels li code {
    font-size: 0.8rem;
    white-space: pre-wrap;
    overflow-wrap: anywhere;
  }
  .ca-table-wrap {
    overflow-x: auto;
    border: 1px solid var(--color-border);
    border-radius: 10px;
    max-width: 100%;
  }
  .ca-table {
    width: 100%;
    border-collapse: collapse;
    font-size: 0.9rem;
  }
  .ca-table th,
  .ca-table td {
    padding: 0.6rem 0.8rem;
    border-bottom: 1px solid var(--color-border);
    text-align: left;
  }
  .ca-table th {
    background: var(--color-surface);
    font-size: 0.8rem;
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }
  .ca-steps {
    display: grid;
    gap: 0.5rem;
    padding-left: 1.2rem;
  }
  .ca-community p {
    max-width: 70ch;
    line-height: 1.6;
  }
  .ca-community a {
    color: var(--world-accent-strong);
    font-weight: 600;
  }
</style>
