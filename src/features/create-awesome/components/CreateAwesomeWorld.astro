---
import FlagshipProvenance from '@/shared/components/FlagshipProvenance.astro';
import { SceneInspector, WorldDock } from '@/shared/components/visual';
import '@/shared/components/visual/visual.css';
import Composer from './Composer.astro';
import Variants from './Variants.astro';
import {
  catalogTotals,
  comparisonRows,
  compositionExamples,
  contributionSteps,
  distributionChannels,
  familyIntro,
  variants,
} from '../data/index.js';

const sourceById = {
  node: 'cna-templates',
  python: 'cpa-templates',
  v: 'cva-templates',
  rust: 'cra-templates',
} as const;

const stations = variants.map((v) => ({
  id: v.id,
  label: v.label,
  title: v.title,
  status: v.status,
  description: v.description,
  install: v.install,
  href: v.href,
  repo: v.repo,
  accent: v.accentLight,
  templates: catalogTotals[v.id].templates,
  addons: catalogTotals[v.id].addons,
  source: sourceById[v.id],
}));

const stationsJson = JSON.stringify(stations);
const defaultStation = stations[0]!;

const lineModules = [
  { id: 'runtime', label: 'Runtime', hint: 'Node · Python · V · Rust' },
  { id: 'template', label: 'Template', hint: 'starter shape' },
  { id: 'addons', label: 'Addons', hint: 'optional slices' },
  { id: 'app', label: 'App', hint: 'real files you own' },
];
---

<section
  class="ca-world"
  aria-labelledby="ca-world-title"
  data-ca-world
  data-ca-enhanced="false"
  data-stations={stationsJson}
>
  <header class="ca-world__hero">
    <div class="ca-world__hero-copy">
      <p class="ca-world__eyebrow">Create Awesome · assembly line</p>
      <h1 id="ca-world-title">{familyIntro.title}</h1>
      <p class="ca-world__problem">Choose a runtime, starter and compatible addons to build your project.</p>
      <p class="ca-world__lede">{familyIntro.principle}</p>
      <a class="ca-world__compose-link" href="#ca-composer-title">
        <span>Build a command</span>
        <span aria-hidden="true">↓</span>
      </a>
    </div>
    <aside class="ca-world__hero-ledger" aria-label="Create Awesome catalog totals">
      <p>Catalog counter · templates + addons</p>
      <ul>
        <li>
          <strong>Node</strong>
          <span>
            {catalogTotals.node.templates} + {catalogTotals.node.addons}
          </span>
        </li>
        <li>
          <strong>Python</strong>
          <span>
            {catalogTotals.python.templates} + {catalogTotals.python.addons}
          </span>
        </li>
        <li>
          <strong>V</strong>
          <span>
            {catalogTotals.v.templates} + {catalogTotals.v.addons}
          </span>
        </li>
        <li>
          <strong>Rust</strong>
          <span>
            {catalogTotals.rust.templates} + {catalogTotals.rust.addons}
          </span>
        </li>
      </ul>
      <small>templates + addons · sourced totals</small>
    </aside>
  </header>

  <div class="vf-scene ca-world__scene">
    <div class="vf-stage ca-world__stage">
      <div class="ca-world__stage-heading">
        <div>
          <p>Assembly line · composition model</p>
          <h2>Runtime → template → addons → project</h2>
        </div>
      </div>
      <p class="ca-world__stage-copy">
        Choose a runtime. Your template and compatible addons travel through the line to shape the command.
      </p>
      <svg class="ca-world__line" viewBox="0 0 720 220" aria-hidden="true" focusable="false">
        <defs>
          <linearGradient id="ca-line-glow" x1="0%" y1="0%" x2="100%" y2="0%">
            <stop offset="0%" stop-color="#fbbf24" stop-opacity="0.35"></stop>
            <stop offset="50%" stop-color="#22d3ee" stop-opacity="0.28"></stop>
            <stop offset="100%" stop-color="#a78bfa" stop-opacity="0.35"></stop>
          </linearGradient>
        </defs>
        <rect x="0" y="0" width="720" height="220" fill="url(#ca-line-glow)" opacity="0.35"></rect>
        <path
          class="vf-flow is-active"
          data-ca-belt
          d="M70 110 H650"
          style="--vf-flow-accent: var(--nest-sunset-orange, #fb923c)"
        ></path>
        {lineModules.map((mod, index) => {
          const x = 70 + index * 180;
          return (
            <g class="ca-world__module" data-module={mod.id} transform={`translate(${x} 60)`}>
              <rect class="ca-world__module-disk" x="-48" y="0" width="96" height="100" rx="4" />
              <text class="ca-world__module-label" x="0" y="42" text-anchor="middle">
                {mod.label}
              </text>
              <text class="ca-world__module-hint" data-ca-module-value={mod.id} x="0" y="68" text-anchor="middle">
                {mod.hint}
              </text>
            </g>
          );
        })}
        <path class="ca-world__package-output" d="M610 160v10" aria-hidden="true"></path>
        <g class="ca-world__package" data-ca-package data-ca-package-stage="runtime" aria-hidden="true">
          <circle class="ca-world__package-halo" cx="70" cy="110" r="25"></circle>
          <path class="ca-world__package-body" d="M51 101 70 91l19 10v19l-19 10-19-10z"></path>
          <path class="ca-world__package-seam" d="m51 101 19 10 19-10M70 111v19"></path>
          <g class="ca-world__package-layer ca-world__package-layer--template" data-ca-package-layer="template">
            <path d="m62 98 8-4 8 4v8l-8 4-8-4z"></path>
          </g>
          <g class="ca-world__package-layer ca-world__package-layer--addons" data-ca-package-layer="addons">
            <path d="m48 109 6-3 6 3v7l-6 3-6-3z"></path>
            <path d="m80 116 6-3 6 3v7l-6 3-6-3z"></path>
            <path d="m78 94 6-3 6 3v7l-6 3-6-3z"></path>
          </g>
          <text class="ca-world__package-runtime" data-ca-package-runtime x="70" y="118" text-anchor="middle">
            NODE
          </text>
          <text class="ca-world__package-addon-count" data-ca-package-addon-count x="70" y="126" text-anchor="middle">
            0 ADDONS
          </text>
        </g>
      </svg>

      <ol class="ca-world__flow-index" aria-label="Composition stages">
        {lineModules.map((mod, index) => (
          <li data-ca-step={mod.id}>
            <span class="ca-world__flow-number">{String(index + 1).padStart(2, '0')}</span>
            <strong>{mod.label}</strong>
            <small data-ca-flow-value={mod.id}>{mod.hint}</small>
          </li>
        ))}
      </ol>

      <fieldset class="ca-world__stations" role="radiogroup" aria-labelledby="ca-runtime-legend" disabled hidden>
        <legend id="ca-runtime-legend">Runtime station</legend>
        {stations.map((station, index) => (
          <>
            <input
              class="ca-world__radio"
              type="radio"
              name="ca-world-runtime"
              id={`ca-station-${station.id}`}
              value={station.id}
              checked={index === 0}
              data-ca-station={station.id}
              aria-controls="ca-runtime-inspector"
            />
            <label
              class="vf-node"
              for={`ca-station-${station.id}`}
              style={`--vf-node-accent: ${station.accent}`}
              data-visual-node={station.id}
            >
              <span>
                {station.label}
                <small>
                  {station.templates}+{station.addons}
                </small>
              </span>
            </label>
          </>
        ))}
      </fieldset>
    </div>

    <SceneInspector eyebrow="Runtime" title={defaultStation.title} id="ca-runtime-inspector" headingLevel={2}>
      <p data-ca-inspector-body>{defaultStation.description}</p>
      <Fragment slot="meta">
        <span data-ca-inspector-status>
          {defaultStation.status} · {defaultStation.templates} templates · {defaultStation.addons} addons
        </span>
        <span>
          source <code data-ca-inspector-source>{defaultStation.source}</code>
        </span>
        <span>
          <span data-ca-inspector-install-label>
            {defaultStation.id === 'v' || defaultStation.id === 'rust'
              ? 'CLI installation command'
              : 'Base project command'}
          </span>
          <br />
          <code data-ca-inspector-install>{defaultStation.install}</code>
        </span>
        <span>
          <a data-ca-inspector-link href={defaultStation.href} target="_blank" rel="noopener noreferrer">
            {' '}
            Catalog ↗{' '}
          </a>
        </span>
      </Fragment>
    </SceneInspector>
  </div>

  <Composer embedded />

  <section class="ca-world__family-record" aria-label="Create Awesome family record">
    <FlagshipProvenance
      entryId="create-node-app"
      note="One composable scaffolding family across Node.js, Python, V, and Rust — created and maintained by Ulises across the four Create Awesome organizations."
    />
  </section>

  <WorldDock label="Project links">
    <a
      class="vf-dock__primary"
      href={defaultStation.href}
      target="_blank"
      rel="noopener noreferrer"
      data-ca-dock-catalog
    >
      Catalog
    </a>
    <a href={`https://github.com/${defaultStation.repo}`} target="_blank" rel="noopener noreferrer" data-ca-dock-repo>
      GitHub
    </a>
    <a href="/community">Community</a>
  </WorldDock>

  <Variants />

  <section class="ca-world__fold">
    <h2 class="ca-world__fold-label">Compare · distribute · contribute · examples</h2>
    <div class="ca-table-wrap" role="region" aria-label="Create Awesome family comparison" tabindex="0">
      <table>
        <thead>
          <tr>
            <th>Feature</th>
            <th>Node</th>
            <th>Python</th>
            <th>V</th>
            <th>Rust</th>
          </tr>
        </thead>
        <tbody>
          {comparisonRows.map((row) => (
            <tr>
              <td>{row.feature}</td>
              <td>{row.node}</td>
              <td>{row.python}</td>
              <td>{row.v}</td>
              <td>{row.rust}</td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
    <ul class="ca-world__channels">
      {distributionChannels.map((channel) => (
        <li>
          <strong>{channel.label}</strong> <code>{channel.command}</code>
        </li>
      ))}
    </ul>
    <ol class="ca-world__steps">
      {contributionSteps.map((step) => (
        <li>
          {step.title}
          {step.href ? (
            <>
              {' '}
              <a href={step.href} target="_blank" rel="noopener noreferrer">
                ↗
              </a>
            </>
          ) : null}
        </li>
      ))}
    </ol>
    <ul class="ca-world__examples">
      {compositionExamples.map((example) => (
        <li>
          <strong>{example.title}</strong>
          <code>{example.command}</code>
        </li>
      ))}
    </ul>
  </section>
</section>

<script>
  type Station = {
    id: string;
    label: string;
    title: string;
    status: string;
    description: string;
    install: string;
    href: string;
    repo: string;
    accent: string;
    templates: number;
    addons: number;
    source: string;
  };

  type SelectionOrigin = 'initial' | 'restore' | 'user';

  function initWorld(root: HTMLElement) {
    const stations = JSON.parse(root.dataset.stations || '[]') as Station[];

    const title = root.querySelector('#ca-runtime-inspector .vf-inspector__title');
    const body = root.querySelector<HTMLElement>('[data-ca-inspector-body]');
    const status = root.querySelector<HTMLElement>('[data-ca-inspector-status]');
    const source = root.querySelector<HTMLElement>('[data-ca-inspector-source]');
    const install = root.querySelector<HTMLElement>('[data-ca-inspector-install]');
    const link = root.querySelector<HTMLAnchorElement>('[data-ca-inspector-link]');
    const dockCatalog = root.querySelector<HTMLAnchorElement>('[data-ca-dock-catalog]');
    const dockRepo = root.querySelector<HTMLAnchorElement>('[data-ca-dock-repo]');
    const modules = root.querySelectorAll<SVGGElement>('[data-module]');
    const composer = root.querySelector<HTMLElement>('[data-ca-composer]');
    const fallback = root.querySelector<HTMLElement>('[data-ca-static-fallback]');
    const stationControls = root.querySelector<HTMLFieldSetElement>('.ca-world__stations');
    const defaultStationId = stations[0]?.id;
    let selectedStationId =
      root.querySelector<HTMLInputElement>('[data-ca-station]:checked')?.value ?? defaultStationId;
    let lastFocusedElement: HTMLElement | null = null;
    let locationBeingRestored: string | undefined;

    root.addEventListener('focusin', (event) => {
      lastFocusedElement = event.target instanceof HTMLElement ? event.target : null;
    });

    root.addEventListener('focusout', (event) => {
      const nextTarget = event.relatedTarget;
      if (nextTarget instanceof Node && root.contains(nextTarget)) return;

      window.requestAnimationFrame(() => {
        if (!root.contains(document.activeElement)) lastFocusedElement = null;
      });
    });

    const stationForHash = () => {
      const hash = window.location.hash.slice(1);
      if (!hash) return defaultStationId;
      return stations.some((station) => station.id === hash) ? hash : undefined;
    };

    const activateEnhancedWorld = () => {
      if (composer?.dataset.caReady !== 'true') return;
      composer.hidden = false;
      if (fallback) fallback.hidden = true;
      if (stationControls) stationControls.hidden = false;
      root.dataset.caEnhanced = 'true';
    };

    const select = (id: string, origin: SelectionOrigin) => {
      const station = stations.find((candidate) => candidate.id === id);
      if (!station) return;

      const familyChanged = selectedStationId !== station.id;
      selectedStationId = station.id;

      const stationInput = root.querySelector<HTMLInputElement>(`[data-ca-station="${station.id}"]`);
      if (stationInput && !stationInput.checked) {
        stationInput.checked = true;
      }

      if (title) title.textContent = station.title;
      if (body) body.textContent = station.description;
      if (status) {
        status.textContent = `${station.status} · ${station.templates} templates · ${station.addons} addons`;
      }
      if (source) source.textContent = station.source;
      if (install) install.textContent = station.install;
      const installLabel = root.querySelector<HTMLElement>('[data-ca-inspector-install-label]');
      if (installLabel) {
        installLabel.textContent =
          station.id === 'v' || station.id === 'rust' ? 'CLI installation command' : 'Base project command';
      }
      if (link) {
        link.href = station.href;
      }
      if (dockCatalog) dockCatalog.href = station.href;
      if (dockRepo) dockRepo.href = `https://github.com/${station.repo}`;

      modules.forEach((mod) => {
        const kind = mod.dataset.module;
        mod.classList.toggle(
          'is-active',
          kind === 'runtime' || kind === 'template' || kind === 'addons' || kind === 'app',
        );
        if (kind === 'runtime') {
          mod.style.setProperty('--ca-module-accent', station.accent);
        }
      });

      const composerRadio = root.querySelector<HTMLInputElement>(`#ca-runtime-${station.id}`);
      if (composerRadio && !composerRadio.checked) {
        composerRadio.checked = true;
        composerRadio.dispatchEvent(
          new CustomEvent('change', { bubbles: true, detail: { animate: origin === 'user' } }),
        );
      }

      root.querySelectorAll<HTMLElement>('[data-visual-node]').forEach((node) => {
        node.classList.toggle('is-active', node.getAttribute('data-visual-node') === station.id);
      });

      if (origin === 'user' && familyChanged && window.location.hash !== `#${station.id}`) {
        const nextUrl = new URL(window.location.href);
        nextUrl.hash = station.id;
        window.history.pushState(null, '', `${nextUrl.pathname}${nextUrl.search}${nextUrl.hash}`);
      }
    };

    root.querySelectorAll<HTMLInputElement>('[data-ca-station]').forEach((input) => {
      input.addEventListener('change', () => {
        if (input.checked) select(input.value, 'user');
      });
    });
    root.addEventListener('ca:composition-change', (event) => {
      if (!(event instanceof CustomEvent)) return;
      const family = event.detail?.family;
      if (typeof family === 'string' && family !== selectedStationId) select(family, 'user');
    });
    if (stationControls) stationControls.disabled = false;

    const restoreFromLocation = () => {
      const locationKey = `${window.location.pathname}${window.location.search}${window.location.hash}`;
      if (locationBeingRestored === locationKey) return;
      locationBeingRestored = locationKey;

      const focusBeforeRestore = lastFocusedElement;
      const stationId = stationForHash();
      if (stationId) select(stationId, 'restore');

      // Same-document fragment traversal can reset focus to <body>. Restore only
      // the element that already held focus; never choose a new destination.
      window.requestAnimationFrame(() => {
        if (locationBeingRestored === locationKey) locationBeingRestored = undefined;
        if (
          focusBeforeRestore?.isConnected &&
          (document.activeElement === document.body || document.activeElement === document.documentElement)
        ) {
          focusBeforeRestore.focus({ preventScroll: true });
        }
      });
    };

    const initialStationId = stationForHash() ?? defaultStationId;
    if (initialStationId) select(initialStationId, 'initial');

    window.addEventListener('hashchange', restoreFromLocation);
    window.addEventListener('popstate', restoreFromLocation);

    if (composer?.dataset.caReady === 'true') {
      activateEnhancedWorld();
    } else {
      composer?.addEventListener('ca:composer-ready', activateEnhancedWorld, { once: true });
    }
  }

  document.querySelectorAll<HTMLElement>('[data-ca-world]').forEach(initWorld);
</script>

<script is:inline>
  (() => {
    // Keep the visual choreography inline to preserve this route's zero external-JS budget.
    const stages = ['runtime', 'template', 'addons', 'app'];

    document.querySelectorAll('[data-ca-world]').forEach((world) => {
      const stations = JSON.parse(world.getAttribute('data-stations') || '[]');
      const modules = [...world.querySelectorAll('[data-module]')];
      const steps = [...world.querySelectorAll('[data-ca-step]')];
      const packageGroup = world.querySelector('[data-ca-package]');
      const belt = world.querySelector('[data-ca-belt]');
      const form = world.querySelector('[data-ca-composer]');
      const motionPreference = window.matchMedia('(prefers-reduced-motion: reduce)');
      let animationId = 0;
      let timers = [];

      const currentState = () => {
        const family = form?.querySelector('[name="ca-runtime"]:checked')?.value || stations[0]?.id;
        const panel = family && world.querySelector(`[data-ca-panel="${family}"]`);
        return {
          family,
          projectName: form?.querySelector('[data-ca-project]')?.value || 'my-app',
          template: panel?.querySelector('[data-ca-template]')?.value || 'starter',
          addons: [...(panel?.querySelectorAll('[data-ca-addon]:checked') || [])].map((input) => input.value),
          animate: false,
        };
      };

      const syncValues = (state) => {
        const station = stations.find((candidate) => candidate.id === state.family);
        if (!station) return;
        const panel = world.querySelector(`[data-ca-panel="${station.id}"]`);
        const template = state.template || panel?.querySelector('[data-ca-template]')?.value || 'starter';
        const addons = Array.isArray(state.addons)
          ? state.addons.length
          : panel?.querySelectorAll('[data-ca-addon]:checked').length || 0;
        const values = {
          runtime: station.label,
          template,
          addons: `${addons} selected`,
          app: state.projectName || 'my-app',
        };

        Object.entries(values).forEach(([stage, value]) => {
          const compact = value.length > 11 ? `${value.slice(0, 10)}…` : value;
          world.querySelector(`[data-ca-module-value="${stage}"]`)?.replaceChildren(compact);
          world.querySelector(`[data-ca-flow-value="${stage}"]`)?.replaceChildren(value);
        });

        const runtime = station.label.toUpperCase();
        const addonCount = Array.isArray(state.addons)
          ? state.addons.length
          : panel?.querySelectorAll('[data-ca-addon]:checked').length || 0;
        world.querySelector('[data-ca-package-runtime]')?.replaceChildren(runtime);
        world
          .querySelector('[data-ca-package-addon-count]')
          ?.replaceChildren(`${addonCount} ${addonCount === 1 ? 'ADDON' : 'ADDONS'}`);
      };

      const stopAssembly = () => {
        animationId += 1;
        timers.forEach((timer) => window.clearTimeout(timer));
        timers = [];
        packageGroup?.getAnimations().forEach((animation) => animation.cancel());
        packageGroup?.querySelectorAll('*').forEach((element) => {
          element.getAnimations().forEach((animation) => animation.cancel());
        });
        world.removeAttribute('data-ca-animating');
        packageGroup?.removeAttribute('data-ca-package-static');
        packageGroup?.removeAttribute('transform');
        modules.forEach((module) => module.classList.remove('is-current'));
        steps.forEach((step) => step.classList.remove('is-current'));
      };

      const setPackageStage = (stage) => packageGroup?.setAttribute('data-ca-package-stage', stage);

      const showRuntime = () => {
        setPackageStage('runtime');
        modules.forEach((module) => module.classList.toggle('is-current', module.dataset.module === 'runtime'));
        steps.forEach((step) => step.classList.toggle('is-current', step.dataset.caStep === 'runtime'));
      };

      const showCompleteComposition = () => {
        setPackageStage('app');
        packageGroup?.setAttribute('transform', 'translate(540 75)');
        packageGroup?.setAttribute('data-ca-package-static', 'true');
        modules.forEach((module) => module.classList.toggle('is-current', module.dataset.module === 'app'));
        steps.forEach((step) => step.classList.toggle('is-current', step.dataset.caStep === 'app'));
      };

      const runAssembly = (state) => {
        syncValues(state);
        if (!state.animate) return;

        stopAssembly();
        if (motionPreference.matches || !packageGroup || !belt) {
          showCompleteComposition();
          return;
        }

        const currentAnimation = animationId;
        const station = stations.find((candidate) => candidate.id === state.family);
        const diagramWidth = belt.ownerSVGElement?.getBoundingClientRect().width || 0;
        world.dataset.caAnimating = 'true';
        packageGroup.style.setProperty('--ca-package-accent', station?.accent || 'var(--nest-sunset-orange)');

        if (diagramWidth > 0) {
          packageGroup.animate(
            [
              { transform: 'translateX(0px)', opacity: 0, offset: 0 },
              { transform: 'translateX(0px)', opacity: 1, offset: 0.08 },
              { transform: 'translate(540px, 75px)', opacity: 1, offset: 0.9 },
              { transform: 'translate(540px, 75px)', opacity: 1, offset: 1 },
            ],
            { duration: 1800, easing: 'cubic-bezier(0.42, 0, 0.2, 1)', fill: 'forwards' },
          );
        }

        stages.forEach((stage, index) => {
          timers.push(
            window.setTimeout(() => {
              if (currentAnimation !== animationId) return;
              setPackageStage(stage);
              modules.forEach((module) => module.classList.toggle('is-current', module.dataset.module === stage));
              steps.forEach((step) => step.classList.toggle('is-current', step.dataset.caStep === stage));

              const arrivingModule = world.querySelector(`[data-module="${stage}"] .ca-world__module-disk`);
              arrivingModule?.animate(
                [
                  { transform: 'scale(0.88)', filter: 'brightness(1)' },
                  { transform: 'scale(1.14)', filter: 'brightness(1.4)', offset: 0.55 },
                  { transform: 'scale(1.08)', filter: 'brightness(1.18)' },
                ],
                { duration: 380, easing: 'cubic-bezier(0.2, 0.8, 0.2, 1)' },
              );

              const layer = packageGroup.querySelector(`[data-ca-package-layer="${stage}"]`);
              if (layer) {
                layer.animate(
                  [
                    { opacity: 0, transform: 'translateY(-5px) scale(0.72)' },
                    { opacity: 1, transform: 'translateY(0) scale(1)' },
                  ],
                  { duration: 320, easing: 'cubic-bezier(0.2, 0.8, 0.2, 1)' },
                );
              }
            }, index * 520),
          );
        });

        timers.push(
          window.setTimeout(() => {
            if (currentAnimation !== animationId) return;
            world.removeAttribute('data-ca-animating');
            setPackageStage('app');
            modules.forEach((module) => module.classList.toggle('is-current', module.dataset.module === 'app'));
            steps.forEach((step) => step.classList.toggle('is-current', step.dataset.caStep === 'app'));
          }, 1820),
        );
      };

      world.addEventListener('ca:composition-change', (event) => {
        if (event instanceof CustomEvent) runAssembly(event.detail);
      });
      motionPreference.addEventListener('change', () => {
        if (motionPreference.matches) {
          stopAssembly();
          showCompleteComposition();
        }
      });

      syncValues(currentState());
      showRuntime();
    });
  })();
</script>

