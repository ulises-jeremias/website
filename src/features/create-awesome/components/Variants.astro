---
import { catalogTotals, variants } from '../data/index.js';

const featuredOnly = (templates: (typeof variants)[number]['templates']) =>
  templates.filter((t) => t.featured).concat(templates.filter((t) => !t.featured).slice(0, 4));
---

<section aria-labelledby="ca-variants-title" class="ca-variants" data-testid="ca-variants">
  <h2 id="ca-variants-title">Family — three runtimes, one composition model</h2>
  <p class="ca-variants__intro">
    Same mental model across Node, Python, and V: pick a <code>template</code>, add <code>addons</code>. Real files, no
    hidden runtime. Totals from sourced catalogs (not sample arrays): CNA {catalogTotals.node.templates}+{
      catalogTotals.node.addons
    }, CPA {catalogTotals.python.templates}+{catalogTotals.python.addons}, CVA {catalogTotals.v.templates}+{
      catalogTotals.v.addons
    }. Cards below highlight featured + a few starters; the composer exposes the full catalogs.
  </p>
  <div class="ca-variants__grid">
    {
      variants.map((v) => {
        const totals = catalogTotals[v.id];
        const shown = featuredOnly(v.templates);
        const featuredAddons = v.addons.slice(0, 6);
        return (
          <article class="ca-variant" id={v.id} style={`--v-accent:${v.accent}; --v-bg:${v.bg}`}>
            <header class="ca-variant__head">
              <h3 class="ca-variant__name">{v.title}</h3>
              <span class={`ca-variant__status ca-variant__status--${v.status}`}>{v.status}</span>
            </header>
            <img
              class="ca-variant__hero"
              src={`/media/create-awesome/${v.id === 'node' ? 'cna' : v.id === 'python' ? 'cpa' : 'cva'}-hero.svg`}
              alt=""
              loading="lazy"
              decoding="async"
            />
            <p class="ca-variant__desc">{v.description}</p>
            <p class="ca-variant__count">
              <strong>
                {totals.templates} templates · {totals.addons} addons
              </strong>{' '}
              <span class="ca-muted">from {v.id === 'node' ? 'cna' : v.id === 'python' ? 'cpa' : 'cva'}-templates</span>
            </p>
            <div class="ca-variant__templates">
              <strong>Featured / starters</strong>
              <ul>
                {shown.map((t) => (
                  <li>
                    <code>{t.id}</code> — {t.description} {t.featured ? <span class="ca-badge">featured</span> : null}
                  </li>
                ))}
              </ul>
            </div>
            <div class="ca-variant__addons">
              <strong>Addon sample</strong>
              <ul>
                {featuredAddons.map((a) => (
                  <li>
                    <code>{a.id}</code> — {a.description} <span class="ca-muted">({a.category})</span>
                  </li>
                ))}
              </ul>
              <p class="ca-muted">Full {totals.addons} available in the composer above.</p>
            </div>
            <pre class="ca-variant__install">
              <code>{v.install}</code>
            </pre>
            <a href={v.href} target="_blank" rel="noopener noreferrer" class="ca-variant__link">
              Live catalog →
            </a>
          </article>
        );
      })
    }
  </div>
</section>

<style>
  .ca-variants {
    margin: var(--space-8) 0;
  }
  .ca-variants__intro {
    color: var(--color-text-muted);
    max-width: 70ch;
  }
  .ca-variants__grid {
    display: grid;
    gap: var(--space-4);
    margin-top: var(--space-4);
    width: 100%;
    max-width: 100%;
  }
  @media (min-width: 900px) {
    .ca-variants__grid {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }
  .ca-variant {
    min-width: 0;
    max-width: 100%;
    padding: var(--space-4);
    border: 1px solid var(--color-border);
    border-radius: 12px;
    background: color-mix(in srgb, var(--nest-midnight-900) 92%, var(--v-accent));
    border-top: 3px solid var(--v-accent);
    color: var(--color-text);
    scroll-margin-top: 1.5rem;
  }
  .ca-variant__head {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: var(--space-2);
  }
  .ca-variant__hero {
    width: 100%;
    height: auto;
    margin-top: var(--space-3);
    border-radius: 8px;
    border: 1px solid color-mix(in srgb, var(--v-accent) 30%, transparent);
    background: color-mix(in srgb, var(--v-bg, #0b1020) 80%, transparent);
  }
  .ca-variant__name {
    font-size: 1rem;
    margin: 0;
    overflow-wrap: anywhere;
  }
  .ca-variant__status {
    font-size: 0.7rem;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    padding: 0.2rem 0.5rem;
    border-radius: 999px;
    border: 1px solid var(--color-border);
    flex-shrink: 0;
  }
  .ca-variant__status--stable {
    background: color-mix(in srgb, #75e6b2 18%, transparent);
    color: #b9f7d9;
    border-color: color-mix(in srgb, #75e6b2 44%, transparent);
  }
  .ca-variant__status--beta {
    background: color-mix(in srgb, var(--nest-violet) 18%, transparent);
    color: var(--nest-pink);
    border-color: color-mix(in srgb, var(--nest-violet) 44%, transparent);
  }
  .ca-variant__desc {
    color: var(--color-text-muted);
    font-size: 0.95rem;
    min-height: 3rem;
  }
  .ca-variant__count {
    margin: 0 0 0.5rem;
    font-size: 0.85rem;
  }
  .ca-variant ul {
    margin: 0.5rem 0;
    padding-left: 1.1rem;
    font-size: 0.9rem;
  }
  .ca-badge {
    font-size: 0.65rem;
    background: var(--v-accent);
    color: white;
    padding: 0.1rem 0.3rem;
    border-radius: 4px;
    margin-left: 0.3rem;
  }
  .ca-muted {
    color: var(--color-text-muted);
    font-size: 0.8rem;
  }
  .ca-variant__install {
    margin: var(--space-3) 0;
    padding: var(--space-2);
    background: var(--nest-midnight-950);
    color: var(--nest-paper);
    border-radius: 8px;
    font-size: 0.75rem;
    overflow-x: auto;
    max-width: 100%;
    white-space: pre-wrap;
    overflow-wrap: anywhere;
  }
  .ca-variant__link {
    font-size: 0.9rem;
  }
</style>
