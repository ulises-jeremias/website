---
import { catalogTotals, variants } from '../data/index.js';
import { buildCreateAwesomeCommand, DEFAULT_PROJECT_NAME } from '../lib/buildCommand.js';

interface Props {
  /** When true, omit the long lead — the surrounding world supplies context. */
  embedded?: boolean;
}

const { embedded = false } = Astro.props;

const defaultVariant = variants[0]!;
const defaultTemplate = defaultVariant.templates.find((t) => t.featured)?.id ?? defaultVariant.templates[0]?.id ?? '';
const initialCommand = buildCreateAwesomeCommand({
  family: defaultVariant.id,
  projectName: DEFAULT_PROJECT_NAME,
  template: defaultTemplate,
  addons: [],
});

const staticFamilies = variants.map((variant) => ({
  id: variant.id,
  label: variant.label,
  title: variant.title,
  description: variant.description,
  catalog: variant.href,
  repository: `https://github.com/${variant.repo}`,
  baseExample: variant.id === 'v' ? 'create-vlang-app my-app' : variant.install,
  exampleNote: variant.id === 'v' ? 'after installing the CLI' : 'no template or addons selected',
}));

const composerBootstrap = {
  defaultProjectName: DEFAULT_PROJECT_NAME,
  families: Object.fromEntries(
    variants.map((variant) => [
      variant.id,
      {
        id: variant.id,
        featuredTemplate: variant.templates.find((t) => t.featured)?.id ?? variant.templates[0]?.id ?? '',
      },
    ]),
  ),
};
---

<section
  class:list={['ca-composer', { 'ca-composer--embedded': embedded }]}
  aria-labelledby="ca-composer-title"
  data-ca-composer-root
  data-ca-embedded={embedded ? 'true' : 'false'}
>
  <header>
    <p class="ca-composer__eyebrow">Composer</p>
    <h2 id="ca-composer-title">Runtime + template + addons → command</h2>
    {
      embedded ? null : (
        <p>
          Native controls. Catalogs: CNA {catalogTotals.node.templates}+{catalogTotals.node.addons}, CPA{' '}
          {catalogTotals.python.templates}+{catalogTotals.python.addons}, CVA {catalogTotals.v.templates}+
          {catalogTotals.v.addons}. Commands follow each family’s CLI shape.
        </p>
      )
    }
  </header>

  <div class="ca-composer__fallback" data-ca-static-fallback>
    <p>
      Choose a family from these canonical sources. Each command is a base example only; template and addon composition
      becomes available after the interactive composer initializes successfully.
    </p>
    <div class="ca-composer__fallback-grid">
      {
        staticFamilies.map((family) => (
          <article data-ca-static-family={family.id}>
            <p class="ca-composer__fallback-family">{family.label}</p>
            <h3>{family.title}</h3>
            <p>{family.description}</p>
            <p class="ca-composer__fallback-command">
              <span>Base example · {family.exampleNote}</span>
              <code>{family.baseExample}</code>
            </p>
            <p class="ca-composer__fallback-links">
              <a href={family.catalog} target="_blank" rel="noreferrer">
                {family.label} catalog ↗
              </a>
              <a href={family.repository} target="_blank" rel="noreferrer">
                {family.label} repository ↗
              </a>
            </p>
          </article>
        ))
      }
    </div>
  </div>

  <form
    class="ca-composer__form"
    id="ca-composer-form"
    data-ca-composer
    data-ca-bootstrap={JSON.stringify(composerBootstrap)}
    hidden
  >
    {/* Runtime radios stay in the form for command state; embedded worlds expose stations instead. */}
    {/* Proxied radios stay in the form for command state but leave the a11y tree when embedded. */}
    <fieldset class:list={[{ 'ca-composer__runtime--proxy': embedded }]} inert={embedded || undefined}>
      {embedded ? null : <legend>Runtime</legend>}
      {
        variants.map((variant, index) => (
          <>
            <input
              type="radio"
              name="ca-runtime"
              id={`ca-runtime-${variant.id}`}
              value={variant.id}
              data-family={variant.id}
              checked={index === 0}
              tabindex={embedded ? -1 : undefined}
              aria-label={embedded ? variant.label : undefined}
            />
            {embedded ? null : <label for={`ca-runtime-${variant.id}`}>{variant.label}</label>}
          </>
        ))
      }
    </fieldset>

    <label class="ca-composer__project">
      Project name
      <input
        type="text"
        name="ca-project"
        value={DEFAULT_PROJECT_NAME}
        autocomplete="off"
        spellcheck="false"
        data-ca-project
        aria-label="Project directory name"
      />
    </label>

    {
      variants.map((variant, index) => (
        <div
          class={`ca-composer__panel ca-composer__panel--${variant.id}`}
          data-runtime={variant.id}
          data-ca-panel={variant.id}
          data-ca-panel-active={index === 0 ? 'true' : 'false'}
        >
          <label>
            Template
            <select name={`template-${variant.id}`} data-ca-template aria-label={`${variant.label} template`}>
              {variant.templates.map((template) => (
                <option value={template.id} selected={template.featured}>
                  {template.name} ({template.id})
                </option>
              ))}
            </select>
          </label>
          <fieldset class="ca-composer__addons">
            <legend>Addons ({variant.addons.length})</legend>
            {variant.addons.map((addon) => (
              <label title={addon.description}>
                <input type="checkbox" name={`addon-${variant.id}`} value={addon.id} data-ca-addon />
                <code>{addon.id}</code>
              </label>
            ))}
          </fieldset>
        </div>
      ))
    }

    <p class="ca-composer__preview">
      <span>Composable command</span>
      <code data-ca-command>{initialCommand}</code>
    </p>
  </form>
</section>

<script is:inline>
  (function () {
    const form = document.querySelector('[data-ca-composer]');
    if (!form) return;

    const root = form.closest('[data-ca-composer-root]');
    const fallback = root && root.querySelector('[data-ca-static-fallback]');
    const embedded = root && root.getAttribute('data-ca-embedded') === 'true';

    let composerBootstrap;
    try {
      composerBootstrap = JSON.parse(form.getAttribute('data-ca-bootstrap') || '{}');
      if (!composerBootstrap || typeof composerBootstrap !== 'object' || !composerBootstrap.families) return;
    } catch (_err) {
      return;
    }

    const families = composerBootstrap.families || {};

    function activeFamily() {
      const checked = form.querySelector('input[name="ca-runtime"]:checked');
      return checked ? checked.value : 'node';
    }

    function selectedTemplate(family) {
      const panel = form.querySelector('[data-ca-panel="' + family + '"]');
      if (!panel) return '';
      const select = panel.querySelector('[data-ca-template]');
      return select && select.value ? select.value : (families[family] && families[family].featuredTemplate) || '';
    }

    function selectedAddons(family) {
      const panel = form.querySelector('[data-ca-panel="' + family + '"]');
      if (!panel) return [];
      return Array.prototype.map
        .call(panel.querySelectorAll('[data-ca-addon]:checked'), function (el) {
          return el.value;
        })
        .filter(Boolean);
    }

    function buildCommand(family, projectName, template, addons) {
      const name =
        (projectName || composerBootstrap.defaultProjectName || 'my-app').trim().replace(/\s+/g, '-') || 'my-app';
      const cleaned = (addons || []).filter(Boolean);

      if (family === 'node') {
        const node = ['npm', 'create', 'awesome-node-app@latest', name, '--'];
        if (template) {
          node.push('--template', template);
        }
        if (cleaned.length) {
          node.push('--addons');
          for (let i = 0; i < cleaned.length; i++) node.push(cleaned[i]);
        }
        return node.join(' ');
      }

      if (family === 'python') {
        const py = ['uvx', 'create-awesome-python-app@latest', name];
        if (template) py.push('--template', template);
        for (let j = 0; j < cleaned.length; j++) {
          py.push('--addons', cleaned[j]);
        }
        return py.join(' ');
      }

      const vcmd = ['create-vlang-app', name];
      if (template) vcmd.push('--template', template);
      if (cleaned.length) vcmd.push('--addons', cleaned.join(','));
      return vcmd.join(' ');
    }

    function syncPanels(family) {
      const panels = form.querySelectorAll('[data-ca-panel]');
      for (let i = 0; i < panels.length; i++) {
        const panel = panels[i];
        const on = panel.getAttribute('data-ca-panel') === family;
        if (on) panel.removeAttribute('hidden');
        else panel.setAttribute('hidden', '');
      }
    }

    function refresh() {
      const family = activeFamily();
      syncPanels(family);
      const projectInput = form.querySelector('[data-ca-project]');
      const projectName = projectInput ? projectInput.value : composerBootstrap.defaultProjectName;
      const command = buildCommand(family, projectName, selectedTemplate(family), selectedAddons(family));
      const out = form.querySelector('[data-ca-command]');
      if (!out) return false;
      out.textContent = command;
      return true;
    }

    try {
      form.addEventListener('change', refresh);
      form.addEventListener('input', refresh);
      if (!refresh()) return;
      form.setAttribute('data-ca-ready', 'true');
      if (!embedded) {
        form.removeAttribute('hidden');
        if (fallback) fallback.setAttribute('hidden', '');
        if (root) root.setAttribute('data-ca-enhanced', 'true');
      }
      form.dispatchEvent(new CustomEvent('ca:composer-ready', { bubbles: true }));
    } catch (_err) {
      return;
    }
  })();
</script>

<style>
  .ca-composer {
    width: min(100% - 2 * var(--section-padding-x), 74rem);
    margin: 0 auto;
    padding-block: clamp(1.5rem, 4vw, 2.75rem);
  }

  .ca-composer--embedded {
    width: 100%;
  }

  .ca-composer,
  .ca-composer__form,
  .ca-composer__panel,
  .ca-composer__panel > label,
  .ca-composer fieldset,
  .ca-composer__preview,
  .ca-composer__fallback,
  .ca-composer__fallback-grid,
  .ca-composer__fallback article {
    min-inline-size: 0;
    max-inline-size: 100%;
  }

  .ca-composer__eyebrow {
    margin: 0 0 var(--space-2);
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--nest-sunset-orange);
  }

  .ca-composer h2 {
    margin: 0 0 var(--space-3);
    text-transform: uppercase;
    letter-spacing: 0.03em;
  }

  .ca-composer header p {
    margin: 0 0 1rem;
    max-inline-size: 68ch;
    color: var(--color-text-muted);
  }

  .ca-composer__form {
    inline-size: 100%;
    box-sizing: border-box;
    padding: 1rem;
    border: 1px solid var(--color-border);
    background: color-mix(in srgb, var(--nest-midnight-900) 92%, transparent);
    clip-path: var(--clip-corner-md);
  }

  .ca-composer__form[hidden],
  .ca-composer__fallback[hidden] {
    display: none;
  }

  .ca-composer__fallback {
    padding: 1rem;
    border: 1px solid var(--color-border);
    background: color-mix(in srgb, var(--nest-midnight-900) 92%, transparent);
    clip-path: var(--clip-corner-md);
  }

  .ca-composer__fallback > p {
    margin: 0 0 1rem;
    color: var(--color-text-muted);
    font-size: 0.88rem;
  }

  .ca-composer__fallback-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 18rem), 1fr));
    gap: 0.75rem;
  }

  .ca-composer__fallback article {
    padding: 0.8rem;
    border: 1px solid var(--color-border);
    background: color-mix(in srgb, var(--nest-midnight-950) 84%, transparent);
  }

  .ca-composer__fallback article > p {
    margin: 0.45rem 0 0;
    color: var(--color-text-muted);
    font-size: 0.82rem;
  }

  .ca-composer__fallback h3 {
    margin: 0.2rem 0 0;
    font-size: 0.95rem;
  }

  .ca-composer__fallback .ca-composer__fallback-family,
  .ca-composer__fallback-command span {
    font-family: var(--font-mono);
    font-size: 0.66rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--nest-cyan);
  }

  .ca-composer__fallback-command code {
    display: block;
    min-inline-size: 0;
    max-inline-size: 100%;
    margin-top: 0.35rem;
    padding: 0.55rem;
    border: 1px solid var(--color-border);
    background: var(--color-code-bg, var(--nest-midnight-950));
    color: var(--color-text);
    overflow-wrap: anywhere;
  }

  .ca-composer__fallback-links {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem 0.8rem;
  }

  .ca-composer fieldset {
    margin: 0 0 1rem;
    padding: 0;
    border: 0;
  }

  .ca-composer legend {
    margin-bottom: 0.45rem;
    font-family: var(--font-mono);
    font-size: 0.7rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--nest-cyan);
  }

  .ca-composer input[type='radio'] {
    position: absolute;
    opacity: 0;
    pointer-events: none;
  }

  .ca-composer fieldset > label {
    display: inline-flex;
    align-items: center;
    min-block-size: 44px;
    margin: 0 0.35rem 0.35rem 0;
    padding: 0.4rem 0.85rem;
    border: 1px solid var(--color-border);
    clip-path: var(--clip-corner-sm);
    font-family: var(--font-mono);
    font-size: 0.78rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    cursor: pointer;
  }

  .ca-composer input[type='radio']:checked + label {
    border-color: var(--nest-magenta);
    color: var(--nest-magenta);
  }

  .ca-composer input[type='radio']:focus-visible + label {
    outline: 2px solid var(--nest-cyan);
    outline-offset: 2px;
  }

  .ca-composer__project {
    display: grid;
    gap: 0.35rem;
    margin: 0 0 1rem;
    font-size: 0.9rem;
  }

  .ca-composer__project input,
  .ca-composer select {
    inline-size: 100%;
    min-inline-size: 0;
    max-inline-size: 100%;
    box-sizing: border-box;
    min-block-size: 44px;
    padding: 0.45rem 0.6rem;
    border: 1px solid var(--color-border);
    background: var(--nest-midnight-950);
    color: var(--color-text);
  }

  .ca-composer__panel {
    display: grid;
    gap: 0.85rem;
  }

  .ca-composer__panel[hidden] {
    display: none;
  }

  .ca-composer__panel > label {
    display: grid;
    gap: 0.35rem;
    font-size: 0.9rem;
  }

  .ca-composer__addons {
    display: grid;
    gap: 0.25rem;
    max-block-size: 14rem;
    overflow: auto;
    padding-right: 0.25rem;
  }

  .ca-composer__addons label {
    display: flex;
    min-inline-size: 0;
    max-inline-size: 100%;
    gap: 0.55rem;
    align-items: center;
    min-block-size: 40px;
    padding: 0.2rem 0;
    font-size: 0.82rem;
    color: var(--color-text-muted);
  }

  .ca-composer__addons code {
    min-inline-size: 0;
    max-inline-size: 100%;
    overflow-wrap: anywhere;
  }

  .ca-composer__preview {
    display: grid;
    gap: 0.35rem;
    margin: 0.85rem 0 0;
  }

  .ca-composer__preview span {
    font-family: var(--font-mono);
    font-size: 0.68rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--color-text-faint);
  }

  .ca-composer__preview code {
    display: block;
    padding: 0.7rem;
    overflow-x: auto;
    border: 1px solid var(--color-border);
    background: var(--color-code-bg, color-mix(in srgb, var(--nest-midnight-950) 88%, transparent));
    clip-path: var(--clip-corner-sm);
    font-size: 0.78rem;
    white-space: pre-wrap;
    overflow-wrap: anywhere;
  }

  /* Keep radios queryable when the world owns the station UI. */
  .ca-composer__runtime--proxy {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }
</style>
