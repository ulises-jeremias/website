---
/**
 * ZIP hero atmosphere: plate + readability veil + bottom fade + scanlines.
 * Plate supplies striped sun, palms, city, and constellation art from the ZIP.
 */
---

<div class="synthwave-environment" aria-hidden="true">
  <picture>
    <source
      type="image/webp"
      srcset="/assets/nest/hero-bg-sm.webp 960w, /assets/nest/hero-bg.webp 1920w"
      sizes="100vw"
    />
    <img
      class="synthwave-environment__plate"
      src="/assets/hero-bg.png"
      width="1920"
      height="1080"
      alt=""
      decoding="async"
      fetchpriority="high"
    />
  </picture>
  <div class="synthwave-environment__veil"></div>
  <div class="synthwave-environment__floor-fade"></div>
  <div class="synthwave-environment__scanlines scanlines"></div>
</div>
