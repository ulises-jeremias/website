---
/**
 * ZIP constellation: dashed cyan links across the 3-column project-world grid.
 * Coordinates match the digital-nest-portfolio mock (viewBox 600×460).
 */
---

<svg
  class="atlas-connections"
  viewBox="0 0 600 460"
  preserveAspectRatio="none"
  aria-hidden="true"
  focusable="false"
  fill="none"
>
  <g class="atlas-connections__group">
    <path class="atlas-connection" d="M110 90 L300 120 L490 155" data-connects="dotfiles toolkit workstation"></path>
    <path class="atlas-connection" d="M60 210 L300 230 L520 250" data-connects="v hub create-awesome"></path>
    <path class="atlas-connection" d="M110 90 L60 210 L120 355" data-connects="dotfiles v community"></path>
    <path class="atlas-connection" d="M490 155 L520 250 L470 370" data-connects="toolkit create-awesome open-source"
    ></path>
    <path class="atlas-connection" d="M120 355 L300 380 L470 370" data-connects="community projects open-source"></path>
    <path class="atlas-connection" d="M300 120 L300 230 L300 380" data-connects="workstation hub projects"></path>
  </g>
</svg>
