---
import { profile } from '@/data/profile.js';
import { heroKeywords } from '../data/index.js';
import DigitalNestMark from '@/shared/components/DigitalNestMark.astro';
import SynthwaveEnvironment from './SynthwaveEnvironment.astro';
---

<section class="hero" aria-labelledby="hero-title">
  <SynthwaveEnvironment />

  <div class="hero__stage">
    <div class="hero__identity">
      <p class="hero__nest-mark" aria-hidden="true">
        <DigitalNestMark />
      </p>
      <p class="hero__wordmark">— DIGITAL NEST —</p>
      <h1 id="hero-title" class="hero__name">
        <span class="hero__name-line">{profile.displayName.split(' ')[0]}</span>
        <span class="hero__name-line hero__name-line--accent">{profile.displayName.split(' ').slice(1).join(' ')}</span>
      </h1>
      <p class="hero__role">{profile.title}</p>
      <p class="hero__summary">{profile.summary}</p>
      <p class="hero__keywords">
        {
          heroKeywords.map((keyword, index) => (
            <>
              {index > 0 && (
                <span class="hero__keyword-sep" aria-hidden="true">
                  /
                </span>
              )}
              <span>{keyword}</span>
            </>
          ))
        }
      </p>
      <div class="hero__actions">
        <a class="hero__cta hero__cta--primary" href="#project-atlas">Explore the atlas</a>
        <a class="hero__cta hero__cta--secondary" href={profile.links.github} target="_blank" rel="noopener noreferrer">
          GitHub
        </a>
        <a class="hero__cta hero__cta--secondary" href={`mailto:${profile.contact.email}`}>Collaborate</a>
      </div>
      <p class="hero__location">{profile.location}</p>
    </div>

    <div class="hero__atlas-slot">
      <slot name="atlas" />
    </div>
  </div>
</section>
