---
import type { AtlasWorld } from '../types/index.js';

export interface Props {
  world: AtlasWorld;
  offsetClass?: string;
  /** Visual hierarchy: flagship worlds render slightly larger dioramas. */
  scale?: 'lg' | 'md' | 'sm';
}

const { world, offsetClass = '', scale = 'md' } = Astro.props as Props;
const accentTokens = {
  magenta: 'var(--nest-magenta)',
  pink: 'var(--nest-pink)',
  violet: 'var(--nest-violet)',
  blue: 'var(--nest-blue)',
  cyan: 'var(--nest-cyan)',
  orange: 'var(--nest-sunset-orange)',
} as const;
const islandSrc = `/assets/nest/${world.island}.webp`;
const islandSrcSm = `/assets/nest/${world.island}-sm.webp`;
const islandPngSrcSet = `/assets/${world.island}-220.png 220w, /assets/${world.island}-440.png 440w`;
const islandPng = `/assets/${world.island}-220.png`;
const islandSmallWidth = world.island === 'island-harness' ? 320 : 440;
const islandSizes = '(max-width: 640px) 160px, (max-width: 1024px) 180px, 200px';
const plateFrame = world.accent === 'cyan' || world.accent === 'blue' ? 'neon-frame-accent' : 'neon-frame';
---

<a
  href={world.path}
  class:list={['atlas-world', `atlas-world--${scale}`, offsetClass, world.id === 'projects' && 'atlas-world--city']}
  style={`--world-color: ${accentTokens[world.accent]}`}
  data-world-id={world.id}
  data-related-worlds={world.relatedWorlds.join(' ')}
  aria-label={`${world.number} — ${world.title}: ${world.description}`}
>
  <span class:list={['atlas-world__plate', plateFrame, 'clip-corner-sm']}>
    <span class="atlas-world__number">{world.number}</span>
    <strong class="atlas-world__title">{world.title}</strong>
    <span class="atlas-world__description">{world.description}</span>
  </span>

  <span class="atlas-world__platform" aria-hidden="true">
    <span class="atlas-world__glow"></span>
    <svg class="atlas-world__dock" viewBox="0 0 320 112" aria-hidden="true">
      <ellipse class="atlas-world__dock-shadow" cx="160" cy="91" rx="125" ry="13" />
      <path class="atlas-world__dock-side" d="m33 48 127 35 127-35-14 18-113 32L47 66z" />
      <path class="atlas-world__dock-surface" d="m33 48 127-35 127 35-127 37z" />
      <path class="atlas-world__dock-grid" d="m68 38 92 27 92-27m-146-10 54 16 54-16m-54-11v67m-42-54v41m84-41v41" />
      <path class="atlas-world__dock-ring" d="M72 50c17-20 159-20 176 0s-61 32-88 32-105-12-88-32Z" />
      <path class="atlas-world__dock-signal" d="m46 52 112 33 111-33" />
    </svg>
    <picture class="atlas-world__visual">
      <source type="image/webp" srcset={`${islandSrcSm} ${islandSmallWidth}w, ${islandSrc} 640w`} sizes={islandSizes} />
      <source type="image/png" srcset={islandPngSrcSet} sizes={islandSizes} />
      <img
        class="atlas-world__island art-fade"
        src={islandPng}
        width="220"
        height="220"
        alt=""
        loading="lazy"
        decoding="async"
      />
    </picture>
  </span>
</a>
