---
import type { AtlasWorld } from '../types/index.js';

export interface Props {
  world: AtlasWorld;
  offsetClass?: string;
  /** Visual hierarchy: flagship worlds render slightly larger dioramas. */
  scale?: 'lg' | 'md' | 'sm';
}

const { world, offsetClass = '', scale = 'md' } = Astro.props as Props;
const accentTokens = {
  magenta: 'var(--nest-magenta)',
  pink: 'var(--nest-pink)',
  violet: 'var(--nest-violet)',
  blue: 'var(--nest-blue)',
  cyan: 'var(--nest-cyan)',
  orange: 'var(--nest-sunset-orange)',
} as const;
const islandSrc = `/assets/nest/${world.island}.webp`;
const islandSrcSm = `/assets/nest/${world.island}-sm.webp`;
const islandPng = `/assets/${world.island}.png`;
const plateFrame = world.accent === 'cyan' || world.accent === 'blue' ? 'neon-frame-accent' : 'neon-frame';
---

<a
  href={world.path}
  class:list={['atlas-world', `atlas-world--${scale}`, offsetClass]}
  style={`--world-color: ${accentTokens[world.accent]}`}
  data-world-id={world.id}
  data-related-worlds={world.relatedWorlds.join(' ')}
  aria-label={`${world.number} — ${world.title}: ${world.description}`}
>
  <span class:list={['atlas-world__plate', plateFrame, 'clip-corner-sm']}>
    <span class="atlas-world__number">{world.number}</span>
    <strong class="atlas-world__title">{world.title}</strong>
    <span class="atlas-world__description">{world.description}</span>
  </span>

  <span class="atlas-world__platform" aria-hidden="true">
    <span class="atlas-world__glow"></span>
    <picture class="atlas-world__visual">
      <source
        type="image/webp"
        srcset={`${islandSrcSm} 256w, ${islandSrc} 512w`}
        sizes="(max-width: 640px) 160px, (max-width: 1024px) 180px, 200px"
      />
      <img
        class="atlas-world__island art-fade"
        src={islandPng}
        width="220"
        height="220"
        alt=""
        loading="lazy"
        decoding="async"
      />
    </picture>
  </span>
</a>
