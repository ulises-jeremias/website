---
import { atlasWorlds } from '../data/index.js';
import AtlasConnections from './AtlasConnections.astro';
import ProjectWorld from './ProjectWorld.astro';
import ResponsibilityTopology from '@/shared/components/ResponsibilityTopology.astro';

/**
 * Reference homepage order (also encoded in project-worlds priorities):
 * Dotfiles → Toolkit → Workstation → V → Create Awesome → Community → Blog → Projects → OSS
 *
 * Offset classes create depth on desktop; they are neutralized on mobile
 * in favor of a vertical journey composition.
 */
const offsetClasses = ['atlas-world--rise', 'atlas-world--mid', 'atlas-world--drop'] as const;

const scaleFor = (id: string): 'lg' | 'md' | 'sm' => {
  if (id === 'toolkit' || id === 'workstation' || id === 'dotfiles') return 'lg';
  if (id === 'blog' || id === 'open-source') return 'sm';
  return 'md';
};
---

<section
  id="project-atlas"
  class="project-atlas"
  aria-labelledby="project-atlas-title"
  aria-describedby="project-atlas-guide"
>
  <header class="project-atlas__header">
    <div class="project-atlas__label">
      <span class="project-atlas__label-rule" aria-hidden="true"></span>
      <p id="project-atlas-title" class="project-atlas__eyebrow text-glow-accent">Project Worlds</p>
      <span class="project-atlas__label-rule project-atlas__label-rule--flip" aria-hidden="true"></span>
    </div>
    <span class="project-atlas__chevron" aria-hidden="true"></span>
  </header>

  <p id="project-atlas-guide" class="project-atlas__guide">
    Build surfaces first → workshop, notes, archive, and evidence complete the route.
  </p>

  <div class="project-atlas__stage">
    <AtlasConnections />
    <div class="project-atlas__worlds">
      {
        atlasWorlds.map((world, index) => (
          <ProjectWorld
            world={world}
            offsetClass={offsetClasses[index % offsetClasses.length]}
            scale={scaleFor(world.id)}
          />
        ))
      }
    </div>
  </div>
  <ResponsibilityTopology />
</section>
