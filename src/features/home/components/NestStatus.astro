---
import { nestStack, nestStatus } from '../data/index.js';

/** Decorative activity wave — not presented as live metrics. */
const series = [14, 20, 12, 26, 18, 30, 22, 34, 24, 40, 28, 36, 30, 44, 32, 26, 38, 30, 46, 34, 40, 28, 48, 36, 42];

function toSmoothPath(values: number[], width: number, height: number): string {
  const max = Math.max(...values);
  const step = width / (values.length - 1);
  const pts = values.map((v, i) => [i * step, height - (v / max) * height] as const);

  return pts.reduce((path, [x, y], i) => {
    if (i === 0) return `M${x.toFixed(1)} ${y.toFixed(1)}`;
    const [px, py] = pts[i - 1];
    const cx = (px + x) / 2;
    return `${path} C${cx.toFixed(1)} ${py.toFixed(1)} ${cx.toFixed(1)} ${y.toFixed(1)} ${x.toFixed(1)} ${y.toFixed(1)}`;
  }, '');
}

const linePath = toSmoothPath(series, 260, 44);
const fillPath = `${linePath} L260 54 L0 54 Z`;
---

<section class="nest-status neon-frame clip-corner" aria-labelledby="nest-status-title">
  <header class="nest-status__header">
    <h2 id="nest-status-title" class="nest-status__eyebrow text-glow-accent">Digital Nest Status</h2>
    <span class="nest-status__rule" aria-hidden="true"></span>
  </header>

  <dl class="nest-status__grid">
    {
      nestStatus.map((item) => (
        <div class:list={['nest-status__item', `nest-status__item--${item.tone}`]}>
          <dt>
            <span class="nest-status__prompt" aria-hidden="true">
              &gt;
            </span>
            {item.label}
          </dt>
          <dd>{item.value}</dd>
        </div>
      ))
    }
  </dl>

  <svg
    class="nest-status__spark"
    viewBox="0 0 260 54"
    fill="none"
    preserveAspectRatio="none"
    aria-hidden="true"
    focusable="false"
  >
    <defs>
      <linearGradient id="nest-spark" x1="0" y1="0" x2="1" y2="0">
        <stop offset="0%" stop-color="var(--nest-magenta)"></stop>
        <stop offset="100%" stop-color="var(--nest-cyan)"></stop>
      </linearGradient>
    </defs>
    <path d={fillPath} fill="url(#nest-spark)" opacity="0.12" stroke="none"></path>
    <path
      d={linePath}
      stroke="url(#nest-spark)"
      stroke-width="1.6"
      stroke-linecap="round"
      class="nest-status__spark-line"></path>
  </svg>

  <div class="nest-status__stack">
    {
      nestStack.map((row) => (
        <p>
          <span class="nest-status__prompt" aria-hidden="true">
            &gt;
          </span>
          {row.map((item, index) => (
            <>
              {index > 0 && (
                <span class="nest-status__sep" aria-hidden="true">
                  •
                </span>
              )}
              <span>{item}</span>
            </>
          ))}
        </p>
      ))
    }
  </div>
</section>
