---
/**
 * Strengths — E-08 without generic skill bars
 * Systems, not percentages.
 */
import Section from '@/shared/components/Section.astro';
import { strengths } from '../data/index.js';
---

<Section
  id="strengths"
  eyebrow="Strengths — systems, not bars"
  title="How I work, not how I score"
  lead="No skill bars. Each strength is a system: principles, tools, and proof you can verify."
  tinted
>
  <div class="strengths__grid">
    {
      strengths.map((s) => (
        <article class="strength">
          <div class="strength__icon" aria-hidden="true">
            {s.icon}
          </div>
          <h3 class="strength__title">{s.title}</h3>
          <p class="strength__desc">{s.description}</p>
          <ul class="strength__list">
            {s.points.map((pt) => (
              <li>{pt}</li>
            ))}
          </ul>
        </article>
      ))
    }
  </div>
</Section>
