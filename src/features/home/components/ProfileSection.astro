---
/**
 * Profile and current-role section — E-05
 * Verified facts only, no invented claims.
 */
import Section from '@/shared/components/Section.astro';
import { profile } from '@/data/profile';

const roles = profile.roles;
const focus = profile.focusAreas;
---

<Section
  id="profile"
  eyebrow="Profile · verified"
  title="Solutions Architect, V Core Team, AUR Maintainer"
  lead="Warm, precise, and reproducible — I help teams ship tooling that survives reinstalls and handoffs."
>
  <div class="profile">
    <div class="profile__card">
      <h3 class="profile__name">
        {profile.displayName}
        <span aria-hidden="true">·</span>
        <span style="font-weight:600;color:var(--text-muted);font-size:var(--text-lg);">{profile.pronouns}</span>
      </h3>
      <p class="profile__title">{profile.title}</p>
      <p class="profile__location" aria-label="Location"><span aria-hidden="true">📍</span> {profile.location}</p>
      <p class="profile__bio">{profile.bio}</p>
      <ul class="profile__roles" aria-label="Roles">
        {
          roles.map((role) =>
            role.href ? (
              <li>
                <a href={role.href} class="profile__role" target="_blank" rel="noreferrer noopener">
                  <span aria-hidden="true">{role.icon ?? '·'}</span> {role.label}{' '}
                  {role.organization ? `· ${role.organization}` : ''}
                </a>
              </li>
            ) : (
              <li>
                <span class="profile__role">
                  <span aria-hidden="true">{role.icon ?? '·'}</span> {role.label}
                </span>
              </li>
            ),
          )
        }
      </ul>
      <p class="profile__bio" style="margin-bottom:0;font-size:var(--text-sm);">{profile.summary}</p>
    </div>

    <div class="profile__meta">
      <div class="profile__card">
        <h4 class="profile__meta-title">Focus areas</h4>
        <ul
          style="margin:0;padding-left:1.2rem;color:var(--text-muted);font-size:var(--text-sm);line-height:var(--leading-relaxed);"
        >
          {focus.map((item) => <li>{item}</li>)}
        </ul>
      </div>
      <div class="profile__card">
        <h4 class="profile__meta-title">Languages & tooling</h4>
        <div style="display:flex;flex-wrap:wrap;gap:var(--space-2);">
          {
            profile.languages.map((lang) => (
              <span style="padding:var(--space-1) var(--space-2);border-radius:var(--radius-pill);background:var(--bg-subtle);border:1px solid var(--border);font-size:var(--text-xs);font-weight:600;color:var(--text-muted);">
                {lang}
              </span>
            ))
          }
        </div>
        <p style="margin-top:var(--space-3);color:var(--text-faint);font-size:var(--text-xs);">
          Learning: Science Computation, Linux distro development, AI-assisted workflows
        </p>
      </div>
      <div class="profile__card">
        <h4 class="profile__meta-title">Verified links</h4>
        <ul class="profile__links" aria-label="Verified links">
          <li>
            <a href={profile.links.github} class="profile__link" target="_blank" rel="noreferrer noopener"
              ><span aria-hidden="true">🐙</span> GitHub</a
            >
          </li>
          <li>
            <a href={profile.links.linkedin} class="profile__link" target="_blank" rel="noreferrer noopener"
              ><span aria-hidden="true">💼</span> LinkedIn</a
            >
          </li>
          <li>
            <a href={`mailto:${profile.links.email}`} class="profile__link profile__link--email"
              ><span aria-hidden="true">✉️</span> Email</a
            >
          </li>
          <li>
            <a href={profile.links.discord} class="profile__link" target="_blank" rel="noreferrer noopener"
              ><span aria-hidden="true">💬</span> Discord</a
            >
          </li>
        </ul>
      </div>
    </div>
  </div>
</Section>
