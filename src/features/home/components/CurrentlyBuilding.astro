---
/**
 * Currently building — E-06
 * Active focus areas without vanity metrics.
 */
import Section from '@/shared/components/Section.astro';
import { currentlyBuilding } from '../data/index.js';
---

<Section
  id="building"
  eyebrow="Currently building"
  title="What I’m building now"
  lead="Active, not aspirational — each tile is a repo you can read, run, and critique today."
  tinted
>
  <div class="building__grid">
    {
      currentlyBuilding.map((item) => (
        <article class="building-card">
          <div class="building-card__icon" aria-hidden="true">
            {item.icon}
          </div>
          <h3 class="building-card__title">{item.title}</h3>
          <p class="building-card__desc">{item.description}</p>
          <a href={item.href} class="building-card__link" target="_blank" rel="noreferrer noopener">
            Explore {item.tag ?? ''} <span aria-hidden="true">→</span>
          </a>
        </article>
      ))
    }
  </div>
</Section>
