---
import FlagshipProvenance from '@/shared/components/FlagshipProvenance.astro';
import SupportNote from '@/shared/components/SupportNote.astro';
import { SceneInspector, WorldDock } from '@/shared/components/visual';
import '@/shared/components/visual/visual.css';
import DotfilesNarrative from './DotfilesNarrative.astro';
import LayersDiagram from './LayersDiagram.astro';
import ScreenshotGallery from './ScreenshotGallery.astro';
import HorneroExtractionBridge from '@/shared/components/HorneroExtractionBridge.astro';
import { horneroRepositoryUrls, horneroSystemRepositories } from '@/data/hornero-transition.js';
import { attributionEntries, dotfilesLayers, heroArt, verifiedFacts } from '../data/index.js';

const layersJson = JSON.stringify(
  dotfilesLayers.map((l) => ({
    id: l.id,
    label: l.label,
    description: l.description,
    details: l.details,
  })),
);

const defaultLayer = dotfilesLayers[0]!;
const orderedLayers = [...dotfilesLayers].reverse();
const heroShot = heroArt;
---

<section class="df-world" aria-labelledby="df-world-title" data-df-world data-layers={layersJson}>
  <header class="df-world__hero">
    <div class="df-world__hero-copy">
      <p class="df-world__eyebrow">HorneroConfig · desktop</p>
      <div class="df-world__hero-rail" aria-label="Configuration review flow">
        <span>CHEZMOI SOURCE</span>
        <span aria-hidden="true">→</span>
        <span>REVIEW DIFF</span>
        <span aria-hidden="true">→</span>
        <span>APPLY BY CHOICE</span>
      </div>
      <h1 id="df-world-title">HorneroConfig</h1>
      <p class="df-world__problem">
        Personal Linux configuration drifts when it is hard to inspect, repeat, or keep separate from system defaults.
      </p>
      <p class="df-world__lede">
        HorneroConfig is the personal chezmoi source for an Arch Linux workstation. It manages user-level applications,
        preferences, and optional wallpaper media. Product defaults, appearance packs, the Quickshell shell, and stable
        system operations live in <a href="/hornero-os">Hornero OS</a> repositories.
      </p>
      <FlagshipProvenance
        entryId="horneroconfig"
        note="A personal chezmoi configuration layer with explicit review, privacy, and ownership boundaries."
      />
      <p class="df-world__fact-line">
        <span>personal config</span>
        <span aria-hidden="true">·</span>
        <span>{verifiedFacts.systemCli}</span>
        <span aria-hidden="true">·</span>
        <span>chezmoi</span>
      </p>
    </div>
    <figure class="df-world__hero-scene">
      <img
        src={heroShot.src}
        srcset={heroShot.srcSet}
        sizes="(min-width: 960px) 42rem, calc(100vw - 3rem)"
        alt={heroShot.alt}
        width={heroShot.width}
        height={heroShot.height}
        decoding="async"
        fetchpriority="high"
      />
      <figcaption class="df-world__hero-cap">{heroShot.caption}</figcaption>
    </figure>
  </header>

  <HorneroExtractionBridge
    currentPage="dotfiles"
    compositionRepoUrl={horneroRepositoryUrls.composition}
    repositories={horneroSystemRepositories}
  />

  <DotfilesNarrative />

  <WorldDock label="Review configuration">
    <a class="vf-dock__primary" href={verifiedFacts.repoUrl} target="_blank" rel="noopener noreferrer"> GitHub </a>
    <a href={verifiedFacts.readmeUrl} target="_blank" rel="noopener noreferrer">README ↗</a>
    <a href={verifiedFacts.contributingUrl} target="_blank" rel="noopener noreferrer">Contribution policy ↗</a>
    <button type="button" data-df-copy aria-label="Copy review command" hidden>Copy review command</button>
    <code
      class="vf-dock__code"
      data-df-review-command
      tabindex="0"
      role="region"
      aria-label="HorneroConfig review command"
      aria-describedby="df-review-command-hint">{verifiedFacts.reviewCommand}</code
    >
    <span class="df-world__review-command-hint" id="df-review-command-hint"
      >Review the proposed changes before applying this source.</span
    >
  </WorldDock>
  <p class="df-world__copy-status" role="status" aria-atomic="true" data-df-copy-status></p>

  <section class="df-world__methods">
    <h2 class="df-world__label">Other methods &amp; docs</h2>
    <ul>
      <li><code>{verifiedFacts.applyCommand}</code> — apply only after reviewing the diff</li>
      <li>
        <code>horneroctl --help</code> — product operations come from{' '}
        <a href={verifiedFacts.systemCliUrl} target="_blank" rel="noopener noreferrer">HorneroOS/hornero ↗</a>; inspect
        the <a href={verifiedFacts.horneroctlDocUrl} target="_blank" rel="noopener noreferrer">current CLI guide ↗</a>
      </li>
      <li>Package installation does not run <code>chezmoi apply</code> automatically.</li>
    </ul>
  </section>

  <div class="df-world__layers-block">
    <header class="df-world__layers-head">
      <p class="df-world__eyebrow">Architecture</p>
      <h2>Layer stack</h2>
    </header>
    <div class="vf-scene">
      <div class="vf-stage df-world__layers-stage">
        <LayersDiagram compact />
        <fieldset class="df-world__layer-controls" data-df-layer-controls disabled>
          <legend>Choose a HorneroConfig layer</legend>
          <div class="df-world__layer-options">
            {
              orderedLayers.map((layer) => (
                <>
                  <input
                    class="df-world__layer-radio"
                    type="radio"
                    name="df-layer"
                    id={`df-layer-${layer.id}`}
                    value={layer.id}
                    checked={layer.id === defaultLayer.id}
                    data-layer-control={layer.id}
                    aria-controls="df-layer-inspector"
                  />
                  <label class="vf-node" for={`df-layer-${layer.id}`}>
                    {layer.label}
                  </label>
                </>
              ))
            }
          </div>
        </fieldset>
        <noscript>
          <div class="df-world__layer-fallback" data-df-layer-fallback>
            <p>Interactive selection is unavailable. Complete stack, from daily surface to foundation:</p>
            <ul>
              {
                orderedLayers.map((layer) => (
                  <li>
                    <strong>{layer.label}</strong> — {layer.description}
                  </li>
                ))
              }
            </ul>
          </div>
        </noscript>
      </div>
      <SceneInspector eyebrow="Layer" title={defaultLayer.label} id="df-layer-inspector" live={false}>
        <p data-layer-copy>{defaultLayer.description}</p>
        <Fragment slot="meta">
          <div data-layer-meta>
            {defaultLayer.details.map((d) => <code data-layer-detail>{d}</code>)}
          </div>
        </Fragment>
      </SceneInspector>
    </div>
    <p class="df-world__layer-status" role="status" aria-atomic="true" data-df-layer-status></p>
  </div>

  <ScreenshotGallery />

  <aside class="df-world__prov" aria-label="Provenance">
    <p>
      <span>personal source</span>
      <span aria-hidden="true">·</span>
      <span>{verifiedFacts.systemCli}</span>
      <span aria-hidden="true">·</span>
      <span>verified upstream {verifiedFacts.verifiedAt} @{verifiedFacts.sourceRevision}</span>
    </p>
  </aside>

  <section class="df-world__attribution">
    <h2 class="df-world__label">Attribution &amp; licenses</h2>
    <ul>
      {
        attributionEntries.map((entry) => (
          <li>
            <strong>{entry.component}</strong> · {entry.license} · {entry.source}
            <span> — {entry.notes}</span>
          </li>
        ))
      }
    </ul>
  </section>

  <nav class="df-world__links" aria-label="Related worlds">
    <a href="/hornero-os">Hornero OS</a>
    <a href="/community">Community</a>
    <a href="/agentic-workstation">Workstation</a>
    <a href="/agent-toolkit">Toolkit</a>
    <a href={verifiedFacts.repoUrl} target="_blank" rel="noopener noreferrer">GitHub ↗</a>
  </nav>

  <SupportNote area="hornero" />
</section>

<script>
  function clearChildren(el: HTMLElement) {
    while (el.firstChild) el.removeChild(el.firstChild);
  }

  function initWorld(root: HTMLElement) {
    type Layer = { id: string; label: string; description: string; details: string[] };
    const layers = JSON.parse(root.dataset.layers || '[]') as Layer[];

    const title = root.querySelector('#df-layer-inspector .vf-inspector__title');
    const copy = root.querySelector<HTMLElement>('[data-layer-copy]');
    const meta = root.querySelector<HTMLElement>('[data-layer-meta]');
    const controls = root.querySelector<HTMLFieldSetElement>('[data-df-layer-controls]');
    const radios = Array.from(root.querySelectorAll<HTMLInputElement>('[data-layer-control]'));
    const status = root.querySelector<HTMLElement>('[data-df-layer-status]');

    const selectLayer = (id: string, announce = false) => {
      const layer = layers.find((l) => l.id === id) || layers[0];
      if (!layer) return;
      if (title) title.textContent = layer.label;
      if (copy) copy.textContent = layer.description;
      if (meta) {
        clearChildren(meta);
        layer.details.forEach((d) => {
          const code = document.createElement('code');
          code.textContent = d;
          meta.appendChild(code);
        });
      }
      root.querySelectorAll<SVGGElement>('[data-layer-visual]').forEach((g) => {
        g.classList.toggle('is-selected', g.dataset.layerVisual === id);
      });
      if (announce && status) status.textContent = `Layer selected: ${layer.label} — ${layer.description}.`;
    };

    radios.forEach((input) => {
      input.addEventListener('change', () => {
        if (input.checked) selectLayer(input.value, true);
      });
    });

    root.querySelectorAll<SVGGElement>('[data-layer-visual]').forEach((g) => {
      g.classList.add('is-pointer-ready');
      g.addEventListener('click', () => {
        const radio = radios.find((input) => input.value === g.dataset.layerVisual);
        radio?.click();
      });
    });

    const reviewCommand = root.querySelector<HTMLElement>('[data-df-review-command]');
    const copyButton = root.querySelector<HTMLButtonElement>('[data-df-copy]');
    const copyStatus = root.querySelector<HTMLElement>('[data-df-copy-status]');
    reviewCommand?.addEventListener('keydown', (event) => {
      if (!['ArrowLeft', 'ArrowRight', 'Home', 'End', 'PageUp', 'PageDown'].includes(event.key)) return;
      event.preventDefault();
      if (event.key === 'Home') {
        reviewCommand.scrollLeft = 0;
        return;
      }
      if (event.key === 'End') {
        reviewCommand.scrollLeft = reviewCommand.scrollWidth;
        return;
      }
      const amount = 120;
      const direction = event.key === 'ArrowLeft' || event.key === 'PageUp' ? -1 : 1;
      reviewCommand.scrollBy({ left: amount * direction, behavior: 'auto' });
    });
    if (copyButton) {
      copyButton.addEventListener('click', async () => {
        const text = reviewCommand?.textContent || '';
        try {
          await navigator.clipboard.writeText(text);
          if (copyStatus) copyStatus.textContent = 'Review command copied.';
        } catch {
          if (copyStatus) copyStatus.textContent = 'Copy failed. Select and copy the command manually.';
        }
      });
      copyButton.hidden = false;
    }

    const initialRadio = radios.find((input) => input.checked) ?? radios[0];
    if (initialRadio) selectLayer(initialRadio.value);
    if (controls) controls.disabled = false;
  }

  document.querySelectorAll<HTMLElement>('[data-df-world]').forEach(initWorld);
</script>

<style>
  .df-world {
    margin: 0 auto;
    padding-block: clamp(1.25rem, 3vw, 2.5rem) clamp(2rem, 5vw, 3.5rem);
    padding-inline: clamp(0.85rem, 2vw, 1.5rem);
    width: min(100% - 2 * var(--section-padding-x, 1.5rem), 78rem);
    border-inline: 1px solid color-mix(in srgb, var(--dotfiles-pink) 16%, transparent);
    --vf-node-accent: var(--dotfiles-pink);
  }

  .df-world__eyebrow {
    margin: 0 0 0.35rem;
    font-family: var(--font-mono);
    font-size: 0.75rem;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--dotfiles-pink);
  }

  .df-world__hero {
    display: grid;
    gap: 1rem;
    margin-bottom: 0.5rem;
  }

  .df-world__hero > * {
    min-inline-size: 0;
  }

  .df-world__hero {
    position: relative;
    padding-block: clamp(1.5rem, 4vw, 3.5rem);
    border-block: 1px solid color-mix(in srgb, var(--dotfiles-pink) 22%, transparent);
  }

  .df-world__hero-copy {
    padding-inline-start: clamp(0.75rem, 2vw, 1.5rem);
    border-inline-start: 2px solid color-mix(in srgb, var(--dotfiles-pink) 68%, transparent);
    container-type: inline-size;
  }

  .df-world__hero-rail {
    display: flex;
    flex-wrap: wrap;
    gap: 0.3rem 0.55rem;
    align-items: center;
    margin: 0 0 0.65rem;
    color: color-mix(in srgb, var(--dotfiles-pink) 72%, var(--nest-paper));
    font-family: var(--font-mono);
    font-size: 0.62rem;
    letter-spacing: 0.12em;
  }

  .df-world__hero-rail span:not([aria-hidden='true']) {
    padding: 0.18rem 0.35rem;
    border-block: 1px solid color-mix(in srgb, var(--dotfiles-pink) 38%, transparent);
  }

  @media (min-width: 960px) {
    .df-world__hero {
      grid-template-columns: minmax(22rem, 0.85fr) minmax(0, 1.25fr);
      align-items: end;
    }
  }

  .df-world h1 {
    margin: 0;
    /* 13-character brand word — scale to the copy column so it never clips. */
    font-size: clamp(1.6rem, 10.5cqw, 2.75rem);
    text-transform: uppercase;
    letter-spacing: 0.02em;
    line-height: 1.05;
    /* The brand name is a single 13-character word; never fracture it. */
    overflow-wrap: normal;
    word-break: keep-all;
  }

  .df-world__problem {
    margin: 0.6rem 0 0;
    max-inline-size: 44ch;
    font-size: 0.95rem;
    line-height: 1.55;
    color: var(--color-text-muted, #d5c2c6);
  }

  .df-world__lede {
    margin: 0.55rem 0 0;
    color: var(--color-text-muted, #d5c2c6);
    max-inline-size: 36ch;
    font-size: 1.02rem;
    line-height: 1.45;
  }

  .df-world__fact-line {
    margin: 1rem 0 0;
    font-family: var(--font-mono);
    font-size: 0.75rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: #c9a8b2;
    display: flex;
    flex-wrap: wrap;
    gap: 0.45rem;
    padding-top: 0.75rem;
    border-top: 1px solid color-mix(in srgb, var(--dotfiles-pink) 28%, transparent);
  }

  .df-world__copy-status {
    min-height: 1.4em;
    margin: 0.4rem 0 0;
    font-family: var(--font-mono);
    font-size: 0.75rem;
    color: var(--color-text-muted, #d5c2c6);
  }

  .df-world :global(.vf-dock__code) {
    display: block;
    min-inline-size: 0;
    max-inline-size: 100%;
    overflow-x: auto;
    white-space: nowrap;
  }

  .df-world :global(.vf-dock__code:focus-visible) {
    outline: 2px solid var(--dotfiles-pink);
    outline-offset: 3px;
  }

  .df-world__review-command-hint {
    flex: 1 1 100%;
    color: var(--dotfiles-pink-soft);
    font-family: var(--font-mono);
    font-size: 0.68rem;
  }

  .df-world__hero-scene {
    margin: 0;
    border: 1px solid color-mix(in srgb, #ffb0ca 35%, transparent);
    clip-path: var(--clip-corner-md, polygon(0 0, calc(100% - 12px) 0, 100% 12px, 100% 100%, 0 100%));
    overflow: hidden;
    background: #191114;
  }

  .df-world__hero-scene img {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 16 / 9;
    object-fit: cover;
  }

  .df-world__hero-cap {
    padding: 0.45rem 0.75rem;
    font-family: var(--font-mono);
    font-size: 0.75rem;
    letter-spacing: 0.06em;
    color: #c9a8b2;
    overflow-wrap: anywhere;
  }

  .df-world__methods,
  .df-world__attribution {
    margin-top: 0.5rem;
    color: var(--color-text-muted, #d5c2c6);
    font-size: 0.86rem;
  }

  .df-world__methods {
    margin-top: 1.5rem;
    padding: 0.9rem 1rem;
    border-block: 1px solid color-mix(in srgb, var(--dotfiles-pink) 22%, transparent);
    background: color-mix(in srgb, var(--dotfiles-plum) 72%, transparent);
  }

  .df-world__label {
    margin: 0 0 0.5rem;
    font-family: var(--font-mono);
    font-size: 0.75rem;
    font-weight: 400;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--color-text-faint, #c9a8b2);
  }

  .df-world__methods ul,
  .df-world__attribution ul {
    margin: 0.55rem 0 0;
    padding-left: 1.1rem;
    line-height: 1.55;
  }

  .df-world__methods code {
    color: #ffb0ca;
    font-size: 0.82rem;
  }

  .df-world__layers-head {
    margin: 1.75rem 0 0.65rem;
    padding-inline-start: 0.75rem;
    border-inline-start: 2px solid color-mix(in srgb, var(--dotfiles-pink) 60%, transparent);
  }

  .df-world__layers-head h2 {
    margin: 0;
    font-size: 1.05rem;
    text-transform: uppercase;
    letter-spacing: 0.04em;
  }

  .df-world__layers-stage {
    min-height: 18rem;
    padding: 0.65rem;
    border-color: color-mix(in srgb, #ffb0ca 40%, transparent);
    background:
      radial-gradient(ellipse 70% 55% at 50% 0%, color-mix(in srgb, #ffb0ca 14%, transparent), transparent 65%),
      color-mix(in srgb, #191114 96%, #3a232e);
  }

  .df-world__layer-controls {
    min-inline-size: 0;
    margin: 0.75rem 0 0;
    padding: 0;
    border: 0;
  }

  .df-world__layer-controls legend {
    margin: 0 0 0.5rem;
    padding: 0;
    color: #c9a8b2;
    font-family: var(--font-mono);
    font-size: 0.75rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  .df-world__layer-options {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
  }

  .df-world__layer-radio {
    position: absolute;
    inline-size: 1px;
    block-size: 1px;
    opacity: 0;
    pointer-events: none;
  }

  .df-world__layer-radio:checked + .vf-node,
  .df-world__layer-radio:focus-visible + .vf-node {
    border-color: #ffb0ca;
    color: var(--nest-paper);
    box-shadow: 0 0 0 2px color-mix(in srgb, #ffb0ca 35%, transparent);
  }

  .df-world__layer-radio:checked + .vf-node {
    background: color-mix(in srgb, #ffb0ca 16%, transparent);
  }

  .df-world__layer-controls:disabled .vf-node {
    cursor: default;
    opacity: 0.72;
  }

  .df-world__layer-fallback {
    margin-top: 0.75rem;
    color: var(--color-text-muted, #d5c2c6);
    font-size: 0.82rem;
    line-height: 1.5;
  }

  .df-world__layer-fallback p,
  .df-world__layer-fallback ul {
    margin-block: 0.45rem 0;
  }

  .df-world__layer-status {
    position: absolute;
    inline-size: 1px;
    block-size: 1px;
    margin: -1px;
    padding: 0;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }

  #df-layer-inspector [data-layer-meta] {
    display: grid;
    gap: 0.35rem;
  }

  #df-layer-inspector code {
    display: block;
    white-space: normal;
    line-height: 1.4;
  }

  @media (forced-colors: active) {
    .df-world__layer-radio:checked + .vf-node {
      border-color: Highlight;
    }

    .df-world__layer-radio:focus-visible + .vf-node {
      outline: 2px solid Highlight;
      outline-offset: 2px;
    }
  }

  .df-world__prov {
    margin-top: 1.5rem;
    font-family: var(--font-mono);
    font-size: 0.75rem;
    letter-spacing: 0.08em;
    color: #c9a8b2;
  }

  .df-world__prov p {
    margin: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
  }

  .df-world__links {
    margin-top: 1rem;
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem 1.1rem;
    font-size: 0.86rem;
  }

  .df-world__links a {
    color: #ffb0ca;
    font-weight: 700;
    text-decoration: none;
  }
</style>
