---
import { screenshotItems } from '../data/index.js';

const hero = screenshotItems[0]!;
const rest = screenshotItems.slice(1);
---

<section class="df-gallery" data-reveal aria-labelledby="df-gallery-title" data-df-gallery>
  <header class="df-gallery__header">
    <p class="df-gallery__eyebrow">Gallery</p>
    <h2 id="df-gallery-title">Desktop captures</h2>
  </header>

  <figure class="df-gallery__hero">
    <img
      src={hero.src}
      srcset={hero.srcSet}
      sizes="(min-width: 1184px) 74rem, calc(100vw - 3rem)"
      alt={hero.alt}
      width={hero.width}
      height={hero.height}
      loading="lazy"
      decoding="async"
      data-gallery-main
    />
    <figcaption>
      <span data-gallery-caption>{hero.caption}</span>
      <span class="df-gallery__credit" data-gallery-credit>{hero.credit}</span>
    </figcaption>
  </figure>

  <ul class="df-gallery__rail" aria-label="Select capture">
    {
      screenshotItems.map((shot, i) => (
        <li>
          <button
            type="button"
            class="df-gallery__thumb"
            aria-pressed={i === 0 ? 'true' : 'false'}
            data-gallery-id={shot.id}
            data-src={shot.src}
            data-srcset={shot.srcSet}
            data-alt={shot.alt}
            data-caption={shot.caption}
            data-credit={shot.credit}
            data-w={String(shot.width)}
            data-h={String(shot.height)}
          >
            <img
              src={shot.src}
              srcset={shot.srcSet}
              sizes="160px"
              alt=""
              width="160"
              height="90"
              loading="lazy"
              decoding="async"
            />
            <span>{shot.caption}</span>
          </button>
        </li>
      ))
    }
  </ul>

  <p class="df-gallery__note">
    First-party MIT captures from <code>dotfiles/static</code>
    {rest.length ? ` · ${screenshotItems.length} frames` : ''}.
  </p>
</section>

<script>
  function initGallery(root: HTMLElement) {
    const main = root.querySelector<HTMLImageElement>('[data-gallery-main]');
    const caption = root.querySelector<HTMLElement>('[data-gallery-caption]');
    const credit = root.querySelector<HTMLElement>('[data-gallery-credit]');
    const thumbs = Array.from(root.querySelectorAll<HTMLButtonElement>('[data-gallery-id]'));

    const select = (btn: HTMLButtonElement) => {
      thumbs.forEach((t) => t.setAttribute('aria-pressed', t === btn ? 'true' : 'false'));
      if (main) {
        main.src = btn.dataset.src || main.src;
        main.srcset = btn.dataset.srcset || '';
        main.alt = btn.dataset.alt || '';
        if (btn.dataset.w) main.width = Number(btn.dataset.w);
        if (btn.dataset.h) main.height = Number(btn.dataset.h);
      }
      if (caption) caption.textContent = btn.dataset.caption || '';
      if (credit) credit.textContent = btn.dataset.credit || '';
    };

    thumbs.forEach((btn, index) => {
      btn.addEventListener('click', () => select(btn));
      btn.addEventListener('keydown', (e) => {
        if (e.key === 'ArrowRight') {
          e.preventDefault();
          const next = thumbs[(index + 1) % thumbs.length]!;
          next.focus();
          select(next);
        } else if (e.key === 'ArrowLeft') {
          e.preventDefault();
          const prev = thumbs[(index - 1 + thumbs.length) % thumbs.length]!;
          prev.focus();
          select(prev);
        }
      });
    });
  }

  document.querySelectorAll<HTMLElement>('[data-df-gallery]').forEach(initGallery);
</script>

<style>
  .df-gallery {
    margin-top: 1.75rem;
  }

  .df-gallery__eyebrow {
    margin: 0 0 0.25rem;
    font-family: var(--font-mono);
    font-size: 0.75rem;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: #ffb0ca;
  }

  .df-gallery__header h2 {
    margin: 0 0 0.75rem;
    font-size: clamp(1.2rem, 2.4vw, 1.55rem);
    text-transform: uppercase;
    letter-spacing: 0.03em;
  }

  .df-gallery__hero {
    margin: 0;
    border: 1px solid color-mix(in srgb, #ffb0ca 35%, transparent);
    clip-path: var(--clip-corner-md, polygon(0 0, calc(100% - 12px) 0, 100% 12px, 100% 100%, 0 100%));
    overflow: hidden;
    background: #191114;
  }

  .df-gallery__hero img {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 16 / 9;
    object-fit: cover;
  }

  .df-gallery__hero figcaption {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 0.35rem 1rem;
    padding: 0.65rem 0.85rem;
    font-size: 0.88rem;
    color: #fbe7ec;
    background: color-mix(in srgb, #191114 92%, transparent);
  }

  .df-gallery__credit {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    color: #c9a8b2;
  }

  .df-gallery__rail {
    display: grid;
    grid-auto-flow: column;
    grid-auto-columns: minmax(9.5rem, 1fr);
    gap: 0.55rem;
    margin: 0.75rem 0 0;
    padding: 0 0 0.25rem;
    list-style: none;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    -webkit-overflow-scrolling: touch;
  }

  .df-gallery__rail > li {
    margin: 0;
    padding: 0;
    min-width: 0;
  }

  .df-gallery__thumb {
    appearance: none;
    display: grid;
    gap: 0.35rem;
    margin: 0;
    padding: 0.35rem;
    border: 1px solid rgba(255, 176, 202, 0.2);
    background: color-mix(in srgb, #191114 90%, transparent);
    color: #d5c2c6;
    text-align: left;
    cursor: pointer;
    scroll-snap-align: start;
    min-height: 44px;
    clip-path: var(--clip-corner-sm, polygon(0 0, calc(100% - 8px) 0, 100% 8px, 100% 100%, 0 100%));
  }

  .df-gallery__thumb img {
    display: block;
    width: 100%;
    height: 4.5rem;
    object-fit: cover;
    background: #191114;
  }

  .df-gallery__thumb span {
    font-size: 0.75rem;
    line-height: 1.3;
    font-family: var(--font-mono);
    letter-spacing: 0.02em;
  }

  .df-gallery__thumb[aria-pressed='true'] {
    border-color: #ffb0ca;
    color: #fbe7ec;
    box-shadow: 0 0 0 2px color-mix(in srgb, #ffb0ca 35%, transparent);
  }

  .df-gallery__note {
    margin: 0.65rem 0 0;
    font-size: 0.78rem;
    color: #c9a8b2;
  }

  .df-gallery__note code {
    color: #ffb0ca;
    font-size: inherit;
  }
</style>
