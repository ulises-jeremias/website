---
import { screenshotItems } from '../data/index.js';

const assetById: Record<string, string> = {
  collage: '/media/dotfiles/collage.png',
  dark: '/media/dotfiles/screen.png',
  light: '/media/dotfiles/screen-2.jpg',
  launchpad: '/media/dotfiles/screenshot-launchpad.png',
  spotlight: '/media/dotfiles/screenshot-spotlight-dark.png',
};
---

<section class="screenshot-gallery" aria-labelledby="gallery-title">
  <header class="screenshot-gallery__header">
    <p class="screenshot-gallery__eyebrow">Gallery</p>
    <h2 id="gallery-title" class="screenshot-gallery__title">Real MIT captures from HorneroConfig</h2>
    <p class="screenshot-gallery__desc">
      First-party screenshots from <code>dotfiles/static</code> (MIT). Lazy-loaded, descriptive <code>alt</code>, and
      license notes below — no stock wallpapers or unverified collage assets.
    </p>
  </header>

  <div class="screenshot-gallery__grid" role="list">
    {
      screenshotItems.map((shot) => (
        <figure class="screenshot-gallery__card" role="listitem">
          <img
            class="screenshot-gallery__img"
            src={assetById[shot.id] ?? assetById.dark}
            alt={shot.alt}
            width={String(shot.width)}
            height={String(shot.height)}
            loading="lazy"
            decoding="async"
          />
          <figcaption class="screenshot-gallery__caption">
            <span class="screenshot-gallery__caption-title">{shot.caption}</span>
            <span class="screenshot-gallery__caption-credit">{shot.credit}</span>
          </figcaption>
        </figure>
      ))
    }
  </div>

  <div class="screenshot-gallery__dialog" role="note" aria-label="License and integration notes">
    <h3 class="screenshot-gallery__dialog-title">License notes</h3>
    <ul class="screenshot-gallery__dialog-list">
      <li>
        <strong>MIT assets:</strong> files under <code>public/media/dotfiles/</code> are copied from
        <code>ulises-jeremias/dotfiles/static</code> (MIT, 2019–2025).
      </li>
      <li>
        <strong>Wallpapers:</strong> rice background images may carry separate licenses — verify before redistribution.
      </li>
      <li>
        <strong>Quickshell GPL-3.0:</strong> shell UI adapted from <code>caelestia-dots/shell</code> — respect GPL-3.0 if
        redistributing derived binaries.
      </li>
    </ul>
  </div>
</section>

<style>
  .screenshot-gallery {
    width: min(100% - 2 * var(--section-padding-x), 72rem);
    margin: 0 auto;
    padding-block: clamp(1.5rem, 4vw, 2.75rem);
  }

  .screenshot-gallery__eyebrow {
    margin: 0 0 var(--space-2);
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--world-accent-tertiary, #f4c7a5);
  }

  .screenshot-gallery__title {
    margin: 0 0 var(--space-3);
    font-size: clamp(1.35rem, 2.8vw, 1.85rem);
    text-transform: uppercase;
    letter-spacing: 0.03em;
    color: var(--theme-pink, #ffb0ca);
  }

  .screenshot-gallery__desc {
    margin: 0;
    max-inline-size: 68ch;
    color: var(--color-text-muted);
  }

  .screenshot-gallery__grid {
    display: grid;
    gap: 1rem;
    margin-block: 1.35rem;
    grid-template-columns: repeat(auto-fill, minmax(16rem, 1fr));
    padding: 0;
    list-style: none;
  }

  .screenshot-gallery__card {
    margin: 0;
    border: 1px solid color-mix(in srgb, #ffb0ca 28%, transparent);
    background: color-mix(in srgb, #191114 92%, transparent);
    clip-path: polygon(0 0, calc(100% - 12px) 0, 100% 12px, 100% 100%, 0 100%);
    overflow: hidden;
  }

  .screenshot-gallery__img {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 4 / 3;
    object-fit: cover;
    background: #191114;
  }

  .screenshot-gallery__caption {
    display: grid;
    gap: 0.25rem;
    padding: 0.75rem 0.85rem;
  }

  .screenshot-gallery__caption-title {
    font-size: 0.9rem;
  }

  .screenshot-gallery__caption-credit {
    font-family: var(--font-mono);
    font-size: 0.68rem;
    color: var(--color-text-faint);
  }

  .screenshot-gallery__dialog {
    padding: 1rem;
    border: 1px solid var(--color-border);
    background: color-mix(in srgb, #3a232e 35%, var(--nest-midnight-900));
    clip-path: var(--clip-corner-md);
  }

  .screenshot-gallery__dialog-title {
    margin: 0 0 0.55rem;
    font-size: 0.95rem;
    color: #ffb0ca;
  }

  .screenshot-gallery__dialog-list {
    margin: 0;
    padding-inline-start: 1.1rem;
    color: var(--color-text-muted);
    font-size: 0.88rem;
  }

  .screenshot-gallery__dialog-list li + li {
    margin-block-start: 0.4rem;
  }
</style>
