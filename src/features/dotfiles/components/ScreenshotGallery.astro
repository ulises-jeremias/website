---
import { screenshotItems } from '../data/index.js';
---

<section class="screenshot-gallery" aria-labelledby="gallery-title">
  <header class="screenshot-gallery__header">
    <p class="screenshot-gallery__eyebrow">Gallery</p>
    <h2 id="gallery-title" class="screenshot-gallery__title">Desktop captures from HorneroConfig</h2>
    <p class="screenshot-gallery__desc">
      First-party screenshots from <code>ulises-jeremias/dotfiles/static</code> (MIT). Anime wallpaper stills and collage
      assets with unclear redistribution rights are omitted on purpose.
    </p>
  </header>

  <div class="screenshot-gallery__grid" role="list">
    {
      screenshotItems.map((shot) => (
        <figure class="screenshot-gallery__card" role="listitem">
          <img
            class="screenshot-gallery__img"
            src={shot.src}
            alt={shot.alt}
            width={String(shot.width)}
            height={String(shot.height)}
            loading="lazy"
            decoding="async"
          />
          <figcaption class="screenshot-gallery__caption">
            <span class="screenshot-gallery__caption-title">{shot.caption}</span>
            <span class="screenshot-gallery__caption-credit">{shot.credit}</span>
          </figcaption>
        </figure>
      ))
    }
  </div>
</section>

<style>
  .screenshot-gallery {
    width: min(100% - 2 * var(--section-padding-x, 1.2rem), 72rem);
    margin: 0 auto;
    padding-block: clamp(0.5rem, 2vw, 1rem);
  }

  .screenshot-gallery__eyebrow {
    margin: 0 0 var(--space-2, 0.5rem);
    font-family: var(--font-mono, ui-monospace, monospace);
    font-size: var(--text-xs, 0.75rem);
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--world-accent-tertiary, #f4c7a5);
  }

  .screenshot-gallery__title {
    margin: 0 0 var(--space-3, 0.75rem);
    font-size: clamp(1.35rem, 2.8vw, 1.85rem);
    text-transform: uppercase;
    letter-spacing: 0.03em;
    color: var(--theme-pink, #ffb0ca);
  }

  .screenshot-gallery__desc {
    margin: 0;
    max-inline-size: 68ch;
    color: var(--color-text-muted, #d5c2c6);
  }

  .screenshot-gallery__desc code {
    padding: 0.12rem 0.3rem;
    border-radius: 0.3rem;
    background: rgba(255, 176, 202, 0.13);
    color: #ffb0ca;
    font-size: 0.88em;
  }

  .screenshot-gallery__grid {
    display: grid;
    gap: 1rem;
    margin-block: 1.35rem 0;
    grid-template-columns: repeat(auto-fill, minmax(16rem, 1fr));
    padding: 0;
    list-style: none;
  }

  .screenshot-gallery__card {
    margin: 0;
    border: 1px solid color-mix(in srgb, #ffb0ca 28%, transparent);
    background: color-mix(in srgb, #191114 92%, transparent);
    clip-path: polygon(0 0, calc(100% - 12px) 0, 100% 12px, 100% 100%, 0 100%);
    overflow: hidden;
  }

  .screenshot-gallery__img {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 4 / 3;
    object-fit: cover;
    background: #191114;
  }

  .screenshot-gallery__caption {
    display: grid;
    gap: 0.25rem;
    padding: 0.75rem 0.85rem;
  }

  .screenshot-gallery__caption-title {
    font-size: 0.9rem;
    color: #fbe7ec;
  }

  .screenshot-gallery__caption-credit {
    font-family: var(--font-mono, ui-monospace, monospace);
    font-size: 0.68rem;
    color: var(--color-text-faint, #c9a8b2);
  }
</style>
