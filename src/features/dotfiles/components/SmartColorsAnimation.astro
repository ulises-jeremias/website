---
import { PlaybackControls, SceneInspector, StageScrubber, StatusMeter } from '@/shared/components/visual';
import { smartColorSteps, verifiedFacts } from '../data/index.js';

const stages = smartColorSteps.map((step, i) => ({
  id: step.id,
  title: step.title,
  index: i,
}));

const stagesPayload = smartColorSteps.map((step, i) => ({
  id: step.id,
  title: step.title,
  description: step.description,
  detail: step.detail,
  progress: Math.round(((i + 1) / smartColorSteps.length) * 100),
}));

const stagesJson = JSON.stringify(stagesPayload);
const first = smartColorSteps[0]!;
---

<section class="df-colors" data-reveal aria-labelledby="df-colors-title" data-df-colors data-stages={stagesJson}>
  <header class="df-colors__head">
    <div>
      <p class="df-colors__eyebrow">Smart Colors</p>
      <h2 id="df-colors-title">Wallpaper → palette → apps</h2>
    </div>
    <StatusMeter
      value={Math.round((1 / smartColorSteps.length) * 100)}
      label="Pipeline"
      caption="stage"
      displayValue={`Step 1/${smartColorSteps.length}`}
      accent="#FFB0CA"
    />
  </header>

  <div class="vf-scene df-colors__scene">
    <div class="vf-stage df-colors__stage" data-pipeline>
      <svg
        class="df-colors__svg"
        viewBox="0 0 640 220"
        role="img"
        aria-label="Smart Colors pipeline: wallpaper, extraction, scheme cache, desktop consumers"
      >
        <defs>
          <linearGradient id="df-sc-rail" x1="0%" y1="0%" x2="100%" y2="0%">
            <stop offset="0%" stop-color="#FFB0CA" stop-opacity="0.15"></stop>
            <stop offset="100%" stop-color="#e2bdc7" stop-opacity="0.35"></stop>
          </linearGradient>
        </defs>
        <rect x="24" y="96" width="592" height="10" rx="5" fill="url(#df-sc-rail)"></rect>
        <path class="vf-flow is-active" data-sc-flow d="M88 101 H552" style="--vf-flow-accent:#FFB0CA"></path>

        {
          smartColorSteps.map((step, i) => {
            const x = 88 + i * 155;
            return (
              <g class="df-colors__node" data-sc-node={step.id} data-sc-index={String(i)}>
                <circle cx={x} cy="101" r="28" class="df-colors__disk" />
                <text x={x} y="97" text-anchor="middle" class="df-colors__idx">
                  {String(i + 1).padStart(2, '0')}
                </text>
                <text x={x} y="112" text-anchor="middle" class="df-colors__node-label">
                  {step.title.split(' ')[0]}
                </text>
              </g>
            );
          })
        }

        <!-- Stage vignettes -->
        <g data-sc-viz="wallpaper" class="df-colors__viz is-active">
          <rect x="200" y="24" width="72" height="40" rx="6" fill="#7a4a5f"></rect>
          <rect x="280" y="24" width="40" height="40" rx="6" fill="#FFB0CA"></rect>
          <rect x="328" y="24" width="56" height="40" rx="6" fill="#191114" stroke="#FFB0CA"></rect>
          <text x="320" y="78" text-anchor="middle" class="df-colors__viz-cap">dots-wallpaper-set</text>
        </g>
        <g data-sc-viz="extraction" class="df-colors__viz is-hidden">
          {
            ['#FFB0CA', '#e2bdc7', '#7a4a5f', '#4a2d3a', '#fbe7ec'].map((c, i) => (
              <circle cx={260 + i * 28} cy="44" r="10" fill={c} stroke="#191114" stroke-width="2" />
            ))
          }
          <text x="320" y="78" text-anchor="middle" class="df-colors__viz-cap"> pywal + materialyoucolor </text>
        </g>
        <g data-sc-viz="palette" class="df-colors__viz is-hidden">
          <rect x="220" y="28" width="200" height="36" rx="8" fill="#241a1f" stroke="rgba(255,176,202,0.35)"></rect>
          <text x="320" y="51" text-anchor="middle" class="df-colors__viz-code">scheme.json</text>
          <text x="320" y="78" text-anchor="middle" class="df-colors__viz-cap"> ~/.cache/dots/smart-colors/ </text>
        </g>
        <g data-sc-viz="apps" class="df-colors__viz is-hidden">
          <!-- Mini desktop: wallpaper plane + recolored consumers -->
          <rect x="190" y="18" width="260" height="88" rx="8" fill="#3a232e" stroke="#FFB0CA" stroke-width="1.25"
          ></rect>
          <rect x="200" y="28" width="100" height="56" rx="4" fill="#7a4a5f"></rect>
          <rect x="310" y="28" width="128" height="18" rx="3" fill="#191114" stroke="#FFB0CA"></rect>
          <text x="374" y="41" text-anchor="middle" class="df-colors__viz-app">Quickshell</text>
          <rect x="310" y="52" width="60" height="28" rx="3" fill="#191114" stroke="#e2bdc7"></rect>
          <text x="340" y="70" text-anchor="middle" class="df-colors__viz-app">Kitty</text>
          <rect x="378" y="52" width="60" height="28" rx="3" fill="#191114" stroke="#FFB0CA"></rect>
          <text x="408" y="70" text-anchor="middle" class="df-colors__viz-app">GTK</text>
          <text x="250" y="98" text-anchor="middle" class="df-colors__viz-cap">Hyprland desktop</text>
          <text x="420" y="98" text-anchor="middle" class="df-colors__viz-cap">recolored</text>
        </g>

        <text x="320" y="200" text-anchor="middle" class="df-colors__foot" aria-hidden="true">
          Maintained Hyprland + Quickshell path
        </text>
      </svg>
    </div>

    <SceneInspector eyebrow="Stage" title={first.title} id="df-colors-inspector">
      <p data-sc-copy>{first.description}</p>
      <Fragment slot="meta">
        <code data-sc-detail>{first.detail}</code>
      </Fragment>
    </SceneInspector>
  </div>

  <StageScrubber stages={stages} label="Smart Colors stage" />
  <PlaybackControls label="Smart Colors playback" />

  <p class="df-colors__docs">
    <a href={verifiedFacts.smartColorsWikiUrl} target="_blank" rel="noopener noreferrer">Smart Colors wiki ↗</a>
  </p>
</section>

<script>
  import { initStagePlayer } from '@/shared/lib/visual-stage-player';

  type Stage = {
    id: string;
    title: string;
    description: string;
    detail: string;
    progress: number;
  };

  function initColors(root: HTMLElement) {
    const stages = JSON.parse(root.dataset.stages || '[]') as Stage[];
    const title = root.querySelector('#df-colors-inspector .vf-inspector__title');
    const copy = root.querySelector<HTMLElement>('[data-sc-copy]');
    const detail = root.querySelector<HTMLElement>('[data-sc-detail]');
    const meter = root.querySelector<HTMLElement>('.vf-meter');
    const flow = root.querySelector<SVGPathElement>('[data-sc-flow]');

    const apply = (index: number) => {
      const stage = stages[index];
      if (!stage) return;
      if (title) title.textContent = stage.title;
      if (copy) copy.textContent = stage.description;
      if (detail) detail.textContent = stage.detail;
      if (meter) {
        meter.style.setProperty('--vf-meter-value', String(stage.progress));
        meter.setAttribute('aria-valuenow', String(stage.progress));
        meter.setAttribute('aria-valuetext', `Step ${index + 1}/${stages.length}`);
        const strong = meter.querySelector('[data-vf-meter-value], strong');
        if (strong) strong.textContent = `Step ${index + 1}/${stages.length}`;
      }
      root.querySelectorAll<SVGGElement>('[data-sc-node]').forEach((node) => {
        const on = node.dataset.scNode === stage.id;
        node.classList.toggle('is-active', on);
      });
      root.querySelectorAll<SVGGElement>('[data-sc-viz]').forEach((viz) => {
        const on = viz.dataset.scViz === stage.id;
        viz.classList.toggle('is-active', on);
        viz.classList.toggle('is-hidden', !on);
      });
      if (flow) {
        const length = 464;
        flow.style.strokeDasharray = `${(length * stage.progress) / 100} ${length}`;
      }
    };

    initStagePlayer({
      root,
      stageCount: stages.length,
      onStage: apply,
      autoplayOnce: true,
      intervalMs: 2200,
    });
  }

  document.querySelectorAll<HTMLElement>('[data-df-colors]').forEach(initColors);
</script>

<style>
  .df-colors {
    margin-top: 1.75rem;
  }

  .df-colors__head {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem;
    margin-bottom: 0.75rem;
  }

  .df-colors__eyebrow {
    margin: 0 0 0.25rem;
    font-family: var(--font-mono);
    font-size: 0.75rem;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: #ffb0ca;
  }

  .df-colors__head h2 {
    margin: 0;
    font-size: clamp(1.2rem, 2.4vw, 1.55rem);
    text-transform: uppercase;
    letter-spacing: 0.03em;
  }

  .df-colors__scene {
    margin-bottom: 0.75rem;
  }

  .df-colors__stage {
    min-height: 14rem;
    padding: 0.5rem;
    border-color: color-mix(in srgb, #ffb0ca 40%, transparent);
    background:
      radial-gradient(ellipse 70% 55% at 50% 0%, color-mix(in srgb, #ffb0ca 16%, transparent), transparent 65%),
      color-mix(in srgb, #191114 96%, #3a232e);
  }

  .df-colors__svg {
    display: block;
    width: 100%;
    height: auto;
  }

  .df-colors__disk {
    fill: color-mix(in srgb, #ffb0ca 18%, #191114);
    stroke: rgba(255, 176, 202, 0.35);
    stroke-width: 1.5;
  }

  .df-colors__node.is-active .df-colors__disk {
    fill: color-mix(in srgb, #ffb0ca 42%, #191114);
    stroke: #ffb0ca;
    stroke-width: 2.4;
  }

  .df-colors__idx,
  .df-colors__node-label {
    fill: #fbe7ec;
    font-family: var(--font-mono, ui-monospace, monospace);
    font-size: 12px;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .df-colors__node-label {
    fill: #d5c2c6;
    font-size: 12px;
  }

  .df-colors__viz-cap,
  .df-colors__foot {
    fill: #c9a8b2;
    font-family: var(--font-mono, ui-monospace, monospace);
    font-size: 12px;
    letter-spacing: 0.06em;
  }

  .df-colors__viz-code,
  .df-colors__viz-app {
    fill: #ffb0ca;
    font-family: var(--font-mono, ui-monospace, monospace);
    font-size: 12px;
    font-weight: 700;
  }

  .df-colors__viz-app {
    fill: #fbe7ec;
    font-size: 12px;
  }

  .df-colors__viz.is-hidden {
    display: none;
  }

  .df-colors :global(.vf-scrubber) {
    margin: 0.65rem 0 0.45rem;
  }

  .df-colors__docs {
    margin: 0.65rem 0 0;
    font-size: 0.82rem;
  }

  .df-colors__docs a {
    color: #ffb0ca;
    font-weight: 700;
    text-decoration: none;
  }

  #df-colors-inspector code {
    display: block;
    white-space: normal;
    line-height: 1.45;
    color: #d5c2c6;
  }
</style>
