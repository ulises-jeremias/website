---
import { dotfilesLayers } from '../data/index.js';

interface Props {
  /** When true, omit section chrome — parent supplies title/inspector. */
  compact?: boolean;
}

const { compact = true } = Astro.props;

const ordered = [...dotfilesLayers].reverse();

/**
 * Isometric slab palette, lit from the surface down: each deeper slab sits in
 * the shadow of the one above, so the value progression encodes stack depth.
 * Keyed by layer id; unknown ids fall back to the data color as a flat slab.
 */
const slabPalette: Record<string, { front: string; top: string; side: string }> = {
  shell: { front: '#552b3d', top: '#7d4258', side: '#3a1e2a' },
  compositor: { front: '#4a2534', top: '#6f3a4e', side: '#321a24' },
  terminal: { front: '#3f202d', top: '#613247', side: '#2b161e' },
  scripts: { front: '#341b27', top: '#522a3c', side: '#241219' },
  chezmoi: { front: '#2a1620', top: '#432336', side: '#1d0f14' },
};

const FACE = { x: 118, w: 430, h: 70, dx: 34, dy: 24, pitch: 98, top: 52 };
const RAIL_X = 64;

const slabFor = (index: number) => {
  const y = FACE.top + index * FACE.pitch;
  const x0 = FACE.x;
  const x1 = FACE.x + FACE.w;
  return {
    y,
    cy: y + FACE.h / 2,
    front: { x: x0, y, w: FACE.w, h: FACE.h },
    top: `${x0},${y} ${x0 + FACE.dx},${y - FACE.dy} ${x1 + FACE.dx},${y - FACE.dy} ${x1},${y}`,
    side: `${x1},${y} ${x1 + FACE.dx},${y - FACE.dy} ${x1 + FACE.dx},${y + FACE.h - FACE.dy} ${x1},${y + FACE.h}`,
  };
};

const paletteFor = (id: string, fallback: string) =>
  slabPalette[id] ?? { front: fallback, top: fallback, side: fallback };
---

<div class:list={['df-layers', { 'df-layers--compact': compact }]} data-df-layers>
  <svg
    class="df-layers__svg"
    viewBox="0 0 640 580"
    aria-hidden="true"
    focusable="false"
    xmlns="http://www.w3.org/2000/svg"
  >
    <text
      x={RAIL_X}
      y="20"
      text-anchor="middle"
      font-size="9"
      font-family="ui-monospace, SFMono-Regular, Menlo, monospace"
      letter-spacing="0.22em"
      fill="#8a6a76"
      aria-hidden="true"
    >
      SURFACE
    </text>
    <line
      x1={RAIL_X}
      y1="30"
      x2={RAIL_X}
      y2="556"
      stroke="rgba(255,176,202,0.25)"
      stroke-width="2"
      aria-hidden="true"
    ></line>
    {ordered.map((layer, index) => {
      const slab = slabFor(index);
      const palette = paletteFor(layer.id, layer.color);
      const numeral = String(index + 1).padStart(2, '0');
      return (
        <g class:list={['df-layers__layer', { 'is-selected': layer.id === 'chezmoi' }]} data-layer-visual={layer.id}>
          <text
            class="df-layers__num"
            x="34"
            y={slab.cy + 4}
            text-anchor="middle"
            font-size="11"
            font-family="ui-monospace, SFMono-Regular, Menlo, monospace"
            letter-spacing="0.08em"
            aria-hidden="true"
          >
            {numeral}
          </text>
          <line
            x1={RAIL_X + 6}
            y1={slab.cy}
            x2={FACE.x - 6}
            y2={slab.cy}
            stroke="rgba(255,176,202,0.22)"
            stroke-width="1.5"
            aria-hidden="true"
          />
          <circle class="df-layers__node" cx={RAIL_X} cy={slab.cy} r="5" stroke-width="1.5" aria-hidden="true" />
          <polygon
            points={slab.top}
            fill={palette.top}
            stroke="rgba(255,176,202,0.18)"
            stroke-width="1"
            aria-hidden="true"
          />
          <polygon
            points={slab.side}
            fill={palette.side}
            stroke="rgba(255,176,202,0.14)"
            stroke-width="1"
            aria-hidden="true"
          />
          <rect
            class="df-layers__front"
            x={slab.front.x}
            y={slab.front.y}
            width={slab.front.w}
            height={slab.front.h}
            rx="10"
            fill={palette.front}
          />
          <rect
            class="df-layers__accent"
            x={slab.front.x + 8}
            y={slab.front.y + 12}
            width="3"
            height="46"
            rx="1.5"
            aria-hidden="true"
          />
          <text
            x={slab.front.x + 24}
            y={slab.front.y + 31}
            font-size="17"
            font-weight="800"
            letter-spacing="-0.02em"
            fill="#fbe7ec"
          >
            {layer.label}
          </text>
          <text x={slab.front.x + 24} y={slab.front.y + 53} font-size="12.5" fill="#d5c2c6">
            {layer.description}
          </text>
          <circle
            cx={slab.front.x + slab.front.w - 9}
            cy={slab.front.y + 27}
            r="2.5"
            fill="#FFB0CA"
            opacity="0.85"
            aria-hidden="true"
          />
          <text
            x={slab.front.x + slab.front.w - 18}
            y={slab.front.y + 31}
            text-anchor="end"
            font-size="11"
            font-family="ui-monospace, SFMono-Regular, Menlo, monospace"
            letter-spacing="0.04em"
            fill="#FFB0CA"
          >
            {layer.shortLabel}
          </text>
        </g>
      );
    })}
    <rect
      x="109"
      y="528"
      width="448"
      height="30"
      rx="6"
      fill="#1a1015"
      stroke="rgba(255,176,202,0.22)"
      stroke-width="1"
      aria-hidden="true"
    ></rect>
    <text
      x="333"
      y="547"
      text-anchor="middle"
      font-size="11"
      font-family="ui-monospace, SFMono-Regular, Menlo, monospace"
      letter-spacing="0.04em"
      fill="#c9a8b2"
      aria-hidden="true"
    >
      .chezmoiroot → home/ · atomic apply
    </text>
  </svg>
</div>

<style>
  .df-layers {
    width: 100%;
  }

  .df-layers__svg {
    display: block;
    width: 100%;
    height: auto;
  }

  .df-layers__front {
    stroke: rgba(255, 176, 202, 0.28);
    stroke-width: 1.2;
  }

  .df-layers__accent {
    fill: rgba(255, 176, 202, 0.35);
  }

  .df-layers__node {
    fill: #3a232e;
    stroke: rgba(255, 176, 202, 0.4);
  }

  .df-layers__num {
    fill: #8a6a76;
  }

  .df-layers__layer.is-pointer-ready {
    cursor: pointer;
  }

  .df-layers__layer.is-selected {
    filter: drop-shadow(0 0 12px rgba(255, 176, 202, 0.3));
  }

  .df-layers__layer.is-selected .df-layers__front {
    stroke: #ffb0ca;
    stroke-width: 2;
  }

  .df-layers__layer.is-selected .df-layers__accent {
    fill: #ffb0ca;
  }

  .df-layers__layer.is-selected .df-layers__node {
    fill: #ffb0ca;
    stroke: #ffb0ca;
  }

  .df-layers__layer.is-selected .df-layers__num {
    fill: #ffb0ca;
    font-weight: 700;
  }

  @media (prefers-reduced-motion: no-preference) {
    .df-layers__layer.is-pointer-ready {
      transition: transform 0.18s ease;
    }
    .df-layers__layer.is-pointer-ready:hover {
      transform: translateY(-3px);
    }
  }

  @media (forced-colors: active) {
    .df-layers__layer.is-selected {
      filter: none;
    }
    .df-layers__layer.is-selected .df-layers__front {
      stroke: Highlight;
    }
    .df-layers__layer.is-selected .df-layers__node {
      fill: Highlight;
      stroke: Highlight;
    }
  }
</style>
