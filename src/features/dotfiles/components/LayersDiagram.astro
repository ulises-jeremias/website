---
import { dotfilesLayers } from '../data/index.js';

interface Props {
  /** When true, omit section chrome — parent supplies title/inspector. */
  compact?: boolean;
}

const { compact = true } = Astro.props;

const ordered = [...dotfilesLayers].reverse();
---

<div class:list={['df-layers', { 'df-layers--compact': compact }]} data-df-layers>
  <svg
    class="df-layers__svg"
    viewBox="0 0 680 540"
    aria-hidden="true"
    focusable="false"
    xmlns="http://www.w3.org/2000/svg"
  >
    <rect x="324" y="20" width="12" height="470" rx="6" fill="rgba(255,176,202,0.12)" aria-hidden="true"></rect>
    {
      ordered.map((layer, index) => {
        const y = 20 + index * 100;
        const isTop = index === 0;
        const isBottom = index === ordered.length - 1;
        return (
          <g class:list={['df-layers__layer', { 'is-selected': layer.id === 'chezmoi' }]} data-layer-visual={layer.id}>
            <rect
              x="56"
              y={String(y)}
              width="568"
              height="80"
              rx="14"
              fill={layer.color}
              stroke="rgba(255,176,202,0.28)"
              stroke-width="1.2"
            />
            <rect
              x="56"
              y={String(y)}
              width="568"
              height="4"
              rx="2"
              fill={isTop ? '#FFB0CA' : isBottom ? '#e2bdc7' : 'rgba(255,176,202,0.85)'}
            />
            <rect
              x="70"
              y={String(y + 16)}
              width="48"
              height="48"
              rx="10"
              fill="rgba(25,17,20,0.72)"
              stroke="rgba(255,176,202,0.18)"
            />
            <text
              x="94"
              y={String(y + 46)}
              text-anchor="middle"
              dominant-baseline="middle"
              font-size="11"
              font-family="ui-monospace, SFMono-Regular, Menlo, monospace"
              letter-spacing="0.08em"
              fill="#FFB0CA"
              aria-hidden="true"
            >
              {layer.shortLabel.slice(0, 4).toUpperCase()}
            </text>
            <text x="132" y={String(y + 34)} font-size="15" font-weight="800" letter-spacing="-0.02em" fill="#fbe7ec">
              {layer.label}
            </text>
            <text x="132" y={String(y + 56)} font-size="12" fill="#d5c2c6">
              {layer.description}
            </text>
            {index < ordered.length - 1 && (
              <g aria-hidden="true">
                <line
                  x1="340"
                  y1={String(y + 80)}
                  x2="340"
                  y2={String(y + 100)}
                  stroke="rgba(255,176,202,0.55)"
                  stroke-width="2"
                  stroke-linecap="round"
                  stroke-dasharray="6 6"
                />
                <polygon points={`${340},${y + 100} ${334},${y + 92} ${346},${y + 92}`} fill="#FFB0CA" />
              </g>
            )}
            <rect
              class="df-layers__focus"
              x="54"
              y={String(y - 2)}
              width="572"
              height="84"
              rx="16"
              fill="none"
              stroke="transparent"
              stroke-width="2"
            />
          </g>
        );
      })
    }
    <text
      x="340"
      y="528"
      text-anchor="middle"
      font-size="11"
      font-weight="600"
      letter-spacing="0.06em"
      fill="#FFB0CA"
      aria-hidden="true"
    >
      .chezmoiroot → home/ · atomic apply
    </text>
  </svg>
</div>

<style>
  .df-layers {
    width: 100%;
  }

  .df-layers__svg {
    display: block;
    width: 100%;
    height: auto;
  }

  .df-layers__layer.is-pointer-ready {
    cursor: pointer;
  }

  .df-layers__layer.is-selected .df-layers__focus,
  .df-layers__layer.is-pointer-ready:hover .df-layers__focus {
    stroke: #ffb0ca;
  }

  .df-layers__layer.is-selected rect[rx='14'] {
    stroke: #ffb0ca;
    stroke-width: 1.8;
  }

  @media (prefers-reduced-motion: no-preference) {
    .df-layers__layer.is-pointer-ready {
      transition: transform 0.18s ease;
    }
    .df-layers__layer.is-pointer-ready:hover {
      transform: translateX(2px);
    }
  }

  @media (forced-colors: active) {
    .df-layers__layer.is-selected .df-layers__focus {
      stroke: Highlight;
    }
  }
</style>
