---
import { verifiedFacts } from '../data/index.js';
---

<figure class="df-color-flow" aria-labelledby="df-color-flow-title">
  <figcaption class="df-color-flow__caption">
    <div>
      <p>Appearance system · Smart Colors</p>
      <h2 id="df-color-flow-title">One wallpaper, a synchronized desktop</h2>
    </div>
    <a href={verifiedFacts.smartColorsWikiUrl} target="_blank" rel="noopener noreferrer">
      Read the system contract <span aria-hidden="true">↗</span>
      <span class="visually-hidden"> (opens in new tab)</span>
    </a>
  </figcaption>

  <div class="df-color-flow__controls" data-df-flow-controls hidden>
    <span>Trace a system path</span>
    <button type="button" data-df-flow="live">
      Shell running · Quickshell IPC
    </button>
    <button type="button" data-df-flow="fallback">
      Shell stopped · palette fallback
    </button>
  </div>

  <span class="df-color-flow__signal" data-df-flow-signal aria-hidden="true" hidden></span>

  <p class="visually-hidden" role="status" aria-atomic="true" data-df-flow-status></p>

  <div class="df-color-flow__source" data-df-flow-source>
    <span class="df-color-flow__step">01 · SOURCE</span>
    <span class="df-color-flow__wallpaper" aria-hidden="true">
      <span></span>
      <span></span>
      <span></span>
      <span></span>
      <span></span>
    </span>
    <strong>Wallpaper selected</strong>
    <code>horneroctl wallpaper set</code>
  </div>

  <div class="df-color-flow__split" aria-hidden="true">
    <span></span>
    <span></span>
  </div>

  <div class="df-color-flow__routes">
    <section
      class="df-color-flow__route df-color-flow__route--live"
      aria-labelledby="df-colors-live-title"
      data-df-flow-route="live"
    >
      <p class="df-color-flow__step">02A · SHELL RUNNING</p>
      <h3 id="df-colors-live-title">Quickshell IPC</h3>
      <p>
        <code>appearance setWallpaper</code> refreshes the active shell.
      </p>
      <span class="df-color-flow__output" data-df-flow-output>
        Colours.qml reload
      </span>
    </section>
    <section
      class="df-color-flow__route df-color-flow__route--fallback"
      aria-labelledby="df-colors-fallback-title"
      data-df-flow-route="fallback"
    >
      <p class="df-color-flow__step">02B · SHELL STOPPED</p>
      <h3 id="df-colors-fallback-title">Apply the palette fallback</h3>
      <p>
        <code>apply-appearance.sh</code> runs pywal and generates Material 3 colors.
      </p>
      <span class="df-color-flow__output" data-df-flow-output>
        scheme.json · scheme state · GTK policy
      </span>
    </section>
  </div>

  <p class="df-color-flow__note">
    Both paths read the same wallpaper state; generated shell, Kitty, screen-lock, and CSS colors live in the Smart
    Colors cache.
  </p>
</figure>

<script>
  const routeCopy = {
    live: {
      source: 'Wallpaper selected with horneroctl.',
      route: 'Quickshell is running. appearance setWallpaper refreshes the active shell.',
      output: 'Colours.qml reload.',
    },
    fallback: {
      source: 'Wallpaper selected with horneroctl.',
      route: 'Quickshell is stopped. apply-appearance.sh runs pywal and generates Material 3 colors.',
      output: 'scheme.json, scheme state, and GTK policy.',
    },
  } as const;

  document.querySelectorAll<HTMLElement>('.df-color-flow').forEach((flow) => {
    const controls = flow.querySelector<HTMLElement>('[data-df-flow-controls]');
    const source = flow.querySelector<HTMLElement>('[data-df-flow-source]');
    const signal = flow.querySelector<HTMLElement>('[data-df-flow-signal]');
    const status = flow.querySelector<HTMLElement>('[data-df-flow-status]');
    const buttons = Array.from(flow.querySelectorAll<HTMLButtonElement>('[data-df-flow]'));
    const routes = Array.from(flow.querySelectorAll<HTMLElement>('[data-df-flow-route]'));
    if (!controls || !source || !signal || !status || buttons.length !== 2 || routes.length !== 2) return;

    const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
    let timer: number | undefined;
    let activePath: keyof typeof routeCopy | undefined;
    let signalAnimation: Animation | undefined;

    const reset = () => {
      if (timer !== undefined) window.clearTimeout(timer);
      timer = undefined;
      signalAnimation?.cancel();
      signalAnimation = undefined;
      signal.hidden = true;
      activePath = undefined;
      flow.dataset.traceState = 'idle';
      source.classList.remove('is-active');
      routes.forEach((route) => {
        route.classList.remove('is-active', 'is-complete');
        route.querySelector('[data-df-flow-output]')?.classList.remove('is-active');
      });
    };

    const complete = (route: HTMLElement, path: (typeof routeCopy)[keyof typeof routeCopy]) => {
      route.classList.add('is-complete');
      flow.dataset.traceState = 'complete';
      status.textContent = `Path complete. ${path.route} ${path.output} Both branches read the same wallpaper state.`;
      timer = undefined;
    };

    const trace = (button: HTMLButtonElement) => {
      const id = button.dataset.dfFlow as keyof typeof routeCopy;
      const path = routeCopy[id];
      const route = routes.find((candidate) => candidate.dataset.dfFlowRoute === id);
      if (!path || !route) return;

      reset();
      activePath = id;
      flow.dataset.traceState = 'running';
      source.classList.add('is-active');
      status.textContent = path.source;

      if (reduceMotion.matches) {
        route.classList.add('is-active');
        route.querySelector('[data-df-flow-output]')?.classList.add('is-active');
        complete(route, path);
        return;
      }

      const flowRect = flow.getBoundingClientRect();
      const sourceRect = source.getBoundingClientRect();
      const output = route.querySelector<HTMLElement>('[data-df-flow-output]');
      if (!output) return;
      const outputRect = output.getBoundingClientRect();
      const startX = sourceRect.left + sourceRect.width / 2 - flowRect.left;
      const startY = sourceRect.top + sourceRect.height / 2 - flowRect.top;
      const endX = outputRect.left + outputRect.width / 2 - flowRect.left;
      const endY = outputRect.top + outputRect.height / 2 - flowRect.top;

      signal.hidden = false;
      signalAnimation = signal.animate(
        [
          { transform: `translate(${startX}px, ${startY}px) scale(0.65)`, opacity: 0 },
          { offset: 0.12, transform: `translate(${startX}px, ${startY}px) scale(1)`, opacity: 1 },
          { offset: 0.82, transform: `translate(${endX}px, ${endY}px) scale(0.85)`, opacity: 1 },
          { transform: `translate(${endX}px, ${endY}px) scale(0.2)`, opacity: 0 },
        ],
        { duration: 700, easing: 'cubic-bezier(0.45, 0, 0.55, 1)' },
      );
      signalAnimation.onfinish = () => {
        signal.hidden = true;
        signalAnimation = undefined;
      };

      timer = window.setTimeout(() => {
        route.classList.add('is-active');
        status.textContent = path.route;
        timer = window.setTimeout(() => {
          route.querySelector('[data-df-flow-output]')?.classList.add('is-active');
          complete(route, path);
          timer = undefined;
        }, 560);
      }, 700);
    };

    buttons.forEach((button) => button.addEventListener('click', () => trace(button)));
    reduceMotion.addEventListener('change', (event) => {
      if (!event.matches || !activePath || flow.dataset.traceState !== 'running') return;
      const path = routeCopy[activePath];
      const route = routes.find((candidate) => candidate.dataset.dfFlowRoute === activePath);
      if (!route) return;
      if (timer !== undefined) window.clearTimeout(timer);
      timer = undefined;
      signalAnimation?.cancel();
      signalAnimation = undefined;
      signal.hidden = true;
      source.classList.add('is-active');
      route.classList.add('is-active');
      route.querySelector('[data-df-flow-output]')?.classList.add('is-active');
      complete(route, path);
    });
    controls.hidden = false;
  });
</script>

<style>
  .df-color-flow {
    --flow-accent: var(--dotfiles-pink, #ffb0ca);
    position: relative;
    display: grid;
    gap: 0.85rem;
    margin: 0;
    padding: clamp(0.85rem, 2vw, 1.2rem);
    border: 1px solid color-mix(in srgb, var(--flow-accent) 38%, transparent);
    background:
      linear-gradient(145deg, color-mix(in srgb, var(--flow-accent) 10%, transparent), transparent 58%), #191114;
    clip-path: var(
      --clip-corner-md,
      polygon(0 0, calc(100% - 12px) 0, 100% 12px, 100% 100%, 12px 100%, 0 calc(100% - 12px))
    );
  }

  .df-color-flow__caption {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: end;
    gap: 0.75rem;
    padding-bottom: 0.75rem;
    border-bottom: 1px solid color-mix(in srgb, var(--flow-accent) 25%, transparent);
  }

  .df-color-flow__caption p,
  .df-color-flow__caption h2,
  .df-color-flow__caption a {
    margin: 0;
  }

  .df-color-flow__caption p,
  .df-color-flow__step {
    color: color-mix(in srgb, var(--flow-accent) 78%, white);
    font: 0.61rem/1.4 var(--font-mono, monospace);
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  .df-color-flow__caption h2 {
    margin-top: 0.3rem;
    font-size: clamp(1rem, 1.6vw, 1.35rem);
  }

  .df-color-flow__caption a {
    color: var(--flow-accent);
    font: 0.68rem/1.4 var(--font-mono, monospace);
    text-underline-offset: 0.2em;
  }

  .df-color-flow__source,
  .df-color-flow__route {
    position: relative;
    min-width: 0;
    padding: 0.75rem;
    border: 1px solid color-mix(in srgb, var(--flow-accent) 30%, transparent);
    background: color-mix(in srgb, var(--dotfiles-plum-soft, #241a1f) 78%, transparent);
    transition:
      border-color var(--motion-duration-slow, 180ms) var(--motion-ease-out, ease-out),
      box-shadow var(--motion-duration-slow, 180ms) var(--motion-ease-out, ease-out),
      background-color var(--motion-duration-slow, 180ms) var(--motion-ease-out, ease-out);
  }

  .df-color-flow__signal {
    position: absolute;
    z-index: 2;
    inset: 0 auto auto 0;
    width: 0.72rem;
    height: 0.72rem;
    border: 1px solid #fff3df;
    border-radius: 50%;
    background: var(--flow-accent);
    box-shadow:
      0 0 0.5rem var(--flow-accent),
      0 0 1.1rem color-mix(in srgb, var(--flow-accent) 58%, transparent);
    pointer-events: none;
  }

  .df-color-flow__signal[hidden] {
    display: none;
  }

  .df-color-flow__source.is-active,
  .df-color-flow__route.is-active {
    border-color: var(--flow-accent);
    box-shadow: 0 0 1.25rem color-mix(in srgb, var(--flow-accent) 22%, transparent);
    background-color: color-mix(in srgb, var(--flow-accent) 10%, #191114);
  }

  .df-color-flow__route.is-active::before {
    position: absolute;
    inset: 0 auto 0 0;
    width: 3px;
    content: '';
    background: var(--route-accent);
    transform-origin: top;
    animation: df-flow-ignite 560ms var(--motion-ease-out, ease-out) both;
  }

  .df-color-flow__route.is-complete .df-color-flow__output {
    color: white;
    text-shadow: 0 0 0.75rem var(--route-accent);
  }

  .df-color-flow__controls {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.5rem;
    padding-block: 0.25rem;
  }

  .df-color-flow__controls[hidden] {
    display: none;
  }

  .df-color-flow__controls > span {
    margin-inline-end: 0.2rem;
    color: var(--dotfiles-text-muted, #c9a8b2);
    font: 0.64rem/1.4 var(--font-mono, monospace);
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .df-color-flow__controls button {
    min-height: 44px;
    padding: 0.45rem 0.7rem;
    border: 1px solid color-mix(in srgb, var(--flow-accent) 45%, transparent);
    background: color-mix(in srgb, var(--dotfiles-plum-soft, #241a1f) 80%, transparent);
    color: var(--color-text, #f8fafc);
    font: 0.64rem/1.4 var(--font-mono, monospace);
    text-align: start;
    cursor: pointer;
  }

  .df-color-flow__controls button:hover,
  .df-color-flow__controls button:focus-visible {
    border-color: var(--flow-accent);
    outline: 2px solid var(--color-focus-ring);
    outline-offset: 2px;
  }

  .df-color-flow__source {
    display: grid;
    grid-template-columns: auto 1fr;
    align-items: center;
    gap: 0.4rem 0.75rem;
  }

  .df-color-flow__source .df-color-flow__step {
    grid-column: 1 / -1;
  }

  .df-color-flow__wallpaper {
    display: grid;
    grid-template-columns: repeat(5, 1fr);
    width: 3.25rem;
    height: 2rem;
    overflow: hidden;
    border: 1px solid color-mix(in srgb, var(--flow-accent) 48%, transparent);
    transform: skewY(-8deg);
  }

  .df-color-flow__wallpaper span:nth-child(1) {
    background: #402032;
  }
  .df-color-flow__wallpaper span:nth-child(2) {
    background: #75435c;
  }
  .df-color-flow__wallpaper span:nth-child(3) {
    background: #bd718c;
  }
  .df-color-flow__wallpaper span:nth-child(4) {
    background: #e7a6a0;
  }
  .df-color-flow__wallpaper span:nth-child(5) {
    background: #f3d2b0;
  }

  .df-color-flow__source strong {
    font-size: 0.88rem;
  }

  .df-color-flow code {
    color: var(--dotfiles-pink-soft, #e2bdc7);
    font: 0.68rem/1.5 var(--font-mono, monospace);
    overflow-wrap: anywhere;
  }

  .df-color-flow__source code {
    grid-column: 2;
  }

  .df-color-flow__split {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1rem;
    height: 1.2rem;
    margin-inline: 25%;
  }

  .df-color-flow__split span {
    border-inline-start: 1px solid color-mix(in srgb, var(--flow-accent) 55%, transparent);
    border-block-end: 1px solid color-mix(in srgb, var(--flow-accent) 55%, transparent);
  }

  .df-color-flow__split span:last-child {
    transform: scaleX(-1);
  }

  .df-color-flow__routes {
    display: grid;
    gap: 0.7rem;
  }

  .df-color-flow__route {
    border-inline-start: 2px solid var(--route-accent);
  }

  .df-color-flow__route--live {
    --route-accent: var(--nest-cyan, #1cefff);
  }
  .df-color-flow__route--fallback {
    --route-accent: var(--nest-sunset-orange, #ff9a4d);
  }

  .df-color-flow__route h3 {
    margin: 0.25rem 0;
    font-size: 0.88rem;
  }

  .df-color-flow__route p:not(.df-color-flow__step) {
    margin: 0;
    color: var(--dotfiles-text-muted, #c9a8b2);
    font-size: 0.76rem;
    line-height: 1.5;
  }

  .df-color-flow__step {
    margin: 0;
  }

  .df-color-flow__output {
    display: block;
    margin-top: 0.5rem;
    padding-top: 0.4rem;
    border-top: 1px dashed color-mix(in srgb, var(--route-accent) 34%, transparent);
    color: var(--route-accent);
    font: 0.65rem/1.45 var(--font-mono, monospace);
    overflow-wrap: anywhere;
    transition:
      color var(--motion-duration-slow, 180ms) var(--motion-ease-out, ease-out),
      text-shadow var(--motion-duration-slow, 180ms) var(--motion-ease-out, ease-out);
  }

  .df-color-flow__note {
    margin: 0;
    color: var(--dotfiles-text-muted, #c9a8b2);
    font-size: 0.7rem;
    line-height: 1.45;
  }

  @media (min-width: 960px) {
    .df-color-flow__routes {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (forced-colors: active) {
    .df-color-flow__source,
    .df-color-flow__route {
      border: 1px solid CanvasText;
    }

    .df-color-flow__output,
    .df-color-flow__step {
      color: CanvasText;
    }
  }

  @keyframes df-flow-ignite {
    from {
      transform: scaleY(0.08);
      opacity: 0.35;
    }
    to {
      transform: scaleY(1);
      opacity: 1;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .df-color-flow__source,
    .df-color-flow__route,
    .df-color-flow__output {
      transition: none;
    }

    .df-color-flow__signal {
      display: none;
    }

    .df-color-flow__route.is-active::before {
      animation: none;
      transform: none;
    }
  }
</style>
