---
import { toolkitStats } from '../data/index.js';
---

<section class="toolkit-hero">
  <h2>Hero</h2><div>{toolkitStats.map((s) => <span>{s.value}</span>)}</div><svg viewBox="0 0 100 100"
    ><circle cx="50" cy="50" r="40"></circle></svg
  >
</section>
<style>
  .toolkit-hero {
    max-width: 72rem;
    margin: 0 auto;
  }
</style>
