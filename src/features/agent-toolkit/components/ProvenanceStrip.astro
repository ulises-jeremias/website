---
import {
  inventoryCommit,
  inventoryCommitFull,
  inventoryVerifiedAt,
  inventoryVersionLabel,
  toolkitDocs,
} from '../data/index.js';

const verifiedShort = inventoryVerifiedAt;
---

<aside class="atk-prov" aria-label="Inventory provenance">
  <p class="atk-prov__line">
    <span>{inventoryVersionLabel}</span>
    <span aria-hidden="true">·</span>
    <span>verified {verifiedShort}</span>
  </p>
  <div class="atk-prov__details">
    <p>
      Snapshot commit <code title={inventoryCommitFull}>{inventoryCommit}</code> from
      <a href={toolkitDocs.repo} target="_blank" rel="noopener noreferrer">ulises-jeremias/agent-toolkit</a>. Counts are
      generated from catalogs — not marketing counters.
    </p>
  </div>
</aside>

<style>
  .atk-prov {
    width: min(100% - 2 * var(--section-padding-x, 1.5rem), 74rem);
    margin: 0.75rem auto 0;
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.65rem 1.25rem;
    font-family: var(--font-mono);
    font-size: 0.72rem;
    letter-spacing: 0.08em;
    color: var(--color-text-faint);
  }

  .atk-prov__line {
    margin: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
    color: var(--nest-cyan);
  }

  .atk-prov__details {
    margin: 0;
  }

  .atk-prov__details summary {
    cursor: pointer;
    color: var(--color-text-muted);
    text-transform: uppercase;
    letter-spacing: 0.12em;
  }

  .atk-prov__details[open] summary {
    color: var(--nest-magenta);
  }

  .atk-prov__details p {
    margin: 0.45rem 0 0;
    max-inline-size: 62ch;
    letter-spacing: 0.02em;
    text-transform: none;
    color: var(--color-text-muted);
    font-size: 0.78rem;
    line-height: 1.45;
  }

  .atk-prov__details a {
    color: var(--nest-cyan);
  }
</style>
