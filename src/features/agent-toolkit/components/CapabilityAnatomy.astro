---
import { capabilityNodes, inventoryCommit, inventoryVerifiedAt, skillDomains, toolkitStats } from '../data/index.js';

const totalSkills = skillDomains.reduce((sum, domain) => sum + domain.count, 0);
---

<section class="cap-anatomy" aria-labelledby="cap-anatomy-title">
  <header class="cap-anatomy__header">
    <p class="cap-anatomy__eyebrow">Capability anatomy</p>
    <h2 id="cap-anatomy-title">Skills · agents · loops · packs · plugins · MCP</h2>
    <p class="cap-anatomy__lede">
      One catalog, six capability families. Counts verified against agent-toolkit
      <code>{inventoryCommit}</code> ({inventoryVerifiedAt}) — inventory facts, not telemetry.
    </p>
  </header>

  <ul class="cap-anatomy__stats" role="list">
    {
      toolkitStats.map((stat) => (
        <li>
          <strong>{stat.value}</strong>
          <span>{stat.label}</span>
          {stat.hint ? <small>{stat.hint}</small> : null}
        </li>
      ))
    }
  </ul>

  <div class="cap-anatomy__stage" role="img" aria-label="Capability anatomy diagram linking six catalog families">
    <svg class="cap-anatomy__svg" viewBox="0 0 960 320" role="presentation" aria-hidden="true">
      <defs>
        <linearGradient id="cap-core-glow" x1="0" y1="0" x2="1" y2="1">
          <stop offset="0%" stop-color="#ff42d0" stop-opacity="0.55"></stop>
          <stop offset="100%" stop-color="#1cefff" stop-opacity="0.35"></stop>
        </linearGradient>
      </defs>
      {
        capabilityNodes.map((node, index) => {
          const angle = (Math.PI * 2 * index) / capabilityNodes.length - Math.PI / 2;
          const x = 480 + Math.cos(angle) * 280;
          const y = 160 + Math.sin(angle) * 110;
          return (
            <g>
              <line x1="480" y1="160" x2={x} y2={y} stroke={node.color} stroke-opacity="0.45" stroke-width="1.5" />
              <circle cx={x} cy={y} r="8" fill={node.color} fill-opacity="0.9" />
            </g>
          );
        })
      }
      <circle cx="480" cy="160" r="54" fill="url(#cap-core-glow)" fill-opacity="0.25"></circle>
      <circle cx="480" cy="160" r="34" fill="none" stroke="#ff84f1" stroke-width="1.5"></circle>
      <text x="480" y="154" text-anchor="middle" fill="#f7f5ff" font-size="13" font-family="ui-monospace, monospace">
        catalog
      </text>
      <text x="480" y="174" text-anchor="middle" fill="#1cefff" font-size="11" font-family="ui-monospace, monospace">
        {totalSkills} · 9 domains
      </text>
    </svg>

    <ol class="cap-anatomy__nodes">
      {
        capabilityNodes.map((node) => (
          <li style={`--node-color: ${node.color}`}>
            <a href={node.href} target="_blank" rel="noreferrer">
              <span class="cap-anatomy__count">{node.count}</span>
              <span class="cap-anatomy__name">{node.title}</span>
              <span class="cap-anatomy__summary">{node.summary}</span>
              <span class="cap-anatomy__detail">{node.detail}</span>
            </a>
          </li>
        ))
      }
    </ol>
  </div>

  <div class="cap-anatomy__domains" aria-labelledby="skill-domains-title">
    <h3 id="skill-domains-title">Skill domains — core is 8, not 6</h3>
    <ul role="list">
      {
        skillDomains.map((domain) => (
          <li>
            <span>{domain.id}</span>
            <strong>{domain.count}</strong>
          </li>
        ))
      }
    </ul>
  </div>
</section>

<style>
  .cap-anatomy {
    width: min(100% - 2 * var(--section-padding-x), 74rem);
    margin: 0 auto;
    padding-block: clamp(2rem, 5vw, 3.5rem);
  }

  .cap-anatomy__eyebrow {
    margin: 0 0 var(--space-2);
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--world-accent-tertiary, var(--nest-sunset-orange));
  }

  .cap-anatomy__header h2 {
    margin: 0 0 var(--space-3);
    font-size: clamp(1.4rem, 3vw, 2rem);
    letter-spacing: 0.03em;
    text-transform: uppercase;
  }

  .cap-anatomy__lede {
    margin: 0;
    max-inline-size: 68ch;
    color: var(--color-text-muted);
  }

  .cap-anatomy__lede code {
    font-size: 0.85em;
    color: var(--nest-cyan);
  }

  .cap-anatomy__stats {
    display: grid;
    grid-template-columns: repeat(5, minmax(0, 1fr));
    gap: 0.65rem;
    margin: 1.25rem 0 1.5rem;
    padding: 0;
    list-style: none;
  }

  .cap-anatomy__stats li {
    display: grid;
    gap: 0.12rem;
    padding: 0.75rem;
    border: 1px solid var(--color-border);
    background: color-mix(in srgb, var(--nest-midnight-900) 88%, transparent);
    clip-path: var(--clip-corner-sm);
  }

  .cap-anatomy__stats strong {
    font-size: 1.35rem;
    color: var(--nest-cyan);
  }

  .cap-anatomy__stats span {
    font-family: var(--font-mono);
    font-size: 0.68rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  .cap-anatomy__stats small {
    color: var(--color-text-faint);
    font-size: 0.72rem;
  }

  .cap-anatomy__stage {
    position: relative;
    padding: 1rem;
    overflow-x: auto;
    border: 1px solid color-mix(in srgb, var(--nest-violet) 35%, transparent);
    background:
      radial-gradient(ellipse at 50% 40%, color-mix(in srgb, var(--nest-magenta) 12%, transparent), transparent 55%),
      color-mix(in srgb, var(--nest-midnight-900) 92%, transparent);
    clip-path: var(--clip-corner-lg, var(--clip-corner-md));
  }

  .cap-anatomy__svg {
    display: block;
    width: min(100%, 52rem);
    margin: 0 auto 1rem;
    max-block-size: 14rem;
  }

  .cap-anatomy__nodes {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 0.75rem;
    margin: 0;
    padding: 0;
    list-style: none;
    counter-reset: cap-node;
  }

  .cap-anatomy__nodes li {
    --node-color: var(--nest-violet);
  }

  .cap-anatomy__nodes a {
    display: grid;
    gap: 0.35rem;
    min-block-size: 100%;
    padding: 0.9rem;
    border: 1px solid color-mix(in srgb, var(--node-color) 38%, transparent);
    border-inline-start: 3px solid var(--node-color);
    background: color-mix(in srgb, var(--nest-midnight-950) 70%, transparent);
    clip-path: var(--clip-corner-md);
    color: inherit;
    text-decoration: none;
    transition:
      border-color var(--motion-duration-feedback, 160ms) ease,
      transform var(--motion-duration-feedback, 160ms) ease;
  }

  .cap-anatomy__nodes a:hover,
  .cap-anatomy__nodes a:focus-visible {
    border-color: var(--node-color);
    transform: translateY(-2px);
    outline: 2px solid var(--node-color);
    outline-offset: 2px;
  }

  .cap-anatomy__count {
    font-family: var(--font-mono);
    font-size: 1.2rem;
    color: var(--node-color);
  }

  .cap-anatomy__name {
    font-weight: 650;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    font-size: 0.92rem;
  }

  .cap-anatomy__summary,
  .cap-anatomy__detail {
    color: var(--color-text-muted);
    font-size: 0.86rem;
  }

  .cap-anatomy__detail {
    font-family: var(--font-mono);
    font-size: 0.72rem;
    color: color-mix(in srgb, var(--node-color) 70%, var(--color-text-muted));
  }

  .cap-anatomy__domains {
    margin-block-start: 1.25rem;
  }

  .cap-anatomy__domains h3 {
    margin: 0 0 0.65rem;
    font-size: 0.95rem;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: var(--nest-pink);
  }

  .cap-anatomy__domains ul {
    display: grid;
    grid-template-columns: repeat(9, minmax(0, 1fr));
    gap: 0.4rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .cap-anatomy__domains li {
    display: grid;
    gap: 0.15rem;
    padding: 0.55rem 0.45rem;
    border: 1px solid var(--color-border);
    background: color-mix(in srgb, var(--nest-midnight-900) 90%, transparent);
    clip-path: var(--clip-corner-sm);
    text-align: center;
  }

  .cap-anatomy__domains span {
    font-family: var(--font-mono);
    font-size: 0.62rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--color-text-faint);
  }

  .cap-anatomy__domains strong {
    color: var(--nest-cyan);
    font-size: 1rem;
  }

  @media (width < 960px) {
    .cap-anatomy__stats {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .cap-anatomy__nodes,
    .cap-anatomy__domains ul {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .cap-anatomy__svg {
      display: none;
    }
  }

  @media (width < 560px) {
    .cap-anatomy__stats,
    .cap-anatomy__nodes,
    .cap-anatomy__domains ul {
      grid-template-columns: 1fr;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .cap-anatomy__nodes a {
      transition: none;
    }

    .cap-anatomy__nodes a:hover,
    .cap-anatomy__nodes a:focus-visible {
      transform: none;
    }
  }
</style>
