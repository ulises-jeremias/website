---
import {
  personaVisuals,
  sharedRunStateFiles,
  swarmRecipes,
  swarmStages,
  toolkitDocs,
  uiBackends,
} from '../data/index.js';

const recipesJson = JSON.stringify(
  swarmRecipes.map((recipe) => ({
    id: recipe.id,
    label: recipe.label,
    useWhen: recipe.useWhen,
    roles: recipe.roles.map((role) => ({
      id: role.id,
      policy: role.policy,
      persona: role.persona ?? '',
      visual: personaVisuals[role.id] ??
        personaVisuals[role.persona ?? ''] ?? {
          label: role.id,
          prop: 'operator station',
          glyph: 'agent',
        },
    })),
  })),
);

const stagesJson = JSON.stringify(
  swarmStages.map((stage) => ({
    id: stage.id,
    index: stage.index,
    title: stage.title,
    summary: stage.summary,
  })),
);

const demoHandoff = 'a18f3c9e2b71';
---

<section
  class="atk-swarm"
  aria-labelledby="atk-swarm-title"
  data-atk-swarm
  data-recipes={recipesJson}
  data-stages={stagesJson}
>
  <header class="atk-swarm__header">
    <p class="atk-swarm__eyebrow">Swarm Control Room</p>
    <h2 id="atk-swarm-title">Recipe → roles → worktrees → handoffs → artifact</h2>
    <p class="atk-swarm__lede">Watch the topology. Scrub the pipeline. Same run state under Herdr or tmux.</p>
  </header>

  <div class="atk-swarm__toolbar">
    <div class="atk-swarm__recipes" role="radiogroup" aria-label="Swarm recipe">
      {
        swarmRecipes.map((recipe, index) => (
          <>
            <input
              class="atk-swarm__recipe-radio"
              type="radio"
              name="atk-recipe"
              id={`atk-recipe-${recipe.id}`}
              value={recipe.id}
              checked={index === 0}
            />
            <label class="atk-swarm__recipe" for={`atk-recipe-${recipe.id}`}>
              {recipe.label}
            </label>
          </>
        ))
      }
    </div>

    <div class="atk-swarm__shell" role="radiogroup" aria-label="UI backend">
      {
        uiBackends.map((backend, index) => (
          <>
            <input
              class="atk-swarm__shell-radio"
              type="radio"
              name="atk-shell"
              id={`atk-shell-${backend.id}`}
              value={backend.id}
              checked={index === 0}
            />
            <label class="atk-swarm__shell-btn" for={`atk-shell-${backend.id}`}>
              {backend.title}
            </label>
          </>
        ))
      }
    </div>
  </div>

  <div class="atk-swarm__room" data-shell="herdr">
    <div class="atk-swarm__chrome" aria-hidden="true">
      <span class="atk-swarm__chrome-dot"></span>
      <span class="atk-swarm__chrome-dot"></span>
      <span class="atk-swarm__chrome-dot"></span>
      <span class="atk-swarm__chrome-title" data-shell-title>Herdr workspace · swarm-demo</span>
    </div>

    <div class="atk-swarm__layout">
      <div class="atk-swarm__topology" data-topology aria-live="polite"></div>

      <aside class="atk-swarm__core" aria-label="Shared run state">
        <p class="atk-swarm__core-label">Run state</p>
        <dl class="atk-swarm__core-stats">
          <div>
            <dt>Status</dt>
            <dd data-core-status>RUNNING</dd>
          </div>
          <div>
            <dt>Role</dt>
            <dd data-core-role>implementer</dd>
          </div>
          <div>
            <dt>Handoff</dt>
            <dd data-core-handoff>idle</dd>
          </div>
        </dl>
        <div class="atk-swarm__budget" aria-label="Budget constraint">
          <svg viewBox="0 0 72 72" aria-hidden="true">
            <circle cx="36" cy="36" r="28" class="atk-swarm__budget-track"></circle>
            <circle cx="36" cy="36" r="28" class="atk-swarm__budget-fill" data-budget-ring pathLength="100"></circle>
          </svg>
          <div>
            <strong data-budget-label>63%</strong>
            <span>budget remaining</span>
          </div>
        </div>
        <details class="atk-swarm__state-files">
          <summary>Inspect run state</summary>
          <ul>
            {
              sharedRunStateFiles.map((file) => (
                <li>
                  <code>{file}</code>
                </li>
              ))
            }
          </ul>
        </details>
      </aside>
    </div>

    <div class="atk-swarm__gate" data-gate hidden>
      <p>APPROVAL REQUIRED</p>
      <button type="button" class="atk-swarm__approve" data-approve>Approve demo</button>
      <span>Educational only — no remote actions.</span>
    </div>

    <div class="atk-swarm__artifact" data-artifact hidden>
      <p>ARTIFACT</p>
      <ul>
        <li>diff</li>
        <li>report</li>
        <li>plan</li>
        <li>logs</li>
      </ul>
    </div>

    <svg class="atk-swarm__packet-layer" aria-hidden="true" focusable="false">
      <g data-packet-layer></g>
    </svg>
  </div>

  <div class="atk-swarm__transport">
    <ol class="atk-swarm__scrubber" aria-label="Swarm pipeline stage" data-scrubber>
      {
        swarmStages.map((stage, index) => (
          <li>
            <button
              type="button"
              aria-pressed={index === 0 ? 'true' : 'false'}
              data-stage={stage.id}
              data-stage-index={String(stage.index)}
            >
              <span>{String(stage.index).padStart(2, '0')}</span>
              {stage.title}
            </button>
          </li>
        ))
      }
    </ol>
    <p class="atk-swarm__stage-copy" data-stage-copy>{swarmStages[0]!.summary}</p>
    <div class="atk-swarm__playback" role="group" aria-label="Playback controls">
      <button type="button" data-play>Play</button>
      <button type="button" data-pause>Pause</button>
      <button type="button" data-prev>Prev</button>
      <button type="button" data-next>Next</button>
      <button type="button" data-replay>Replay</button>
    </div>
  </div>

  <details class="atk-swarm__cli">
    <summary>Show CLI</summary>
    <div class="atk-swarm__cli-grid">
      {
        uiBackends.map((backend) => (
          <figure>
            <figcaption>{backend.title}</figcaption>
            <pre>
              <code>{backend.commands[0]}</code>
            </pre>
          </figure>
        ))
      }
    </div>
    <p>
      Full swarm manual:
      <a href={toolkitDocs.swarm} target="_blank" rel="noreferrer">docs/SWARMS.md ↗</a>
    </p>
  </details>

  <noscript>
    <div class="atk-swarm__fallback">
      <p>Static recipe topologies (canonical inventory):</p>
      {
        swarmRecipes.map((recipe) => (
          <p>
            <strong>{recipe.label}</strong>
            {' — '}
            {recipe.roles.map((r) => r.id).join(' → ')}
          </p>
        ))
      }
      <p>
        Demo handoff aesthetic uses commit hashes such as <code>{demoHandoff}</code> — never uncommitted code.
      </p>
    </div>
  </noscript>
</section>

<style>
  .atk-swarm {
    width: min(100% - 2 * var(--section-padding-x, 1.5rem), 74rem);
    margin: 0 auto;
    padding-block: clamp(1.75rem, 4vw, 3.25rem);
  }

  .atk-swarm__eyebrow {
    margin: 0 0 0.35rem;
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--world-accent-tertiary, var(--nest-sunset-orange));
  }

  .atk-swarm h2 {
    margin: 0;
    text-transform: uppercase;
    letter-spacing: 0.03em;
    font-size: clamp(1.2rem, 2.5vw, 1.65rem);
  }

  .atk-swarm__lede {
    margin: 0.45rem 0 0;
    color: var(--color-text-muted);
    max-inline-size: 60ch;
  }

  .atk-swarm__toolbar {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem 1.25rem;
    justify-content: space-between;
    margin: 1rem 0 0.75rem;
  }

  .atk-swarm__recipes,
  .atk-swarm__shell {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
  }

  .atk-swarm__recipe-radio,
  .atk-swarm__shell-radio {
    position: absolute;
    opacity: 0;
    pointer-events: none;
  }

  .atk-swarm__recipe,
  .atk-swarm__shell-btn {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    padding: 0.4rem 0.85rem;
    border: 1px solid var(--color-border);
    font-family: var(--font-mono);
    font-size: 0.74rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--color-text-muted);
    cursor: pointer;
    clip-path: var(--clip-corner-sm);
  }

  .atk-swarm__recipe-radio:checked + .atk-swarm__recipe,
  .atk-swarm__recipe-radio:focus-visible + .atk-swarm__recipe {
    border-color: var(--nest-magenta);
    color: var(--nest-paper);
    box-shadow: 0 0 0 2px color-mix(in srgb, var(--nest-magenta) 40%, transparent);
  }

  .atk-swarm__shell-radio:checked + .atk-swarm__shell-btn,
  .atk-swarm__shell-radio:focus-visible + .atk-swarm__shell-btn {
    border-color: var(--nest-cyan);
    color: var(--nest-cyan);
    box-shadow: 0 0 0 2px color-mix(in srgb, var(--nest-cyan) 35%, transparent);
  }

  .atk-swarm__room {
    position: relative;
    border: 1px solid color-mix(in srgb, var(--nest-violet) 45%, transparent);
    background:
      radial-gradient(
        ellipse 70% 60% at 50% 0%,
        color-mix(in srgb, var(--nest-violet) 20%, transparent),
        transparent 65%
      ),
      color-mix(in srgb, var(--nest-midnight-950) 96%, #1a0b33);
    clip-path: var(--clip-corner-md);
    overflow: hidden;
    min-height: 28rem;
  }

  .atk-swarm__room[data-shell='tmux'] {
    background:
      linear-gradient(180deg, color-mix(in srgb, #0d1f18 80%, transparent), transparent 40%),
      color-mix(in srgb, var(--nest-midnight-950) 96%, #06140f);
    border-color: color-mix(in srgb, #3dffb5 40%, transparent);
  }

  .atk-swarm__chrome {
    display: flex;
    align-items: center;
    gap: 0.4rem;
    padding: 0.55rem 0.75rem;
    border-bottom: 1px solid var(--color-border);
    font-family: var(--font-mono);
    font-size: 0.7rem;
    letter-spacing: 0.08em;
    color: var(--color-text-faint);
  }

  .atk-swarm__chrome-dot {
    width: 0.55rem;
    height: 0.55rem;
    border-radius: 50%;
    background: var(--nest-magenta);
    opacity: 0.7;
  }

  .atk-swarm__chrome-dot:nth-child(2) {
    background: var(--nest-sunset-orange);
  }

  .atk-swarm__chrome-dot:nth-child(3) {
    background: var(--nest-cyan);
  }

  .atk-swarm__room[data-shell='tmux'] .atk-swarm__chrome-dot {
    border-radius: 0;
    width: 0.45rem;
    height: 0.45rem;
  }

  .atk-swarm__layout {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(12rem, 15rem);
    gap: 0.75rem;
    padding: 0.85rem;
  }

  .atk-swarm__topology {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(7.5rem, 1fr));
    gap: 0.65rem;
    align-content: start;
    min-height: 18rem;
  }

  .atk-swarm__station {
    position: relative;
    display: grid;
    gap: 0.35rem;
    justify-items: center;
    padding: 0.65rem 0.45rem 0.75rem;
    border: 1px solid color-mix(in srgb, var(--nest-magenta) 40%, transparent);
    background: color-mix(in srgb, var(--nest-midnight-900) 88%, transparent);
    text-align: center;
  }

  .atk-swarm__room[data-shell='tmux'] .atk-swarm__station {
    border-color: color-mix(in srgb, #3dffb5 45%, transparent);
    font-family: var(--font-mono);
  }

  .atk-swarm__station.is-active {
    border-color: var(--nest-cyan);
    box-shadow: 0 0 18px color-mix(in srgb, var(--nest-cyan) 25%, transparent);
  }

  .atk-swarm__station.is-dim {
    opacity: 0.45;
  }

  .atk-swarm__silhouette {
    width: 3.4rem;
    height: 3.8rem;
    background: linear-gradient(
      180deg,
      color-mix(in srgb, var(--nest-magenta) 80%, #fff),
      var(--nest-violet) 55%,
      #1a0b2e
    );
    clip-path: polygon(
      35% 0,
      65% 0,
      78% 22%,
      70% 42%,
      88% 70%,
      70% 70%,
      70% 100%,
      30% 100%,
      30% 70%,
      12% 70%,
      30% 42%,
      22% 22%
    );
    box-shadow: 0 0 14px color-mix(in srgb, var(--nest-magenta) 45%, transparent);
  }

  .atk-swarm__prop {
    font-size: 0.6rem;
    letter-spacing: 0.04em;
    color: var(--nest-cyan);
    text-transform: lowercase;
  }

  .atk-swarm__station[data-glyph='plan'] .atk-swarm__silhouette {
    clip-path: polygon(10% 15%, 90% 15%, 90% 85%, 10% 85%);
  }

  .atk-swarm__station[data-glyph='shield'] .atk-swarm__silhouette {
    clip-path: polygon(50% 0, 90% 18%, 82% 70%, 50% 100%, 18% 70%, 10% 18%);
  }

  .atk-swarm__station[data-glyph='merge'] .atk-swarm__silhouette {
    clip-path: polygon(50% 0, 70% 30%, 100% 30%, 70% 55%, 85% 100%, 50% 75%, 15% 100%, 30% 55%, 0 30%, 30% 30%);
  }

  .atk-swarm__role-id {
    font-family: var(--font-mono);
    font-size: 0.68rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--nest-paper);
  }

  .atk-swarm__role-policy {
    font-size: 0.65rem;
    color: var(--color-text-faint);
  }

  .atk-swarm__worktree {
    width: 100%;
    margin-top: 0.2rem;
    padding: 0.35rem 0.3rem;
    border: 1px dashed color-mix(in srgb, var(--nest-cyan) 45%, transparent);
    background:
      radial-gradient(circle at 30% 40%, color-mix(in srgb, var(--nest-cyan) 20%, transparent), transparent 55%),
      color-mix(in srgb, #0a1620 80%, transparent);
    font-family: var(--font-mono);
    font-size: 0.62rem;
    letter-spacing: 0.06em;
    color: var(--nest-cyan);
  }

  .atk-swarm__core {
    border: 1px solid color-mix(in srgb, var(--nest-cyan) 35%, transparent);
    background: color-mix(in srgb, var(--nest-midnight-900) 90%, transparent);
    padding: 0.75rem;
    display: grid;
    gap: 0.65rem;
    align-content: start;
  }

  .atk-swarm__core-label {
    margin: 0;
    font-family: var(--font-mono);
    font-size: 0.68rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--nest-cyan);
  }

  .atk-swarm__core-stats {
    margin: 0;
    display: grid;
    gap: 0.35rem;
  }

  .atk-swarm__core-stats div {
    display: flex;
    justify-content: space-between;
    gap: 0.5rem;
    font-size: 0.78rem;
  }

  .atk-swarm__core-stats dt {
    color: var(--color-text-faint);
  }

  .atk-swarm__core-stats dd {
    margin: 0;
    font-family: var(--font-mono);
    color: var(--nest-paper);
  }

  .atk-swarm__budget {
    display: flex;
    align-items: center;
    gap: 0.55rem;
  }

  .atk-swarm__budget svg {
    width: 3.4rem;
    height: 3.4rem;
    transform: rotate(-90deg);
  }

  .atk-swarm__budget-track {
    fill: none;
    stroke: color-mix(in srgb, var(--nest-violet) 30%, transparent);
    stroke-width: 6;
  }

  .atk-swarm__budget-fill {
    fill: none;
    stroke: var(--nest-magenta);
    stroke-width: 6;
    stroke-linecap: round;
    stroke-dasharray: 63 100;
  }

  .atk-swarm__budget strong {
    display: block;
    color: var(--nest-magenta);
    font-size: 1.1rem;
  }

  .atk-swarm__budget span {
    font-size: 0.68rem;
    color: var(--color-text-faint);
  }

  .atk-swarm__state-files summary {
    cursor: pointer;
    font-family: var(--font-mono);
    font-size: 0.7rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--color-text-muted);
  }

  .atk-swarm__state-files ul {
    margin: 0.4rem 0 0;
    padding: 0;
    list-style: none;
    display: grid;
    gap: 0.2rem;
  }

  .atk-swarm__state-files code {
    font-size: 0.72rem;
    color: var(--nest-cyan);
  }

  .atk-swarm__gate,
  .atk-swarm__artifact {
    position: absolute;
    left: 50%;
    bottom: 1rem;
    transform: translateX(-50%);
    z-index: 3;
    min-width: min(90%, 22rem);
    padding: 0.85rem 1rem;
    border: 1px solid var(--nest-sunset-orange);
    background: color-mix(in srgb, var(--nest-midnight-950) 92%, #3a1608);
    text-align: center;
  }

  .atk-swarm__artifact {
    border-color: var(--nest-cyan);
    background: color-mix(in srgb, var(--nest-midnight-950) 92%, #08303a);
  }

  .atk-swarm__gate p,
  .atk-swarm__artifact p {
    margin: 0;
    font-family: var(--font-mono);
    letter-spacing: 0.14em;
    color: var(--nest-sunset-orange);
  }

  .atk-swarm__artifact p {
    color: var(--nest-cyan);
  }

  .atk-swarm__approve {
    margin: 0.55rem 0;
    min-height: 44px;
    padding: 0.45rem 1rem;
    border: 1px solid var(--nest-magenta);
    background: transparent;
    color: var(--nest-magenta);
    font-family: var(--font-mono);
    letter-spacing: 0.1em;
    text-transform: uppercase;
    cursor: pointer;
  }

  .atk-swarm__gate span {
    display: block;
    font-size: 0.72rem;
    color: var(--color-text-faint);
  }

  .atk-swarm__artifact ul {
    display: flex;
    justify-content: center;
    gap: 0.55rem;
    margin: 0.55rem 0 0;
    padding: 0;
    list-style: none;
    font-family: var(--font-mono);
    font-size: 0.72rem;
    color: var(--nest-paper);
  }

  .atk-swarm__packet-layer {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    pointer-events: none;
  }

  .atk-swarm__packet {
    fill: var(--nest-cyan);
    filter: drop-shadow(0 0 6px var(--nest-cyan));
  }

  .atk-swarm__transport {
    margin-top: 0.9rem;
    display: grid;
    gap: 0.65rem;
  }

  .atk-swarm__scrubber {
    display: grid;
    grid-template-columns: repeat(8, minmax(0, 1fr));
    gap: 0.3rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .atk-swarm__scrubber button {
    width: 100%;
    min-height: 52px;
    padding: 0.35rem 0.25rem;
    border: 1px solid var(--color-border);
    background: color-mix(in srgb, var(--nest-midnight-900) 90%, transparent);
    color: var(--color-text-muted);
    font-family: var(--font-mono);
    font-size: 0.62rem;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    cursor: pointer;
  }

  .atk-swarm__scrubber button span {
    display: block;
    color: var(--nest-magenta);
    margin-bottom: 0.15rem;
  }

  .atk-swarm__scrubber button[aria-pressed='true'] {
    border-color: var(--nest-cyan);
    color: var(--nest-paper);
    box-shadow: inset 0 0 0 1px color-mix(in srgb, var(--nest-cyan) 50%, transparent);
  }

  .atk-swarm__stage-copy {
    margin: 0;
    color: var(--color-text-muted);
    font-size: 0.9rem;
  }

  .atk-swarm__playback {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
  }

  .atk-swarm__playback button {
    min-height: 40px;
    padding: 0.35rem 0.75rem;
    border: 1px solid color-mix(in srgb, var(--nest-violet) 45%, transparent);
    background: transparent;
    color: var(--nest-paper);
    font-family: var(--font-mono);
    font-size: 0.7rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    cursor: pointer;
  }

  .atk-swarm__playback button:focus-visible {
    outline: 2px solid var(--nest-cyan);
    outline-offset: 2px;
  }

  .atk-swarm__cli {
    margin-top: 0.85rem;
  }

  .atk-swarm__cli summary {
    cursor: pointer;
    font-family: var(--font-mono);
    font-size: 0.75rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--color-text-muted);
  }

  .atk-swarm__cli-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 0.65rem;
    margin-top: 0.55rem;
  }

  .atk-swarm__cli figure {
    margin: 0;
  }

  .atk-swarm__cli figcaption {
    margin-bottom: 0.3rem;
    font-size: 0.75rem;
    color: var(--nest-cyan);
  }

  .atk-swarm__cli pre {
    margin: 0;
    padding: 0.65rem;
    overflow-x: auto;
    border: 1px solid var(--color-border);
    background: var(--color-code-bg, #120a22);
    font-size: 0.72rem;
  }

  .atk-swarm__cli p {
    margin: 0.55rem 0 0;
    font-size: 0.85rem;
    color: var(--color-text-muted);
  }

  .atk-swarm__cli a {
    color: var(--nest-cyan);
  }

  .atk-swarm__fallback {
    margin-top: 0.75rem;
    color: var(--color-text-muted);
    font-size: 0.9rem;
  }

  @media (width < 900px) {
    .atk-swarm__layout {
      grid-template-columns: 1fr;
    }

    .atk-swarm__scrubber {
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }

    .atk-swarm__cli-grid {
      grid-template-columns: 1fr;
    }
  }
</style>

<script>
  type RecipeRole = {
    id: string;
    policy: string;
    persona: string;
    visual: { label: string; prop: string; glyph: string };
  };
  type Recipe = { id: string; label: string; useWhen: string; roles: RecipeRole[] };
  type Stage = { id: string; index: number; title: string; summary: string };

  function el<K extends keyof HTMLElementTagNameMap>(
    tag: K,
    className?: string,
    text?: string,
  ): HTMLElementTagNameMap[K] {
    const node = document.createElement(tag);
    if (className) node.className = className;
    if (text !== undefined) node.textContent = text;
    return node;
  }

  function initSwarm(root: HTMLElement) {
    const recipes = JSON.parse(root.dataset.recipes || '[]') as Recipe[];
    const stages = JSON.parse(root.dataset.stages || '[]') as Stage[];
    const topology = root.querySelector<HTMLElement>('[data-topology]');
    const room = root.querySelector<HTMLElement>('.atk-swarm__room');
    const shellTitle = root.querySelector<HTMLElement>('[data-shell-title]');
    const stageCopy = root.querySelector<HTMLElement>('[data-stage-copy]');
    const gate = root.querySelector<HTMLElement>('[data-gate]');
    const artifact = root.querySelector<HTMLElement>('[data-artifact]');
    const coreStatus = root.querySelector<HTMLElement>('[data-core-status]');
    const coreRole = root.querySelector<HTMLElement>('[data-core-role]');
    const coreHandoff = root.querySelector<HTMLElement>('[data-core-handoff]');
    const budgetRing = root.querySelector<SVGCircleElement>('[data-budget-ring]');
    const budgetLabel = root.querySelector<HTMLElement>('[data-budget-label]');
    const scrubberButtons = Array.from(root.querySelectorAll<HTMLButtonElement>('[data-stage]'));
    const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    let recipeId = recipes[0]?.id ?? 'pair';
    let stageIndex = 1;
    let playing = false;
    let timer: number | null = null;
    let approved = false;
    let autoplayed = false;

    const currentRecipe = () => recipes.find((r) => r.id === recipeId) ?? recipes[0]!;

    const renderTopology = () => {
      if (!topology) return;
      const recipe = currentRecipe();
      topology.replaceChildren();
      recipe.roles.forEach((role, index) => {
        const station = el('article', 'atk-swarm__station');
        station.dataset.glyph = role.visual.glyph;
        station.dataset.role = role.id;
        const sil = el('div', 'atk-swarm__silhouette');
        sil.setAttribute('aria-hidden', 'true');
        const prop = el('span', 'atk-swarm__prop', role.visual.prop);
        station.append(
          sil,
          el('span', 'atk-swarm__role-id', role.visual.label || role.id),
          el('span', 'atk-swarm__role-policy', role.policy),
          prop,
          el('div', 'atk-swarm__worktree', `worktree ${String.fromCharCode(65 + index)}`),
        );
        topology.append(station);
      });
      applyStage();
    };

    const setBudget = (pct: number) => {
      const value = Math.max(8, Math.min(100, pct));
      if (budgetRing) budgetRing.style.strokeDasharray = `${value} 100`;
      if (budgetLabel) budgetLabel.textContent = `${value}%`;
    };

    const pulseHandoff = () => {
      const stations = Array.from(root.querySelectorAll<HTMLElement>('.atk-swarm__station'));
      if (stations.length < 2 || !room) return;
      const from = stations[0]!.getBoundingClientRect();
      const to = stations[1]!.getBoundingClientRect();
      const roomBox = room.getBoundingClientRect();
      const layer = root.querySelector<SVGGElement>('[data-packet-layer]');
      if (!layer) return;
      layer.replaceChildren();
      const packet = document.createElementNS('http://www.w3.org/2000/svg', 'circle');
      packet.setAttribute('r', '6');
      packet.setAttribute('class', 'atk-swarm__packet');
      const x1 = from.left + from.width / 2 - roomBox.left;
      const y1 = from.top + from.height / 2 - roomBox.top;
      const x2 = to.left + to.width / 2 - roomBox.left;
      const y2 = to.top + to.height / 2 - roomBox.top;
      packet.setAttribute('cx', String(x1));
      packet.setAttribute('cy', String(y1));
      layer.append(packet);
      packet.animate(
        [
          { cx: x1, cy: y1, opacity: 0.2 },
          { cx: (x1 + x2) / 2, cy: (y1 + y2) / 2 - 20, opacity: 1 },
          { cx: x2, cy: y2, opacity: 0.2 },
        ],
        { duration: 1200, easing: 'ease-in-out', fill: 'forwards' },
      );
    };

    const applyStage = () => {
      const stage = stages.find((s) => s.index === stageIndex) ?? stages[0]!;
      const recipe = currentRecipe();
      const stations = Array.from(root.querySelectorAll<HTMLElement>('.atk-swarm__station'));
      scrubberButtons.forEach((button) => {
        button.setAttribute('aria-pressed', button.dataset.stage === stage.id ? 'true' : 'false');
      });
      if (stageCopy) stageCopy.textContent = `${stage.summary} · ${recipe.useWhen}`;

      const activeRoleIndex = Math.min(Math.max(stageIndex - 3, 0), Math.max(recipe.roles.length - 1, 0));
      stations.forEach((station, index) => {
        station.classList.toggle('is-active', stageIndex >= 3 && index === activeRoleIndex);
        station.classList.toggle('is-dim', stageIndex >= 3 && index > activeRoleIndex + 1);
      });

      if (coreStatus) {
        coreStatus.textContent =
          stage.id === 'governance' && !approved ? 'BLOCKED' : stage.id === 'artifact' ? 'COMPLETE' : 'RUNNING';
      }
      if (coreRole) coreRole.textContent = recipe.roles[activeRoleIndex]?.id ?? '—';
      if (coreHandoff) {
        coreHandoff.textContent = stage.id === 'handoffs' ? 'a18f3c9e2b71' : stageIndex > 5 ? 'received' : 'idle';
      }
      setBudget(stage.id === 'artifact' ? 41 : stage.id === 'governance' ? 52 : 63 + (8 - stageIndex));

      if (gate) gate.hidden = !(stage.id === 'governance' && !approved);
      if (artifact) artifact.hidden = stage.id !== 'artifact';
      if (!reduce && stage.id === 'handoffs') pulseHandoff();
    };

    const stop = () => {
      playing = false;
      if (timer !== null) {
        window.clearInterval(timer);
        timer = null;
      }
    };

    const play = () => {
      if (playing) return;
      playing = true;
      timer = window.setInterval(
        () => {
          if (stageIndex >= stages.length) {
            stop();
            return;
          }
          stageIndex += 1;
          if (stageIndex > stages.length) {
            stageIndex = stages.length;
            stop();
          }
          applyStage();
          if (stageIndex >= stages.length) stop();
        },
        reduce ? 10_000 : 1400,
      );
    };

    root.querySelectorAll<HTMLInputElement>('input[name="atk-recipe"]').forEach((input) => {
      input.addEventListener('change', () => {
        if (!input.checked) return;
        recipeId = input.value;
        approved = false;
        renderTopology();
      });
    });

    root.querySelectorAll<HTMLInputElement>('input[name="atk-shell"]').forEach((input) => {
      input.addEventListener('change', () => {
        if (!input.checked || !room) return;
        room.dataset.shell = input.value;
        if (shellTitle) {
          shellTitle.textContent =
            input.value === 'tmux' ? 'tmux · agent-toolkit-swarm-demo' : 'Herdr workspace · swarm-demo';
        }
      });
    });

    scrubberButtons.forEach((button) => {
      button.addEventListener('click', () => {
        stop();
        stageIndex = Number(button.dataset.stageIndex || '1');
        applyStage();
      });
    });

    root.querySelector<HTMLButtonElement>('[data-play]')?.addEventListener('click', play);
    root.querySelector<HTMLButtonElement>('[data-pause]')?.addEventListener('click', stop);
    root.querySelector<HTMLButtonElement>('[data-prev]')?.addEventListener('click', () => {
      stop();
      stageIndex = Math.max(1, stageIndex - 1);
      applyStage();
    });
    root.querySelector<HTMLButtonElement>('[data-next]')?.addEventListener('click', () => {
      stop();
      stageIndex = Math.min(stages.length, stageIndex + 1);
      applyStage();
    });
    root.querySelector<HTMLButtonElement>('[data-replay]')?.addEventListener('click', () => {
      stop();
      approved = false;
      stageIndex = 1;
      applyStage();
      play();
    });
    root.querySelector<HTMLButtonElement>('[data-approve]')?.addEventListener('click', () => {
      approved = true;
      if (gate) gate.hidden = true;
      if (coreStatus) coreStatus.textContent = 'APPROVED';
      stageIndex = stages.length;
      applyStage();
    });

    renderTopology();

    const io = new IntersectionObserver(
      (entries) => {
        if (autoplayed) return;
        if (entries.some((e) => e.isIntersecting)) {
          autoplayed = true;
          if (!reduce) play();
          io.disconnect();
        }
      },
      { threshold: 0.35 },
    );
    io.observe(root);
  }

  document.querySelectorAll<HTMLElement>('[data-atk-swarm]').forEach(initSwarm);
</script>
