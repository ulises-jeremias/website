---
import { capabilities } from '../data/index.js';
---

<section class="capabilities" aria-labelledby="capabilities-title">
  <h2 id="capabilities-title">Capabilities</h2>
  <div role="list">
    {
      capabilities.map((c) => (
        <article>
          <>
            <h3>{c.title}</h3>
            <p>{c.description}</p>
          </>
        </article>
      ))
    }
  </div>
  <svg viewBox="0 0 100 100" role="img"
    ><title>t</title><rect width="100" height="100" fill="var(--theme-accent)"></rect></svg
  >
</section>
<style>
  .capabilities {
    max-width: 72rem;
    margin: 0 auto;
  }
</style>
