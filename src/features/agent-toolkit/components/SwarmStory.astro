---
import { swarmRecipes, swarmStages, uiBackends } from '../data/index.js';

const defaultRecipe = swarmRecipes[0]!;
---

<section class="swarm-story" aria-labelledby="swarm-story-title">
  <header class="swarm-story__header">
    <p class="swarm-story__eyebrow">Swarm story</p>
    <h2 id="swarm-story-title">Request → recipe → roles → worktrees → handoffs → state → governance → artifact</h2>
    <p class="swarm-story__lede">
      Multi-role orchestration is separate from DevCompanion’s queue. Pick a recipe — the same stage pipeline stays;
      only the role topology changes. Herdr and tmux are two views of one run state.
    </p>
  </header>

  <ol class="swarm-story__pipeline">
    {
      swarmStages.map((stage) => (
        <li>
          <span class="swarm-story__index">{String(stage.index).padStart(2, '0')}</span>
          <span class="swarm-story__stage-title">{stage.title}</span>
          <span class="swarm-story__stage-summary">{stage.summary}</span>
          <span class="swarm-story__stage-detail">{stage.detail}</span>
        </li>
      ))
    }
  </ol>

  <form class="swarm-story__recipes" aria-labelledby="recipe-title">
    <div class="swarm-story__recipe-head">
      <h3 id="recipe-title">Recipe topology</h3>
      <p>pair is implementer → reviewer → integrator (3 roles). Not planner → implementer.</p>
    </div>

    <div class="swarm-story__tabs" role="radiogroup" aria-label="Swarm recipe">
      {
        swarmRecipes.map((recipe, index) => (
          <>
            <input
              class="swarm-story__radio"
              type="radio"
              name="swarm-recipe"
              id={`recipe-${recipe.id}`}
              value={recipe.id}
              checked={index === 0}
            />
            <label class="swarm-story__tab" for={`recipe-${recipe.id}`}>
              {recipe.label}
            </label>
          </>
        ))
      }
    </div>

    {
      swarmRecipes.map((recipe) => (
        <div class={`swarm-story__panel swarm-story__panel--${recipe.id}`} data-recipe={recipe.id}>
          <p class="swarm-story__when">
            <strong>{recipe.label}</strong> — {recipe.useWhen}
          </p>
          <ol class="swarm-story__roles" aria-label={`${recipe.label} roles`}>
            {recipe.roles.map((role, index) => (
              <li>
                {index > 0 ? <span class="swarm-story__arrow" aria-hidden="true" /> : null}
                <span class="swarm-story__role">
                  <span class="swarm-story__role-id">{role.id}</span>
                  <span class="swarm-story__role-policy">{role.policy}</span>
                </span>
              </li>
            ))}
          </ol>
          <svg
            class="swarm-story__role-svg"
            viewBox={`0 0 ${Math.max(recipe.roles.length * 140, 280)} 72`}
            aria-hidden="true"
          >
            {recipe.roles.map((role, index) => {
              const x = 40 + index * 140;
              return (
                <g>
                  {index > 0 ? (
                    <path
                      d={`M${x - 100} 36 H${x - 40}`}
                      stroke="currentColor"
                      stroke-width="1.5"
                      fill="none"
                      opacity="0.7"
                    />
                  ) : null}
                  <rect
                    x={x - 36}
                    y="12"
                    width="88"
                    height="48"
                    rx="2"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="1.5"
                  />
                  <text x={x + 8} y="34" text-anchor="middle" fill="currentColor" font-size="11">
                    {role.id}
                  </text>
                  <text x={x + 8} y="50" text-anchor="middle" fill="currentColor" font-size="9" opacity="0.7">
                    {role.policy}
                  </text>
                </g>
              );
            })}
          </svg>
        </div>
      ))
    }

    <noscript>
      <p class="swarm-story__noscript">
        Without script enhancement, all recipe topologies remain visible below. Default documented recipe: {
          defaultRecipe.label
        }.
      </p>
    </noscript>
  </form>

  <div class="swarm-story__backends" aria-labelledby="backends-title">
    <h3 id="backends-title">Herdr · tmux — same state, two views</h3>
    <div class="swarm-story__state">
      <p class="swarm-story__state-label">Shared run state</p>
      <ul>
        <li>run.yaml</li>
        <li>trace.jsonl</li>
        <li>budget.json</li>
        <li>ownership.json</li>
        <li>approvals.json</li>
        <li>artifacts/</li>
      </ul>
    </div>
    <div class="swarm-story__views">
      {
        uiBackends.map((backend) => (
          <article>
            <h4>{backend.title}</h4>
            <p>{backend.summary}</p>
          </article>
        ))
      }
    </div>
  </div>
</section>

<style>
  .swarm-story {
    width: min(100% - 2 * var(--section-padding-x), 74rem);
    margin: 0 auto;
    padding-block: clamp(2rem, 5vw, 3.5rem);
  }

  .swarm-story__eyebrow {
    margin: 0 0 var(--space-2);
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--world-accent-tertiary, var(--nest-sunset-orange));
  }

  .swarm-story__header h2 {
    margin: 0 0 var(--space-3);
    font-size: clamp(1.25rem, 2.6vw, 1.75rem);
    letter-spacing: 0.02em;
    text-transform: uppercase;
  }

  .swarm-story__lede {
    margin: 0;
    max-inline-size: 72ch;
    color: var(--color-text-muted);
  }

  .swarm-story__pipeline {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 0.65rem;
    margin: 1.4rem 0;
    padding: 0;
    list-style: none;
  }

  .swarm-story__pipeline li {
    display: grid;
    gap: 0.3rem;
    padding: 0.85rem;
    border: 1px solid var(--color-border);
    border-block-start: 2px solid var(--nest-violet);
    background: color-mix(in srgb, var(--nest-midnight-900) 90%, transparent);
    clip-path: var(--clip-corner-sm);
  }

  .swarm-story__index {
    font-family: var(--font-mono);
    font-size: 0.68rem;
    letter-spacing: 0.14em;
    color: var(--nest-magenta);
  }

  .swarm-story__stage-title {
    font-weight: 650;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    font-size: 0.88rem;
  }

  .swarm-story__stage-summary {
    color: var(--color-text-muted);
    font-size: 0.86rem;
  }

  .swarm-story__stage-detail {
    font-family: var(--font-mono);
    font-size: 0.7rem;
    color: var(--nest-cyan);
  }

  .swarm-story__recipes {
    margin-block: 1.5rem;
    padding: 1rem;
    border: 1px solid color-mix(in srgb, var(--nest-pink) 30%, transparent);
    background: color-mix(in srgb, var(--nest-midnight-900) 92%, transparent);
    clip-path: var(--clip-corner-md);
  }

  .swarm-story__recipe-head h3 {
    margin: 0 0 0.35rem;
    text-transform: uppercase;
    letter-spacing: 0.04em;
  }

  .swarm-story__recipe-head p {
    margin: 0 0 0.9rem;
    color: var(--color-text-muted);
    font-size: 0.9rem;
  }

  .swarm-story__tabs {
    display: flex;
    flex-wrap: wrap;
    gap: 0.45rem;
    margin-bottom: 1rem;
  }

  .swarm-story__radio {
    position: absolute;
    opacity: 0;
    pointer-events: none;
  }

  .swarm-story__tab {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-block-size: 44px;
    min-inline-size: 5.5rem;
    padding: 0.45rem 0.9rem;
    border: 1px solid var(--color-border);
    background: color-mix(in srgb, var(--nest-midnight-950) 80%, transparent);
    clip-path: var(--clip-corner-sm);
    font-family: var(--font-mono);
    font-size: 0.78rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    cursor: pointer;
  }

  .swarm-story__radio:focus-visible + .swarm-story__tab {
    outline: 2px solid var(--nest-cyan);
    outline-offset: 2px;
  }

  .swarm-story__radio:checked + .swarm-story__tab {
    border-color: var(--nest-magenta);
    color: var(--nest-magenta);
    box-shadow: 0 0 0 1px color-mix(in srgb, var(--nest-magenta) 45%, transparent);
  }

  .swarm-story__panel {
    display: none;
    gap: 0.85rem;
  }

  .swarm-story__recipes:has(#recipe-pair:checked) .swarm-story__panel--pair,
  .swarm-story__recipes:has(#recipe-team:checked) .swarm-story__panel--team,
  .swarm-story__recipes:has(#recipe-full:checked) .swarm-story__panel--full {
    display: grid;
  }

  @supports not selector(:has(*)) {
    .swarm-story__panel {
      display: grid;
      margin-block-end: 1rem;
      padding-block-end: 1rem;
      border-block-end: 1px solid var(--color-border);
    }
  }

  .swarm-story__when {
    margin: 0;
    color: var(--color-text-muted);
    font-size: 0.92rem;
  }

  .swarm-story__roles {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.35rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .swarm-story__roles li {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
  }

  .swarm-story__arrow {
    width: 1.1rem;
    height: 1px;
    background: var(--nest-cyan);
  }

  .swarm-story__role {
    display: grid;
    gap: 0.1rem;
    padding: 0.55rem 0.7rem;
    border: 1px solid color-mix(in srgb, var(--nest-violet) 40%, transparent);
    background: color-mix(in srgb, var(--nest-violet) 10%, var(--nest-midnight-950));
    clip-path: var(--clip-corner-sm);
  }

  .swarm-story__role-id {
    font-weight: 650;
    font-size: 0.88rem;
  }

  .swarm-story__role-policy {
    font-family: var(--font-mono);
    font-size: 0.68rem;
    color: var(--color-text-faint);
    letter-spacing: 0.06em;
  }

  .swarm-story__role-svg {
    width: min(100%, 48rem);
    max-inline-size: 100%;
    color: var(--nest-cyan);
    overflow: hidden;
  }

  .swarm-story__noscript {
    margin: 0.75rem 0 0;
    color: var(--color-text-faint);
    font-size: 0.85rem;
  }

  .swarm-story__backends {
    display: grid;
    gap: 0.85rem;
  }

  .swarm-story__backends h3 {
    margin: 0;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    font-size: 1rem;
  }

  .swarm-story__state {
    padding: 0.9rem 1rem;
    border: 1px dashed color-mix(in srgb, var(--nest-cyan) 45%, transparent);
    background: color-mix(in srgb, var(--nest-cyan) 6%, var(--nest-midnight-950));
    clip-path: var(--clip-corner-md);
  }

  .swarm-story__state-label {
    margin: 0 0 0.45rem;
    font-family: var(--font-mono);
    font-size: 0.7rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--nest-cyan);
  }

  .swarm-story__state ul {
    display: flex;
    flex-wrap: wrap;
    gap: 0.45rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .swarm-story__state li {
    padding: 0.35rem 0.55rem;
    border: 1px solid var(--color-border);
    font-family: var(--font-mono);
    font-size: 0.72rem;
    color: var(--color-text-muted);
  }

  .swarm-story__views {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0.75rem;
  }

  .swarm-story__views article {
    padding: 1rem;
    border: 1px solid var(--color-border);
    background: color-mix(in srgb, var(--nest-violet) 8%, var(--nest-midnight-900));
    clip-path: var(--clip-corner-md);
  }

  .swarm-story__views h4 {
    margin: 0 0 0.35rem;
    color: var(--nest-pink);
  }

  .swarm-story__views p {
    margin: 0;
    color: var(--color-text-muted);
    font-size: 0.9rem;
  }

  @media (width < 900px) {
    .swarm-story__pipeline {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (width < 640px) {
    .swarm-story__pipeline,
    .swarm-story__views {
      grid-template-columns: 1fr;
    }

    .swarm-story__role-svg {
      display: none;
    }
  }
</style>
