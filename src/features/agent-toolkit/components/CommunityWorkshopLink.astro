---
import { communityCrossLink } from '../data/index.js';
---

<section class="atk-community" data-reveal aria-labelledby="atk-community-title">
  <p class="atk-community__eyebrow">Digital Nest</p>
  <h2 id="atk-community-title">{communityCrossLink.title}</h2>
  <p>{communityCrossLink.summary.split('.')[0]}.</p>
  <a href={communityCrossLink.href}>{communityCrossLink.cta} →</a>
</section>

<style>
  .atk-community {
    width: min(100% - 2 * var(--section-padding-x, 1.5rem), 74rem);
    margin: 0 auto;
    padding-block: 1.5rem 2.5rem;
  }

  .atk-community__eyebrow {
    margin: 0 0 0.35rem;
    font-family: var(--font-mono);
    font-size: 0.68rem;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--world-accent-tertiary, var(--nest-sunset-orange));
  }

  .atk-community h2 {
    margin: 0 0 0.4rem;
    font-size: 1.15rem;
    text-transform: uppercase;
  }

  .atk-community p {
    margin: 0 0 0.65rem;
    color: var(--color-text-muted);
    max-inline-size: 60ch;
  }

  .atk-community a {
    font-family: var(--font-mono);
    font-size: 0.78rem;
    color: var(--nest-cyan);
    text-decoration: none;
    border-bottom: 1px solid color-mix(in srgb, var(--nest-cyan) 40%, transparent);
  }
</style>
