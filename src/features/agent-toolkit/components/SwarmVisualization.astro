---
import { swarmScenes } from '../data/index.js';
---

<section class="swarm" aria-labelledby="swarm-title">
  <h2 id="swarm-title">Swarm 8 scenes</h2>
  <div role="list">
    {
      swarmScenes.map((s) => (
        <article>
          <>
            <h3>{s.title}</h3>
            <p>{s.description}</p>
            <svg viewBox="0 0 100 100" role="img">
              <>
                <title>{s.title}</title>
                <rect width="100" height="100" fill={s.color} />
              </>
            </svg>
          </>
        </article>
      ))
    }
  </div>
  <p>No canvas, only HTML/CSS/inline SVG</p>
</section>
<style>
  .swarm {
    max-width: 72rem;
    margin: 0 auto;
  }
</style>
