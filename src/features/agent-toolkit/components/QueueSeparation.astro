---
import { queueVsSwarm } from '../data/index.js';
---

<section class="queue-sep" aria-labelledby="queue-sep-title">
  <header>
    <p class="queue-sep__eyebrow">KEEP queue ≠ swarm</p>
    <h2 id="queue-sep-title">DevCompanion queues work. Swarm orchestrates roles.</h2>
    <p>
      Mixing them is the most common mental model bug. DevCompanion’s durable KEEP queue persists background jobs; the
      swarm runs a recipe topology with isolated worktrees and governance over shared state files. Same CLI surface —
      different products.
    </p>
  </header>

  <div class="queue-sep__grid">
    {
      queueVsSwarm.map((item) => (
        <article data-kind={item.id}>
          <h3>{item.title}</h3>
          <p>{item.summary}</p>
          <ul>
            {item.bullets.map((bullet) => (
              <li>{bullet}</li>
            ))}
          </ul>
          <pre>
            <code>{item.command}</code>
          </pre>
        </article>
      ))
    }
  </div>
</section>

<style>
  .queue-sep {
    width: min(100% - 2 * var(--section-padding-x), 74rem);
    margin: 0 auto;
    padding-block: clamp(1.75rem, 4vw, 3rem);
  }

  .queue-sep__eyebrow {
    margin: 0 0 var(--space-2);
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--world-accent-tertiary, var(--nest-sunset-orange));
  }

  .queue-sep h2 {
    margin: 0 0 var(--space-3);
    font-size: clamp(1.35rem, 2.8vw, 1.85rem);
    text-transform: uppercase;
  }

  .queue-sep header p {
    margin: 0;
    max-inline-size: 70ch;
    color: var(--color-text-muted);
  }

  .queue-sep__grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0.85rem;
    margin-block-start: 1.2rem;
  }

  .queue-sep article {
    display: grid;
    gap: 0.55rem;
    padding: 1rem;
    border: 1px solid var(--color-border);
    background: color-mix(in srgb, var(--nest-midnight-900) 90%, transparent);
    clip-path: var(--clip-corner-md);
  }

  .queue-sep article[data-kind='devcompanion'] {
    border-inline-start: 3px solid var(--nest-sunset-orange);
  }

  .queue-sep article[data-kind='swarm'] {
    border-inline-start: 3px solid var(--nest-cyan);
  }

  .queue-sep h3 {
    margin: 0;
    font-size: 1rem;
  }

  .queue-sep p,
  .queue-sep li {
    margin: 0;
    color: var(--color-text-muted);
    font-size: 0.9rem;
  }

  .queue-sep ul {
    margin: 0;
    padding-inline-start: 1.1rem;
  }

  .queue-sep pre {
    margin: 0;
    padding: 0.7rem;
    overflow-x: auto;
    border: 1px solid var(--color-border);
    background: var(--color-code-bg, color-mix(in srgb, var(--nest-midnight-950) 88%, transparent));
    clip-path: var(--clip-corner-sm);
    font-size: 0.75rem;
  }

  @media (width < 800px) {
    .queue-sep__grid {
      grid-template-columns: 1fr;
    }
  }
</style>
