---
import { toolkitOverview, toolkitStats } from '../data/index.js';
---

<section class="toolkit-overview" aria-labelledby="overview-title">
  <h2 id="overview-title">Overview</h2>
  <div role="list">
    {
      toolkitStats.map((s) => (
        <div>
          {s.value} {s.label}
        </div>
      ))
    }
  </div>
  <div>
    {
      toolkitOverview.map((s) => (
        <article>
          <h3>{s.title}</h3>
          {s.paragraphs.map((p) => (
            <p>{p}</p>
          ))}
        </article>
      ))
    }
  </div>
  <svg viewBox="0 0 100 100" role="img" aria-labelledby="t d"
    ><title id="t">t</title><desc id="d">d</desc><rect width="100" height="100" fill="var(--theme-accent)"></rect></svg
  >
</section>
<style>
  .toolkit-overview {
    max-width: 72rem;
    margin: 0 auto;
  }
</style>
