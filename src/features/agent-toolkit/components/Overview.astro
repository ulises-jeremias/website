---
import { toolkitOverview } from '../data/index.js';
---

<section class="toolkit-overview" aria-labelledby="overview-title">
  <header>
    <p class="toolkit-overview__eyebrow">Responsibility</p>
    <h2 id="overview-title">Capability distribution in the Personal DX graph</h2>
    <p>
      Workstation provisions the machine. Toolkit distributes capabilities and owns orchestration. Harness holds
      persistent context. HorneroConfig is an optional desktop path, not a mandatory step.
    </p>
  </header>

  <ol class="toolkit-overview__layers">
    <li data-layer="workstation"><span>Machine</span><strong>Workstation</strong><em>provisioning · policy</em></li>
    <li data-layer="toolkit" aria-current="true">
      <span>Capabilities</span><strong>Toolkit</strong><em>distribution · orchestration</em>
    </li>
    <li data-layer="harness"><span>Context</span><strong>Harness</strong><em>workspace · memory</em></li>
    <li data-layer="hornero"><span>Desktop</span><strong>HorneroConfig</strong><em>optional configuration</em></li>
  </ol>

  <div class="toolkit-overview__points">
    {
      toolkitOverview.map((section) => (
        <article>
          <h3>{section.title}</h3>
          {section.paragraphs.map((paragraph) => (
            <p>{paragraph}</p>
          ))}
        </article>
      ))
    }
  </div>
</section>

<style>
  .toolkit-overview {
    width: min(100% - 2 * var(--section-padding-x), 74rem);
    margin: 0 auto;
    padding-block: clamp(1.5rem, 4vw, 2.75rem);
  }

  .toolkit-overview__eyebrow {
    margin: 0 0 var(--space-2);
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--world-accent-tertiary, var(--nest-sunset-orange));
  }

  .toolkit-overview h2 {
    margin: 0 0 var(--space-3);
    font-size: clamp(1.35rem, 2.8vw, 1.85rem);
    text-transform: uppercase;
  }

  .toolkit-overview header p {
    margin: 0;
    max-inline-size: 68ch;
    color: var(--color-text-muted);
  }

  .toolkit-overview__layers {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 0.55rem;
    margin: 1.25rem 0;
    padding: 0;
    list-style: none;
  }

  .toolkit-overview__layers li {
    display: grid;
    gap: 0.2rem;
    padding: 0.8rem;
    border: 1px solid var(--color-border);
    background: color-mix(in srgb, var(--nest-midnight-900) 90%, transparent);
    clip-path: var(--clip-corner-sm);
  }

  .toolkit-overview__layers li[aria-current='true'] {
    border-color: color-mix(in srgb, var(--nest-magenta) 55%, transparent);
    box-shadow: inset 0 0 0 1px color-mix(in srgb, var(--nest-magenta) 35%, transparent);
  }

  .toolkit-overview__layers span {
    font-family: var(--font-mono);
    font-size: 0.68rem;
    letter-spacing: 0.12em;
    color: var(--nest-cyan);
  }

  .toolkit-overview__layers strong {
    font-size: 0.95rem;
  }

  .toolkit-overview__layers em {
    font-style: normal;
    color: var(--color-text-faint);
    font-size: 0.78rem;
  }

  .toolkit-overview__points {
    display: grid;
    gap: 0.85rem;
    grid-template-columns: repeat(3, minmax(0, 1fr));
  }

  .toolkit-overview__points article {
    padding: 0;
    border: 0;
    background: transparent;
    border-block-start: 2px solid color-mix(in srgb, var(--nest-violet) 55%, transparent);
    padding-block-start: 0.75rem;
  }

  .toolkit-overview__points h3 {
    margin: 0 0 0.45rem;
    font-size: 0.98rem;
  }

  .toolkit-overview__points p {
    margin: 0 0 0.4rem;
    color: var(--color-text-muted);
    font-size: 0.9rem;
  }

  @media (width < 900px) {
    .toolkit-overview__layers,
    .toolkit-overview__points {
      grid-template-columns: 1fr;
    }
  }
</style>
