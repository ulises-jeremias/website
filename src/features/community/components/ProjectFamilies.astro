---
import { projectFamilies, weeklyOpportunities } from '../data/index.js';
---

<section class="community-families" aria-labelledby="families-title" data-testid="project-families">
  <header class="community-families__header">
    <p class="community-families__eyebrow">Project families</p><h2
      id="families-title"
      class="community-families__title"
    >
      Three families, one composition model
    </h2><p class="community-families__lead">
      Choose a template, add addons, and ship files you own. Weekly triage keeps the boards fresh — check the labeled
      issues rather than relying on announcements.
    </p>
  </header>
  <div class="community-families__grid">
    {
      projectFamilies.map((family) => (
        <article class="community-families__card" aria-labelledby={`family-${family.id}`}>
          <>
            <div class="community-families__card-head">
              <>
                <span class="community-families__icon" aria-hidden="true">
                  {family.icon}
                </span>
                <span class="community-families__label">{family.label}</span>
              </>
            </div>
            <h3 id={`family-${family.id}`} class="community-families__card-title">
              {family.title}
            </h3>
            <p class="community-families__card-text">{family.description}</p>
            <div class="community-families__meta" aria-label="Languages">
              {family.languages.map((lang) => (
                <span class="community-families__tag">{lang}</span>
              ))}
            </div>
            <p class="community-families__hint">
              <code>{family.installHint}</code>
            </p>
            <a
              href={family.href}
              class="community-families__link"
              target="_blank"
              rel="noreferrer noopener"
              aria-label={`${family.title} templates on GitHub (opens in new tab)`}
            >
              Templates →<span class="sr-only"> (opens in new tab)</span>
            </a>
          </>
        </article>
      ))
    }
  </div>
  <div class="community-families__weekly" role="region" aria-labelledby="weekly-title">
    <h3 id="weekly-title" class="community-families__weekly-title">Weekly contribution opportunities</h3><p
      class="community-families__weekly-lead"
    >
      Triage runs weekly. Look for these labels; each issue has scope and the file it touches.
    </p><div class="community-families__weekly-grid">
      {
        weeklyOpportunities.map((op) => (
          <a
            href={op.href}
            class="community-families__op"
            target="_blank"
            rel="noreferrer noopener"
            aria-label={`${op.title} — ${op.labels.join(', ')} (opens in new tab)`}
          >
            <>
              <span class="community-families__op-title">{op.title}</span>
              <span class="community-families__op-text">{op.description}</span>
              <span class="community-families__op-labels" aria-label="Labels">
                {op.labels.map((label) => (
                  <span class="community-families__op-label">{label}</span>
                ))}
              </span>
            </>
          </a>
        ))
      }
    </div>
  </div>
</section>
<style>
  .community-families {
    max-width: 72rem;
    margin: 0 auto;
    padding: 1.5rem 0;
  }
  .community-families__eyebrow {
    display: inline-flex;
    padding: 0.25rem 0.65rem;
    border-radius: 999px;
    background: var(--world-accent-subtle);
    border: 1px solid var(--color-border);
    color: var(--world-accent);
    font-size: 0.78rem;
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    margin: 0 0 0.75rem;
  }
  .community-families__title {
    margin: 0;
    font-size: clamp(1.5rem, 3vw, 2rem);
    font-weight: 800;
    line-height: 1.1;
    letter-spacing: -0.03em;
    color: var(--color-text);
  }
  .community-families__lead {
    margin: 0.5rem 0 0;
    max-width: 62ch;
    color: var(--color-text-muted);
    line-height: 1.6;
    font-size: 1rem;
  }
  .community-families__grid {
    display: grid;
    gap: 1rem;
    margin-top: 1.25rem;
    grid-template-columns: 1fr;
  }
  @media (min-width: 860px) {
    .community-families__grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }
  .community-families__card {
    padding: 1.15rem;
    border-radius: 1rem;
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    box-shadow: var(--shadow-sm);
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }
  .community-families__card-head {
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }
  .community-families__icon {
    width: 2rem;
    height: 2rem;
    display: grid;
    place-items: center;
    border-radius: 0.6rem;
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    font-size: 1.1rem;
    line-height: 1;
  }
  .community-families__label {
    font-weight: 750;
    font-size: 0.85rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--color-text-muted);
  }
  .community-families__card-title {
    margin: 0;
    font-size: 1.05rem;
    font-weight: 750;
    color: var(--color-text);
    letter-spacing: -0.02em;
  }
  .community-families__card-text {
    margin: 0;
    color: var(--color-text-muted);
    line-height: 1.6;
    font-size: 0.95rem;
  }
  .community-families__meta {
    display: flex;
    flex-wrap: wrap;
    gap: 0.35rem;
    margin-top: 0.25rem;
  }
  .community-families__tag {
    padding: 0.2rem 0.5rem;
    border-radius: 999px;
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    font-size: 0.78rem;
    font-weight: 600;
    color: var(--color-text-faint);
  }
  .community-families__hint {
    margin: 0.25rem 0 0;
    color: var(--color-text-faint);
    font-size: 0.82rem;
    line-height: 1.5;
    overflow-wrap: break-word;
  }
  .community-families__hint code {
    padding: 0.15rem 0.35rem;
    border-radius: 0.35rem;
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    font-size: 0.78rem;
  }
  .community-families__link {
    margin-top: auto;
    display: inline-flex;
    align-items: center;
    gap: 0.25rem;
    color: var(--color-link);
    font-weight: 600;
    font-size: 0.9rem;
    text-decoration: none;
    min-height: 44px;
  }
  .community-families__link:hover {
    text-decoration: underline;
    text-underline-offset: 3px;
  }
  .community-families__link:focus-visible {
    outline: 2px solid var(--color-focus);
    outline-offset: 2px;
    border-radius: 0.25rem;
  }
  .community-families__weekly {
    margin-top: 1.5rem;
    padding: 1.15rem;
    border-radius: 1rem;
    background: var(--color-surface);
    border: 1px solid var(--color-border);
  }
  .community-families__weekly-title {
    margin: 0;
    font-size: 1.05rem;
    font-weight: 750;
    color: var(--color-text);
  }
  .community-families__weekly-lead {
    margin: 0.35rem 0 0;
    color: var(--color-text-muted);
    font-size: 0.9rem;
    line-height: 1.5;
  }
  .community-families__weekly-grid {
    display: grid;
    gap: 0.75rem;
    margin-top: 0.85rem;
    grid-template-columns: 1fr;
  }
  @media (min-width: 720px) {
    .community-families__weekly-grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }
  .community-families__op {
    display: grid;
    gap: 0.35rem;
    padding: 0.9rem;
    border-radius: 0.85rem;
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    text-decoration: none;
    color: inherit;
    transition:
      border-color 140ms ease,
      box-shadow 140ms ease;
  }
  .community-families__op:hover {
    border-color: var(--color-border-strong, #d4c4b2);
    box-shadow: var(--shadow-sm);
  }
  .community-families__op:focus-visible {
    outline: 2px solid var(--color-focus);
    outline-offset: 2px;
  }
  .community-families__op-title {
    font-weight: 700;
    font-size: 0.95rem;
    color: var(--color-text);
  }
  .community-families__op-text {
    color: var(--color-text-muted);
    font-size: 0.85rem;
    line-height: 1.5;
  }
  .community-families__op-labels {
    display: flex;
    flex-wrap: wrap;
    gap: 0.3rem;
  }
  .community-families__op-label {
    padding: 0.15rem 0.45rem;
    border-radius: 999px;
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    font-size: 0.75rem;
    font-weight: 600;
    color: var(--color-text-faint);
  }
  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }
</style>
