---
import { communityMeta, workshopSections } from '../data/index.js';
---

<section class="cm-narrative" aria-labelledby="cm-narrative-title" data-testid="workshop-narrative">
  <header class="cm-narrative__header">
    <p class="cm-narrative__eyebrow">Workshop narrative</p>
    <h2 id="cm-narrative-title" class="cm-narrative__title">What this community is</h2>
  </header>
  <div class="cm-narrative__grid">
    {
      workshopSections.map((section) => (
        <article class="cm-narrative__card" aria-labelledby={`narrative-${section.id}`}>
          <h3 id={`narrative-${section.id}`} class="cm-narrative__card-title">
            {section.title}
          </h3>
          {section.paragraphs.map((p) => (
            <p class="cm-narrative__text">{p}</p>
          ))}
        </article>
      ))
    }
  </div>
  <p class="cm-narrative__note" role="note">{communityMeta.communityDistinctNote}</p>
</section>

<style>
  .cm-narrative {
    padding: 1.75rem 0;
  }
  .cm-narrative__eyebrow {
    margin: 0;
    font-family: var(--font-display);
    font-size: 0.7rem;
    font-weight: 700;
    letter-spacing: 0.28em;
    text-transform: uppercase;
    color: var(--nest-cyan);
  }
  .cm-narrative__title {
    margin: 0.5rem 0 0;
    font-size: clamp(1.35rem, 3vw, 1.75rem);
    font-weight: 800;
    color: var(--color-text);
  }
  .cm-narrative__grid {
    display: grid;
    gap: 0.9rem;
    margin-top: 1.1rem;
  }
  @media (width >= 900px) {
    .cm-narrative__grid {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }
  .cm-narrative__card {
    padding: 1rem;
    clip-path: var(--clip-corner-sm);
    border: 1px solid var(--color-border);
    background: color-mix(in srgb, var(--nest-midnight-900) 88%, transparent);
  }
  .cm-narrative__card-title {
    margin: 0;
    font-size: 1.02rem;
    color: var(--nest-pink);
  }
  .cm-narrative__text {
    margin: 0.55rem 0 0;
    color: var(--color-text-muted);
    font-size: 0.92rem;
    line-height: 1.55;
  }
  .cm-narrative__note {
    margin: 1rem 0 0;
    color: var(--color-text-faint);
    font-size: 0.88rem;
    line-height: 1.5;
  }
</style>
