---
import { communityMeta } from '../data/index.js';

interface Props {
  inviteUrl?: string;
}

const { inviteUrl = communityMeta.discordInviteUrl } = Astro.props as Props;
---

<section class="cm-discord" aria-labelledby="cm-discord-title" data-testid="discord-cta">
  <div class="cm-discord__copy">
    <p class="cm-discord__eyebrow">Discord · verified invite</p>
    <h2 id="cm-discord-title" class="cm-discord__title">Join the Digital Nest Discord</h2>
    <p class="cm-discord__lead">
      The umbrella room for HorneroConfig, Workstation, Harness, Agent Toolkit, Create Awesome, V work, and incubating
      experiments. Ask questions, share drafts, or just follow along — contribution is optional.
    </p>
    <p class="cm-discord__note">
      Invite <code>discord.gg/bR5VyATgka</code> · {communityMeta.communityDistinctNote}
    </p>
  </div>
  <a
    class="cm-discord__cta"
    href={inviteUrl}
    target="_blank"
    rel="noopener noreferrer"
    aria-label="Join the Digital Nest Discord (opens in a new tab)"
    data-testid="discord-invite"
  >
    Join the Discord
  </a>
  <p class="cm-discord__policy">{communityMeta.metricsPolicy}</p>
</section>

<style>
  .cm-discord {
    display: grid;
    gap: 1rem;
    padding: 1.25rem;
    margin: 0.5rem 0;
    clip-path: var(--clip-corner-md);
    border: 1px solid color-mix(in srgb, #5865f2 45%, transparent);
    background: color-mix(in srgb, var(--nest-midnight-900) 90%, #5865f2 6%);
  }
  @media (width >= 860px) {
    .cm-discord {
      grid-template-columns: 1.5fr auto;
      align-items: center;
    }
  }
  .cm-discord__eyebrow {
    margin: 0;
    font-family: var(--font-display);
    font-size: 0.7rem;
    font-weight: 700;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: #9aa4ff;
  }
  .cm-discord__title {
    margin: 0.45rem 0 0;
    font-size: clamp(1.35rem, 3vw, 1.7rem);
    font-weight: 800;
    color: var(--color-text);
  }
  .cm-discord__lead,
  .cm-discord__note,
  .cm-discord__policy {
    margin: 0.5rem 0 0;
    color: var(--color-text-muted);
    line-height: 1.55;
    font-size: 0.95rem;
  }
  .cm-discord__note code,
  .cm-discord__policy {
    font-size: 0.85rem;
    color: var(--color-text-faint);
  }
  .cm-discord__cta {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 44px;
    padding: 0 1.2rem;
    clip-path: var(--clip-corner-sm);
    background: #5865f2;
    border: 1px solid #5865f2;
    color: #fff;
    font-weight: 750;
    text-decoration: none;
    white-space: nowrap;
  }
  .cm-discord__cta:hover {
    background: #4752c4;
    border-color: #4752c4;
  }
  .cm-discord__cta:focus-visible {
    outline: 2px solid var(--color-focus-ring);
    outline-offset: 2px;
  }
  .cm-discord__policy {
    grid-column: 1 / -1;
  }
</style>
