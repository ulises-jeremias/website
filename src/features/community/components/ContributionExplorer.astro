---
import { contributionOpportunities, interestFilters } from '../data/index.js';

const opsJson = JSON.stringify(
  contributionOpportunities.map((op) => ({
    id: op.id,
    interests: op.interests,
  })),
);
---

<section
  id="find-something"
  class="cm-explore"
  aria-labelledby="cm-explore-title"
  data-testid="contribution-explorer"
  data-cm-explore
  data-ops={opsJson}
>
  <header class="cm-explore__header">
    <p class="cm-explore__eyebrow">Contribute</p>
    <h2 id="cm-explore-title" class="cm-explore__title">Explore by interest</h2>
    <p class="cm-explore__lead">Filter across Digital Nest worlds and Create Awesome orgs.</p>
  </header>

  <div class="cm-explore__filters" role="group" aria-label="Interest filters">
    <button type="button" class="cm-explore__chip" data-cm-filter="all" aria-pressed="true" disabled>All</button>
    {
      interestFilters.map((filter) => (
        <button
          type="button"
          class="cm-explore__chip"
          data-cm-filter={filter.id}
          aria-pressed="false"
          disabled
          title={filter.hint}
        >
          {filter.label}
        </button>
      ))
    }
  </div>

  <ul class="cm-explore__ops" aria-label="Contribution opportunities">
    {
      contributionOpportunities.map((op) => (
        <li class="cm-explore__op" data-cm-op={op.id}>
          <div class="cm-explore__op-main">
            <h3 class="cm-explore__op-title">{op.title}</h3>
            <p class="cm-explore__op-desc">{op.description}</p>
          </div>
          <a class="cm-explore__op-link" href={op.href} target="_blank" rel="noopener noreferrer">
            GitHub
          </a>
        </li>
      ))
    }
  </ul>

  <p class="cm-explore__hint" data-cm-explore-hint aria-live="polite">
    Filter illuminates plaza stations above. Pick an interest to focus the workshop.
  </p>
</section>

<style>
  .cm-explore {
    padding: 0.5rem 0;
    scroll-margin-top: 5rem;
  }

  .cm-explore__hint {
    margin: 0.65rem 0 0;
    color: var(--color-text-muted);
    font-size: 0.85rem;
  }

  .cm-explore__eyebrow {
    margin: 0;
    font-family: var(--font-mono, ui-monospace, monospace);
    font-size: 0.68rem;
    font-weight: 700;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--nest-cyan, #22d3ee);
  }

  .cm-explore__title {
    margin: 0.35rem 0 0;
    font-size: clamp(1.15rem, 2.5vw, 1.4rem);
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: 0.03em;
    color: var(--color-text);
  }

  .cm-explore__lead {
    margin: 0.35rem 0 0;
    max-width: 48ch;
    color: var(--color-text-muted);
    font-size: 0.88rem;
    line-height: 1.4;
  }

  .cm-explore__filters {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
    margin-top: 0.85rem;
  }

  .cm-explore__chip {
    display: inline-flex;
    align-items: center;
    min-height: var(--touch-min, 44px);
    padding: 0 0.7rem;
    clip-path: var(--clip-corner-sm);
    border: 1px solid color-mix(in srgb, var(--nest-cyan, #22d3ee) 40%, transparent);
    background: transparent;
    color: var(--nest-cyan, #22d3ee);
    font-size: 0.78rem;
    font-weight: 650;
    cursor: pointer;
  }

  .cm-explore__chip[aria-pressed='true'],
  .cm-explore__chip:hover,
  .cm-explore__chip:focus-visible {
    border-color: var(--nest-magenta, #e879f9);
    color: var(--nest-pink, #ff6bb5);
  }

  .cm-explore__chip:focus-visible {
    outline: 2px solid var(--color-focus-ring);
    outline-offset: 2px;
  }

  .cm-explore__ops {
    list-style: none;
    margin: 0.9rem 0 0;
    padding: 0;
    display: grid;
    gap: 0.45rem;
  }

  .cm-explore__op {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 1rem;
    align-items: center;
    justify-content: space-between;
    padding: 0.65rem 0.8rem;
    clip-path: var(--clip-corner-sm);
    border: 1px solid var(--color-border);
    background: color-mix(in srgb, var(--nest-midnight-900, #0f172a) 88%, transparent);
  }

  .cm-explore__op[hidden] {
    display: none;
  }

  .cm-explore__op-title {
    margin: 0;
    font-size: 0.92rem;
    color: var(--color-text);
  }

  .cm-explore__op-desc {
    margin: 0.2rem 0 0;
    color: var(--color-text-muted);
    font-size: 0.8rem;
    line-height: 1.35;
    max-width: 52ch;
  }

  .cm-explore__op-link {
    color: var(--nest-cyan, #22d3ee);
    font-weight: 700;
    font-size: 0.82rem;
    text-decoration: none;
    min-height: 44px;
    display: inline-flex;
    align-items: center;
  }
</style>

<script>
  type OpMeta = { id: string; interests: string[] };

  function bindExplore(root: HTMLElement) {
    const ops = JSON.parse(root.dataset.ops || '[]') as OpMeta[];
    const chips = root.querySelectorAll<HTMLButtonElement>('[data-cm-filter]');

    const apply = (filter: string) => {
      chips.forEach((chip) => {
        chip.setAttribute('aria-pressed', chip.dataset.cmFilter === filter ? 'true' : 'false');
      });
      ops.forEach((op) => {
        const row = root.querySelector<HTMLElement>(`[data-cm-op="${op.id}"]`);
        if (!row) return;
        const show = filter === 'all' || op.interests.includes(filter);
        row.hidden = !show;
      });
    };

    chips.forEach((chip) => {
      chip.addEventListener('click', () => apply(chip.dataset.cmFilter || 'all'));
      chip.disabled = false;
    });
  }

  document.querySelectorAll<HTMLElement>('[data-cm-explore]').forEach(bindExplore);
</script>
