---
import { moderationItems, communityMeta } from '../data/index.js';
---

<section class="community-moderation" aria-labelledby="moderation-title" data-testid="moderation-privacy">
  <header class="community-moderation__header">
    <p class="community-moderation__eyebrow">Moderation & privacy</p><h2
      id="moderation-title"
      class="community-moderation__title"
    >
      Guardrails for a calm workshop
    </h2><p class="community-moderation__lead">
      Moderation is documented, privacy is minimal, and metrics are honest — or they are not shown at all.
    </p>
  </header>
  <div class="community-moderation__grid">
    {
      moderationItems.map((item) => (
        <article class="community-moderation__card" aria-label={item.title}>
          <>
            <h3 class="community-moderation__card-title">{item.title}</h3>
            <p class="community-moderation__card-text">{item.description}</p>
          </>
        </article>
      ))
    }
  </div>
  <div class="community-moderation__metrics" role="note" aria-label="Community metrics policy">
    <h3 class="community-moderation__metrics-title">Metrics policy</h3><p class="community-moderation__metrics-text">
      {communityMeta.metricsPolicy}
    </p><p class="community-moderation__metrics-text">
      If a count appears in the future, it will state its source, timestamp, and refresh cadence — and link to the query
      that produces it. Until then, the workshop is measured by merged PRs and closed issues, not by headcounts.
    </p>
  </div>
</section>
<style>
  .community-moderation {
    max-width: 72rem;
    margin: 0 auto;
    padding: 1.5rem 0;
  }
  .community-moderation__eyebrow {
    display: inline-flex;
    padding: 0.25rem 0.65rem;
    border-radius: 999px;
    background: var(--color-clay-muted, #f7f0e6);
    border: 1px solid var(--color-border, #e9d8c3);
    color: var(--color-clay-strong, #a14e2f);
    font-size: 0.78rem;
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    margin: 0 0 0.75rem;
  }
  .community-moderation__title {
    margin: 0;
    font-size: clamp(1.5rem, 3vw, 2rem);
    font-weight: 800;
    line-height: 1.1;
    letter-spacing: -0.03em;
    color: var(--color-ink, #181512);
  }
  .community-moderation__lead {
    margin: 0.5rem 0 0;
    max-width: 62ch;
    color: var(--color-text-muted, #3a352f);
    line-height: 1.6;
    font-size: 1rem;
  }
  .community-moderation__grid {
    display: grid;
    gap: 0.85rem;
    margin-top: 1.25rem;
    grid-template-columns: 1fr;
  }
  @media (min-width: 820px) {
    .community-moderation__grid {
      grid-template-columns: 1fr 1fr;
    }
  }
  .community-moderation__card {
    padding: 1rem 1.15rem;
    border-radius: 0.9rem;
    background: var(--color-surface, #fff);
    border: 1px solid var(--color-border, #e9d8c3);
    box-shadow: var(--shadow-sm);
  }
  .community-moderation__card-title {
    margin: 0 0 0.35rem;
    font-size: 0.95rem;
    font-weight: 750;
    color: var(--color-ink, #181512);
  }
  .community-moderation__card-text {
    margin: 0;
    color: var(--color-text-muted, #3a352f);
    font-size: 0.9rem;
    line-height: 1.6;
  }
  .community-moderation__metrics {
    margin-top: 1rem;
    padding: 1rem 1.15rem;
    border-radius: 0.9rem;
    background: var(--color-paper, #f7f0e6);
    border: 1px solid var(--color-border, #e9d8c3);
  }
  .community-moderation__metrics-title {
    margin: 0;
    font-size: 0.95rem;
    font-weight: 750;
    color: var(--color-ink, #181512);
  }
  .community-moderation__metrics-text {
    margin: 0.35rem 0 0;
    color: var(--color-text-muted, #3a352f);
    font-size: 0.9rem;
    line-height: 1.6;
  }
</style>
