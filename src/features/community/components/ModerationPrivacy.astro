---
import { moderationItems } from '../data/index.js';
---

<section class="cm-moderation" aria-labelledby="cm-moderation-title" data-testid="moderation-privacy">
  <header class="cm-moderation__header">
    <p class="cm-moderation__eyebrow">Boundaries</p>
    <h2 id="cm-moderation-title" class="cm-moderation__title">Moderation & privacy — only what is real</h2>
    <p class="cm-moderation__lead">
      No invented escalation ladders, appeals processes, or universal policies. When a Digital Nest–wide Code of Conduct
      exists, it will be linked explicitly.
    </p>
  </header>
  <ul class="cm-moderation__list">
    {
      moderationItems.map((item) => (
        <li class="cm-moderation__item">
          <h3 class="cm-moderation__item-title">{item.title}</h3>
          <p class="cm-moderation__item-text">{item.description}</p>
        </li>
      ))
    }
  </ul>
</section>

<style>
  .cm-moderation {
    padding: 1.75rem 0;
  }
  .cm-moderation__eyebrow {
    margin: 0;
    font-family: var(--font-display);
    font-size: 0.7rem;
    font-weight: 700;
    letter-spacing: 0.28em;
    text-transform: uppercase;
    color: var(--nest-cyan);
  }
  .cm-moderation__title {
    margin: 0.5rem 0 0;
    font-size: clamp(1.35rem, 3vw, 1.75rem);
    font-weight: 800;
    color: var(--color-text);
  }
  .cm-moderation__lead {
    margin: 0.55rem 0 0;
    max-width: 70ch;
    color: var(--color-text-muted);
    line-height: 1.6;
  }
  .cm-moderation__list {
    list-style: none;
    margin: 1rem 0 0;
    padding: 0;
    display: grid;
    gap: 0.75rem;
  }
  @media (width >= 800px) {
    .cm-moderation__list {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
  .cm-moderation__item {
    padding: 0.9rem 1rem;
    clip-path: var(--clip-corner-sm);
    border: 1px solid var(--color-border);
  }
  .cm-moderation__item-title {
    margin: 0;
    font-size: 0.98rem;
    color: var(--color-text);
  }
  .cm-moderation__item-text {
    margin: 0.4rem 0 0;
    color: var(--color-text-muted);
    font-size: 0.9rem;
    line-height: 1.55;
  }
</style>
