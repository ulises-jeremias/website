---
import { supportChannels } from '../data/index.js';
---

<section class="cm-support" aria-labelledby="cm-support-title" data-testid="support-channels">
  <header class="cm-support__header">
    <p class="cm-support__eyebrow">Channels</p>
    <h2 id="cm-support-title" class="cm-support__title">Where to talk and where to leave a trail</h2>
    <p class="cm-support__lead">
      Channel names inside Discord are not listed here unless they are intentionally published. Prefer durable GitHub
      issues for work that should outlive a chat thread.
    </p>
  </header>
  <ul class="cm-support__list">
    {
      supportChannels.map((channel) => (
        <li class="cm-support__item">
          <a
            href={channel.href}
            class="cm-support__link"
            target={channel.external ? '_blank' : undefined}
            rel={channel.external ? 'noopener noreferrer' : undefined}
          >
            {channel.label}
          </a>
          <p class="cm-support__desc">{channel.description}</p>
        </li>
      ))
    }
  </ul>
</section>

<style>
  .cm-support {
    padding: 1.75rem 0;
  }
  .cm-support__eyebrow {
    margin: 0;
    font-family: var(--font-display);
    font-size: 0.7rem;
    font-weight: 700;
    letter-spacing: 0.28em;
    text-transform: uppercase;
    color: var(--nest-cyan);
  }
  .cm-support__title {
    margin: 0.5rem 0 0;
    font-size: clamp(1.35rem, 3vw, 1.75rem);
    font-weight: 800;
    color: var(--color-text);
  }
  .cm-support__lead {
    margin: 0.55rem 0 0;
    max-width: 70ch;
    color: var(--color-text-muted);
    line-height: 1.6;
  }
  .cm-support__list {
    list-style: none;
    margin: 1rem 0 0;
    padding: 0;
    display: grid;
    gap: 0.75rem;
  }
  @media (width >= 800px) {
    .cm-support__list {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
  .cm-support__item {
    padding: 0.9rem 1rem;
    clip-path: var(--clip-corner-sm);
    border: 1px solid var(--color-border);
    background: color-mix(in srgb, var(--nest-midnight-900) 88%, transparent);
  }
  .cm-support__link {
    color: var(--nest-cyan);
    font-weight: 750;
    text-decoration: none;
  }
  .cm-support__link:focus-visible {
    outline: 2px solid var(--color-focus-ring);
    outline-offset: 2px;
  }
  .cm-support__desc {
    margin: 0.35rem 0 0;
    color: var(--color-text-muted);
    font-size: 0.9rem;
    line-height: 1.5;
  }
</style>
