---
import type { VProject } from '../types/index.js';

interface Props extends VProject {
  compact?: boolean;
}

const { title, shortLabel, description, href, repo, icon, role, highlights, compact = false } = Astro.props as Props;
---

<article class:list={['v-card', compact && 'v-card--compact']} data-project={shortLabel}>
  <header class="v-card__header">
    <span class="v-card__icon" aria-hidden="true">{icon}</span>
    <div class="v-card__meta">
      <h3 class="v-card__title">{title}</h3>
      <p class="v-card__repo">{repo}</p>
    </div>
    <a class="v-card__ext" href={href} target="_blank" rel="noreferrer" aria-label={`${title} on GitHub (external)`}>↗</a>
  </header>

  <p class="v-card__desc">{description}</p>
  <p class="v-card__role">{role}</p>

  {
    highlights.length > 0 && (
      <ul class="v-card__list" role="list">
        {highlights.map((h) => (
          <li class="v-card__item">{h}</li>
        ))}
      </ul>
    )
  }

  <a href={href} class="v-card__link" target="_blank" rel="noreferrer">
    {repo} →<span class="sr-only"> (opens in new tab)</span>
  </a>
</article>

<style>
  .v-card {
    display: flex;
    flex-direction: column;
    gap: 0.65rem;
    padding: 1.1rem 1.15rem;
    border-radius: 14px;
    background: var(--color-warm-white, #fffdf9);
    border: 1px solid var(--color-sand, #e9d8c3);
    box-shadow: 0 1px 2px rgba(0, 0, 0, 0.05), 0 4px 12px rgba(0, 0, 0, 0.04);
    transition:
      transform 160ms ease,
      box-shadow 160ms ease,
      border-color 160ms ease;
  }

  .v-card:hover {
    transform: translateY(-2px);
    border-color: color-mix(in srgb, var(--theme-accent, #1e5a8a) 22%, var(--color-sand));
    box-shadow: 0 10px 24px rgba(0, 0, 0, 0.08), 0 4px 12px rgba(0, 0, 0, 0.05);
  }

  .v-card:focus-within {
    outline: 2px solid var(--color-focus, #005fcc);
    outline-offset: 2px;
  }

  .v-card__header {
    display: flex;
    align-items: center;
    gap: 0.75rem;
  }

  .v-card__icon {
    display: inline-grid;
    place-items: center;
    width: 2.25rem;
    height: 2.25rem;
    border-radius: 10px;
    background: var(--theme-accent-subtle, color-mix(in srgb, #1e5a8a 7%, #f7f0e6));
    border: 1px solid var(--theme-border-accent, color-mix(in srgb, #1e5a8a 12%, #e9d8c3));
    font-size: 1.1rem;
    flex-shrink: 0;
  }

  .v-card__meta {
    flex: 1;
    min-width: 0;
  }

  .v-card__title {
    margin: 0;
    font-size: 1.02rem;
    font-weight: 800;
    letter-spacing: -0.02em;
    color: var(--color-deep-ink, #181512);
    line-height: 1.2;
  }

  .v-card__repo {
    margin: 0;
    font-family: var(--font-mono, ui-monospace, monospace);
    font-size: 0.76rem;
    color: var(--theme-accent-strong, #16446a);
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .v-card__ext {
    width: 32px;
    height: 32px;
    display: inline-grid;
    place-items: center;
    border-radius: 999px;
    border: 1px solid var(--color-sand, #e9d8c3);
    text-decoration: none;
    color: var(--color-deep-ink, #181512);
    font-size: 0.9rem;
    flex-shrink: 0;
  }

  .v-card__ext:hover {
    background: var(--theme-accent-subtle);
    border-color: var(--theme-border-accent);
  }

  .v-card__ext:focus-visible {
    outline: 2px solid var(--color-focus);
    outline-offset: 2px;
  }

  .v-card__desc {
    margin: 0;
    font-size: 0.92rem;
    line-height: 1.55;
    color: var(--color-deep-ink, #181512);
  }

  .v-card__role {
    margin: 0;
    font-size: 0.8rem;
    font-weight: 600;
    color: var(--color-moss-strong, #5a5e4f);
    letter-spacing: 0.01em;
  }

  .v-card__list {
    margin: 0;
    padding: 0;
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 0.32rem;
  }

  .v-card__item {
    position: relative;
    padding-left: 1rem;
    font-size: 0.82rem;
    line-height: 1.45;
    color: var(--color-text, #181512);
  }

  .v-card__item::before {
    content: '·';
    position: absolute;
    left: 0.15rem;
    color: var(--theme-accent, #1e5a8a);
    font-weight: 800;
  }

  .v-card__link {
    margin-top: auto;
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    font-family: var(--font-mono, ui-monospace, monospace);
    font-size: 0.82rem;
    font-weight: 600;
    color: var(--theme-accent-strong, #16446a);
    text-decoration: none;
    padding-top: 0.35rem;
  }

  .v-card__link:hover {
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  .v-card__link:focus-visible {
    outline: 2px solid var(--color-focus);
    outline-offset: 2px;
    border-radius: 4px;
  }

  .v-card--compact {
    padding: 0.9rem 1rem;
  }

  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }

  @media (prefers-reduced-motion: reduce) {
    .v-card {
      transition: none;
    }
  }
</style>
