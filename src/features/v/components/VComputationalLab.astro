</style>

<script is:inline>
  function clearChildren(el) {
    while (el.firstChild) el.removeChild(el.firstChild);
  }

  function setChips(list, chips) {
    clearChildren(list);
    for (const chip of chips) {
      const li = document.createElement('li');
      const code = document.createElement('code');
      code.textContent = chip;
      li.appendChild(code);
      list.appendChild(li);
    }
  }

  function loadSceneEvidence(panel) {
    panel.querySelectorAll('source[data-deferred-srcset]').forEach((source) => {
      const srcset = source.dataset.deferredSrcset;
      if (srcset) source.srcset = srcset;
      const sizes = source.dataset.deferredSizes;
      if (sizes) source.sizes = sizes;
      source.removeAttribute('data-deferred-srcset');
      source.removeAttribute('data-deferred-sizes');
    });

    panel.querySelectorAll('img[data-deferred-src]').forEach((image) => {
      const src = image.dataset.deferredSrc;
      if (src) image.src = src;
      image.removeAttribute('data-deferred-src');
    });
  }

  function bindLab(root) {
    if (root.hasAttribute('data-v-enhanced')) return;

    const stations = JSON.parse(root.dataset.stations || '[]');
    const selector = root.querySelector('[data-v-station-selector]');
    const titleEl = root.querySelector('#v-lab-inspector .vf-inspector__title');
    const bodyEl = root.querySelector('[data-v-inspector-body]');
    const roleEl = root.querySelector('[data-v-inspector-role]');
    const repoEl = root.querySelector('[data-v-inspector-repo]');
    const licenseEl = root.querySelector('[data-v-inspector-license]');
    const chipsEl = root.querySelector('[data-v-inspector-chips]');
    const linkEl = root.querySelector('[data-v-inspector-link]');
    const contributingEl = root.querySelector('[data-v-inspector-contributing]');
    const issuesEl = root.querySelector('[data-v-inspector-issues]');
    const statusEl = root.querySelector('[data-v-station-status]');
    const traceButton = root.querySelector('[data-v-architecture-run]');
    const topology = root.querySelector('[data-v-architecture-topology]');
    const architectureStatus = root.querySelector('[data-v-architecture-status]');
    const tabs = [...root.querySelectorAll('[data-v-station]')];
    const panels = [...root.querySelectorAll('[data-v-panel]')];
    const stationIds = new Set(stations.map((station) => station.id));
    const firstStation = stations[0];

    if (!firstStation) return;

    const completeController =
      stations.length > 0 &&
      stations.length === tabs.length &&
      stations.length === panels.length &&
      stationIds.size === stations.length &&
      Boolean(
        selector &&
        titleEl &&
        bodyEl &&
        roleEl &&
        repoEl &&
        licenseEl &&
        chipsEl &&
        linkEl &&
        contributingEl &&
        issuesEl,
      ) &&
      stations.every(
        (station) =>
          tabs.some((tab) => tab.dataset.vStation === station.id) &&
          panels.some((panel) => panel.id === station.id && panel.dataset.vPanel === station.id),
      );

    if (
      !completeController ||
      !selector ||
      !titleEl ||
      !bodyEl ||
      !roleEl ||
      !repoEl ||
      !licenseEl ||
      !chipsEl ||
      !linkEl ||
      !contributingEl ||
      !issuesEl
    ) {
      return;
    }

    const controller = new AbortController();

    const hashStation = () => {
      if (!location.hash) return '';
      try {
        return decodeURIComponent(location.hash.slice(1));
      } catch {
        return '';
      }
    };

    let selectedStationId = '';

    const select = (id, focusTab = false, announce = false) => {
      const station = stations.find((s) => s.id === id);
      if (!station) return false;

      tabs.forEach((btn) => {
        const on = btn.dataset.vStation === id;
        btn.setAttribute('aria-selected', on ? 'true' : 'false');
        btn.tabIndex = on ? 0 : -1;
        if (on && focusTab) btn.focus();
      });

      panels.forEach((panel) => {
        panel.hidden = panel.dataset.vPanel !== id;
        if (!panel.hidden) loadSceneEvidence(panel);
      });
      root.querySelectorAll('[data-v-quick-station]').forEach((button) => {
        if (button.dataset.vQuickStation === id) button.setAttribute('aria-current', 'location');
        else button.removeAttribute('aria-current');
      });
      root.querySelectorAll('[data-v-map-station]').forEach((node) => {
        node.classList.toggle('is-current', node.dataset.vMapStation === id);
      });

      if (titleEl) titleEl.textContent = station.title;
      if (bodyEl) bodyEl.textContent = station.body;
      if (roleEl) roleEl.textContent = station.role;
      if (repoEl) repoEl.textContent = station.repo;
      if (licenseEl) licenseEl.textContent = station.license;
      if (chipsEl) setChips(chipsEl, station.chips);
      if (linkEl) {
        linkEl.href = station.href;
        linkEl.textContent = `Open ${station.repo} ↗`;
      }
      if (contributingEl) contributingEl.href = station.contributingHref;
      if (issuesEl) issuesEl.href = station.issuesHref;
      if (announce && statusEl) statusEl.textContent = `Station selected: ${station.title} — ${station.role}.`;
      selectedStationId = id;
      return true;
    };

    const pushStation = (id) => {
      if (location.hash === `#${id}`) return;
      history.pushState({ vStation: id }, '', `${location.pathname}${location.search}#${id}`);
    };

    const selectFromUser = (id, focusTab = false) => {
      const requested = hashStation();
      if (selectedStationId === id && (!requested || requested === id)) return;
      if (!select(id, focusTab, true)) return;
      pushStation(id);
    };

    const syncFromLocation = () => {
      const requested = hashStation();
      if (!requested) {
        select(firstStation.id);
        return;
      }
      if (stationIds.has(requested)) select(requested);
    };

    const restoreStaticDocument = () => {
      controller.abort();
      root.removeAttribute('data-v-enhanced');
      selector.hidden = true;
      selector.removeAttribute('role');
      selector.removeAttribute('aria-label');
      selector.removeAttribute('aria-orientation');
      tabs.forEach((tab) => {
        tab.removeAttribute('role');
        tab.removeAttribute('aria-selected');
        tab.removeAttribute('aria-controls');
        tab.removeAttribute('tabindex');
      });
      panels.forEach((panel) => {
        loadSceneEvidence(panel);
        panel.hidden = false;
        panel.removeAttribute('role');
        const station = stations.find((item) => item.id === panel.id);
        if (station) panel.setAttribute('aria-labelledby', station.headingId);
      });
    };

    try {
      selector.setAttribute('role', 'tablist');
      selector.setAttribute('aria-label', 'Lab stations');
      selector.setAttribute('aria-orientation', 'horizontal');

      tabs.forEach((btn, index) => {
        const id = btn.dataset.vStation || '';
        btn.setAttribute('role', 'tab');
        btn.setAttribute('aria-selected', 'false');
        btn.setAttribute('aria-controls', id);
        btn.tabIndex = -1;
        btn.addEventListener('click', () => selectFromUser(id), { signal: controller.signal });
        btn.addEventListener(
          'keydown',
          (event) => {
            if (
              event.key !== 'ArrowRight' &&
              event.key !== 'ArrowLeft' &&
              event.key !== 'Home' &&
              event.key !== 'End'
            ) {
              return;
            }
            event.preventDefault();
            let next = index;
            if (event.key === 'ArrowRight') next = (index + 1) % tabs.length;
            if (event.key === 'ArrowLeft') next = (index - 1 + tabs.length) % tabs.length;
            if (event.key === 'Home') next = 0;
            if (event.key === 'End') next = tabs.length - 1;
            const target = tabs[next];
            if (target) selectFromUser(target.dataset.vStation || '', true);
          },
          { signal: controller.signal },
        );
      });

      root.querySelectorAll('[data-v-quick-station]').forEach((button) => {
        const id = button.dataset.vQuickStation || '';
        if (!stationIds.has(id)) return;
        button.addEventListener(
          'click',
          (event) => {
            event.preventDefault();
            selectFromUser(id);
          },
          { signal: controller.signal },
        );
      });

      panels.forEach((panel) => {
        panel.setAttribute('role', 'tabpanel');
        panel.setAttribute('aria-labelledby', `v-station-${panel.id}`);
      });

      addEventListener('hashchange', syncFromLocation, { signal: controller.signal });
      addEventListener('popstate', syncFromLocation, { signal: controller.signal });

      const requested = hashStation();
      const initialStation = stationIds.has(requested) ? requested : firstStation.id;
      if (!select(initialStation)) throw new Error('Unable to select the initial V station.');

      if (traceButton && topology && architectureStatus) {
        const reducedMotion = matchMedia('(prefers-reduced-motion: reduce)');
        let traceTimer = 0;
        traceButton.addEventListener(
          'click',
          () => {
            window.clearTimeout(traceTimer);
            topology.removeAttribute('data-tracing');
            if (reducedMotion.matches) {
              architectureStatus.textContent =
                'VTL builds on VSL; VSL defaults to pure V. Motion is disabled by your system preference.';
              return;
            }
            topology.setAttribute('data-tracing', 'true');
            architectureStatus.textContent = 'Tracing VTL → VSL → V: tensors, scientific computing, language.';
            traceTimer = window.setTimeout(() => {
              topology.removeAttribute('data-tracing');
              architectureStatus.textContent = 'Trace complete · VTL is backed by VSL, whose default path is pure V.';
            }, 1600);
          },
          { signal: controller.signal },
        );
        traceButton.hidden = false;
      }

      selector.hidden = false;
      root.setAttribute('data-v-enhanced', 'true');
    } catch (error) {
      restoreStaticDocument();
      console.error('V Lab enhancement failed; restored the complete static document.', error);
    }
  }

  document.querySelectorAll('[data-v-lab]').forEach(bindLab);
</script>
