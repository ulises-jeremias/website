---
import FlagshipProvenance from '@/shared/components/FlagshipProvenance.astro';
import { SceneInspector, WorldDock } from '@/shared/components/visual';
import '@/shared/components/visual/visual.css';
import VLanguageScene from './scenes/VLanguageScene.astro';
import VSLScene from './scenes/VSLScene.astro';
import VTLAutoGradScene from './scenes/VTLAutoGradScene.astro';
import RxVStreamScene from './scenes/RxVStreamScene.astro';
import SetupVScene from './scenes/SetupVScene.astro';
import AwesomeVScene from './scenes/AwesomeVScene.astro';
import { licenseEntries, SETUP_V_PIN, vProjects } from '../data/index.js';

const stationHeadingIds = {
  v: 'v-scene-v-title',
  vsl: 'v-scene-vsl-title',
  vtl: 'v-scene-vtl-title',
  rxv: 'v-scene-rxv-title',
  'setup-v': 'v-scene-setup-title',
  'awesome-v': 'v-scene-awesome-title',
} as const;

const stations = vProjects.map((project) => ({
  id: project.id,
  label: project.title,
  title: project.title,
  headingId: stationHeadingIds[project.id],
  body: project.description,
  role: project.role,
  repo: project.repo,
  href: project.href,
  contributingHref: project.contributingHref,
  issuesHref: project.issuesHref,
  license: project.license,
  chips: project.highlights.slice(0, 3),
}));

const defaultStation = stations[0]!;
const stationsJson = JSON.stringify(stations);
---

<section class="v-lab" aria-labelledby="v-lab-title" data-v-lab data-stations={stationsJson}>
  <header class="v-lab__header">
    <div class="v-lab__header-copy">
      <p class="v-lab__eyebrow">V Ecosystem · computational lab</p>
      <h1 id="v-lab-title">V Ecosystem</h1>
      <p class="v-lab__lede">
        Six lab stations cover my work across the V ecosystem — the compiler core, scientific computing, tensors and
        autograd, reactive streams, CI tooling, and the community catalog. Each station pairs a working diagram with the
        verified role, repository, and license behind it.
      </p>
    </div>
    <aside class="v-lab__architecture" aria-labelledby="v-architecture-title" data-v-architecture>
      <div class="v-lab__architecture-head">
        <p class="v-lab__architecture-kicker">One documented foundation path</p>
        <button type="button" class="v-lab__trace-button" data-v-architecture-run hidden>
          Trace the dependency
        </button>
      </div>
      <h2 id="v-architecture-title">VTL builds on VSL</h2>
      <p class="v-lab__architecture-lede">
        A tensor and autograd library builds on VSL's scientific computing. VSL's default path is pure V.
      </p>
      <div class="v-lab__topology" data-v-architecture-topology>
        <div class="v-lab__topology-node" style="--trace-order: 0">
          <span class="v-lab__node-index">01 · MODEL</span>
          <strong>VTL</strong>
          <small>Tensors · autograd</small>
        </div>
        <div class="v-lab__topology-edge" style="--trace-order: 0" aria-label="VTL builds on VSL">
          <span>builds on</span>
          <i aria-hidden="true"></i>
        </div>
        <div class="v-lab__topology-node" style="--trace-order: 1">
          <span class="v-lab__node-index">02 · MATH</span>
          <strong>VSL</strong>
          <small>Scientific computing</small>
        </div>
        <div class="v-lab__topology-edge" style="--trace-order: 1" aria-label="VSL defaults to pure V">
          <span>pure-V default</span>
          <i aria-hidden="true"></i>
        </div>
        <div class="v-lab__topology-node" style="--trace-order: 2">
          <span class="v-lab__node-index">03 · LANGUAGE</span>
          <strong>V</strong>
          <small>Compiler · stdlib</small>
        </div>
      </div>
      <div class="v-lab__sideband" role="group" aria-label="Parallel V project stations">
        <p>
          Parallel stations <span>separate project roles</span>
        </p>
        <div class="v-lab__sideband-list">
          <a href="#rxv" data-v-quick-station="rxv">
            <strong>RxV</strong>
            <small>Reactive streams</small>
          </a>
          <a href="#setup-v" data-v-quick-station="setup-v">
            <strong>setup-v</strong>
            <small>CI installation</small>
          </a>
          <a href="#awesome-v" data-v-quick-station="awesome-v">
            <strong>Awesome V</strong>
            <small>Community catalog</small>
          </a>
        </div>
      </div>
      <p class="v-lab__architecture-note" data-v-architecture-status aria-live="polite">
        Architecture sketch · source-backed relationships, not live telemetry.
      </p>
    </aside>
    <div class="v-lab__header-evidence">
      <FlagshipProvenance
        entryId="v"
        note="Vlang projects are maintained by Ulises, not owned personally; scale belongs to the ecosystem, not one repository."
      />
      <figure class="v-lab__ecosystem-map">
        <svg viewBox="0 0 480 112" role="img" aria-labelledby="v-lab-map-title v-lab-map-description">
          <title id="v-lab-map-title">Selected V ecosystem projects</title>
          <desc id="v-lab-map-description">
            Three separate project areas: VSL for scientific computing, VTL for tensors and autograd, and RxV for
            reactive streams. The lines group projects in one ecosystem and do not indicate dependencies.
          </desc>
          <path d="M58 35H422" fill="none" stroke="var(--v-map-line, #40506d)" stroke-width="1"></path>
          <g class="v-lab__map-station v-lab__map-station--science" data-v-map-station="vsl" aria-hidden="true">
            <circle cx="80" cy="35" r="7"></circle>
            <path d="M80 44V62"></path>
          </g>
          <g class="v-lab__map-station v-lab__map-station--tensor" data-v-map-station="vtl" aria-hidden="true">
            <circle cx="240" cy="35" r="7"></circle>
            <path d="M240 44V62"></path>
          </g>
          <g class="v-lab__map-station v-lab__map-station--reactive" data-v-map-station="rxv" aria-hidden="true">
            <circle cx="400" cy="35" r="7"></circle>
            <path d="M400 44V62"></path>
          </g>
        </svg>
        <figcaption>
          <span>
            <strong>VSL</strong>
            <small>Scientific computing</small>
          </span>
          <span>
            <strong>VTL</strong>
            <small>Tensors · autograd</small>
          </span>
          <span>
            <strong>RxV</strong>
            <small>Reactive channels</small>
          </span>
        </figcaption>
      </figure>
    </div>
  </header>

  <nav class="v-lab__index" aria-label="Lab stations">
    <ol class="v-lab__index-list">
      {stations.map((station) => (
        <li>
          <a class="v-lab__index-link" href={`#${station.id}`}>
            <strong>{station.title}</strong>
            <span class="v-lab__index-role">{station.role}</span>
          </a>
        </li>
      ))}
    </ol>
  </nav>

  <div class="v-lab__stations" data-v-station-selector hidden>
    {stations.map((station) => (
      <button type="button" class="vf-node" id={`v-station-${station.id}`} data-v-station={station.id}>
        {station.label}
      </button>
    ))}
  </div>

  <div class="vf-scene v-lab__scene">
    <div class="vf-stage v-lab__stage">
      {stations.map((station) => (
        <section class="v-lab__panel" id={station.id} aria-labelledby={station.headingId} data-v-panel={station.id}>
          {station.id === 'v' ? <VLanguageScene /> : null}
          {station.id === 'vsl' ? <VSLScene /> : null}
          {station.id === 'vtl' ? <VTLAutoGradScene /> : null}
          {station.id === 'rxv' ? <RxVStreamScene /> : null}
          {station.id === 'setup-v' ? <SetupVScene /> : null}
          {station.id === 'awesome-v' ? <AwesomeVScene chips={station.chips} /> : null}
          <div class="v-lab__station-summary" data-v-station-summary>
            <p>{station.body}</p>
            <p class="v-lab__station-role">{station.role}</p>
            <p class="v-lab__station-source">
              <code>{station.repo}</code> · {station.license}
            </p>
            <ul class="v-lab__chips" aria-label={`${station.title} highlights`}>
              {station.chips.map((chip) => (
                <li>
                  <code>{chip}</code>
                </li>
              ))}
            </ul>
            <a
              class="v-lab__repo-link"
              data-v-station-repo
              href={station.href}
              target="_blank"
              rel="noopener noreferrer"
            >
              Open {station.repo} ↗
            </a>
            <div class="v-lab__contribution-links" role="group" aria-label={`${station.title} contribution paths`}>
              <a href={station.contributingHref} target="_blank" rel="noopener noreferrer">
                Contribution guide ↗
              </a>
              <a href={station.issuesHref} target="_blank" rel="noopener noreferrer">
                Open issues ↗
              </a>
            </div>
          </div>
        </section>
      ))}
    </div>

    <SceneInspector eyebrow="Station" title={defaultStation.title} id="v-lab-inspector">
      <p data-v-inspector-body>{defaultStation.body}</p>
      <Fragment slot="meta">
        <div data-v-inspector-meta>
          <span data-v-inspector-role>{defaultStation.role}</span>
          <span>
            <code data-v-inspector-repo>{defaultStation.repo}</code>·{' '}
            <span data-v-inspector-license>{defaultStation.license}</span>
          </span>
          <ul class="v-lab__chips" data-v-inspector-chips aria-label="Highlights">
            {defaultStation.chips.map((chip) => (
              <li>
                <code>{chip}</code>
              </li>
            ))}
          </ul>
          <a
            class="v-lab__repo-link"
            data-v-inspector-link
            href={defaultStation.href}
            target="_blank"
            rel="noopener noreferrer"
          >
            Open {defaultStation.repo} ↗
          </a>
          <div class="v-lab__contribution-links" role="group" aria-label="Contribution paths">
            <a
              data-v-inspector-contributing
              href={defaultStation.contributingHref}
              target="_blank"
              rel="noopener noreferrer"
            >
              Contribution guide ↗
            </a>
            <a data-v-inspector-issues href={defaultStation.issuesHref} target="_blank" rel="noopener noreferrer">
              Open issues ↗
            </a>
          </div>
        </div>
      </Fragment>
    </SceneInspector>
  </div>

  <p class="visually-hidden" role="status" aria-atomic="true" data-v-station-status></p>

  <WorldDock label="Install & explore">
    <a class="vf-dock__primary" href="https://github.com/vlang/v" target="_blank" rel="noopener noreferrer">
      vlang/v
    </a>
    <a href="https://github.com/vlang/vsl" target="_blank" rel="noopener noreferrer">
      VSL
    </a>
    <a href="https://github.com/vlang/vtl" target="_blank" rel="noopener noreferrer">
      VTL
    </a>
    <a href="https://github.com/ulises-jeremias/rxv" target="_blank" rel="noopener noreferrer">
      RxV
    </a>
    <a href="/community">Community</a>
    <code class="vf-dock__code">v install vsl · v install vtl · uses: {SETUP_V_PIN}</code>
  </WorldDock>

  <section class="v-lab__licenses">
    <h2>Licenses</h2>
    <ul>
      {licenseEntries.map((entry) => (
        <li>
          <strong>{entry.component}</strong> · {entry.license}
          {entry.notes ? ` — ${entry.notes}` : ''}
        </li>
      ))}
    </ul>
  </section>
</section>

<style>
  .v-lab {
    width: min(100% - 2 * var(--section-padding-x, 1.5rem), 78rem);
    margin: 0 auto;
    padding-block: clamp(1.25rem, 3vw, 2.5rem) clamp(2rem, 5vw, 3.5rem);
    padding-inline: clamp(0.75rem, 2vw, 1.5rem);
    border-inline: 1px solid color-mix(in srgb, var(--nest-blue) 20%, transparent);
    background:
      linear-gradient(90deg, color-mix(in srgb, var(--nest-blue) 5%, transparent), transparent 24%),
      repeating-linear-gradient(
        165deg,
        transparent 0,
        transparent 5rem,
        color-mix(in srgb, var(--nest-blue) 4%, transparent) 5rem,
        color-mix(in srgb, var(--nest-blue) 4%, transparent) calc(5rem + 1px)
      );
  }

  .v-lab__header {
    display: grid;
    gap: 1.25rem;
    padding: clamp(1.5rem, 4vw, 3.5rem) clamp(0.75rem, 3vw, 2rem);
    border-block: 1px solid color-mix(in srgb, var(--nest-blue) 34%, transparent);
    border-inline-start: 2px solid var(--nest-blue);
    background: linear-gradient(90deg, color-mix(in srgb, var(--nest-blue) 8%, transparent), transparent 70%);
  }

  @media (min-width: 820px) {
    .v-lab__header {
      grid-template-columns: minmax(0, 1.05fr) minmax(21rem, 0.95fr);
      grid-template-areas:
        'copy instrument'
        'evidence instrument';
      align-items: start;
      column-gap: clamp(1rem, 3vw, 2.5rem);
    }

    .v-lab__header-copy {
      grid-area: copy;
    }

    .v-lab__architecture {
      grid-area: instrument;
    }

    .v-lab__header-evidence {
      grid-area: evidence;
    }
  }

  .v-lab__header-evidence {
    display: grid;
    align-content: start;
    gap: 0.85rem;
  }

  .v-lab__architecture {
    min-inline-size: 0;
    padding: clamp(1rem, 2vw, 1.4rem);
    border: 1px solid color-mix(in srgb, var(--nest-cyan) 40%, transparent);
    border-inline-start: 2px solid var(--nest-cyan);
    background: color-mix(in srgb, var(--nest-midnight-950) 82%, transparent);
  }

  .v-lab__architecture-kicker,
  .v-lab__node-index {
    margin: 0;
    color: var(--nest-cyan);
    font-family: var(--font-mono);
    font-size: 0.68rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }

  .v-lab__architecture h2 {
    margin: 0.7rem 0 0;
    font-size: clamp(1.1rem, 1.8vw, 1.4rem);
  }

  .v-lab__architecture-lede {
    margin: 0.45rem 0 1.15rem;
    color: var(--color-text-muted);
    font-size: 0.88rem;
    line-height: 1.5;
  }

  .v-lab__trace-button {
    min-block-size: 2.75rem;
    padding: 0.4rem 0.65rem;
    border: 1px solid color-mix(in srgb, var(--nest-cyan) 56%, transparent);
    color: var(--nest-paper);
    background: color-mix(in srgb, var(--nest-cyan) 9%, var(--nest-midnight-950));
    font-family: var(--font-mono);
    font-size: 0.68rem;
    cursor: pointer;
    clip-path: var(--clip-corner-sm);
  }

  .v-lab__trace-button:focus-visible {
    outline: 2px solid var(--nest-paper);
  }

  .v-lab__trace-button[hidden] {
    display: none;
  }

  .v-lab__topology {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto minmax(0, 1fr) auto minmax(0, 1fr);
    align-items: center;
    gap: 0.35rem;
    padding: 0.75rem 0;
    border-block: 1px solid color-mix(in srgb, var(--nest-cyan) 22%, transparent);
  }

  .v-lab__topology-node {
    display: grid;
    min-inline-size: 0;
    min-block-size: 6rem;
    align-content: center;
    gap: 0.28rem;
    padding: 0.55rem;
    border: 1px solid color-mix(in srgb, var(--nest-blue) 40%, transparent);
  }

  .v-lab__topology-node strong {
    color: var(--nest-paper);
    font-family: var(--font-display, var(--font-mono));
    font-size: clamp(0.95rem, 1.7vw, 1.2rem);
    letter-spacing: 0.04em;
  }

  .v-lab__topology-node small {
    color: var(--color-text-muted);
    font-size: 0.68rem;
  }

  .v-lab__node-index {
    font-size: 0.56rem;
  }

  .v-lab__topology-edge {
    display: grid;
    justify-items: center;
    gap: 0.45rem;
    color: var(--nest-sunset-orange);
    font-family: var(--font-mono);
    font-size: 0.55rem;
  }

  .v-lab__topology-edge i {
    display: block;
    inline-size: 1.6rem;
    block-size: 1px;
    background: var(--nest-sunset-orange);
  }

  .v-lab__topology-edge i::after {
    float: right;
    inline-size: 0.32rem;
    block-size: 0.32rem;
    margin-block-start: -0.13rem;
    border-block-start: 1px solid var(--nest-sunset-orange);
    border-inline-end: 1px solid var(--nest-sunset-orange);
    content: '';
    transform: rotate(45deg);
  }

  .v-lab__topology[data-tracing='true'] .v-lab__topology-node {
    animation: v-topology-arrive 420ms cubic-bezier(0.2, 0.8, 0.2, 1) calc(var(--trace-order) * 380ms) both;
  }

  .v-lab__topology[data-tracing='true'] .v-lab__topology-edge i {
    animation: v-topology-flow 380ms ease-out calc(180ms + var(--trace-order) * 380ms) both;
  }

  @keyframes v-topology-arrive {
    0% {
      border-color: color-mix(in srgb, var(--nest-cyan) 25%, transparent);
      transform: translateY(0.2rem);
    }

    65% {
      transform: translateY(-0.2rem);
    }

    100% {
      border-color: color-mix(in srgb, var(--nest-cyan) 72%, transparent);
      transform: translateY(0);
    }
  }

  @keyframes v-topology-flow {
    from {
      scale: 0 1;
    }

    to {
      scale: 1 1;
    }
  }

  .v-lab__architecture-note {
    margin: 0.7rem 0 0;
    color: var(--color-text-faint);
    font-family: var(--font-mono);
    font-size: 0.65rem;
  }

  .v-lab__sideband {
    margin-block-start: 0.8rem;
    padding-block-start: 0.7rem;
    border-block-start: 1px solid color-mix(in srgb, var(--nest-violet) 32%, transparent);
  }

  .v-lab__sideband > p {
    margin: 0 0 0.5rem;
    color: var(--nest-paper);
    font-family: var(--font-mono);
    font-size: 0.63rem;
  }

  .v-lab__sideband > p span {
    color: var(--color-text-faint);
  }

  .v-lab__sideband-list {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 0.4rem;
  }

  .v-lab__sideband-list a {
    display: grid;
    align-content: center;
    gap: 0.15rem;
    min-inline-size: 0;
    min-block-size: 2.75rem;
    padding: 0.35rem 0.5rem;
    border: 1px solid color-mix(in srgb, var(--nest-violet) 40%, transparent);
    color: var(--nest-paper);
  }

  .v-lab__sideband-list a:is(:hover, :focus-visible),
  .v-lab__sideband-list a[aria-current='location'] {
    border-color: var(--nest-violet);
  }

  .v-lab__sideband-list a:focus-visible {
    outline: 2px solid var(--nest-paper);
    outline-offset: 3px;
  }

  .v-lab__sideband-list strong {
    font-family: var(--font-mono);
    font-size: 0.69rem;
    font-weight: 500;
  }

  .v-lab__sideband-list small {
    color: var(--color-text-muted);
    font-size: 0.6rem;
  }

  @media (max-width: 560px) {
    .v-lab__topology {
      grid-template-columns: minmax(0, 1fr);
      gap: 0.35rem;
    }

    .v-lab__topology-node {
      min-block-size: 4.5rem;
      grid-template-columns: 5.2rem minmax(0, 1fr);
      column-gap: 0.55rem;
    }

    .v-lab__node-index {
      grid-row: span 2;
      align-self: center;
    }

    .v-lab__topology-node strong,
    .v-lab__topology-node small {
      grid-column: 2;
    }

    .v-lab__topology-edge {
      grid-template-columns: 1fr;
      gap: 0.2rem;
      justify-items: center;
      padding-block: 0.1rem;
    }

    .v-lab__topology-edge i {
      inline-size: 1px;
      block-size: 0.75rem;
    }

    .v-lab__topology-edge i::after {
      float: none;
      display: block;
      inline-size: 0.32rem;
      block-size: 0.32rem;
      margin: 0.55rem 0 0 -0.13rem;
      transform: rotate(135deg);
    }

    .v-lab__sideband-list {
      grid-template-columns: minmax(0, 1fr);
    }

    .v-lab__sideband-list a {
      grid-template-columns: minmax(5rem, auto) minmax(0, 1fr);
      align-items: center;
      gap: 0.65rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .v-lab__topology[data-tracing='true'] .v-lab__topology-node,
    .v-lab__topology[data-tracing='true'] .v-lab__topology-edge i {
      animation: none;
    }
  }

  .v-lab__eyebrow {
    margin: 0 0 0.35rem;
    font-family: var(--font-mono);
    font-size: 0.68rem;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--world-accent-tertiary, var(--nest-sunset-orange));
  }

  .v-lab__header h1 {
    margin: 0;
    font-size: clamp(1.6rem, 3.5vw, 2.35rem);
    text-transform: uppercase;
    letter-spacing: 0.03em;
  }

  .v-lab__lede {
    margin: 0.45rem 0 0;
    color: var(--color-text-muted);
    max-inline-size: 64ch;
    line-height: 1.55;
  }

  .v-lab__ecosystem-map {
    max-inline-size: 31rem;
    margin: 0.9rem 0 0;
    padding: 0.55rem 0.7rem 0.45rem;
    border-block: 1px solid color-mix(in srgb, var(--world-accent, #5b9bd5) 28%, transparent);
    background: color-mix(in srgb, var(--nest-midnight-900, #0b1020) 62%, transparent);
  }

  .v-lab__ecosystem-map svg {
    display: block;
    inline-size: 100%;
    block-size: auto;
    overflow: visible;
  }

  .v-lab__map-station circle {
    fill: var(--nest-midnight-950, #040212);
    stroke: currentColor;
    stroke-width: 2;
    transform-box: fill-box;
    transform-origin: center;
    transition:
      fill 180ms ease,
      stroke-width 180ms ease,
      transform 180ms cubic-bezier(0.2, 0.8, 0.2, 1);
  }

  .v-lab__map-station path {
    fill: none;
    stroke: currentColor;
    stroke-width: 1;
    transition:
      opacity 180ms ease,
      stroke-width 180ms ease;
  }

  .v-lab__map-station.is-current circle {
    fill: color-mix(in srgb, currentColor 40%, var(--nest-midnight-950, #040212));
    stroke-width: 2.6;
    transform: scale(1.18);
    animation: v-lab-node-arrive 380ms cubic-bezier(0.2, 0.8, 0.2, 1) both;
  }

  .v-lab__map-station.is-current path {
    stroke-width: 1.5;
  }

  .v-lab__map-station.is-current {
    filter: drop-shadow(0 0 5px color-mix(in srgb, currentColor 68%, transparent));
  }

