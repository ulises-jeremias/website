---
/**
 * Thin identity strip — not a page essay.
 * Teaching surface lives in VComputationalLab.
 */
import { vProjects } from '../data/index.js';

const labels = vProjects.map((p) => p.shortLabel);
---

<section class="v-overview" aria-labelledby="v-overview-title">
  <header class="v-overview__header">
    <p class="v-overview__eyebrow">Digital Nest · V world</p>
    <h2 id="v-overview-title" class="v-overview__title">V Lab</h2>
    <p class="v-overview__lead">Core Team @ V — select stations on the lab surface.</p>
  </header>

  <div class="v-overview__lab" aria-label="Stations">
    {labels.map((label) => <span class="v-overview__lab-mod">{label}</span>)}
  </div>
</section>

<style>
  .v-overview {
    display: flex;
    flex-direction: column;
    gap: 0.85rem;
  }

  .v-overview__eyebrow {
    margin: 0 0 0.3rem;
    font-size: 0.76rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--world-accent-strong);
  }

  .v-overview__title {
    margin: 0 0 0.35rem;
    font-size: clamp(1.2rem, 2.8vw, 1.5rem);
    font-weight: 800;
    letter-spacing: -0.02em;
  }

  .v-overview__lead {
    margin: 0;
    font-size: 0.92rem;
    color: var(--color-text-muted);
  }

  .v-overview__lab {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
  }

  .v-overview__lab-mod {
    display: inline-grid;
    place-items: center;
    min-block-size: 2.2rem;
    padding: 0 0.65rem;
    font-family: var(--font-mono, ui-monospace, monospace);
    font-size: 0.68rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--world-accent-strong);
    border: 1px solid var(--world-border-accent);
    background: color-mix(in srgb, var(--color-surface) 80%, transparent);
    clip-path: var(--clip-corner-sm);
  }
</style>
