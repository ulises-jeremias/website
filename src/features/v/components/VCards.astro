---
/**
 * Compact repo strip — does not duplicate the lab teaching surface.
 * Prefer VComputationalLab inspector for project detail.
 */
import { vProjects } from '../data/index.js';
---

<section class="v-cards" aria-labelledby="v-cards-title">
  <header class="v-cards__header">
    <p class="v-cards__eyebrow">Repos</p>
    <h2 id="v-cards-title" class="v-cards__title">Repos</h2>
  </header>

  <ul class="v-cards__strip" role="list">
    {
      vProjects.map((p) => (
        <li role="listitem">
          <a href={p.href} target="_blank" rel="noreferrer">
            <span>{p.title}</span>
            <code>{p.repo}</code>
          </a>
        </li>
      ))
    }
  </ul>
</section>

<style>
  .v-cards__header {
    margin: 0 0 0.65rem;
  }

  .v-cards__eyebrow {
    margin: 0 0 0.25rem;
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--world-accent-strong);
  }

  .v-cards__title {
    margin: 0;
    font-size: 1rem;
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: 0.04em;
  }

  .v-cards__strip {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 0.45rem;
  }

  .v-cards__strip a {
    display: inline-flex;
    flex-direction: column;
    gap: 0.15rem;
    min-height: 44px;
    padding: 0.45rem 0.7rem;
    border: 1px solid var(--color-border);
    text-decoration: none;
    color: var(--color-text);
    clip-path: var(--clip-corner-sm);
  }

  .v-cards__strip span {
    font-size: 0.82rem;
    font-weight: 700;
  }

  .v-cards__strip code {
    font-size: 0.7rem;
    color: var(--world-accent-strong);
  }

  .v-cards__strip a:hover {
    border-color: var(--world-accent);
    background: var(--world-accent-subtle);
  }

  .v-cards__strip a:focus-visible {
    outline: 2px solid var(--color-focus, #005fcc);
    outline-offset: 2px;
  }
</style>
