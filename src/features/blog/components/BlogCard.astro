---
interface Props {
  slug: string;
  title: string;
  description: string;
  pubDate: Date;
}

const { slug, title, description, pubDate } = Astro.props as Props;

const formattedDate = pubDate.toLocaleDateString('en-US', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
});
---

<article class="blog-card">
  <a href={`/blog/${slug}/`} class="blog-card__link">
    <h2 class="blog-card__title">{title}</h2>
    <p class="blog-card__description">{description}</p>
    <time class="blog-card__date" datetime={pubDate.toISOString()}>
      {formattedDate}
    </time>
  </a>
</article>

<style>
  .blog-card {
    border-block: 1px solid color-mix(in srgb, var(--nest-violet, #a05cff) 28%, transparent);
    padding: 0;
    background: transparent;
  }

  .blog-card__link {
    display: block;
    text-decoration: none;
    color: inherit;
    min-height: 2.75rem;
    padding: 1.15rem 0.15rem;
  }

  .blog-card__link:focus-visible {
    outline: 2px solid var(--nest-cyan, #1cefff);
    outline-offset: 3px;
  }

  .blog-card__title {
    font-size: 1.15rem;
    font-weight: 600;
    margin: 0 0 0.35rem;
    color: var(--nest-paper, #f7f5ff);
  }

  .blog-card__link:hover .blog-card__title,
  .blog-card__link:focus-visible .blog-card__title {
    color: var(--nest-cyan, #1cefff);
  }

  .blog-card__description {
    color: var(--nest-text-muted, #b9b2d8);
    margin: 0 0 0.55rem;
    line-height: 1.6;
  }

  .blog-card__date {
    font-family: var(--font-mono, ui-monospace, monospace);
    font-size: 0.72rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--nest-text-muted, #b9b2d8);
  }

  @media (prefers-reduced-motion: reduce) {
    .blog-card__link {
      transition: none;
    }
  }
</style>
