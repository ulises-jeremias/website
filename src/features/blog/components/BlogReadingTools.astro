<script>
  import { enhanceCodeBlocks } from '../lib/code-copy';

  const initialize = () => {
    document.querySelectorAll('.blog-prose').forEach((content) => enhanceCodeBlocks(content));
  };

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initialize, { once: true });
  } else {
    initialize();
  }
</script>
