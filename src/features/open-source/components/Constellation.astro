---
import {
  evidenceItems,
  featuredEvidence,
  formatEvidenceDate,
  getConstellationNodes,
  getEvidenceLastUpdated,
} from '@/data/open-source/index.js';

const nodes = getConstellationNodes();
const lastUpdated = getEvidenceLastUpdated();

const kindLegend = [
  { kind: 'owned', label: 'Owned', detail: 'repositories I created and own' },
  { kind: 'maintained', label: 'Maintained', detail: 'projects I lead inside organizations I do not own (vlang)' },
  { kind: 'org', label: 'Organization', detail: 'GitHub organizations I created for project families' },
  { kind: 'external', label: 'Upstream', detail: 'merged pull requests to projects run by other people' },
] as const;

const evidenceLanes = kindLegend.map((entry) => ({
  ...entry,
  records: nodes.filter((node) => node.kind === entry.kind),
}));
---

<section class="constellation" aria-labelledby="constellation-title" data-testid="oss-constellation">
  <header class="constellation__header">
    <div>
      <p class="constellation__eyebrow">Open Source · evidence archive</p>
      <h1 id="constellation-title">Open-source evidence</h1>
      <p class="constellation__lede">
        Source-linked records distinguish repositories I own, projects I maintain for others, organizations I created,
        and merged work in upstream projects.
      </p>
      <p class="constellation__lede constellation__lede--note">
        Forks are working copies, not authorship. They appear only when merged upstream work is documented. See{' '}
        <a href="/projects">Work</a> for project descriptions.
      </p>
    </div>
    <aside class="constellation__brief" aria-label="Evidence archive readout">
      <p class="constellation__brief-kicker">Archive readout</p>
      <dl>
        <div>
          <dt>Visible records</dt>
          <dd>{evidenceItems.length}</dd>
        </div>
        <div>
          <dt>Featured subjects</dt>
          <dd>{featuredEvidence.length}</dd>
        </div>
        <div>
          <dt>Last refresh</dt>
          <dd>{formatEvidenceDate(lastUpdated)}</dd>
        </div>
      </dl>
    </aside>
  </header>

  <div class="constellation__stage">
    <div class="constellation__legend-panel">
      <p class="constellation__legend-kicker">Reading key</p>
      <p class="constellation__legend-note">
        Records are grouped by relationship. Read exact subjects, roles, and source links in the ledger below.
      </p>
      <ul class="constellation__legend" aria-label="Contribution kinds">
        {kindLegend.map((entry) => (
          <li class="constellation__legend-item">
            <span class:list={['constellation__swatch', `constellation__swatch--${entry.kind}`]} aria-hidden="true" />
            <span class="constellation__legend-label">{entry.label}</span>
            <span class="constellation__legend-detail">{entry.detail}</span>
          </li>
        ))}
      </ul>
    </div>
    <div class="constellation__map" aria-label="Contribution evidence map">
      <p class="constellation__map-label">Source-backed records · one marker per subject</p>
      <ul class="constellation__lanes">
        {evidenceLanes.map((lane) => (
          <li class:list={['constellation__lane', `constellation__lane--${lane.kind}`]}>
            <a
              class="constellation__lane-link"
              href={`#evidence-${lane.kind}`}
              aria-label={`View ${lane.records.length} ${lane.label.toLowerCase()} evidence records`}
            >
              <span class="constellation__lane-label">{lane.label}</span>
              <span class="constellation__lane-track" aria-hidden="true">
                {lane.records.map((record) => (
                  <span class="constellation__lane-marker" title={record.label} />
                ))}
              </span>
              <span class="constellation__lane-count">
                {lane.records.length} records <span aria-hidden="true">↘</span>
              </span>
            </a>
          </li>
        ))}
      </ul>
    </div>
  </div>

  <p class="constellation__meta">
    Evidence refreshed <time datetime={lastUpdated}>{formatEvidenceDate(lastUpdated)}</time> · exact records follow
    below.
  </p>
</section>

<style>
  .constellation {
    width: min(100% - 2 * var(--section-padding-x), 78rem);
    margin: 0 auto;
    padding-block: clamp(1.5rem, 4vw, 3rem) 1rem;
    padding-inline: clamp(0.75rem, 2vw, 1.5rem);
    border-inline: 1px solid color-mix(in srgb, var(--nest-sunset-orange) 18%, transparent);
    background:
      linear-gradient(90deg, color-mix(in srgb, var(--nest-sunset-orange) 5%, transparent), transparent 34%),
      color-mix(in srgb, var(--nest-midnight-950) 68%, transparent);
  }

  .constellation__header {
    display: grid;
    gap: 1.25rem;
    padding: clamp(1.25rem, 3vw, 2.5rem) clamp(0.75rem, 3vw, 2rem);
    border-block: 1px solid color-mix(in srgb, var(--nest-sunset-orange) 32%, transparent);
    border-inline-start: 2px solid var(--nest-sunset-orange);
    background: linear-gradient(90deg, color-mix(in srgb, var(--nest-sunset-orange) 7%, transparent), transparent 70%);
  }

  @media (min-width: 820px) {
    .constellation__header {
      grid-template-columns: minmax(0, 1.25fr) minmax(17rem, 0.75fr);
      align-items: end;
    }
  }

  .constellation__brief {
    padding: 0.9rem 1rem;
    border: 1px solid color-mix(in srgb, var(--nest-cyan) 38%, transparent);
    background: color-mix(in srgb, var(--nest-midnight-950) 78%, transparent);
  }

  .constellation__brief-kicker,
  .constellation__legend-kicker,
  .constellation__map-label {
    margin: 0;
    color: var(--nest-cyan);
    font-family: var(--font-mono);
    font-size: 0.68rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }

  .constellation__brief dl {
    display: grid;
    gap: 0.45rem;
    margin: 0.65rem 0 0;
  }

  .constellation__brief dl div {
    display: flex;
    justify-content: space-between;
    gap: 0.75rem;
    padding-top: 0.4rem;
    border-top: 1px solid color-mix(in srgb, var(--nest-cyan) 22%, transparent);
    font-family: var(--font-mono);
    font-size: 0.7rem;
  }

  .constellation__brief dt,
  .constellation__brief dd {
    margin: 0;
  }

  .constellation__brief dt {
    color: var(--color-text-muted);
    text-transform: uppercase;
  }

  .constellation__brief dd {
    color: var(--color-text);
    text-align: right;
  }

  @media (width < 600px) {
    .constellation__brief dl {
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: 0.5rem;
    }

    .constellation__brief dl div {
      display: grid;
      gap: 0.25rem;
    }

    .constellation__brief dt {
      font-size: 0.56rem;
      letter-spacing: 0.04em;
    }

    .constellation__brief dd {
      font-size: 0.62rem;
      text-align: start;
    }
  }

  .constellation__eyebrow {
    margin: 0 0 var(--space-2);
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--nest-sunset-orange);
  }

  .constellation h1 {
    margin: 0 0 var(--space-3);
    text-transform: uppercase;
    letter-spacing: 0.03em;
  }

  .constellation__lede {
    margin: 0 0 1rem;
    max-inline-size: 70ch;
    color: var(--color-text-muted);
  }

  .constellation__lede--note {
    margin-block-end: 1.35rem;
    color: var(--color-text-faint);
    font-size: 0.92rem;
  }

  .constellation__lede a {
    color: var(--nest-cyan);
  }

  .constellation__stage {
    display: grid;
    gap: 1.5rem;
    align-items: center;
    margin-top: 1.5rem;
  }

  @media (min-width: 860px) {
    .constellation__stage {
      grid-template-columns: minmax(18rem, 0.9fr) minmax(0, 1.1fr);
    }
  }

  .constellation__legend {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 0.75rem;
  }

  @media (width < 860px) {
    .constellation__map {
      order: -1;
    }

    .constellation__legend {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 0.85rem 1rem;
    }
  }

  .constellation__legend-panel,
  .constellation__map {
    padding: 1rem;
    border: 1px solid var(--color-border);
    background: color-mix(in srgb, var(--nest-midnight-950) 78%, transparent);
  }

  .constellation__legend-note {
    margin: 0.45rem 0 1rem;
    color: var(--color-text-muted);
    font-size: 0.85rem;
    line-height: 1.45;
  }

  .constellation__map-label {
    color: var(--color-text-faint);
  }

  .constellation__legend-item {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: 0.15rem 0.6rem;
    align-items: baseline;
  }

  .constellation__swatch {
    width: 0.7rem;
    height: 0.7rem;
    border-radius: 50%;
    border: 1px solid var(--nest-paper);
  }

  .constellation__swatch--owned {
    background: var(--nest-magenta);
  }

  .constellation__swatch--maintained {
    background: var(--nest-cyan);
  }

  .constellation__swatch--org {
    background: var(--nest-violet);
  }

  .constellation__swatch--external {
    background: var(--nest-sunset-orange);
  }

  .constellation__legend-label {
    font-family: var(--font-mono);
    font-size: 0.8rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .constellation__legend-detail {
    grid-column: 2;
    font-size: 0.88rem;
    color: var(--color-text-muted);
  }

  @media (width < 860px) {
    .constellation__legend-detail {
      font-size: 0.78rem;
      line-height: 1.35;
    }
  }

  .constellation__lanes {
    display: grid;
    gap: 0.85rem;
    margin: 1rem 0 0;
    padding: 0;
    list-style: none;
  }

  .constellation__lane {
    min-width: 0;
    border-inline-start: 2px solid var(--lane-color);
    background: color-mix(in srgb, var(--lane-color) 6%, transparent);
  }

  .constellation__lane-link {
    display: grid;
    grid-template-columns: minmax(7.5rem, 0.8fr) minmax(0, 1.4fr) auto;
    align-items: center;
    gap: 0.75rem;
    min-height: var(--touch-min, 44px);
    padding: 0.45rem 0.55rem;
    color: inherit;
    text-decoration: none;
  }

  .constellation__lane-link:hover {
    background: color-mix(in srgb, var(--lane-color) 8%, transparent);
  }

  .constellation__lane-link:focus-visible {
    outline: 2px solid var(--lane-color);
    outline-offset: 2px;
    position: relative;
    z-index: 1;
  }

  .constellation__lane--owned {
    --lane-color: var(--nest-magenta);
  }

  .constellation__lane--maintained {
    --lane-color: var(--nest-cyan);
  }

  .constellation__lane--org {
    --lane-color: var(--nest-violet);
  }

  .constellation__lane--external {
    --lane-color: var(--nest-sunset-orange);
  }

  .constellation__lane-label,
  .constellation__lane-count {
    font-family: var(--font-mono);
    font-size: 0.72rem;
  }

  .constellation__lane-count {
    color: var(--lane-color);
    text-align: end;
    white-space: nowrap;
  }

  .constellation__lane-track {
    display: flex;
    flex-wrap: wrap;
    gap: 0.32rem;
    min-height: 0.6rem;
  }

  .constellation__lane-marker {
    width: 0.5rem;
    height: 0.5rem;
    border: 1px solid color-mix(in srgb, var(--lane-color) 65%, white);
    background: var(--lane-color);
    clip-path: polygon(50% 0, 100% 50%, 50% 100%, 0 50%);
  }

  @media (width < 500px) {
    .constellation__lane-link {
      grid-template-columns: minmax(0, 1fr) auto;
      gap: 0.45rem;
    }

    .constellation__lane-track {
      grid-column: 1 / -1;
    }
  }

  .constellation__meta {
    margin: 0.85rem 0 0;
    font-family: var(--font-mono);
    font-size: 0.72rem;
    color: var(--color-text-faint);
  }
</style>
