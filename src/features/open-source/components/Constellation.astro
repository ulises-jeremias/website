---
import { formatEvidenceDate, getConstellationNodes, getEvidenceLastUpdated } from '@/data/open-source/index.js';

const nodes = getConstellationNodes();
const lastUpdated = getEvidenceLastUpdated();

/** Deterministic layout positions for the constellation (no fake metrics). */
const positions = nodes.map((node, index) => {
  const angle = (index / Math.max(nodes.length, 1)) * Math.PI * 2 - Math.PI / 2;
  const radius = node.featured ? 34 : 28;
  const cx = 50 + Math.cos(angle) * radius;
  const cy = 50 + Math.sin(angle) * (radius * 0.72);
  return { ...node, cx, cy };
});
---

<section class="constellation" aria-labelledby="constellation-title" data-testid="oss-constellation">
  <p class="constellation__eyebrow">Open Source · contribution constellation</p>
  <h1 id="constellation-title">Open Source evidence</h1>
  <p class="constellation__lede">
    Owned projects · maintained projects · organization work · external contributions. Verified subjects only.
  </p>

  <div class="constellation__stage">
    <svg class="constellation__svg" viewBox="0 0 100 100" aria-hidden="true" focusable="false">
      <circle cx="50" cy="50" r="3.2" class="constellation__hub"></circle>
      {
        positions.map((node) => (
          <g>
            <line
              x1="50"
              y1="50"
              x2={node.cx}
              y2={node.cy}
              class:list={['constellation__edge', `constellation__edge--${node.kind}`]}
            />
            <circle
              cx={node.cx}
              cy={node.cy}
              r={node.featured ? 2.4 : 1.8}
              class:list={['constellation__node', `constellation__node--${node.kind}`]}
            />
          </g>
        ))
      }
    </svg>
  </div>

  <p class="constellation__meta">
    Evidence refreshed <time datetime={lastUpdated}>{formatEvidenceDate(lastUpdated)}</time>
  </p>
</section>

<style>
  .constellation {
    width: min(100% - 2 * var(--section-padding-x), 74rem);
    margin: 0 auto;
    padding-block: clamp(1.5rem, 4vw, 3rem) 1rem;
  }

  .constellation__eyebrow {
    margin: 0 0 var(--space-2);
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--nest-sunset-orange);
  }

  .constellation h1 {
    margin: 0 0 var(--space-3);
    text-transform: uppercase;
    letter-spacing: 0.03em;
  }

  .constellation__lede {
    margin: 0 0 1.35rem;
    max-inline-size: 70ch;
    color: var(--color-text-muted);
  }

  .constellation__stage {
    display: block;
  }

  .constellation__svg {
    width: 100%;
    max-width: 28rem;
    height: auto;
    display: block;
    margin-inline: auto;
  }

  .constellation__hub {
    fill: var(--nest-cyan);
  }

  .constellation__edge {
    stroke: color-mix(in srgb, var(--nest-violet) 45%, transparent);
    stroke-width: 0.35;
  }

  .constellation__node {
    fill: var(--nest-paper);
    stroke: var(--nest-cyan);
    stroke-width: 0.35;
  }

  .constellation__meta {
    margin: 0.85rem 0 0;
    font-family: var(--font-mono);
    font-size: 0.72rem;
    color: var(--color-text-faint);
  }
</style>
