---
import {
  evidenceItems,
  featuredEvidence,
  formatEvidenceDate,
  getConstellationNodes,
  getEvidenceLastUpdated,
} from '@/data/open-source/index.js';

const nodes = getConstellationNodes();
const lastUpdated = getEvidenceLastUpdated();

const kindLegend = [
  { kind: 'owned', label: 'Owned', detail: 'repositories I created and own' },
  { kind: 'maintained', label: 'Maintained', detail: 'projects I maintain for their communities' },
  { kind: 'org', label: 'Organization', detail: 'work inside organizations I belong to' },
  { kind: 'external', label: 'External', detail: 'merged contributions to projects I do not run' },
] as const;

const kindCounts = Object.fromEntries(
  kindLegend.map((entry) => [entry.kind, nodes.filter((node) => node.kind === entry.kind).length]),
);

/** Deterministic layout positions for the constellation (no fake metrics). */
const positions = nodes.map((node, index) => {
  const angle = (index / Math.max(nodes.length, 1)) * Math.PI * 2 - Math.PI / 2;
  const radius = node.featured ? 34 : 28;
  const cx = 50 + Math.cos(angle) * radius;
  const cy = 50 + Math.sin(angle) * (radius * 0.72);
  return { ...node, cx, cy };
});
---

<section class="constellation" aria-labelledby="constellation-title" data-testid="oss-constellation">
  <header class="constellation__header">
    <div>
      <p class="constellation__eyebrow">Open Source · evidence archive</p>
      <h1 id="constellation-title">Evidence archive</h1>
      <p class="constellation__lede">
        Owned projects · maintained projects · organization work · external contributions. Verified subjects only, with
        exact provenance in the ledger below.
      </p>
    </div>
    <aside class="constellation__brief" aria-label="Evidence archive readout">
      <p class="constellation__brief-kicker">Archive readout</p>
      <dl>
        <div><dt>Visible records</dt><dd>{evidenceItems.length}</dd></div>
        <div><dt>Featured subjects</dt><dd>{featuredEvidence.length}</dd></div>
        <div><dt>Last refresh</dt><dd>{formatEvidenceDate(lastUpdated)}</dd></div>
      </dl>
    </aside>
  </header>

  <div class="constellation__stage">
    <div class="constellation__legend-panel">
      <p class="constellation__legend-kicker">Reading key</p>
      <p class="constellation__legend-note">
        The map is a relationship index. Read exact subjects, roles, and source links below.
      </p>
      <ul class="constellation__legend" aria-label="Contribution kinds">
        {
          kindLegend.map((entry) => (
            <li class="constellation__legend-item">
              <span class:list={['constellation__swatch', `constellation__swatch--${entry.kind}`]} aria-hidden="true" />
              <span class="constellation__legend-label">
                {entry.label} ({kindCounts[entry.kind]})
              </span>
              <span class="constellation__legend-detail">{entry.detail}</span>
            </li>
          ))
        }
      </ul>
    </div>
    <div class="constellation__map" aria-label="Contribution evidence map">
      <p class="constellation__map-label">Relationship index · not a popularity graph</p>
      <svg class="constellation__svg" viewBox="0 0 100 100" aria-hidden="true" focusable="false">
        <circle cx="50" cy="50" r="3.2" class="constellation__hub"></circle>
        {
          positions.map((node) => (
            <g>
              <line
                x1="50"
                y1="50"
                x2={node.cx}
                y2={node.cy}
                class:list={['constellation__edge', `constellation__edge--${node.kind}`]}
              />
              <circle
                cx={node.cx}
                cy={node.cy}
                r={node.featured ? 2.4 : 1.8}
                class:list={['constellation__node', `constellation__node--${node.kind}`]}
              />
            </g>
          ))
        }
      </svg>
    </div>
  </div>

  <p class="constellation__meta">
    Evidence refreshed <time datetime={lastUpdated}>{formatEvidenceDate(lastUpdated)}</time> · exact records follow below.
  </p>
</section>

<style>
  .constellation {
    width: min(100% - 2 * var(--section-padding-x), 78rem);
    margin: 0 auto;
    padding-block: clamp(1.5rem, 4vw, 3rem) 1rem;
    padding-inline: clamp(0.75rem, 2vw, 1.5rem);
    border-inline: 1px solid color-mix(in srgb, var(--nest-sunset-orange) 18%, transparent);
    background:
      linear-gradient(90deg, color-mix(in srgb, var(--nest-sunset-orange) 5%, transparent), transparent 34%),
      color-mix(in srgb, var(--nest-midnight-950) 68%, transparent);
  }

  .constellation__header {
    display: grid;
    gap: 1.25rem;
    padding: clamp(1.25rem, 3vw, 2.5rem) clamp(0.75rem, 3vw, 2rem);
    border-block: 1px solid color-mix(in srgb, var(--nest-sunset-orange) 32%, transparent);
    border-inline-start: 2px solid var(--nest-sunset-orange);
    background: linear-gradient(90deg, color-mix(in srgb, var(--nest-sunset-orange) 7%, transparent), transparent 70%);
  }

  @media (min-width: 820px) {
    .constellation__header {
      grid-template-columns: minmax(0, 1.25fr) minmax(17rem, 0.75fr);
      align-items: end;
    }
  }

  .constellation__brief {
    padding: 0.9rem 1rem;
    border: 1px solid color-mix(in srgb, var(--nest-cyan) 38%, transparent);
    background: color-mix(in srgb, var(--nest-midnight-950) 78%, transparent);
  }

  .constellation__brief-kicker,
  .constellation__legend-kicker,
  .constellation__map-label {
    margin: 0;
    color: var(--nest-cyan);
    font-family: var(--font-mono);
    font-size: 0.68rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }

  .constellation__brief dl {
    display: grid;
    gap: 0.45rem;
    margin: 0.65rem 0 0;
  }

  .constellation__brief dl div {
    display: flex;
    justify-content: space-between;
    gap: 0.75rem;
    padding-top: 0.4rem;
    border-top: 1px solid color-mix(in srgb, var(--nest-cyan) 22%, transparent);
    font-family: var(--font-mono);
    font-size: 0.7rem;
  }

  .constellation__brief dt,
  .constellation__brief dd {
    margin: 0;
  }

  .constellation__brief dt {
    color: var(--color-text-muted);
    text-transform: uppercase;
  }

  .constellation__brief dd {
    color: var(--color-text);
    text-align: right;
  }

  .constellation__eyebrow {
    margin: 0 0 var(--space-2);
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--nest-sunset-orange);
  }

  .constellation h1 {
    margin: 0 0 var(--space-3);
    text-transform: uppercase;
    letter-spacing: 0.03em;
  }

  .constellation__lede {
    margin: 0 0 1.35rem;
    max-inline-size: 70ch;
    color: var(--color-text-muted);
  }

  .constellation__stage {
    display: grid;
    gap: 1.5rem;
    align-items: center;
    margin-top: 1.5rem;
  }

  @media (min-width: 860px) {
    .constellation__stage {
      grid-template-columns: minmax(18rem, 0.9fr) minmax(0, 1.1fr);
    }
  }

  .constellation__legend {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 0.75rem;
  }

  .constellation__legend-panel,
  .constellation__map {
    padding: 1rem;
    border: 1px solid var(--color-border);
    background: color-mix(in srgb, var(--nest-midnight-950) 78%, transparent);
  }

  .constellation__legend-note {
    margin: 0.45rem 0 1rem;
    color: var(--color-text-muted);
    font-size: 0.85rem;
    line-height: 1.45;
  }

  .constellation__map-label {
    color: var(--color-text-faint);
  }

  .constellation__legend-item {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: 0.15rem 0.6rem;
    align-items: baseline;
  }

  .constellation__swatch {
    width: 0.7rem;
    height: 0.7rem;
    border-radius: 50%;
    border: 1px solid var(--nest-paper);
  }

  .constellation__swatch--owned {
    background: var(--nest-magenta);
  }

  .constellation__swatch--maintained {
    background: var(--nest-cyan);
  }

  .constellation__swatch--org {
    background: var(--nest-violet);
  }

  .constellation__swatch--external {
    background: var(--nest-sunset-orange);
  }

  .constellation__legend-label {
    font-family: var(--font-mono);
    font-size: 0.8rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .constellation__legend-detail {
    grid-column: 2;
    font-size: 0.88rem;
    color: var(--color-text-muted);
  }

  .constellation__svg {
    width: 100%;
    max-width: 28rem;
    height: auto;
    display: block;
    margin: 0.75rem auto 0;
  }

  .constellation__hub {
    fill: var(--nest-cyan);
  }

  .constellation__edge {
    stroke: color-mix(in srgb, var(--nest-violet) 45%, transparent);
    stroke-width: 0.35;
  }

  .constellation__node {
    fill: var(--nest-paper);
    stroke: var(--nest-cyan);
    stroke-width: 0.35;
  }

  .constellation__node--owned {
    fill: var(--nest-magenta);
    stroke: var(--nest-pink);
  }

  .constellation__node--maintained {
    fill: var(--nest-cyan);
    stroke: var(--nest-blue);
  }

  .constellation__node--org {
    fill: var(--nest-violet);
    stroke: var(--nest-purple);
  }

  .constellation__node--external {
    fill: var(--nest-sunset-orange);
    stroke: var(--nest-sunset-pink);
  }

  .constellation__meta {
    margin: 0.85rem 0 0;
    font-family: var(--font-mono);
    font-size: 0.72rem;
    color: var(--color-text-faint);
  }
</style>
