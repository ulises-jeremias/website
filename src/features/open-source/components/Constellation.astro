---
import { getConstellationNodes, getEvidenceLastUpdated } from '@/data/open-source/index.js';

const nodes = getConstellationNodes();
const lastUpdated = getEvidenceLastUpdated();

/** Deterministic layout positions for the constellation (no fake metrics). */
const positions = nodes.map((node, index) => {
  const angle = (index / Math.max(nodes.length, 1)) * Math.PI * 2 - Math.PI / 2;
  const radius = node.featured ? 34 : 28;
  const cx = 50 + Math.cos(angle) * radius;
  const cy = 50 + Math.sin(angle) * (radius * 0.72);
  return { ...node, cx, cy, index };
});
---

<section class="constellation" aria-labelledby="constellation-title" data-testid="oss-constellation">
  <p class="constellation__eyebrow">Open Source · contribution constellation</p>
  <h1 id="constellation-title">Evidence first</h1>
  <p class="constellation__lede">Owned · maintained · org · external — verified subjects only.</p>

  <div class="constellation__stage" role="img" aria-label="Contribution constellation of verified subjects">
    <svg class="constellation__svg" viewBox="0 0 100 100" aria-hidden="true" focusable="false">
      <circle cx="50" cy="50" r="3.2" class="constellation__hub"></circle>
      {
        positions.map((node) => (
          <g>
            <line
              x1="50"
              y1="50"
              x2={node.cx}
              y2={node.cy}
              class:list={['constellation__edge', `constellation__edge--${node.kind}`]}
            />
            <circle
              cx={node.cx}
              cy={node.cy}
              r={node.featured ? 2.4 : 1.8}
              class:list={['constellation__node', `constellation__node--${node.kind}`]}
            />
          </g>
        ))
      }
    </svg>

    <details class="constellation__legend-wrap">
      <summary>Subjects</summary>
      <ul class="constellation__legend" role="list">
        {
          positions.map((node) => (
            <li>
              <a href={node.href} target="_blank" rel="noreferrer" data-kind={node.kind}>
                <span class="constellation__kind">{node.kind}</span>
                <span class="constellation__label">{node.label}</span>
              </a>
            </li>
          ))
        }
      </ul>
    </details>
  </div>

  <p class="constellation__meta">
    verified <time datetime={lastUpdated}>{lastUpdated}</time>
  </p>
</section>

<style>
  .constellation {
    width: min(100% - 2 * var(--section-padding-x), 74rem);
    margin: 0 auto;
    padding-block: clamp(1.5rem, 4vw, 3rem) 1rem;
  }

  .constellation__eyebrow {
    margin: 0 0 var(--space-2);
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--nest-sunset-orange);
  }

  .constellation h1 {
    margin: 0 0 var(--space-3);
    text-transform: uppercase;
    letter-spacing: 0.03em;
  }

  .constellation__lede {
    margin: 0 0 1.35rem;
    max-inline-size: 70ch;
    color: var(--color-text-muted);
  }

  .constellation__stage {
    display: grid;
    gap: 1.25rem;
    border: 1px solid var(--color-border);
    background:
      radial-gradient(circle at 50% 45%, color-mix(in srgb, var(--nest-violet) 16%, transparent), transparent 55%),
      color-mix(in srgb, var(--nest-midnight-900) 92%, transparent);
    clip-path: var(--clip-corner-md);
    padding: 1rem;
  }

  @media (width >= 860px) {
    .constellation__stage {
      grid-template-columns: minmax(0, 1.1fr) minmax(14rem, 0.9fr);
      align-items: center;
    }
  }

  .constellation__svg {
    width: min(100%, 28rem);
    margin-inline: auto;
    aspect-ratio: 1;
  }

  .constellation__hub {
    fill: var(--nest-magenta);
  }

  .constellation__edge {
    stroke: color-mix(in srgb, var(--nest-violet) 45%, transparent);
    stroke-width: 0.35;
    stroke-dasharray: 1.1 1.2;
  }

  .constellation__node--owned {
    fill: var(--nest-cyan);
  }
  .constellation__node--maintained {
    fill: var(--nest-pink);
  }
  .constellation__node--org {
    fill: var(--nest-sunset-orange);
  }
  .constellation__node--external {
    fill: var(--nest-blue);
  }

  .constellation__legend {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 0.45rem;
  }

  .constellation__legend a {
    display: grid;
    grid-template-columns: 6.5rem minmax(0, 1fr);
    gap: 0.55rem;
    padding: 0.45rem 0.55rem;
    color: inherit;
    text-decoration: none;
    border: 1px solid transparent;
  }

  .constellation__legend a:hover,
  .constellation__legend a:focus-visible {
    border-color: color-mix(in srgb, var(--nest-cyan) 45%, transparent);
    background: color-mix(in srgb, var(--nest-cyan) 8%, transparent);
    outline: none;
  }

  .constellation__kind {
    font-family: var(--font-mono);
    font-size: 0.68rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--nest-cyan);
  }

  .constellation__label {
    font-size: 0.9rem;
  }

  .constellation__meta {
    margin: 0.85rem 0 0;
    font-size: 0.8rem;
    color: var(--color-text-faint);
  }
</style>
