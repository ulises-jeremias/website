---
import {
  evidenceItems,
  getEvidenceKindLabel,
  getEvidenceNotes,
  getEvidenceProvenanceLabel,
} from '@/data/open-source/index.js';

const notes = getEvidenceNotes().filter((n) => !n.startsWith('[refresh'));
---

<section class="oss-ledger" aria-labelledby="oss-ledger-title" data-testid="oss-ledger">
  <h2 id="oss-ledger-title">Evidence ledger</h2>
  <p class="oss-ledger__lede">Roles and merged work from the evidence cache.</p>

  <ul class="oss-ledger__table" aria-label="Contribution evidence">
    <li class="oss-ledger__row oss-ledger__row--head" aria-hidden="true">
      <span>Kind</span>
      <span>Subject</span>
      <span>Evidence</span>
      <span>Link</span>
    </li>
    {
      evidenceItems.map((row) => (
        <li class="oss-ledger__row">
          <span class="oss-ledger__kind">{getEvidenceKindLabel(row.kind)}</span>
          <span>{row.subject}</span>
          <span class="oss-ledger__evidence">{row.summary ?? row.evidence}</span>
          <a href={row.href} target="_blank" rel="noopener noreferrer" data-testid="oss-row">
            {getEvidenceProvenanceLabel(row.provenance)} ↗
          </a>
        </li>
      ))
    }
  </ul>

  {
    notes.length > 0 && (
      <div class="oss-ledger__notes">
        <p class="oss-ledger__notes-label">Notes</p>
        <ul>
          {notes.map((note) => (
            <li>{note}</li>
          ))}
        </ul>
      </div>
    )
  }
</section>

<style>
  .oss-ledger {
    width: min(100% - 2 * var(--section-padding-x), 74rem);
    margin: 0 auto;
    padding-block: 1rem 2.75rem;
  }

  .oss-ledger h2 {
    margin: 0 0 0.65rem;
    font-size: 1.05rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--nest-cyan);
  }

  .oss-ledger__lede {
    margin: 0 0 1rem;
    max-inline-size: 70ch;
    color: var(--color-text-muted);
  }

  .oss-ledger__table {
    display: grid;
    margin: 0;
    padding: 0;
    list-style: none;
    border: 1px solid var(--color-border);
    clip-path: var(--clip-corner-md);
  }

  .oss-ledger__row {
    display: grid;
    grid-template-columns: 7rem minmax(0, 1.1fr) minmax(0, 1.5fr) minmax(0, 1fr);
    gap: 0.75rem;
    padding: 0.8rem 1rem;
    border-block-end: 1px solid var(--color-border);
    color: inherit;
  }

  .oss-ledger__row a {
    color: var(--nest-cyan);
    text-decoration: none;
    font-family: var(--font-mono);
    font-size: 0.72rem;
  }

  .oss-ledger__row a:focus-visible {
    outline: 2px solid var(--nest-cyan);
    outline-offset: 2px;
  }

  .oss-ledger__evidence {
    color: var(--color-text-muted);
    font-size: 0.85rem;
  }

  .oss-ledger__row:last-child {
    border-block-end: 0;
  }

  .oss-ledger__row--head {
    font-family: var(--font-mono);
    font-size: 0.68rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--color-text-faint);
    background: color-mix(in srgb, var(--nest-violet) 8%, transparent);
  }

  .oss-ledger__row:not(.oss-ledger__row--head):hover {
    background: color-mix(in srgb, var(--nest-cyan) 8%, transparent);
  }

  .oss-ledger__kind {
    font-family: var(--font-mono);
    font-size: 0.72rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--nest-cyan);
  }

  .oss-ledger__prov {
    font-family: var(--font-mono);
    font-size: 0.68rem;
    letter-spacing: 0.04em;
    color: var(--color-text-faint);
    word-break: break-word;
  }

  .oss-ledger__notes {
    margin: 1rem 0 0;
    padding-inline-start: 1.1rem;
    color: var(--color-text-faint);
    font-size: 0.82rem;
  }

  .oss-ledger__foot {
    margin: 1rem 0 0;
    color: var(--color-text-faint);
    font-size: 0.82rem;
  }

  @media (width < 820px) {
    .oss-ledger__row--head {
      display: none;
    }

    .oss-ledger__row {
      grid-template-columns: 1fr;
    }
  }
</style>
