---
import {
  evidenceItems,
  getEvidenceKindLabel,
  getEvidenceNotes,
  getEvidenceProvenanceLabel,
} from '@/data/open-source/index.js';

const notes = getEvidenceNotes().filter((n) => !n.startsWith('[refresh'));
const evidenceGroups = (['owned', 'maintained', 'org', 'external'] as const).map((kind) => ({
  kind,
  label: getEvidenceKindLabel(kind),
  records: evidenceItems.filter((item) => item.kind === kind),
}));
---

<section class="oss-ledger" data-reveal aria-labelledby="oss-ledger-title" data-testid="oss-ledger">
  <header class="oss-ledger__header">
    <div>
      <p class="oss-ledger__kicker">Primary record</p>
      <h2 id="oss-ledger-title">Evidence ledger</h2>
      <p class="oss-ledger__lede">
        Roles and merged work from the evidence cache, with a provenance link on every row.
      </p>
    </div>
    <p class="oss-ledger__reading-key">Kind → subject → evidence → source</p>
  </header>

  <div class="oss-ledger__groups">
    {evidenceGroups.map((group) => (
      <section
        class:list={['oss-ledger__group', `oss-ledger__group--${group.kind}`]}
        id={`evidence-${group.kind}`}
        aria-labelledby={`evidence-${group.kind}-title`}
        tabindex="-1"
      >
        <header class="oss-ledger__group-head">
          <h3 id={`evidence-${group.kind}-title`}>{group.label}</h3>
          <span>
            {group.records.length} {group.records.length === 1 ? 'record' : 'records'}
          </span>
        </header>
        <ul class="oss-ledger__table" aria-label={`${group.label} contribution evidence`}>
          <li class="oss-ledger__row oss-ledger__row--head" aria-hidden="true">
            <span>Subject</span>
            <span>Evidence</span>
            <span>Source</span>
          </li>
          {group.records.map((row) => (
            <li class="oss-ledger__row" data-evidence-trace-row>
              <span class="oss-ledger__subject">{row.subject}</span>
              <span class="oss-ledger__evidence">{row.summary ?? row.evidence}</span>
              <a href={row.href} target="_blank" rel="noopener noreferrer" data-testid="oss-row">
                {getEvidenceProvenanceLabel(row.provenance)} ↗
              </a>
            </li>
          ))}
        </ul>
      </section>
    ))}
  </div>

  {notes.length > 0 && (
    <div class="oss-ledger__notes">
      <h3 class="oss-ledger__notes-label">Notes</h3>
      <ul>
        {notes.map((note) => (
          <li>{note}</li>
        ))}
      </ul>
    </div>
  )}
</section>

<style>
  .oss-ledger {
    width: min(100% - 2 * var(--section-padding-x), 78rem);
    margin: 0 auto;
    padding-block: 1rem 2.75rem;
    padding-inline: clamp(0.75rem, 2vw, 1.5rem);
    border-inline: 1px solid color-mix(in srgb, var(--nest-cyan) 18%, transparent);
  }

  .oss-ledger__header {
    display: grid;
    gap: 1rem;
    align-items: end;
    margin-bottom: 1rem;
  }

  @media (min-width: 820px) {
    .oss-ledger__header {
      grid-template-columns: minmax(0, 1fr) minmax(15rem, 0.5fr);
    }
  }

  .oss-ledger__kicker,
  .oss-ledger__reading-key {
    margin: 0 0 0.45rem;
    color: var(--nest-sunset-orange);
    font-family: var(--font-mono);
    font-size: 0.68rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }

  .oss-ledger__reading-key {
    margin: 0;
    padding: 0.9rem 1rem;
    border: 1px dashed color-mix(in srgb, var(--nest-cyan) 32%, transparent);
    color: var(--color-text-muted);
    line-height: 1.5;
  }

  .oss-ledger h2 {
    margin: 0 0 0.65rem;
    font-size: 1.05rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--nest-cyan);
  }

  .oss-ledger__lede {
    margin: 0 0 1rem;
    max-inline-size: 70ch;
    color: var(--color-text-muted);
  }

  .oss-ledger__table {
    display: grid;
    margin: 0;
    padding: 0;
    list-style: none;
    border: 1px solid var(--color-border);
    clip-path: var(--clip-corner-md);
  }

  .oss-ledger__row {
    display: grid;
    grid-template-columns: minmax(0, 1.1fr) minmax(0, 1.5fr) minmax(0, 1fr);
    gap: 0.75rem;
    padding: 0.8rem 1rem;
    border-block-end: 1px solid var(--color-border);
    color: inherit;
  }

  .oss-ledger__row a {
    display: inline-flex;
    align-items: center;
    min-height: var(--touch-min, 44px);
    color: var(--nest-cyan);
    text-underline-offset: 0.15em;
    font-family: var(--font-mono);
    font-size: 0.72rem;
  }

  .oss-ledger__row a:focus-visible {
    outline: 2px solid var(--nest-cyan);
    outline-offset: 2px;
  }

  .oss-ledger__evidence {
    color: var(--color-text-muted);
    font-size: 0.85rem;
  }

  .oss-ledger__row:last-child {
    border-block-end: 0;
  }

  .oss-ledger__row--head {
    font-family: var(--font-mono);
    font-size: 0.68rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--color-text-faint);
    background: color-mix(in srgb, var(--nest-violet) 8%, transparent);
  }

  .oss-ledger__row:not(.oss-ledger__row--head):hover {
    background: color-mix(in srgb, var(--nest-cyan) 8%, transparent);
  }

  .oss-ledger__notes {
    margin: 1rem 0 0;
    padding-inline-start: 1.1rem;
    color: var(--color-text-faint);
    font-size: 0.82rem;
  }

  .oss-ledger__notes-label {
    margin: 0 0 0.45rem;
    font-family: var(--font-mono);
    font-size: 0.72rem;
    font-weight: 400;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--color-text-muted);
  }

  @media (width < 820px) {
    .oss-ledger__row--head {
      display: none;
    }

    .oss-ledger__row {
      grid-template-columns: 1fr;
    }
  }

  .oss-ledger__groups {
    display: grid;
    gap: 1rem;
  }

  .oss-ledger__group {
    --group-color: var(--nest-magenta);
    scroll-margin-block-start: calc(var(--header-height, 64px) + 1rem);
  }

  .oss-ledger__group:focus-visible {
    outline: 2px solid var(--group-color);
    outline-offset: 4px;
  }

  .oss-ledger__group:target .oss-ledger__group-head {
    animation: oss-evidence-arrival 720ms cubic-bezier(0.2, 0.72, 0.24, 1) both;
  }

  @keyframes oss-evidence-arrival {
    0% {
      box-shadow:
        inset 3px 0 var(--group-color),
        0 0 1.25rem color-mix(in srgb, var(--group-color) 28%, transparent);
      transform: translateX(0.5rem);
    }

    100% {
      box-shadow: inset 0 0 0 transparent;
      transform: translateX(0);
    }
  }

  .oss-ledger__group--maintained {
    --group-color: var(--nest-cyan);
  }

  .oss-ledger__group--org {
    --group-color: var(--nest-violet);
  }

  .oss-ledger__group--external {
    --group-color: var(--nest-sunset-orange);
  }

  .oss-ledger__group-head {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 1rem;
    padding: 0.65rem 0.9rem;
    border-inline-start: 2px solid var(--group-color);
    background: color-mix(in srgb, var(--group-color) 7%, transparent);
  }

  .oss-ledger__group-head h3 {
    margin: 0;
    color: var(--group-color);
    font-family: var(--font-mono);
    font-size: 0.78rem;
    font-weight: 400;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  .oss-ledger__group-head > span {
    color: var(--color-text-faint);
    font-family: var(--font-mono);
    font-size: 0.68rem;
    white-space: nowrap;
  }

  .oss-ledger__group .oss-ledger__row--head {
    grid-template-columns: minmax(0, 1.1fr) minmax(0, 1.5fr) minmax(0, 1fr);
    border-inline-start: 2px solid var(--group-color);
  }

  .oss-ledger__subject {
    font-weight: 600;
    overflow-wrap: anywhere;
  }

  @media (width < 820px) {
    .oss-ledger__group .oss-ledger__row--head {
      display: none;
    }
  }

  @media (width < 640px) {
    .oss-ledger__group {
      scroll-margin-block-start: calc(var(--header-height-sm, 56px) + 4rem);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .oss-ledger__group:target .oss-ledger__group-head {
      animation: none;
    }
  }
</style>
