---
/**
 * PersistenceCore — signature hero scene for the Agentic Harness page.
 *
 * The visual argument of the product in one frame: three persistent cores
 * (knowledge, context, projects) keep feeding the Agent Toolkit runtime while
 * individual sessions fade around them. Pure SVG + CSS motion, no JS, no
 * dependencies; the global reduced-motion kill switch freezes every layer.
 */
---

<div
  class="persistence-core"
  role="img"
  aria-label="Diagram: three persistent workspace cores — knowledge, context, projects — feeding the Agent Toolkit runtime ring, while transient sessions appear and fade around them."
>
  <svg viewBox="0 0 640 460" fill="none" aria-hidden="true" focusable="false">
    <defs>
      <radialGradient id="pc-core-glow" cx="50%" cy="50%" r="50%">
        <stop offset="0%" stop-color="#34d399" stop-opacity="0.5"></stop>
        <stop offset="70%" stop-color="#34d399" stop-opacity="0.08"></stop>
        <stop offset="100%" stop-color="#34d399" stop-opacity="0"></stop>
      </radialGradient>
      <linearGradient id="pc-link" x1="0" y1="0" x2="0" y2="1">
        <stop offset="0%" stop-color="#34d399" stop-opacity="0.7"></stop>
        <stop offset="100%" stop-color="#22d3ee" stop-opacity="0.25"></stop>
      </linearGradient>
      <linearGradient id="pc-ring-stroke" x1="0" y1="0" x2="1" y2="1">
        <stop offset="0%" stop-color="#34d399"></stop>
        <stop offset="100%" stop-color="#22d3ee"></stop>
      </linearGradient>
    </defs>

    <!-- connection lanes: core → runtime -->
    <g class="pc-links">
      <path class="pc-link" d="M140 168 C 150 240, 250 270, 306 306" pathLength="100"></path>
      <path class="pc-link" d="M320 168 L 320 300" pathLength="100"></path>
      <path class="pc-link" d="M500 168 C 490 240, 390 270, 334 306" pathLength="100"></path>
    </g>

    <!-- packets travelling down the lanes -->
    <g class="pc-packets">
      <circle class="pc-packet pc-packet--a" r="3.5" fill="#6ee7b7"></circle>
      <circle class="pc-packet pc-packet--b" r="3.5" fill="#6ee7b7"></circle>
      <circle class="pc-packet pc-packet--c" r="3.5" fill="#6ee7b7"></circle>
    </g>

    <!-- persistent cores -->
    <g class="pc-core pc-core--k">
      <circle cx="140" cy="120" r="46" fill="url(#pc-core-glow)"></circle>
      <circle cx="140" cy="120" r="30" class="pc-core__ring"></circle>
      <text x="140" y="126" class="pc-core__glyph">K</text>
      <text x="140" y="182" class="pc-core__label">knowledge/</text>
    </g>
    <g class="pc-core pc-core--c">
      <circle cx="320" cy="120" r="46" fill="url(#pc-core-glow)"></circle>
      <circle cx="320" cy="120" r="30" class="pc-core__ring"></circle>
      <text x="320" y="126" class="pc-core__glyph">C</text>
      <text x="320" y="182" class="pc-core__label">personas · packs</text>
    </g>
    <g class="pc-core pc-core--p">
      <circle cx="500" cy="120" r="46" fill="url(#pc-core-glow)"></circle>
      <circle cx="500" cy="120" r="30" class="pc-core__ring"></circle>
      <text x="500" y="126" class="pc-core__glyph">P</text>
      <text x="500" y="182" class="pc-core__label">projects/</text>
    </g>

    <!-- transient session ghost: appears, dies, fades — the contrast that carries the message -->
    <g class="pc-session">
      <rect x="436" y="24" width="168" height="52" rx="8" class="pc-session__box"></rect>
      <text x="520" y="46" class="pc-session__title">SESSION #4128</text>
      <text x="520" y="62" class="pc-session__sub">terminated</text>
    </g>

    <!-- runtime ring -->
    <g class="pc-runtime" transform="translate(320 356)">
      <circle r="64" class="pc-runtime__track"></circle>
      <circle r="64" class="pc-runtime__dash" pathLength="100"></circle>
      <circle r="46" class="pc-runtime__inner"></circle>
      <text y="-4" class="pc-runtime__title">AGENT TOOLKIT</text>
      <text y="14" class="pc-runtime__sub">loops · jobs · memory</text>
    </g>
  </svg>
</div>

<style>
  .persistence-core {
    container-type: inline-size;
    width: 100%;
    max-width: 40rem;
    margin-inline: auto;
  }

  .persistence-core svg {
    display: block;
    width: 100%;
    height: auto;
  }

  .pc-link {
    stroke: url(#pc-link);
    stroke-width: 1.5;
    stroke-dasharray: 4 6;
    stroke-linecap: round;
    opacity: 0.65;
    animation: pc-flow 2.6s linear infinite;
  }

  @keyframes pc-flow {
    to {
      stroke-dashoffset: -100;
    }
  }

  .pc-packet {
    opacity: 0;
    filter: drop-shadow(0 0 6px rgba(110, 231, 183, 0.9));
  }

  .pc-packet--a {
    offset-path: path('M140 168 C 150 240, 250 270, 306 306');
    animation: pc-travel-a 3.4s ease-in-out infinite;
  }

  .pc-packet--b {
    offset-path: path('M320 168 L 320 300');
    animation: pc-travel-b 3.4s ease-in-out 1.1s infinite;
  }

  .pc-packet--c {
    offset-path: path('M500 168 C 490 240, 390 270, 334 306');
    animation: pc-travel-c 3.4s ease-in-out 2.2s infinite;
  }

  @keyframes pc-travel-a {
    0% {
      offset-distance: 0%;
      opacity: 0;
    }
    12% {
      opacity: 1;
    }
    82% {
      opacity: 1;
    }
    100% {
      offset-distance: 100%;
      opacity: 0;
    }
  }

  @keyframes pc-travel-b {
    0% {
      offset-distance: 0%;
      opacity: 0;
    }
    12% {
      opacity: 1;
    }
    82% {
      opacity: 1;
    }
    100% {
      offset-distance: 100%;
      opacity: 0;
    }
  }

  @keyframes pc-travel-c {
    0% {
      offset-distance: 0%;
      opacity: 0;
    }
    12% {
      opacity: 1;
    }
    82% {
      opacity: 1;
    }
    100% {
      offset-distance: 100%;
      opacity: 0;
    }
  }

  .pc-core__ring {
    fill: rgba(6, 26, 18, 0.55);
    stroke: var(--world-accent, #34d399);
    stroke-width: 1.5;
  }

  .pc-core--k .pc-core__ring,
  .pc-core--c .pc-core__ring,
  .pc-core--p .pc-core__ring {
    animation: pc-breathe 5.5s ease-in-out infinite;
  }

  .pc-core--c .pc-core__ring {
    animation-delay: 1.8s;
  }

  .pc-core--p .pc-core__ring {
    animation-delay: 3.6s;
  }

  @keyframes pc-breathe {
    0%,
    100% {
      stroke-opacity: 0.65;
    }
    50% {
      stroke-opacity: 1;
    }
  }

  .pc-core__glyph {
    fill: var(--world-accent-strong, #6ee7b7);
    font-family: var(--font-display, monospace);
    font-size: 22px;
    font-weight: 700;
    text-anchor: middle;
  }

  .pc-core__label {
    fill: var(--color-text-muted, #9fb8ad);
    font-family: var(--font-mono, monospace);
    font-size: 11px;
    letter-spacing: 0.08em;
    text-anchor: middle;
  }

  .pc-session {
    animation: pc-session-cycle 7s ease-in-out infinite;
  }

  .pc-session__box {
    fill: rgba(6, 26, 18, 0.2);
    stroke: var(--world-accent-secondary, #22d3ee);
    stroke-width: 1;
    stroke-dasharray: 5 5;
  }

  .pc-session__title {
    fill: var(--world-accent-secondary, #22d3ee);
    font-family: var(--font-mono, monospace);
    font-size: 11px;
    letter-spacing: 0.12em;
    text-anchor: middle;
  }

  .pc-session__sub {
    fill: var(--color-text-muted, #9fb8ad);
    font-family: var(--font-mono, monospace);
    font-size: 10px;
    letter-spacing: 0.1em;
    text-anchor: middle;
  }

  @keyframes pc-session-cycle {
    0%,
    55% {
      opacity: 0.9;
      transform: translateY(0);
    }
    80% {
      opacity: 0.15;
      transform: translateY(6px);
    }
    100% {
      opacity: 0;
      transform: translateY(10px);
    }
  }

  .pc-runtime__track {
    fill: rgba(6, 26, 18, 0.5);
    stroke: rgba(52, 211, 153, 0.25);
    stroke-width: 1;
  }

  .pc-runtime__dash {
    fill: none;
    stroke: url(#pc-ring-stroke);
    stroke-width: 2.5;
    stroke-linecap: round;
    stroke-dasharray: 14 6;
    transform-box: fill-box;
    transform-origin: center;
    animation: pc-orbit 24s linear infinite;
  }

  @keyframes pc-orbit {
    to {
      transform: rotate(360deg);
    }
  }

  .pc-runtime__inner {
    fill: rgba(4, 18, 12, 0.85);
    stroke: rgba(52, 211, 153, 0.35);
    stroke-width: 1;
  }

  .pc-runtime__title,
  .pc-runtime__sub {
    font-family: var(--font-mono, monospace);
    text-anchor: middle;
    letter-spacing: 0.14em;
  }

  .pc-runtime__title {
    fill: var(--world-accent-strong, #6ee7b7);
    font-size: 11px;
  }

  .pc-runtime__sub {
    fill: var(--color-text-muted, #9fb8ad);
    font-size: 9px;
  }

  @media (prefers-reduced-motion: reduce) {
    .pc-link,
    .pc-packet,
    .pc-session,
    .pc-runtime__dash,
    .pc-core--k .pc-core__ring,
    .pc-core--c .pc-core__ring,
    .pc-core--p .pc-core__ring {
      animation: none;
    }

    /* Freeze packets mid-lane instead of stacking them at the start. */
    .pc-packet--a {
      offset-distance: 40%;
      opacity: 0.55;
    }

    .pc-packet--b {
      offset-distance: 70%;
      opacity: 0.55;
    }

    .pc-packet--c {
      offset-distance: 20%;
      opacity: 0.55;
    }
  }

  @media (forced-colors: active) {
    .pc-core__ring {
      stroke: CanvasText;
    }

    .pc-core__glyph,
    .pc-runtime__title {
      fill: CanvasText;
    }
  }
</style>
