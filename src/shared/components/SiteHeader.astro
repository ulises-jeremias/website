---
import { getPrimaryNavigation } from '@/data/routes.js';
import { profile } from '@/data/profile.js';
import DigitalNestMark from './DigitalNestMark.astro';
import MobileNav from './MobileNav.astro';

export interface Props {
  currentPath?: string;
  transparent?: boolean;
  id?: string;
}

const { currentPath = '/', transparent = false, id } = Astro.props as Props;
const navigation = getPrimaryNavigation(currentPath);
const emailHref = `mailto:${profile.contact.email}`;
---

<header id={id} class:list={['site-header', { 'site-header--transparent': transparent }]} data-testid="site-header">
  <a href="#main-content" class="site-header__skip">Skip to content</a>

  <div class="site-header__inner">
    <a href="/" class="site-header__brand" aria-label="Digital Nest — Ulises Jeremias, home">
      <span class="site-header__mark">
        <picture>
          <source
            type="image/webp"
            srcset="/assets/nest/logo-nest-sm.webp 112w, /assets/nest/logo-nest.webp 256w"
            sizes="44px"
          />
          <img
            class="site-header__logo art-fade"
            src="/assets/logo-nest.png"
            width="56"
            height="56"
            alt=""
            decoding="async"
          />
        </picture>
        <span class="site-header__mark-fallback">
          <DigitalNestMark />
        </span>
      </span>
      <span class="site-header__identity">
        <strong class="text-glow-primary">Digital Nest</strong>
        <span>by Ulises Jeremias</span>
      </span>
    </a>

    <nav class="site-header__desktop-nav" aria-label="Primary">
      <ul>
        {
          navigation.map((item) => (
            <li>
              <a
                href={item.path}
                class:list={['site-header__link', { 'is-active': item.isActive }]}
                aria-current={item.isActive ? 'page' : undefined}
              >
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    <div class="site-header__utilities">
      <a
        class="site-header__github"
        href={profile.links.github}
        target="_blank"
        rel="noopener noreferrer"
        aria-label="Ulises Jeremias on GitHub (opens in new tab)"
      >
        <svg viewBox="0 0 24 24" fill="none" aria-hidden="true">
          <path
            d="M12 2.8a9.2 9.2 0 0 0-2.9 17.9c.5.1.6-.2.6-.5v-1.8c-2.8.6-3.4-1.2-3.4-1.2-.5-1.2-1.1-1.5-1.1-1.5-.9-.6.1-.6.1-.6 1 0 1.6 1.1 1.6 1.1.9 1.6 2.4 1.1 2.9.9.1-.7.4-1.1.7-1.4-2.3-.3-4.7-1.1-4.7-5.1 0-1.1.4-2.1 1.1-2.8-.1-.3-.5-1.3.1-2.8 0 0 .9-.3 2.9 1.1a10 10 0 0 1 5.3 0c2-1.4 2.9-1.1 2.9-1.1.6 1.5.2 2.5.1 2.8.7.7 1.1 1.7 1.1 2.8 0 4-2.4 4.8-4.7 5.1.4.3.7 1 .7 1.9v2.6c0 .3.2.6.7.5A9.2 9.2 0 0 0 12 2.8Z"
          ></path>
        </svg>
      </a>

      <MobileNav items={navigation} githubHref={profile.links.github} emailHref={emailHref} />
    </div>
  </div>

  <nav class="site-header__compact-nav" aria-label="Primary (compact)">
    <ul>
      {
        navigation.map((item) => (
          <li>
            <a
              href={item.path}
              class:list={[{ 'is-active': item.isActive }]}
              aria-current={item.isActive ? 'page' : undefined}
            >
              {item.label}
            </a>
          </li>
        ))
      }
    </ul>
  </nav>
</header>

<style>
  .site-header {
    --header-bg: color-mix(in srgb, var(--nest-midnight-950) 94%, transparent);
    position: sticky;
    inset-block-start: 0;
    z-index: 60;
    color: var(--color-text);
    background: var(--header-bg);
    border-block-end: 1px solid var(--color-border);
  }

  @supports (backdrop-filter: blur(1rem)) {
    .site-header {
      backdrop-filter: blur(1rem) saturate(1.08);
    }
  }

  .site-header--transparent {
    --header-bg: color-mix(in srgb, var(--nest-midnight-950) 82%, transparent);
  }

  .site-header__skip {
    position: fixed;
    inset-block-start: var(--space-2);
    inset-inline-start: var(--space-2);
    z-index: 100;
    padding: var(--space-2) var(--space-4);
    color: var(--color-text);
    background: var(--color-surface-elevated);
    border: 1px solid var(--color-border-strong);
    clip-path: var(--clip-corner-sm);
    transform: translateY(-180%);
    transition: transform var(--motion-duration-fast) var(--motion-ease-out);
  }

  .site-header__skip:focus-visible {
    transform: translateY(0);
  }

  .site-header__inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-4);
    inline-size: min(calc(100% - 2 * var(--gutter)), var(--container-full));
    min-block-size: 4.25rem;
    margin-inline: auto;
  }

  .site-header__compact-nav {
    display: none;
    inline-size: min(calc(100% - 2 * var(--gutter)), var(--container-full));
    margin: 0 auto;
    padding-block: 0 0.65rem;
  }

  .site-header__compact-nav ul {
    display: flex;
    align-items: center;
    gap: 1.25rem;
    margin: 0;
    padding: 0 0.15rem 0.15rem;
    list-style: none;
    overflow-x: auto;
    -webkit-overflow-scrolling: touch;
  }

  .site-header__compact-nav a {
    display: inline-flex;
    white-space: nowrap;
    color: color-mix(in srgb, var(--nest-paper) 70%, transparent);
    font-size: 0.8125rem;
    text-decoration: none;
  }

  .site-header__compact-nav a:hover {
    color: var(--nest-cyan);
  }

  .site-header__compact-nav a.is-active {
    color: var(--nest-magenta);
    text-shadow:
      0 0 8px color-mix(in srgb, var(--nest-magenta) 55%, transparent),
      0 0 18px color-mix(in srgb, var(--nest-magenta) 30%, transparent);
  }

  .site-header__brand {
    display: inline-flex;
    align-items: center;
    gap: var(--space-3);
    min-block-size: var(--touch-min);
    color: var(--color-text);
    text-decoration: none;
  }

  .site-header__mark {
    position: relative;
    inline-size: 2.75rem;
    block-size: 2.75rem;
  }

  .site-header__mark picture {
    position: absolute;
    inset: 0;
    display: block;
  }

  .site-header__logo {
    position: absolute;
    inset: 0;
    inline-size: 100%;
    block-size: 100%;
    object-fit: contain;
  }

  .site-header__mark-fallback {
    display: none;
  }

  .site-header__identity {
    display: grid;
    line-height: 1.1;
  }

  .site-header__identity strong {
    font-family: var(--font-display);
    font-size: var(--text-sm);
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--nest-magenta);
  }

  .site-header__identity span {
    margin-block-start: 0.18rem;
    color: var(--color-text-muted);
    font-family: var(--font-mono);
    font-size: 0.62rem;
    letter-spacing: 0.16em;
  }

  .site-header__desktop-nav {
    display: none;
    margin-inline-start: auto;
  }

  .site-header__desktop-nav ul {
    display: flex;
    align-items: stretch;
    gap: clamp(var(--space-2), 1.6vw, var(--space-5));
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .site-header__link {
    position: relative;
    display: inline-flex;
    align-items: center;
    min-block-size: var(--touch-min);
    padding-inline: var(--space-1);
    color: var(--color-text-muted);
    font-size: var(--text-sm);
    text-decoration: none;
    transition: color var(--motion-duration-fast) var(--motion-ease-standard);
  }

  .site-header__link::after {
    content: '';
    position: absolute;
    inset-inline: 50%;
    inset-block-end: 0.2rem;
    block-size: 2px;
    background: linear-gradient(90deg, var(--nest-magenta), var(--nest-cyan));
    box-shadow: 0 0 0.75rem color-mix(in srgb, var(--nest-magenta) 55%, transparent);
    transition: inset-inline var(--motion-duration-base) var(--motion-ease-emphasized);
  }

  .site-header__link:hover,
  .site-header__link.is-active {
    color: var(--color-text);
  }

  .site-header__link:hover::after,
  .site-header__link.is-active::after {
    inset-inline: 0;
  }

  .site-header__link.is-active {
    color: var(--nest-magenta);
    text-shadow:
      0 0 8px color-mix(in srgb, var(--nest-magenta) 55%, transparent),
      0 0 18px color-mix(in srgb, var(--nest-magenta) 30%, transparent);
  }

  .site-header__link.is-active::after {
    background: var(--nest-magenta);
    box-shadow: 0 0 10px 2px var(--nest-magenta);
  }

  .site-header__utilities {
    display: flex;
    align-items: center;
    gap: var(--space-2);
  }

  .site-header__github {
    display: none;
    place-items: center;
    inline-size: 2.25rem;
    block-size: 2.25rem;
    color: var(--nest-cyan);
    border: 1px solid color-mix(in srgb, var(--nest-magenta) 25%, transparent);
    background: color-mix(in srgb, var(--nest-midnight-950) 40%, transparent);
    border-radius: 0.15rem;
  }

  .site-header__github:hover {
    color: var(--nest-cyan);
    border-color: color-mix(in srgb, var(--nest-cyan) 60%, transparent);
    box-shadow: 0 0 14px -2px var(--nest-cyan);
  }

  .site-header__github svg {
    inline-size: 1.25rem;
    block-size: 1.25rem;
  }

  .site-header__github path {
    fill: currentColor;
  }

  @media (width >= 860px) {
    .site-header__desktop-nav,
    .site-header__github {
      display: grid;
    }
  }

  @media (width < 860px) {
    .site-header__compact-nav {
      display: block;
    }
  }

  @media (width < 430px) {
    .site-header__identity span {
      display: none;
    }

    .site-header__mark {
      inline-size: 2.25rem;
      block-size: 2.25rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .site-header__skip,
    .site-header__link,
    .site-header__link::after {
      transition-duration: var(--motion-duration-instant);
    }
  }

  @media (forced-colors: active) {
    .site-header__link::after {
      background: Highlight;
      box-shadow: none;
    }
  }
</style>
