---
import type { PrimaryNavigationItem } from '@/data/routes.js';

export interface Props {
  items: PrimaryNavigationItem[];
  githubHref: string;
  emailHref: string;
}

const { items, githubHref, emailHref } = Astro.props as Props;
---

<div class="mobile-nav" data-mobile-nav>
  <button
    type="button"
    class="mobile-nav__trigger"
    aria-expanded="false"
    aria-controls="site-navigation-drawer"
    aria-label="Open navigation"
    data-mobile-trigger
  >
    <svg viewBox="0 0 24 24" fill="none" aria-hidden="true">
      <path d="M4 7h16M4 12h16M4 17h16"></path>
    </svg>
    <span>Menu</span>
  </button>

  <div class="mobile-nav__backdrop" data-mobile-backdrop hidden aria-hidden="true"></div>

  <div
    id="site-navigation-drawer"
    class="mobile-nav__drawer"
    role="dialog"
    aria-modal="true"
    aria-labelledby="site-navigation-title"
    data-mobile-drawer
    hidden
  >
    <div class="mobile-nav__drawer-head">
      <div>
        <p class="mobile-nav__eyebrow">Digital Nest</p>
        <h2 id="site-navigation-title">Navigate the atlas</h2>
      </div>
      <button type="button" class="mobile-nav__close" aria-label="Close navigation" data-mobile-close>
        <svg viewBox="0 0 24 24" fill="none" aria-hidden="true">
          <path d="m6 6 12 12M18 6 6 18"></path>
        </svg>
      </button>
    </div>

    <nav aria-label="Primary">
      <ol class="mobile-nav__list">
        {
          items.map((item, index) => (
            <li>
              <a
                href={item.path}
                class:list={['mobile-nav__link', { 'is-active': item.isActive }]}
                aria-current={item.isActive ? 'page' : undefined}
              >
                <span class="mobile-nav__index" aria-hidden="true">
                  {String(index + 1).padStart(2, '0')}
                </span>
                <span>{item.label}</span>
                <svg viewBox="0 0 20 20" fill="none" aria-hidden="true">
                  <path d="M4 10h11m-4-4 4 4-4 4" />
                </svg>
              </a>
            </li>
          ))
        }
      </ol>
    </nav>

    <div class="mobile-nav__footer">
      <a href={githubHref} target="_blank" rel="noopener noreferrer"
        >GitHub <span class="sr-only">(opens in new tab)</span></a
      >
      <a href={emailHref}>Start a conversation</a>
    </div>
  </div>
</div>

<script>
  function initializeMobileNavigation(root: Element) {
    if (root.hasAttribute('data-mobile-nav-ready')) return;

    const trigger = root.querySelector<HTMLButtonElement>('[data-mobile-trigger]');
    const drawer = root.querySelector<HTMLElement>('[data-mobile-drawer]');
    const backdrop = root.querySelector<HTMLElement>('[data-mobile-backdrop]');
    const closeButton = root.querySelector<HTMLButtonElement>('[data-mobile-close]');
    if (!trigger || !drawer || !backdrop || !closeButton) return;

    const navTrigger = trigger;
    const navDrawer = drawer;
    const navBackdrop = backdrop;
    const navCloseButton = closeButton;
    document.body.append(navBackdrop, navDrawer);
    root.setAttribute('data-mobile-nav-ready', '');
    const focusableSelector = 'a[href], button:not([disabled]), [tabindex]:not([tabindex="-1"])';
    let previousFocus: HTMLElement | null = null;
    let restoreFocusAfterClose = true;
    let hideTimer = 0;
    let backgroundStates: Array<{ element: HTMLElement; inert: boolean; ariaHidden: string | null }> = [];

    const reducedMotion = () => window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    const focusableElements = () =>
      Array.from(navDrawer.querySelectorAll<HTMLElement>(focusableSelector)).filter((element) => !element.hidden);

    function isolateBackground() {
      backgroundStates = Array.from(document.body.children)
        .filter(
          (element): element is HTMLElement =>
            element instanceof HTMLElement &&
            element !== navDrawer &&
            element !== navBackdrop &&
            !['SCRIPT', 'STYLE', 'LINK'].includes(element.tagName),
        )
        .map((element) => ({
          element,
          inert: element.hasAttribute('inert'),
          ariaHidden: element.getAttribute('aria-hidden'),
        }));

      for (const { element } of backgroundStates) {
        element.setAttribute('inert', '');
        element.setAttribute('aria-hidden', 'true');
      }
    }

    function restoreBackground() {
      for (const { element, inert, ariaHidden } of backgroundStates) {
        if (!inert) element.removeAttribute('inert');
        if (ariaHidden === null) element.removeAttribute('aria-hidden');
        else element.setAttribute('aria-hidden', ariaHidden);
      }
      backgroundStates = [];
    }

    function openNavigation() {
      window.clearTimeout(hideTimer);
      previousFocus = document.activeElement instanceof HTMLElement ? document.activeElement : null;
      navDrawer.hidden = false;
      navBackdrop.hidden = false;
      navBackdrop.removeAttribute('aria-hidden');
      navTrigger.setAttribute('aria-expanded', 'true');
      navTrigger.setAttribute('aria-label', 'Close navigation');
      navCloseButton.focus();
      isolateBackground();
      document.documentElement.classList.add('mobile-nav-open');
      requestAnimationFrame(() => {
        navDrawer.classList.add('is-open');
        navBackdrop.classList.add('is-open');
      });
      document.addEventListener('keydown', handleKeydown);
    }

    function finishClose() {
      navDrawer.hidden = true;
      navBackdrop.hidden = true;
      navBackdrop.setAttribute('aria-hidden', 'true');
      restoreBackground();
      if (restoreFocusAfterClose) (previousFocus ?? navTrigger).focus();
      previousFocus = null;
    }

    function closeNavigation({ restoreFocus = true } = {}) {
      navDrawer.classList.remove('is-open');
      navBackdrop.classList.remove('is-open');
      navTrigger.setAttribute('aria-expanded', 'false');
      navTrigger.setAttribute('aria-label', 'Open navigation');
      document.documentElement.classList.remove('mobile-nav-open');
      document.removeEventListener('keydown', handleKeydown);
      restoreFocusAfterClose = restoreFocus;
      hideTimer = window.setTimeout(finishClose, reducedMotion() ? 0 : 220);
    }

    function handleKeydown(event: KeyboardEvent) {
      if (event.key === 'Escape') {
        event.preventDefault();
        closeNavigation();
        return;
      }
      if (event.key !== 'Tab') return;

      const focusable = focusableElements();
      const first = focusable.at(0);
      const last = focusable.at(-1);
      if (!first || !last) return;

      if (event.shiftKey && document.activeElement === first) {
        event.preventDefault();
        last.focus();
      } else if (!event.shiftKey && document.activeElement === last) {
        event.preventDefault();
        first.focus();
      }
    }

    navTrigger.addEventListener('click', () => {
      if (navTrigger.getAttribute('aria-expanded') === 'true') closeNavigation();
      else openNavigation();
    });
    navCloseButton.addEventListener('click', () => closeNavigation());
    navBackdrop.addEventListener('click', () => closeNavigation());
    navDrawer.addEventListener('click', (event) => {
      const link = event.target instanceof Element ? event.target.closest('a') : null;
      if (link?.getAttribute('href')?.startsWith('/')) closeNavigation({ restoreFocus: false });
    });

    window.matchMedia('(min-width: 860px)').addEventListener('change', (event) => {
      if (event.matches && navTrigger.getAttribute('aria-expanded') === 'true')
        closeNavigation({ restoreFocus: false });
    });
  }

  document.querySelectorAll('[data-mobile-nav]').forEach(initializeMobileNavigation);
  document.addEventListener('astro:page-load', () => {
    document.querySelectorAll('[data-mobile-nav]').forEach(initializeMobileNavigation);
  });
</script>

<style>
  .mobile-nav {
    display: block;
  }

  .mobile-nav__trigger,
  .mobile-nav__close {
    min-inline-size: var(--touch-min);
    min-block-size: var(--touch-min);
    color: var(--color-text);
    border: 1px solid var(--color-border);
    background: color-mix(in srgb, var(--color-surface) 88%, transparent);
    cursor: pointer;
  }

  .mobile-nav__trigger {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: var(--space-2);
    padding-inline: var(--space-3);
    clip-path: var(--clip-corner-sm);
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    letter-spacing: var(--tracking-wide);
    text-transform: uppercase;
  }

  .mobile-nav__trigger svg,
  .mobile-nav__close svg {
    inline-size: 1.25rem;
    block-size: 1.25rem;
  }

  .mobile-nav__trigger path,
  .mobile-nav__close path {
    stroke: currentColor;
    stroke-width: 1.7;
    stroke-linecap: round;
  }

  .mobile-nav__backdrop {
    position: fixed;
    inset: 0;
    z-index: 70;
    background: rgb(2 1 10 / 0.74);
    opacity: 0;
    transition: opacity var(--motion-duration-base) var(--motion-ease-standard);
  }

  .mobile-nav__backdrop.is-open {
    opacity: 1;
  }

  .mobile-nav__backdrop[hidden],
  .mobile-nav__drawer[hidden] {
    display: none;
  }

  .mobile-nav__drawer {
    position: fixed;
    inset-block: 0;
    inset-inline-end: 0;
    z-index: 80;
    display: flex;
    flex-direction: column;
    inline-size: min(88vw, 24rem);
    overflow-y: auto;
    color: var(--color-text);
    background:
      linear-gradient(180deg, color-mix(in srgb, var(--nest-violet) 9%, transparent), transparent 28%),
      var(--nest-midnight-900);
    border-inline-start: 1px solid var(--color-border-strong);
    box-shadow: -1.5rem 0 4rem rgb(0 0 0 / 0.5);
    transform: translateX(100%);
    transition: transform var(--motion-duration-base) var(--motion-ease-emphasized);
  }

  .mobile-nav__drawer.is-open {
    transform: translateX(0);
  }

  .mobile-nav__drawer-head {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: var(--space-4);
    padding: var(--space-6) var(--space-5);
    border-block-end: 1px solid var(--color-border);
  }

  .mobile-nav__eyebrow {
    margin: 0 0 var(--space-1);
    color: var(--nest-magenta);
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    letter-spacing: var(--tracking-wider);
    text-transform: uppercase;
  }

  .mobile-nav__drawer h2 {
    margin: 0;
    font-size: var(--text-lg);
    letter-spacing: var(--tracking-snug);
  }

  .mobile-nav__close {
    display: grid;
    flex: 0 0 auto;
    place-items: center;
    padding: 0;
  }

  .mobile-nav__list {
    display: grid;
    gap: var(--space-2);
    margin: 0;
    padding: var(--space-5);
    list-style: none;
  }

  .mobile-nav__link {
    display: grid;
    grid-template-columns: auto 1fr auto;
    align-items: center;
    gap: var(--space-3);
    min-block-size: var(--touch-min-large);
    padding: var(--space-3);
    color: var(--color-text-muted);
    border: 1px solid transparent;
    text-decoration: none;
    clip-path: var(--clip-corner-sm);
  }

  .mobile-nav__link:hover,
  .mobile-nav__link.is-active {
    color: var(--color-text);
    background: var(--color-accent-subtle);
    border-color: var(--color-border);
  }

  .mobile-nav__link.is-active {
    border-inline-start-color: var(--nest-magenta);
  }

  .mobile-nav__index {
    color: var(--nest-cyan);
    font-family: var(--font-mono);
    font-size: 0.75rem;
  }

  .mobile-nav__link svg {
    inline-size: 1rem;
    block-size: 1rem;
  }

  .mobile-nav__link path {
    stroke: currentColor;
    stroke-width: 1.5;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .mobile-nav__footer {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-4);
    margin-block-start: auto;
    padding: var(--space-5);
    border-block-start: 1px solid var(--color-border);
  }

  .mobile-nav__footer a {
    min-block-size: var(--touch-min);
    display: inline-flex;
    align-items: center;
    color: var(--color-text-muted);
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    text-underline-offset: 0.25em;
  }

  .mobile-nav__footer a:hover {
    color: var(--nest-cyan);
  }

  .sr-only {
    position: absolute;
    inline-size: 1px;
    block-size: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }

  :global(html.mobile-nav-open) {
    overflow: hidden;
  }

  @media (width >= 860px) {
    .mobile-nav {
      display: none;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .mobile-nav__drawer,
    .mobile-nav__backdrop {
      transition-duration: var(--motion-duration-instant);
    }
  }

  @media (forced-colors: active) {
    .mobile-nav__drawer,
    .mobile-nav__link.is-active {
      border-color: Highlight;
    }
  }
</style>
