---
/**
 * Link primitive — consistent external affordance and a11y.
 * - Internal links: plain <a>, no new tab, no icon unless forced.
 * - External links: optional icon ↗, `target="_blank"` + `rel="noopener noreferrer"`,
 *   and screen-reader announcement. Respects B-08 policy: external GitHub / Discord /
 *   docs open in new tab with icon; internal nav does not.
 * Also supports `variant` for styling: default | subtle | nav
 */

import { cn } from '@/shared/lib/utils.js';

export interface Props {
  href: string;
  variant?: 'default' | 'subtle' | 'nav';
  external?: boolean;
  showExternalIcon?: boolean;
  ariaLabel?: string;
  ariaCurrent?: 'page' | 'step' | 'location' | 'date' | 'time' | boolean;
  class?: string;
  id?: string;
}

const {
  href,
  variant = 'default',
  external,
  showExternalIcon,
  ariaLabel,
  ariaCurrent,
  class: className,
  id,
} = Astro.props as Props;

const isExternal = external ?? /^(https?:)?\/\//.test(href);
const shouldShowIcon = showExternalIcon ?? isExternal;
const target = isExternal ? '_blank' : undefined;
const rel = isExternal ? 'noopener noreferrer' : undefined;

const base = 'link inline-flex items-center gap-1 underline-offset-4 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-offset-2 focus-visible:ring-[var(--color-accent,#181512)] rounded-sm';

const variants: Record<string, string> = {
  default:
    'text-[var(--color-link,#B85C38)] hover:text-[var(--color-link-hover,#8a4428)] underline decoration-[var(--color-border,#E9D8C3)] hover:decoration-current',
  subtle:
    'text-[var(--color-ink,#181512)] hover:text-[var(--color-link,#B85C38)] no-underline hover:underline',
  nav: 'text-[var(--color-ink,#181512)] no-underline hover:text-[var(--color-link,#B85C38)] font-medium aria-[current=page]:text-[var(--color-link,#B85C38)] aria-[current=page]:underline',
};

const classes = cn(base, variants[variant], className);
---

<a
  id={id}
  href={href}
  class={classes}
  aria-label={ariaLabel}
  aria-current={ariaCurrent as string | undefined}
  target={target}
  rel={rel}
  data-variant={variant}
  data-external={isExternal ? 'true' : undefined}
>
  <slot />
  {
    shouldShowIcon && (
      <span aria-hidden="true" class="link__external">
        ↗
      </span>
    )
  }
  {isExternal && <span class="sr-only"> (opens in new tab)</span>}
</a>

<style>
  .link {
    text-underline-offset: 3px;
    text-decoration-thickness: from-font;
  }

  .link__external {
    font-size: 0.85em;
    line-height: 1;
  }

  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }

  .link:focus-visible {
    outline-offset: 2px;
  }

  @media (prefers-reduced-motion: reduce) {
    .link {
      transition: none;
    }
  }
</style>
