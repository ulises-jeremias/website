---
import { getFooterRoutes, getNavLabel } from '@/data/routes.js';
import { profile } from '@/data/profile.js';

export interface Props {
  id?: string;
}

const { id } = Astro.props as Props;
const routes = getFooterRoutes();
const year = new Date().getFullYear();
const emailHref = `mailto:${profile.contact.email}`;
const sourceHref = 'https://github.com/ulises-jeremias/website';
const socialLinks = [
  {
    label: 'GitHub',
    href: profile.links.github,
    external: true,
    icon: 'github',
  },
  {
    label: 'Discord',
    href: profile.links.discord,
    external: true,
    icon: 'discord',
  },
  {
    label: 'Email',
    href: emailHref,
    external: false,
    icon: 'mail',
  },
  {
    label: 'LinkedIn',
    href: profile.links.linkedin,
    external: true,
    icon: 'linkedin',
  },
] as const;
---

<footer id={id} class="site-footer" data-testid="site-footer">
  <div class="site-footer__shell neon-frame clip-corner">
    <a href="/" class="site-footer__brand" aria-label="Digital Nest, home">
      <img
        class="site-footer__logo art-fade"
        src="/assets/logo-nest.png"
        srcset="/assets/nest/logo-nest-sm.webp 112w, /assets/nest/logo-nest.webp 256w"
        sizes="36px"
        width="48"
        height="48"
        alt=""
        decoding="async"
      />
    </a>

    <p class="site-footer__credit">
      <span>&copy; {year} Ulises Jeremias</span>
      <span class="site-footer__bullet" aria-hidden="true">•</span>
      <span class="site-footer__built">
        Built with
        <svg class="site-footer__heart" viewBox="0 0 24 24" aria-hidden="true">
          <path
            fill="currentColor"
            d="M12 20.4s-7.6-4.6-7.6-9.6a4.2 4.2 0 0 1 7.6-2.5A4.2 4.2 0 0 1 19.6 10.8c0 5-7.6 9.6-7.6 9.6Z"></path>
        </svg>
        in the terminal
      </span>
    </p>

    <ul class="site-footer__socials">
      {
        socialLinks.map((link) => (
          <li>
            <a
              href={link.href}
              aria-label={link.label}
              target={link.external ? '_blank' : undefined}
              rel={link.external ? 'noopener noreferrer' : undefined}
            >
              {link.icon === 'github' && (
                <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                  <path d="M12 1.8a10.2 10.2 0 0 0-3.23 19.88c.51.1.7-.22.7-.44v-1.7c-2.84.62-3.44-1.2-3.44-1.2-.46-1.19-1.13-1.5-1.13-1.5-.93-.64.07-.62.07-.62 1.03.07 1.57 1.06 1.57 1.06.9 1.56 2.37 1.11 2.95.85.09-.66.35-1.11.64-1.37-2.27-.26-4.65-1.14-4.65-5.06 0-1.12.4-2.03 1.06-2.75-.11-.26-.46-1.3.1-2.71 0 0 .86-.28 2.82 1.05a9.7 9.7 0 0 1 5.14 0c1.96-1.33 2.82-1.05 2.82-1.05.56 1.41.21 2.45.1 2.71.66.72 1.06 1.63 1.06 2.75 0 3.93-2.39 4.8-4.67 5.05.36.32.68.94.68 1.9v2.81c0 .22.19.55.71.44A10.2 10.2 0 0 0 12 1.8Z" />
                </svg>
              )}
              {link.icon === 'discord' && (
                <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                  <path d="M19.3 5.9A15.6 15.6 0 0 0 15.5 4.7l-.3.6a11 11 0 0 1 3.3 1.6 12.4 12.4 0 0 0-10.9 0 11 11 0 0 1 3.3-1.6l-.3-.6a15.6 15.6 0 0 0-3.9 1.2C3.9 9.4 3.3 12.9 3.5 16.4A15 15 0 0 0 8 19.3l.8-1.4a9.6 9.6 0 0 1-1.9-1c.5.3 2.4 1.4 5.1 1.4s4.6-1.1 5.1-1.4a9.6 9.6 0 0 1-1.9 1l.8 1.4a15 15 0 0 0 4.5-2.9c.3-3.9-.5-7.3-2.2-10.5ZM9.4 14.5c-.9 0-1.6-.8-1.6-1.8s.7-1.9 1.6-1.9 1.7.9 1.6 1.9c0 1-.7 1.8-1.6 1.8Zm5.2 0c-.9 0-1.6-.8-1.6-1.8s.7-1.9 1.6-1.9 1.7.9 1.6 1.9c0 1-.7 1.8-1.6 1.8Z" />
                </svg>
              )}
              {link.icon === 'mail' && (
                <svg viewBox="0 0 24 24" fill="none" aria-hidden="true">
                  <rect x="2.5" y="5" width="19" height="14" rx="2" stroke="currentColor" stroke-width="1.6" />
                  <path d="m3.5 7 8.5 6 8.5-6" stroke="currentColor" stroke-width="1.6" />
                </svg>
              )}
              {link.icon === 'linkedin' && (
                <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                  <path d="M6.5 9.5H3.7V20h2.8V9.5ZM5.1 4A1.7 1.7 0 1 0 5.1 7.4 1.7 1.7 0 0 0 5.1 4ZM20.3 20h-2.8v-5.6c0-1.5-.6-2.4-1.9-2.4-1 0-1.5.7-1.8 1.3-.1.3-.1.6-.1.9V20h-2.8s0-9.2 0-10.5h2.8v1.7c.5-.8 1.4-1.9 3.4-1.9 2.4 0 4.2 1.6 4.2 5V20Z" />
                </svg>
              )}
              {link.external && <span class="sr-only"> (opens in new tab)</span>}
            </a>
          </li>
        ))
      }
    </ul>
  </div>

  <nav class="site-footer__atlas" aria-label="Digital Nest worlds">
    <p class="site-footer__label">Atlas index</p>
    <ol>
      {
        routes.map((route, index) => (
          <li>
            <a href={route.path}>
              <span aria-hidden="true">{String(index).padStart(2, '0')}</span>
              {getNavLabel(route)}
            </a>
          </li>
        ))
      }
    </ol>
    <a class="site-footer__source" href={sourceHref} target="_blank" rel="noopener noreferrer">
      View source
      <span class="sr-only"> (opens in new tab)</span>
    </a>
  </nav>
</footer>

<style>
  .site-footer {
    position: relative;
    color: var(--color-text);
    background: var(--nest-midnight-950);
    padding: var(--space-6) var(--gutter) var(--space-8);
  }

  .site-footer__shell {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-4);
    max-inline-size: min(calc(100% - 0px), 87.5rem);
    margin-inline: auto;
    margin-block-end: var(--space-6);
    padding: var(--space-4) var(--space-6);
  }

  .site-footer__logo {
    inline-size: 2.25rem;
    block-size: 2.25rem;
    object-fit: contain;
  }

  .site-footer__credit {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: center;
    gap: 0.45rem;
    margin: 0;
    color: var(--color-text-muted);
    font-size: 0.75rem;
    text-align: center;
  }

  .site-footer__bullet {
    color: var(--nest-magenta);
  }

  .site-footer__built {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
  }

  .site-footer__heart {
    inline-size: 0.9rem;
    block-size: 0.9rem;
    color: var(--nest-magenta);
  }

  .site-footer__socials {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .site-footer__socials a {
    display: grid;
    place-items: center;
    inline-size: 2rem;
    block-size: 2rem;
    color: color-mix(in srgb, var(--nest-paper) 70%, transparent);
    border: 1px solid color-mix(in srgb, var(--nest-magenta) 25%, transparent);
    border-radius: 999px;
    transition:
      color var(--motion-duration-fast) var(--motion-ease-out),
      border-color var(--motion-duration-fast) var(--motion-ease-out),
      box-shadow var(--motion-duration-fast) var(--motion-ease-out);
  }

  .site-footer__socials a:hover {
    color: var(--nest-cyan);
    border-color: color-mix(in srgb, var(--nest-cyan) 60%, transparent);
    box-shadow: 0 0 14px -3px var(--nest-cyan);
  }

  .site-footer__socials svg {
    inline-size: 1rem;
    block-size: 1rem;
  }

  .site-footer__atlas {
    max-inline-size: min(calc(100% - 0px), 87.5rem);
    margin-inline: auto;
  }

  .site-footer__label {
    margin: 0 0 var(--space-3);
    color: var(--nest-magenta);
    font-family: var(--font-display);
    font-size: 0.65rem;
    letter-spacing: 0.28em;
    text-transform: uppercase;
  }

  .site-footer__atlas ol {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--space-2) var(--space-4);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .site-footer__atlas a {
    display: inline-flex;
    gap: var(--space-2);
    min-block-size: 2rem;
    align-items: center;
    color: var(--color-text-muted);
    font-size: var(--text-sm);
    text-decoration: none;
  }

  .site-footer__atlas a span {
    color: var(--nest-cyan);
    font-family: var(--font-mono);
    font-size: 0.62rem;
  }

  .site-footer__atlas a:hover {
    color: var(--color-text);
  }

  .site-footer__source {
    display: inline-flex;
    margin-block-start: var(--space-4);
    color: var(--nest-cyan);
    font-family: var(--font-mono);
    font-size: var(--text-xs);
  }

  .sr-only {
    position: absolute;
    inline-size: 1px;
    block-size: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }

  @media (width >= 640px) {
    .site-footer__shell {
      flex-direction: row;
      justify-content: space-between;
    }
  }

  @media (width >= 900px) {
    .site-footer__atlas ol {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }
</style>
