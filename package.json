{
  "name": "website",
  "version": "0.1.0",
  "private": true,
  "description": "Personal website — Astro 7, content-first, feature-based architecture. Built with create-awesome-node-app.",
  "type": "module",
  "packageManager": "pnpm@10.28.1",
  "engines": {
    "node": ">=22.0.0",
    "pnpm": ">=10.0.0"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "lint:a11y": "eslint . --report-unused-disable-directives --max-warnings 0",
    "type-check": "astro check",
    "test": "vitest run --passWithNoTests",
    "test:watch": "vitest --watch",
    "test:coverage": "vitest run --coverage --passWithNoTests",
    "test:visual": "playwright test",
    "test:visual:harness": "playwright test tests/visual/harness.spec.ts",
    "test:visual:update": "playwright test --update-snapshots",
    "test:deployment": "playwright test --config=playwright.deployment.config.ts",
    "performance:baseline": "pnpm build && node scripts/check-route-budgets.mjs --write-baseline",
    "performance:check": "pnpm build && node scripts/check-route-budgets.mjs",
    "lighthouse:ci": "pnpm build && node scripts/run-lighthouse-ci.mjs",
    "assets:social": "node scripts/generate-social-cards.mjs",
    "data:refresh": "node scripts/refresh-github-data.mjs",
    "data:create-awesome:refresh": "node scripts/create-awesome-catalogs.mjs refresh",
    "data:create-awesome:check": "node scripts/create-awesome-catalogs.mjs check",
    "data:create-awesome:drift": "node scripts/create-awesome-catalogs.mjs drift",
    "cspell": "cspell lint --no-progress .",
    "knip": "knip",
    "prepare": "husky"
  },
  "dependencies": {
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@fontsource/orbitron": "^5.3.0",
    "astro": "^7.2.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@commitlint/cli": "^21.2.2",
    "@commitlint/config-conventional": "^21.2.0",
    "@playwright/test": "^1.62.1",
    "@testing-library/jest-dom": "^7.0.0",
    "@types/node": "^26.1.2",
    "@vitest/coverage-v8": "^3.2.4",
    "ajv": "^8.20.0",
    "ajv-draft-04": "^1.0.0",
    "axe-core": "^4.13.0",
    "chrome-launcher": "^1.2.1",
    "cspell": "^10.0.1",
    "eslint": "^9.39.2",
    "eslint-config-prettier": "^10.1.8",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-astro": "^3.1.0",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "husky": "^9.1.7",
    "jsdom": "^30.0.1",
    "knip": "^6.31.0",
    "lighthouse": "^13.4.1",
    "lint-staged": "^17.3.0",
    "playwright": "1.62.1",
    "prettier": "^3.9.6",
    "prettier-plugin-astro": "^0.14.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.53.1",
    "vitest": "^3.2.4"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx,astro}": [
      "eslint --fix"
    ],
    "*": [
      "prettier --write"
    ]
  }
}
