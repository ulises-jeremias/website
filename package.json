{
  "name": "website",
  "version": "0.1.0",
  "private": true,
  "description": "Personal website \u2014 Astro 7, content-first, feature-based architecture. Built with create-awesome-node-app.",
  "type": "module",
  "packageManager": "pnpm@10.28.1",
  "engines": {
    "node": ">=22.0.0",
    "pnpm": ">=10.0.0"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "lint:a11y": "eslint . --report-unused-disable-directives --max-warnings 0",
    "type-check": "astro check",
    "test": "vitest run --passWithNoTests",
    "test:watch": "vitest --watch",
    "test:coverage": "vitest run --coverage --passWithNoTests",
    "cspell": "cspell lint --no-progress .",
    "knip": "knip",
    "prepare": "husky"
  },
  "dependencies": {
    "astro": "^7.2.0"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "@vitest/coverage-v8": "^3.2.4",
    "jsdom": "^30.0.1",
    "eslint": "^9.39.2",
    "cspell": "^10.0.1",
    "@types/node": "^26.1.2",
    "vitest": "^3.2.4",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-import": "^2.32.0",
    "@testing-library/jest-dom": "^7.0.0",
    "eslint-plugin-astro": "^3.1.0",
    "lint-staged": "^17.3.0",
    "typescript-eslint": "^8.53.1",
    "@commitlint/config-conventional": "^21.2.0",
    "@commitlint/cli": "^19.8.1",
    "eslint-import-resolver-typescript": "^4.4.5",
    "husky": "^9.1.7",
    "typescript": "^6.0.3",
    "knip": "^6.31.0",
    "prettier": "^3.9.6",
    "prettier-plugin-astro": "^0.14.1"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx,astro}": [
      "eslint --fix"
    ],
    "*": [
      "prettier --write"
    ]
  }
}
